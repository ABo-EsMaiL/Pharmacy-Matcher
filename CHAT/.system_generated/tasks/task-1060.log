    flex: 1;

    overflow-y: auto; /* Screens scroll internally if needed */

}



.screen.active {

    display: flex;

    flex-direction: column;

}



@keyframes slideIn {

    from { opacity: 0; transform: translateY(20px) scale(0.98); }

    to { opacity: 1; transform: translateY(0) scale(1); }

}



