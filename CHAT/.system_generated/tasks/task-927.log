        
        items = []
        for name in extracted:
            if isinstance(name, str) and name.strip():
                items.append({"item_name_raw": name.strip(), "source_page": 1})
        return items
    except Exception as e:
        print(f"     -> Gemini extraction failed: {e}")
        return []

