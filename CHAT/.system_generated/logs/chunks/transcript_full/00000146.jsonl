{"step_index":6947,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-24T14:47:55Z","content":"Created At: 2026-09-24T17:47:55+03:00\nCompleted At: 2026-09-24T17:47:55+03:00\nFile Path: `file:///D:/AI_Engineer/Pharmacy/review/match_guards.py`\nTotal Lines: 161\nTotal Bytes: 7309\nShowing lines 1 to 150\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"\"\"Conservative review flags, not a complete pharmaceutical identity validator.\n2: \n3: Never approve a match. Preserve source text and the model response. Recognize\n4: common explicit measurements/counts; ambiguous units and compound strengths\n5: still require separate review. An exact Arabic-token reversal is only a hint.\n6: \"\"\"\n7: \n8: from collections import Counter\n9: from decimal import Decimal\n10: import re\n11: import unicodedata\n12: \n13: \n14: def normalize(text):\n15:     text = unicodedata.normalize(\"NFKC\", text).lower().replace(\"ـ\", \"\")\n16:     text = \"\".join(str(unicodedata.decimal(c)) if c.isdecimal() else c for c in text)\n17:     return re.sub(r\"[\\u064b-\\u065f\\u0670]\", \"\", text).replace(\"٫\", \".\")\n18: \n19: \n20: UNITS = {}\n21: for aliases, kind, factor in [\n22:     (\"مجم ملجم ملغ مج mg milligram milligrams\", \"mass_mg\", \"1\"),\n23:     (\"جم جرام غرام غم g gm gram grams\", \"mass_mg\", \"1000\"),\n24:     (\"ميكروجرام ميكروغرام mcg ug µg\", \"mass_mg\", \"0.001\"),\n25:     (\"مل ملل مللي مللى ملليلتر ملليتر ml milliliter milliliters\", \"volume_ml\", \"1\"),\n26:     (\"لتر l liter liters\", \"volume_ml\", \"1000\"),\n27:     (\"قرص اقراص أقراص tablet tablets tab tabs\", \"tablets\", \"1\"),\n28:     (\"كبسول كبسوله كبسولة كبسولات capsule capsules cap caps\", \"capsules\", \"1\"),\n29:     (\"امبول أمبول امبوله امبولة أمبولة امبولات أمبولات ampoule ampoules amp amps\", \"ampoules\", \"1\"),\n30:     (\"شريط شرائط strip strips\", \"strips\", \"1\"),\n31:     (\"كيس اكياس أكياس sachet sachets\", \"sachets\", \"1\"),\n32:     (\"% ٪\", \"percent\", \"1\"),\n33: ]:\n34:     for alias in aliases.split():\n35:         UNITS[normalize(alias)] = (kind, Decimal(factor))\n36: \n37: UNIT_PATTERN = \"|\".join(re.escape(unit) for unit in sorted(UNITS, key=len, reverse=True))\n38: MEASURE = re.compile(r\"(?<![\\d.,])(?P<number>\\d+(?:\\.\\d+)?)\\s*(?P<unit>\" + UNIT_PATTERN + r\")(?![a-z\\u0621-\\u064a])\")\n39: TOKENS = re.compile(r\"[\\u0621-\\u064a]+|[a-z]+|\\d+(?:\\.\\d+)?|[%/]\")\n40: NUMBERS = re.compile(r\"\\d+(?:\\.\\d+)?\")\n41: FORMS = {\n42:     \"cream\": \"كريم cream\", \"ointment\": \"مرهم ointment\",\n43:     \"tablets\": \"قرص اقراص أقراص tablet tablets tab tabs\",\n44:     \"capsules\": \"كبسول كبسولة كبسوله كبسولات capsule capsules cap caps\",\n45:     \"syrup\": \"شراب syrup\", \"drops\": \"قطرة قطره نقط drops\",\n46:     \"spray\": \"بخاخ بخاخة بخاخه spray\", \"gel\": \"جل gel\",\n47:     \"ampoules\": \"امبول أمبول امبوله امبولة أمبولة امبولات ampoule ampoules\",\n48:     \"vial\": \"فيال vial vials\", \"suppository\": \"لبوس اقماع أقماع suppository suppositories\",\n49: }\n50: \n51: \n52: def product_text(text):\n53:     # Only explicitly labelled prices are excluded; unlabeled digits remain evidence.\n54:     return re.sub(r\"(?:سعر(?:\\s*(?:جديد|قديم))?|price)\\s*[:=]?\\s*\\d+(?:\\.\\d+)?\", \" \", normalize(text))\n55: \n56: \n57: def bare_numbers(text):\n58:     remaining = MEASURE.sub(\" \", product_text(text))\n59:     return Counter(Decimal(value) for value in NUMBERS.findall(remaining))\n60: \n61: \n62: def dosage_forms(text):\n63:     tokens = set(TOKENS.findall(product_text(text)))\n64:     return {form for form, aliases in FORMS.items() if tokens.intersection(normalize(a) for a in aliases.split())}\n65: \n66: \n67: STRENGTH_KINDS = {\"mass_mg\", \"volume_ml\", \"percent\"}\n68: \n69: def strength_measurements(text):\n70:     \"\"\"Extracts only critical strengths/concentrations (mass, volume, percent).\n71:     Pack sizes (tablets, strips, counts) are excluded as they do not prevent matching.\n72:     \"\"\"\n73:     found = Counter()\n74:     for match in MEASURE.finditer(product_text(text)):\n75:         kind, factor = UNITS[match[\"unit\"]]\n76:         if kind in STRENGTH_KINDS:\n77:             found[(kind, Decimal(match[\"number\"]) * factor)] += 1\n78:     return found\n79: \n80: \n81: def reversal_hint(request, candidate):\n82:     left, right = TOKENS.findall(normalize(request)), TOKENS.findall(normalize(candidate))\n83:     if len(left) != len(right):\n84:         return False\n85:     changed = False\n86:     for a, b in zip(left, right):\n87:         if a == b:\n88:             continue\n89:         if len(a) >= 4 and re.fullmatch(r\"[\\u0621-\\u064a]+\", a) and a == b[::-1]:\n90:             changed = True\n91:         else:\n92:             return False\n93:     return changed\n94: \n95: \n96: def guard_decision(case, decision, catalog):\n97:     \"\"\"\n98:     Applies the new approved pharmaceutical Decision Graph:\n99:     1. Strength / Concentration is a RED LINE: Explicit conflict -> NO_MATCH.\n100:     2. Dosage Form: Different form with matching product and strength -> REVIEW.\n101:     3. Packaging / Pack Count / Bare Numbers / Price markers -> DO NOT prevent MATCH.\n102:     4. Reversal / OCR hints -> REVIEW.\n103:     \"\"\"\n104:     result = {\n105:         **decision,\n106:         \"model_status\": decision[\"status\"],\n107:         \"model_item_ids\": list(decision.get(\"item_ids\", [])),\n108:         \"model_reason\": decision.get(\"reason\", \"\"),\n109:         \"guard_notes\": []\n110:     }\n111:     by_id = {p[\"id\"]: p[\"name\"] for p in catalog}\n112: \n113:     if decision.get(\"status\") == \"match\":\n114:         req_strengths = strength_measurements(case[\"requested_name\"])\n115:         requested_forms = dosage_forms(case[\"requested_name\"])\n116: \n117:         valid_match_ids = []\n118:         for item_id in decision.get(\"item_ids\", []):\n119:             cand_name = by_id.get(item_id, \"\")\n120:             cand_strengths = strength_measurements(cand_name)\n121:             supplied_forms = dosage_forms(cand_name)\n122: \n123:             # Rule 1: Strength conflict is a RED LINE (NO_MATCH)\n124:             # If both have explicit strengths and they conflict\n125:             if req_strengths and cand_strengths and req_strengths != cand_strengths:\n126:                 result[\"guard_notes\"].append(\n127:                     f\"اختلاف صريح في التركيز (خط أحمر): {case['requested_name']} vs {cand_name}\"\n128:                 )\n129:                 continue\n130: \n131:             # Rule 2: Dosage form conflict -> REVIEW (does not reject, but requires pharmacist review)\n132:             if requested_forms and supplied_forms and requested_forms != supplied_forms:\n133:                 result[\"guard_notes\"].append(\n134:                     f\"نفس المنتج والتركيز ولكن مع اختلاف في الشكل الدوائي: مطلوب {requested_forms} والمخزن {supplied_forms}\"\n135:                 )\n136: \n137:             valid_match_ids.append(item_id)\n138: \n139:         # Evaluate final status\n140:         if not valid_match_ids and decision.get(\"item_ids\"):\n141:             # All candidates failed the strength red line\n142:             result[\"status\"] = \"no_match\"\n143:             result[\"item_ids\"] = []\n144:             result[\"reason\"] = \"اختلاف صريح في التركيز يمنع المطابقة تماماً (خط أحمر).\"\n145:         elif any(\"اختلاف في الشكل الدوائي\" in note for note in result[\"guard_notes\"]):\n146:             result[\"status\"] = \"review\"\n147:             result[\"item_ids\"] = valid_match_ids\n148:             result[\"reason\"] = \" | \".join(result[\"guard_notes\"])\n149:         else:\n150:             result[\"item_ids\"] = valid_match_ids\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
