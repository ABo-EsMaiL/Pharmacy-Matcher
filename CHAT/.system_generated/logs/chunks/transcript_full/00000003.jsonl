tes:\n78:             duplicates[name][\"sources\"].append(product)\n79:         else:\n80:             request = {\"id\": f\"Q{len(requests)+1:05}\", \"name_raw\": name, \"sources\": [product]}\n81:             duplicates[name] = request\n82:             requests.append(request)\n83:     suppliers, sources = [], [shortage_source]\n84:     for index, spec in enumerate(config[\"suppliers\"], 1):\n85:         raw, source = read_input(spec, base, args, keys)\n86:         wid = f\"W{index}\"\n87:         items = [{**p, \"id\": f\"{wid}-{i:05}\"} for i, p in enumerate(raw, 1)]\n88:         suppliers.append({\"id\": wid, \"name\": Path(source[\"document_name\"]).stem, \"items\": items})\n89:         sources.append(source)\n90:     if not suppliers:\n91:         raise ValueError(\"Configure at least one supplier.\")\n92:     return requests, suppliers, {\"sources\": sources, \"original_shortage_rows\": len(raw_requests)}\n93: \n94: \n95: def build_jobs(requests, suppliers, size, model):\n96:     decisions, jobs = [], []\n97:     for supplier in suppliers:\n98:         wid = supplier[\"id\"]\n99:         catalog = [{\"id\": p[\"id\"], \"name\": p[\"name_raw\"]} for p in supplier[\"items\"]]\n100:         exact = {}\n101:         for item in catalog:\n102:             exact.setdefault(\" \".join(item[\"name\"].split()).casefold(), []).append(item[\"id\"])\n103:         pending = []\n104:         for request in requests:\n105:             case = {\"case_id\": request[\"id\"] + \"-\" + wid, \"requested_name\": request[\"name_raw\"], \"catalog_id\": wid}\n106:             ids = exact.get(\" \".join(request[\"name_raw\"].split()).casefold())\n107:             if ids:\n108:                 decision = {\"case_id\": case[\"case_id\"], \"status\": \"match\", \"item_ids\": ids,\n109:                             \"reason\": \"تطابق النص الكامل بعد توحيد المسافات وحالة الحروف فقط.\"}\n110:                 decisions.append({**guard_decision(case, decision, catalog), \"request_id\": request[\"id\"],\n111:                                   \"supplier_id\": wid, \"origin\": \"exact_text\"})\n112:             else:\n113:                 pending.append(case)\n114:         for offset in range(0, len(pending), size):\n115:             inputs = {\"catalogs\": {wid: catalog}, \"cases\": pending[offset:offset+size]}\n116:             identity = {\"model\": model, \"system\": SYSTEM, \"generation\": GENERATION, \"inputs\": inputs}\n117:             jobs.append({\"id\": digest(identity), \"supplier_id\": wid, \"inputs\": inputs})\n118:     return decisions, jobs\n119: \n120: \n121: def get_key(keys, name):\n122:     if name not in keys:\n123:         keys[name] = os.environ.get(name, \"\").strip() or getpass.getpass(f\"Paste {name} (hidden): \").strip()\n124:     if not keys[name]:\n125:         raise ValueError(f\"No {name} supplied.\")\n126:     return keys[name]\n127: \n128: \n129: def process_job(job, model, args, keys, interval, last_call):\n130:     import requests\n131:     directory = OUTPUT / \"batch_cache\" / job[\"id\"]\n132:     response_path = directory / \"response.json\"\n133:     if response_path.is_file():\n134:         response = load(response_path)\n135:     else:\n136:         if args.export_only:\n137:             raise ValueError(\"Missing cached batch. Export-only sends no API requests.\")\n138:         attempt_path = directory / \"attempt.json\"\n139:         attempt = load(attempt_path) if attempt_path.is_file() else {}\n140:         if attempt.get(\"state\") == \"uncertain\" and not args.retry_uncertain:\n141:             raise ValueError(\"An earlier batch may have reached Gemini but no reply was saved. Inspect its folder; use --retry-uncertain only to explicitly resend it.\")\n142:         key = get_key(keys, \"GEMINI_API_KEY\")\n143:         wait = interval - (time.monotonic() - last_call[0])\n144:         if wait > 0:\n145:             time.sleep(wait)\n146:         directory.mkdir(parents=True, exist_ok=True)\n147:         body 