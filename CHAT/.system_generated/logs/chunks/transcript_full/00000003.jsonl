y\", \"export_orders.py\", \"match_guards.py\", \"product_inputs.py\")})\n202:         run_id = digest({\"requests\": requests, \"suppliers\": suppliers, \"jobs\": [j[\"id\"] for j in jobs], \"code\": code_hash})[:20]\n203:         run_dir = OUTPUT / \"runs\" / run_id\n204:         run_dir.mkdir(parents=True, exist_ok=True)\n205:         context.update(model=model, run_id=run_id, code_hash=code_hash)\n206:         save(run_dir / \"inputs.json\", {\"requests\": requests, \"suppliers\": suppliers, \"context\": context})\n207:         remaining = sum(not (OUTPUT / \"batch_cache\" / j[\"id\"] / \"response.json\").is_file() for j in jobs)\n208:         print(f\"Python: {sys.executable}\\nModel: {model}\\nRun: {run_dir}\", flush=True)\n209:         print(f\"Shortage rows: {context['original_shortage_rows']}; distinct raw names: {len(requests)}\", flush=True)\n210:         for supplier in suppliers:\n211:             print(f\"Supplier: {supplier['name']} | products: {len(supplier['items'])}\", flush=True)\n212:         print(f\"Exact comparisons handled locally: {len(decisions)}. API batches remaining: {remaining}/{len(jobs)}.\", flush=True)\n213:         print(\"Only these configured suppliers are included. Every request is checked against every supplier.\", flush=True)\n214:         print(\"Use a Gemini Free Tier project key for free allowance; no paid/provider fallback is enabled.\", flush=True)\n215:         last_call = [0.0]\n216:         for index, job in enumerate(jobs, 1):\n217:             print(f\"Batch {index}/{len(jobs)} | {job['supplier_id']} | {len(job['inputs']['cases'])} requests\", flush=True)\n218:             decisions.extend(process_job(job, model, args, keys, interval, last_call))\n219:             save(run_dir / \"progress.json\", {\"completed_batches\": index, \"total_batches\": len(jobs),\n220:                                              \"decision_count\": len(decisions), \"processing_complete\": False})\n221:         save(run_dir / \"results.json