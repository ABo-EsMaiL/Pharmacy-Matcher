"\"\"\n35:         self.ids = [item[\"id\"] for item in warehouse_items]\n36:         self.original_names = [item[\"name\"] for item in warehouse_items]\n37:         self.corpus = [normalize_for_search(name) for name in self.original_names]\n38:         \n39:         if self.corpus:\n40:             self.matrix = self.vectorizer.fit_transform(self.corpus)\n41: \n42:     def search(self, query: str, top_k: int = 5) -> list[dict]:\n43:         \"\"\"Returns the top_k most similar items from the warehouse.\"\"\"\n44:         if not self.corpus:\n45:             return []\n46:             \n47:         q_norm = normalize_for_search(query)\n48:         if not q_norm:\n49:             return []\n50:             \n51:         q_vec = self.vectorizer.transform([q_norm])\n52:         sims = cosine_similarity(q_vec, self.matrix).flatten()\n53:         \n54:         # Get top K indices\n55:         top_indices = np.argsort(sims)[-top_k:][::-1]\n56:         \n57:         results = []\n58:         for idx in top_indices:\n59:             score = float(sims[idx])\n60:             if score > 0.1:  # Ignore completely unrelated items\n61:                 results.append({\n62:                     \"id\": self.ids[idx],\n63:                     \"name\": self.original_names[idx],\n64:                     \"score\": score\n65:                 })\n66:         return results\n67: \nThe above content shows the entire, complete file contents of the requested file.\n"}
{"step_index":3846,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-22T21:15:10Z","tool_calls":[{"name":"write_to_file","args":{"ArtifactMetadata":{"RequestFeedback":false,"Summary":"Enhanced Candidate Finder with dosage form and brand identity filtering","UserFacing":false},"CodeContent":"import numpy as np\nfrom sklearn.feature_extraction.text import TfidfVectorizer\nfrom sklearn.metrics.pairwise import cosine_similarity\nimport re\nfrom rapidfuzz import fuzz\nfrom ..match.text_match import normalize_text\n\nPHARMA_STOPWORDS = {\n    # forms\n    'اقراص', 'قرص', 'كبسول', 'كبسوله', 'كبسولات', 'حبوب', 'شراب', 'شرب', 'معلق', 'سائل',\n    'مرهم', 'كريم', 'جل', 'جيل', 'امبول', 'امبوله', 'امبولات', 'حقن', 'فيال',\n    'لبوس', 'لبوسة', 'لبوسه', 'تحاميل', 'اقماع', 'نقط', 'قطرة', 'قطره',\n    'بخاخ', 'بخاخة', 'بخاخه', 'سبراي', 'فوار', 'اكياس', 'كيس',\n    'شامبو', 'غسول', 'صابون', 'صابونة', 'صابونه', 'محلول', 'مس', 'دهان', 'فيلم', 'شريط',\n    # units & numbers\n    'مجم', 'جم', 'جرام', 'مل', 'مللي', 'لتر', 'ميكرو', 'علبه', 'علبة',\n    'باكت', 'باكو', 'كرتونه', 'كرتونة', 'فلتر',\n    # trade metadata\n    'س', 'ج', 'سعر', 'جديد', 'قديم', 'تاريخ', 'بعيد', 'قريب', 'صغير', 'كبير', 'وسط',\n    'محلي', 'مستورد', 'خاص', 'نقدى', 'اجل'\n}\n\nFORM_GROUPS = {\n    'tablet': {'اقراص', 'قرص', 'كبسول', 'كبسوله', 'كبسولات', 'حبوب', 'فيلم', 'شريط'},\n    'syrup': {'شراب', 'شرب', 'معلق', 'سائل'},\n    'cream_ointment': {'كريم', 'مرهم', 'دهان'},\n    'gel': {'جل', 'جيل'},\n    'suppository': {'لبوس', 'لبوسه', 'لبوسة', 'تحاميل', 'اقماع'},\n    'injection': {'امبول', 'امبوله', 'امبولات', 'حقن', 'فيال'},\n    'drops': {'نقط', 'قطرة', 'قطره'},\n    'spray': {'بخاخ', 'بخاخة', 'بخاخه', 'سبراي'},\n    'sachet': {'فوار', 'اكياس', 'كيس'},\n    'wash': {'شامبو', 'غسول', 'صابون', 'صابونة', 'صابونه'},\n    'topical_solution': {'مس', 'محلول', 'لوشن', 'لوسيون'},\n}\n\ndef extract_form_group(text: str) -> str | None:\n    norm = normalize_text(text)\n    words = set(norm.split())\n    for group_name, group_words in FORM_GROUPS.items():\n        if words & group_words:\n            return group_name\n    return None\n\ndef extract_brand_tokens(text: str) -> str:\n    text = re.sub(r'(\\d+)', r' \\1 ', text)\n    norm = normalize_text(text)\n    norm = re.sub(r'/.*', '', norm)  # remove manufacturer after slash\n    words = [w for w in norm.split() if w not in PHARMA_STOPWORDS and not w.isdigit() and len(w) > 1]\n    return \" \".join(words)\n\ndef normalize_for_search(text: str) -> str:\n    \"\"\"Enhanced normalization for Arabic pharmaceutical search.\"\"\"\n    if not text:\n        return \"\"\n    text = str(text).lower()\n    text = re.sub(r'[\\u064B-\\u065F\\u0670\\u0640]', '', text)  # Remove Arabic diacritics and tatweel\n    text = re.sub(r'[أإآ]', 'ا', text)\n    text = re.sub(r'ة', 'ه', text)\n    text = re.sub(r'ى', 'ي', text)\n    # Eastern Arabic to Western digits\n    for e, w in zip('٠١٢٣٤٥٦٧٨٩', '0123456789'):\n        text = text.replace(e, w)\n    text = re.sub(r'[^\\w\\s]', ' ', text)  # Replace punctuation with spaces\n    text = re.sub(r'\\s+', ' ', text).strip()\n    return text\n\nclass FastCandidateFinder:\n    def __init__(self):\n        # Character N-Grams (2 to 4 chars)\n        self.vectorizer = TfidfVectorizer(analyzer='char_wb', ngram_range=(2, 4))\n        self.corpus = []\n        self.original_names = []\n        self.ids = []\n        self.matrix = None\n\n    def fit(self, warehouse_items: list[dict]):\n        \"\"\"\n        warehouse_items: list of dicts with 'id' and 'name'\n        \"\"\"\n        self.ids = [item[\"id\"] for item in warehouse_items]\n        self.original_names = [item[\"name\"] for item in warehouse_items]\n        self.corpus = [normalize_for_search(name) for name in self.original_names]\n        \n        if self.corpus:\n            self.matrix = self.vectorizer.fit_transform(self.corpus)\n\n    def search(self, query: str, top_k: int = 6) -> list[dict]:\n        \"\"\"Returns the top_k most similar items from the warehouse with pharmaceutical validation.\"\"\"\n        if not self.corpus:\n            return []\n            \n        q_norm = normalize_for_search(query)\n        if not q_norm:\n            return []\n            \n        q_vec = self.vectorizer.transform([q_norm])\n        sims = cosine_similarity(q_vec, self.matrix).flatten()\n        \n        # Look at top candidates\n        top_indices = np.argsort(sims)[-top_k * 3:][::-1]\n        \n        req_brand = extract_brand_tokens(query)\n        req_form = extract_form_group(query)\n        \n        results = []\n        for idx in top_indices:\n            score = float(sims[idx])\n            cand_name = self.original_names[idx]\n            cand_brand = extract_brand_tokens(cand_name)\n            cand_form = extract_form_group(cand_name)\n            \n            # Rule 1: Zero tolerance for conflicting dosage forms (Tablets vs Syrup, Cream vs Suppository, etc.)\n            if req_form and cand_form and req_form != cand_form:\n                continue\n                \n            # Rule 2: Brand similarity check (Levenshtein / Token sort)\n            words_req = req_brand.split()\n            words_cand = cand_brand.split()\n            if len(words_req) > 1 or len(words_cand) > 1:\n                brand_sim = fuzz.token_sort_ratio(req_brand, cand_brand)\n            else:\n                brand_sim = fuzz.ratio(req_brand, cand_brand)\n                \n            # Check prefix match for brand names\n            if req_brand and cand_brand:\n                if req_brand.startswith(cand_brand) or cand_brand.startswith(req_brand):\n                    brand_sim = max(brand_sim, 80)\n                    \n            # Rule 3: Only accept candidates that share the brand name (>=58%) OR very high TF-IDF (>=0.50)\n            if brand_sim >= 58 or score >= 0.50:\n                results.append({\n                    \"id\": self.ids[idx],\n                    \"name\": cand_name,\n                    \"score\": score,\n                    \"brand_sim\": brand_sim\n                })\n                if len(results) >= top_k:\n                    break\n                    \n        return results\n","Description":"Enhanced Candidate Finder with dosage form and brand identity filtering","Overwrite":true,"TargetFile":"d:\\AI_Engineer\\Pharmacy-agy\\src\\fast_match\\search.py","toolAction":"Writing search.py","toolSummary":"Update search.py with strict pharma filtering"}}]}
