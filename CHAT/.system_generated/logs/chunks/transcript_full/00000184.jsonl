{"step_index":9066,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-24T23:04:56Z","content":"Created At: 2026-09-25T02:04:56+03:00\nCompleted At: 2026-09-25T02:04:56+03:00\nFile Path: `file:///D:/AI_Engineer/Pharmacy-agy/desktop_app/server_manager.py`\nTotal Lines: 423\nTotal Bytes: 17143\nShowing lines 1 to 120\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"\"\"\n2: Multi-Server Manager for Pharmacy Matcher.\n3: Supports dual local AI servers:\n4: 1. MSEMAX ChatGPT (OpenAI Web Hook) on Port 8000\n5: 2. MSEMAX Google AI Studio (Gemini Web Hook) on Port 8001\n6: \n7: Provides start, stop, test (live latency & ping), session login, and 1-click active switching.\n8: \"\"\"\n9: \n10: import subprocess\n11: import os\n12: import signal\n13: import time\n14: import sys\n15: import threading\n16: import socket\n17: from pathlib import Path\n18: import requests\n19: \n20: DEFAULT_SERVERS = {\n21:     \"chatgpt\": {\n22:         \"name\": \"MSEMAX (ChatGPT / OpenAI)\",\n23:         \"default_dir\": r\"D:\\AI_Engineer\\MSEMAX\",\n24:         \"port\": 8000,\n25:         \"default_model\": \"gpt-4o\",\n26:         \"url\": \"http://127.0.0.1:8000/v1/chat/completions\",\n27:         \"api_key\": \"[REDACTED_CREDENTIAL]\"\n28:     },\n29:     \"gaistudio\": {\n30:         \"name\": \"MSEMAX (Google AI Studio)\",\n31:         \"default_dir\": r\"D:\\AI_Engineer\\MSEMAX-GAIStudio\",\n32:         \"port\": 8001,\n33:         \"default_model\": \"gemini-3.8-flash\",\n34:         \"url\": \"http://127.0.0.1:8001/v1/chat/completions\",\n35:         \"api_key\": \"[REDACTED_CREDENTIAL]\"\n36:     }\n37: }\n38: \n39: def is_port_listening(port: int, host: str = \"127.0.0.1\", timeout: float = 0.5) -> bool:\n40:     try:\n41:         with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:\n42:             s.settimeout(timeout)\n43:             return s.connect_ex((host, port)) == 0\n44:     except Exception:\n45:         return False\n46: \n47: class ServerInstance:\n48:     def __init__(self, key: str, config: dict, logger_callback=None):\n49:         self.key = key\n50:         self.name = config.get(\"name\", key)\n51:         self.dir = config.get(\"dir\", config.get(\"default_dir\", \"\"))\n52:         self.port = int(config.get(\"port\", 8000))\n53:         self.default_model = config.get(\"default_model\", \"gpt-4o\")\n54:         self.url = config.get(\"url\", f\"http://127.0.0.1:{self.port}/v1/chat/completions\")\n55:         self.api_key = config.get(\"api_key\", \"[REDACTED_CREDENTIAL]\")\n56:         self.process = None\n57:         self.logger = logger_callback\n58: \n59:     def log(self, message: str):\n60:         prefix = f\"[{self.name}]\"\n61:         if self.logger:\n62:             self.logger(f\"{prefix} {message}\")\n63:         else:\n64:             print(f\"{prefix} {message}\")\n65: \n66:     def is_running(self) -> bool:\n67:         if self.process is not None and self.process.poll() is None:\n68:             return True\n69:         return is_port_listening(self.port)\n70: \n71:     def _read_output(self, pipe):\n72:         try:\n73:             for line in iter(pipe.readline, ''):\n74:                 if line:\n75:                     self.log(line.strip())\n76:         except Exception:\n77:             pass\n78:         finally:\n79:             pipe.close()\n80: \n81:     def start(self) -> dict:\n82:         if self.is_running():\n83:             self.log(f\"Server is already running on port {self.port}.\")\n84:             return {\"success\": True, \"message\": \"already running\", \"port\": self.port}\n85: \n86:         target_dir = Path(self.dir)\n87:         if not target_dir.exists():\n88:             self.log(f\"Error: Directory not found: {self.dir}\")\n89:             return {\"success\": False, \"message\": f\"Directory not found: {self.dir}\"}\n90: \n91:         app_script = target_dir / \"app.py\"\n92:         if not app_script.exists():\n93:             self.log(f\"Error: app.py not found in {self.dir}\")\n94:             return {\"success\": False, \"message\": f\"app.py not found in {self.dir}\"}\n95: \n96:         try:\n97:             creationflags = 0\n98:             if os.name == 'nt':\n99:                 creationflags = subprocess.CREATE_NO_WINDOW\n100: \n101:             self.log(f\"Starting server in {self.dir} on port {self.port}...\")\n102:             self.process = subprocess.Popen(\n103:                 [sys.executable, \"app.py\"],\n104:                 cwd=str(target_dir),\n105:                 creationflags=creationflags,\n106:                 stdout=subprocess.PIPE,\n107:                 stderr=subprocess.STDOUT,\n108:                 text=True,\n109:                 bufsize=1\n110:             )\n111: \n112:             t = threading.Thread(target=self._read_output, args=(self.process.stdout,), daemon=True)\n113:             t.start()\n114: \n115:             # Brief check for early crash\n116:             time.sleep(1.5)\n117:             if self.process.poll() is not None:\n118:                 return {\"success\": False, \"message\": f\"Process exited early with code {self.process.returncode}\"}\n119: \n120:             self.log(f\"Server process started successfully (PID: {self.process.pid}).\")\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
