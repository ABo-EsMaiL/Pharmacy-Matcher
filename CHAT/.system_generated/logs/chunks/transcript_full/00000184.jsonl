:                 self.process = None\n152: \n153:             # Step 3: Check if port is still listening by any orphaned process\n154:             if is_port_listening(self.port) and os.name == 'nt':\n155:                 try:\n156:                     res = subprocess.run(\n157:                         f'netstat -ano | findstr \":{self.port} \"',\n158:                         shell=True, capture_output=True, text=True\n159:                     )\n160:                     pids_to_kill = set()\n161:                     for line in res.stdout.strip().splitlines():\n162:                         parts = line.strip().split()\n163:                         if len(parts) >= 5 and \"LISTENING\" in line:\n164:                             pids_to_kill.add(parts[-1])\n165: \n166:                     pids_needing_elevation = set()\n167:                     for pid in pids_to_kill:\n168:                         r_kill = subprocess.run(['taskkill', '/F', '/PID', pid], capture_output=True, text=True)\n169:                         if \"Access is denied\" in r_kill.stderr or r_kill.returncode != 0:\n170:                             pids_needing_elevation.add(pid)\n171: \n172:                     if pids_needing_elevation:\n173:                         try:\n174:                             import ctypes\n175:                             pid_args = \" \".join([f\"/PID {p}\" for p in pids_needing_elevation])\n176:                             self.log(f\"Process {pid_args} requires administrator privileges. Requesting elevation...\")\n177:                             ctypes.windll.shell32.ShellExecuteW(\n178:                                 None, \"runas\", \"cmd.exe\", f\"/c taskkill /F {pid_args}\", None, 0\n179:                             )\n180:                         except Exception as ce:\n181:                             self.log(f\"Elevation request failed: {ce}\")\n182:                 except Exception as e:\n183:                     self.log(f\"Error checking port {self.port}: {e}\")\n184: \n185:             time.sleep(1.2)\n186:             if is_port_listening(self.port):\n187:                 self.log(f\"⚠️ Port {self.port} is still in use by an external elevated process.\")\n188:                 return {\n189:                     \"success\": False,\n190:                     \"message\": f\"المنفذ {self.port} محجوز بعملية سابقة تعمل كمسؤول (Administrator). يمكنك الضغط على 'تحرير المنافذ' أو تشغيل scripts\\\\free_ports.bat كمسؤول.\",\n191:                     \"elevated\": True,\n192:                     \"port\": self.port\n193:                 }\n194: \n195:             self.log(f\"{self.name} stopped successfully.\")\n196:             return {\"success\": True, \"message\": \"stopped\"}\n197:         except Exception as e:\n198:             self.log(f\"Failed to stop server: {e}\")\n199:             return {\"success\": False, \"message\": str(e)}\n200: \n201:     def test(self) -> dict:\n202:         \"\"\"Sends a test ping to the server to check connectivity and response time.\"\"\"\n203:         if not self.is_running():\n204:             return {\n205:                 \"success\": False,\n206:                 \"latency_ms\": 0,\n207:                 \"error\": \"السيرفر متوقف حالياً. يرجى الضغط على 'تشغيل السيرفر' أولاً ثم إعادة فحص الاتصال.\",\n208:                 \"is_stopped\": True,\n209:                 \"name\": self.name,\n210:                 \"port\": self.port\n211:             }\n212:         t0 = time.time()\n213:         self.log(f\"Sending test ping to {self.name} on port {self.port}...\")\n214:         try:\n215:             # First check health endpoint\n216:             health_url = f\"http://127.0.0.1:{self.port}/health\"\n217:             health_info = {}\n218:             try:\n219:                 r_h = requests.get(health_url, timeout=3)\n220:                 if r_h.status_code == 200:\n221:                     health_info = r_h.json()\n222:             except Exception:\n223:                 pass\n224: \n225:             # Next, test chat completions\n226:             payload = {\n227:                 \"model\": self.default_model,\n228:                 \"messages\": [\n229:                     {\"role\": \"user\", \"content\": \"Reply with only the exact word: PONG\"}\n230:                 ],\n231:                 \"stream\": False\n232:             }\n233:             r = requests.post(\n234:                 self.url,\n235:                 headers={\n236:                     \"Authorization\": f\"Bearer {self.api_key}\",\n237:                     \"Content-Type\": \"application/json\"\n238:                 },\n239:                 json=payload,\n240:                 timeout=25\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
