n text or '0.5' in text:\r\n83:         return '0.5'\r\n84:     return None\r\n85: \r\n86: def has_co(text: str) -> bool:\r\n87:     t = text.lower()\r\n88:     return bool(re.search(r'(?:^|[^\\w])(كو|بلس|بلاس|كومب|co|plus|comp)(?:[^\\w]|$)|كواقراص|كوأقراص|بلساقراص|بلسكبسول', t))\r\n89: \r\n90: def are_forms_identical(form1: str | None, form2: str | None) -> bool:\r\n91:     if not form1 or not form2:\r\n92:         return True\r\n93:     if form1 == form2:\r\n94:         return True\r\n95:     if (form1, form2) in {('tablet', 'capsule'), ('capsule', 'tablet')}:\r\n96:         return True\r\n97:     return False\r\n98: \r\n99: def are_forms_compatible(form1: str | None, form2: str | None) -> bool:\r\n100:     if not form1 and not form2:\r\n101:         return True\r\n102:     if form1 == form2:\r\n103:         return True\r\n104:     compat = {\r\n105:         ('tablet', 'capsule'), ('capsule', 'tablet'),\r\n106:         ('cream', 'ointment'), ('ointment', 'cream'),\r\n107:         ('cream', 'gel'), ('gel', 'cream'),\r\n108:         ('injection', 'ampoule'), ('ampoule', 'injection'),\r\n109:     }\r\n110:     if (form1, form2) in compat:\r\n111:         return True\r\n112:     if form1 and form2 and form1 != form2:\r\n113:         return False\r\n114:     return True\r\n115: \r\n116: BRAND_FAMILIES = {'بيتادين', 'هيرو', 'انسولين', 'ليمتلس', 'سيتال', 'لبن'}\r\n117: \r\n118: def classify_pair(req: str, cand: str) -> tuple[str, str]:\r\n119:     \"\"\"\r\n120:     Classifies a (requested, candidate) pair according to the user's pharmaceutical algorithm:\r\n121:     - 'match': Same brand, same strength, identical/compatible form.\r\n122:     - 'review': Same brand, same strength, but DIFFERENT form (e.g. cream vs ointment, drops vs tablet).\r\n123:     - 'reject': Different strength (التركيز خط أحمر), or different combination, or brand family conflict.\r\n124:     - 'ambiguous': Brand similarity 60%-85% (OCR typos like برونفين vs بروفين) -> send to LLM.\r\n125:     \"\"\"\r\n126:     brand_r = extract_brand_tokens(req)\r\n127:     brand_c = extract_brand_tokens(cand)\r\n128:     if not brand_r or not brand_c:\r\n129:         return \"reject\", \"no_brand\"\r\n130:         \r\n131:     words_r = brand_r.split()\r\n132:     words_c = brand_c.split()\r\n133:     first_r = words_r[0] if words_r else \"\"\r\n134:     first_c = words_c[0] if words_c else \"\"\r\n135:     \r\n136:     # 1. Brand Family Protection\r\n137:     if first_r in BRAND_FAMILIES or first_c in BRAND_FAMILIES:\r\n138:         if fuzz.ratio(brand_r, brand_c) < 85:\r\n139:             return \"reject\", \"brand_family_conflict\"\r\n140:             \r\n141:     # 2. Combination check (كو / بلس)\r\n142:     if has_co(req) != has_co(cand):\r\n143:         return \"reject\", \"combination_mismatch\"\r\n144:         \r\n145:     # 3. Strength check (التركيز خط أحمر - zero tolerance)\r\n146:     str_r = get_strength_pattern(req)\r\n147:     str_c = get_strength_pattern(cand)\r\n148:     if str_r and str_c:\r\n149:         try:\r\n150:             if float(str_r) != float(str_c):\r\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
