t_ok=True)\n46:     cache_file = cache_dir / f\"{file_hash}.json\"\n47:     \n48:     if cache_file.exists():\n49:         print(f\"📄 تم العثور على الملف في الذاكرة المؤقتة (Cache). جاري تحميل البيانات المستخرجة مباشرة: {filepath.name}\")\n50:         with open(cache_file, \"r\", encoding=\"utf-8\") as f:\n51:             result = json.load(f)\n52:         # Also copy to local process directory\n53:         json_path = filepath.with_suffix(\".json\")\n54:         with open(json_path, \"w\", encoding=\"utf-8\") as jf:\n55:             json.dump(result, jf, ensure_ascii=False, indent=2)\n56:         return result\n57: \n58:     print(f\"📄 جارٍ رفع ملف PDF إلى Unstructured API: {filepath.name}\")\n59: \n60:     url = f\"{base_url.rstrip('/')}/api/v2/parse\"\n61:     headers = {\"unstructured-api-key\": api_key, \"accept\": \"application/json\"}\n62: \n63:     # رفع الملف مع إعدادات الاستخراج\n64:     with open(filepath, \"rb\") as f:\n65:         files = {\n66:             \"input\": (filepath.name, f, \"application/pdf\"),\n67:         }\n68:         data = {\n69:             \"profile\": \"best\",\n70:             \"output\": \"elements\",\n71:         }\n72: \n73:         response = requests.post(url, headers=headers, files=files, data=data)\n74: \n75:     # معالجة الاستجابة\n76:     if response.status_code == 200:\n77:         # استجابة فورية - النتائج جاهزة\n78:         print(\"  ✅ تم استخراج البيانات فوراً\")\n79:         result = response.json()\n80: \n81:     elif response.status_code == 202:\n82:         # مهمة غير متزامنة - يجب الانتظار\n83:         poll_url = response.headers.get(\"Location\")\n84:         if not poll_url:\n85:             raise RuntimeError(\n86:                 \"❌ استجابة 202 بدون رابط Location للاستعلام عن حالة المهمة\"\n87:             )\n88: \n89:         print(f\"  ⏳ المهمة غير متزامنة، جارٍ الانتظار...\")\n90:         result = _poll_for_result(poll_url, headers)\n91: \n92:     else:\n93:         raise RuntimeError(\n94:             f\"❌ فشل الاتصال بـ Unstructured API\\n\"\n95:             f\"  الحالة: {response.status_code}\\n\"\n96:             f\"  الرد: {response.text[:500]}\"\n97:         )\n98: \n99:     # حفظ الاستجابة الخام كملف JSON بجانب ملف PDF\n100:     json_path = filepath.with_suffix(\".json\")\n101:     with open(json_path, \"w\", encoding=\"utf-8\") as jf:\n102:         json.dump(result, jf, ensure_ascii=False, indent=2)\n103:         \n104:     # حفظ في الذاكرة المؤقتة العامة للمرات القادمة\n105:     with open(cache_file, \"w\", encoding=\"utf-8\") as cf:\n106:         json.dump(result, cf, ensure_ascii=False, indent=2)\n107:         \n108:     print(f\"  💾 تم حفظ الاستجابة الخام: {json_path.name}\")\n109: \n110:     return result\n111: \n112: \n113: def parse_items_from_response(response: dict | list, gemini_api_key: str = None) -> list[dict]:\n114:     elements = _normalize_response(response)\n115: \n116:     items = _try_extracted_data(elements)\n117:     if items:\n118:         print(f\"     -> Extracted {len(items)} items from structured data\")\n119:         return items\n120: \n121:     items = _try_html_tables(elements)\n122:     if items and len(items) > 5:\n123:         print(f\"     -> Extracted {len(items)} items from HTML tables\")\n124:         return items\n125: \n126:     # Fallback to Gemini if normal extraction fails or extracts very few items\n127:     if gemini_api_key:\n128:         print(f\"     -> Basic extraction yielded {len(items)} items. Attempting Gemini AI extraction...\")\n129:         gemini_items = _extract_with_gemini(elements, gemini_api_key)\n130:         if gemini_items:\n131:             print(f\"     -> Extracted {len(gemini_items)} items using Gemini AI\")\n132:             return gemini_items\n133: \n134:     items = _try_text_content(elements)\n135:     print(f\"     -> Extracted {len(items)} items from raw text content\")\n136:     return items\n137: \n138: def _extract_with_gemini(elements: list[dict], api_key: str) -> list[dict]:\n139:     try:\n140:         from google import genai\n141:         client = genai.Client(api_key=api_key)\n142:         \n143:         # Collect all raw text from the elements\n144:         full_text = \"\\n\".join([elem.get(\"text\", \"\").strip() for elem in elements if elem.get(\"text\")])\n145:         if not full_text.strip():\n146:             return []\n147:             \n148:         prompt = f\"\"\"\n149:         أنت مساعد ذكي متخصص في قراءة فواتير ونواقص الأدوية والصيدليات.\n150:         مرفق لك النص الخام المستخرج من ملف PDF.\n151:         قم باستخراج جميع أسماء الأدوية والأصناف الموجودة في هذا النص.\n152:         أرجع النتيجة **فقط** على شكل مصفوفة JSON تحتوي على أسماء الأدوية كنصوص (Strings).\n153:         لا تقم بإضافة أي نصوص أخرى، أو markdown tags مثل ```json، فقط المصفوفة.\n154:         \n155