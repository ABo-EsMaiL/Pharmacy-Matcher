ct[str, Any] = {}\r\n\r\n        if output is not None:\r\n\r\n            query[\"output\"] = output\r\n\r\n        if include:\r\n\r\n            query[\"include\"] = include\r\n\r\n\r\n\r\n        url = f\"{self._client._server_url}/api/v2/jobs/{quote(job_id, safe='')}\"\r\n\r\n        if query:\r\n\r\n            url = f\"{url}?{urlencode(query, doseq=True)}\"\r\n\r\n\r\n\r\n        return stream_job_events(\r\n\r\n            url=url,\r\n\r\n            headers=self._client._request_headers(),\r\n\r\n            timeout_seconds=self._client._timeout_seconds,\r\n\r\n            retries=self._client._retries,\r\n\r\n        )\r\n\r\n\r\n\r\n\r\n\r\nclass _Upload(_Namespace):\r\n\r\n    def run(self, input: FileInput) -> Any:\r\n\r\n        return UploadApi(self._client._api_client).upload_run(as_file_part(input))\r\n\r\n\r\n\r\n    def get(self, file_id: str) -> Any:\r\n\r\n        return UploadApi(self._client._api_client).upload_get(file_id)\r\n\r\n\r\n\r\n    def delete(self, file_id: str) -> None:\r\n\r\n        UploadApi(self._client._api_client).upload_delete(file_id)\r\n\r\n\r\n\r\n\r\n\r\ndef _prefer(wait_seconds: int | None) -> str | None:\r\n\r\n    \"\"\"`Prefer: wait=N`, the contract's spelling for \"block for up to N seconds\".\r\n\r\n\r\n\r\n    Exposed as `wait_seconds=` rather than making callers hand-build a header\r\n\r\n    value; `wait_seconds=0` is meaningful (return the job handle immediately),\r\n\r\n    so the check is against None rather than falsiness.\r\n\r\n    \"\"\"\r\n\r\n    return None if wait_seconds is None else f\"wait={wait_seconds}\"\r\n\r\n\n\n</SYSTEM_MESSAGE>"}
