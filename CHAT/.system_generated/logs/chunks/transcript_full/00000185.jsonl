{"step_index":9120,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-24T23:06:35Z","content":"Created At: 2026-09-25T02:06:35+03:00\nCompleted At: 2026-09-25T02:06:35+03:00\nFile Path: `file:///C:/Users/kakak/.gemini/antigravity/brain/916274de-7f92-49fc-a0a8-d291664b474a/scratch/test_chatgpt_server.py`\nTotal Lines: 41\nTotal Bytes: 1084\nShowing lines 1 to 41\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: import sys\n2: import time\n3: from pathlib import Path\n4: \n5: PROJECT_ROOT = Path(r\"D:\\AI_Engineer\\Pharmacy-agy\")\n6: sys.path.insert(0, str(PROJECT_ROOT))\n7: \n8: from desktop_app.server_manager import MultiServerManager\n9: \n10: def main():\n11:     mgr = MultiServerManager(settings={}, logger_callback=print)\n12:     print(\"Starting chatgpt server...\")\n13:     res = mgr.start(\"chatgpt\")\n14:     print(\"Start result:\", res)\n15:     \n16:     # Wait for server to bind\n17:     for i in range(10):\n18:         time.sleep(1)\n19:         srv = mgr.get_server(\"chatgpt\")\n20:         st = srv.get_status() if srv else {}\n21:         print(f\"Waiting {i+1}s... Running: {st.get('running')}\")\n22:         if st.get(\"running\"):\n23:             break\n24: \n25:     import requests\n26:     try:\n27:         r = requests.get(\"http://127.0.0.1:8000/health\", timeout=3)\n28:         print(\"Health status code:\", r.status_code, \"JSON:\", r.json())\n29:     except Exception as e:\n30:         print(\"Health error:\", e)\n31: \n32:     test_res = mgr.test(\"chatgpt\")\n33:     print(\"Test connection result:\", test_res)\n34: \n35:     # Clean stop\n36:     print(\"Stopping server...\")\n37:     mgr.stop(\"chatgpt\")\n38: \n39: if __name__ == \"__main__\":\n40:     main()\n41: \nThe above content shows the entire, complete file contents of the requested file.\n"}
