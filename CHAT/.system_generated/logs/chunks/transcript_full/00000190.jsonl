de_json, \"r\", encoding=\"utf-8\") as f:\n42:                 result_data = json.load(f)\n43:             cached_items = parse_structured_result(result_data, filepath.name)\n44:             if len(cached_items) > 0:\n45:                 print(f\"[+] Loaded {len(cached_items)} items from alongside JSON: {alongside_json.name}\")\n46:                 return cached_items\n47:         except Exception as e:\n48:             print(f\"[*] Could not read alongside JSON: {e}\")\n49: \n50:     # 1. Local Cache Check\n51:     file_hash = _get_file_hash(filepath)\n52:     cache_dir = filepath.parent.parent.parent / 'data' / '.unstructured_cache'\n53:     cache_dir.mkdir(parents=True, exist_ok=True)\n54:     cache_file = cache_dir / f\"{file_hash}_extract.json\"\n55:     \n56:     if cache_file.exists():\n57:         try:\n58:             with open(cache_file, \"r\", encoding=\"utf-8\") as f:\n59:                 result_data = json.load(f)\n60:             cached_items = parse_structured_result(result_data, filepath.name)\n61:             if len(cached_items) > 0:\n62:                 print(f\"[+] Loaded {len(cached_items)} items from local cache: {filepath.name}\")\n63:                 return cached_items\n64:             else:\n65:                 print(f\"[*] Local cache has 0 items for {filepath.name}. Checking server...\")\n66:         except Exception:\n67:             print(f\"[*] Local cache invalid for {filepath.name}. Checking server...\")\n68: \n69:     try:\n70:         from unstructured_transform_client import TransformClient\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
