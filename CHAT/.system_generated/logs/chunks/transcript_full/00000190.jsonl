{"step_index":9376,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-25T11:42:14Z","content":"Created At: 2026-09-25T14:42:14+03:00\nCompleted At: 2026-09-25T14:42:15+03:00\nFile Path: `file:///C:/Users/kakak/.gemini/antigravity/brain/916274de-7f92-49fc-a0a8-d291664b474a/scratch/forensic_not_found_audit.py`\nTotal Lines: 111\nTotal Bytes: 4700\nShowing lines 1 to 111\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: import json\n2: import re\n3: from pathlib import Path\n4: from rapidfuzz import fuzz\n5: \n6: # 1. Load warehouse catalog items from cache\n7: CACHE_DIR = Path(r\"D:\\AI_Engineer\\Pharmacy-agy\\data\\cache\")\n8: warehouse_items = {}\n9: \n10: for f in CACHE_DIR.glob(\"*_extracted.json\"):\n11:     wh_name = f.name.replace(\"_extracted.json\", \"\")\n12:     with open(f, \"r\", encoding=\"utf-8\") as fp:\n13:         raw = json.load(fp)\n14:         items = raw if isinstance(raw, list) else raw.get(\"items\", [])\n15:         warehouse_items[wh_name] = [\n16:             it.get(\"item_name_raw\", \"\").strip() if isinstance(it, dict) else str(it).strip()\n17:             for it in items if it\n18:         ]\n19: \n20: print(\"=== LOADED WAREHOUSE CATALOGS ===\")\n21: for wh, items in warehouse_items.items():\n22:     print(f\"  {wh}: {len(items)} items\")\n23: \n24: # 2. Load Not Found items from PROC-015\n25: with open(r\"C:\\Users\\kakak\\.gemini\\antigravity\\brain\\916274de-7f92-49fc-a0a8-d291664b474a\\scratch\\extracted_4way_data.json\", \"r\", encoding=\"utf-8\") as fp:\n26:     full_data = json.load(fp)\n27: \n28: nf_items = [row[\"اسم الصنف\"].strip() for row in full_data[\"PROC-015\"][\"not_found\"] if row.get(\"اسم الصنف\")]\n29: print(f\"\\nTotal Not Found items in PROC-015 to audit: {len(nf_items)}\")\n30: \n31: # 3. Normalization helpers\n32: def super_norm(s):\n33:     s = s.lower()\n34:     for e, w in zip('٠١٢٣٤٥٦٧٨٩', '0123456789'):\n35:         s = s.replace(e, w)\n36:     # Normalize arabic/persian letters\n37:     rep = {\n38:         'أ': 'ا', 'إ': 'ا', 'آ': 'ا', 'ى': 'ي', 'ئ': 'ي', 'ی': 'ي',\n39:         'ة': 'ه', 'گ': 'ك', 'ک': 'ك', 'پ': 'ب', 'ژ': 'ز', 'چ': 'ج',\n40:         'ڤ': 'ف', 'ف': 'ف', 'ؤ': 'و', 'ء': '', 'ـ': ''\n41:     }\n42:     for k, v in rep.items():\n43:         s = s.replace(k, v)\n44:     s = re.sub(r'[^a-z0-9\\u0600-\\u06FF\\s]', ' ', s)\n45:     return re.sub(r'\\s+', ' ', s).strip()\n46: \n47: def extract_brand_token(s):\n48:     norm = super_norm(s)\n49:     # remove common dosage words\n50:     dosage_words = {'اقراص', 'قرص', 'كبسول', 'كبسولة', 'شريط', 'امبول', 'حقن', 'نقط', 'قطرة', 'شراب', 'معلق', 'كريم', 'مرهم', 'جل', 'سبراي', 'بخاخ', 'اكياس', 'كيس', 'س', 'ج', 'جديد', 'سعر', 'قديم', 'باكت', 'باكو', 'كرتونة', 'مل', 'ملل', 'جم', 'جرام', 'مجم', 'مج', 'مكجم'}\n51:     tokens = [w for w in norm.split() if w not in dosage_words and not w.isdigit()]\n52:     return tokens[0] if tokens else \"\"\n53: \n54: # 4. Forensic Search\n55: potential_discoveries = []\n56: \n57: for shortage in nf_items:\n58:     brand = extract_brand_token(shortage)\n59:     if not brand or len(brand) < 3:\n60:         continue\n61:         \n62:     norm_req = super_norm(shortage)\n63:     \n64:     for wh, items in warehouse_items.items():\n65:         for cand in items:\n66:             norm_cand = super_norm(cand)\n67:             cand_brand = extract_brand_token(cand)\n68:             if not cand_brand:\n69:                 continue\n70:                 \n71:             # Direct brand substring\n72:             if brand in norm_cand or cand_brand in norm_req:\n73:                 sim = max(fuzz.ratio(brand, cand_brand), fuzz.token_set_ratio(norm_req, norm_cand))\n74:                 if sim >= 70:\n75:                     potential_discoveries.append({\n76:                         \"shortage\": shortage,\n77:                         \"warehouse\": wh,\n78:                         \"warehouse_item\": cand,\n79:                         \"sim\": sim,\n80:                         \"reason\": f\"Substring match '{brand}' in '{cand}'\"\n81:                     })\n82:                     continue\n83:                     \n84:             # High fuzzy ratio on brand\n85:             b_sim = fuzz.ratio(brand, cand_brand)\n86:             if b_sim >= 75 and len(brand) >= 4 and len(cand_brand) >= 4:\n87:                 potential_discoveries.append({\n88:                     \"shortage\": shortage,\n89:                     \"warehouse\": wh,\n90:                     \"warehouse_item\": cand,\n91:                     \"sim\": b_sim,\n92:                     \"reason\": f\"Brand fuzzy match ({b_sim}%): '{brand}' vs '{cand_brand}'\"\n93:                 })\n94: \n95: # Deduplicate by (shortage, warehouse, warehouse_item)\n96: unique_discoveries = {}\n97: for d in potential_discoveries:\n98:     k = (d[\"shortage\"], d[\"warehouse\"], d[\"warehouse_item\"])\n99:     if k not in unique_discoveries or d[\"sim\"] > unique_discoveries[k][\"sim\"]:\n100:         unique_discoveries[k] = d\n101: \n102: results = list(unique_discoveries.values())\n103: results.sort(key=lambda x: x[\"sim\"], reverse=True)\n104: \n105: print(f\"\\n=== POTENTIAL HIDDEN DISCOVERIES FOUND: {len(results)} ===\")\n106: for r in results[:50]:\n107:     print(f\"[{r['warehouse']}] Shortage: '{r['shortage']}' -> Candidate: '{r['warehouse_item']}' ({r['reason']})\")\n108: \n109: with open(r\"C:\\Users\\kakak\\.gemini\\antigravity\\brain\\916274de-7f92-49fc-a0a8-d291664b474a\\scratch\\forensic_not_found_results.json\", \"w\", encoding=\"utf-8\") as fp:\n110:     json.dump(results, fp, ensure_ascii=False, indent=2)\n111: \nThe above content shows the entire, complete file contents of the requested file.\n"}
