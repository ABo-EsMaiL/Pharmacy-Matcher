\n35:             \"catalog_id\": \"W1\",\n36:             \"candidates\": [{\"id\": \"W1-001\", \"name\": \"نوفاكس 500 مجم 20 قرص\"}]\n37:         },\n38:         {\n39:             \"case_id\": \"TEST-02-DOSAGE-FORM\",\n40:             \"requested_name\": \"بيتاديرم مرهم 15 جم\",\n41:             \"catalog_id\": \"W1\",\n42:             \"candidates\": [{\"id\": \"W1-002\", \"name\": \"بيتاديرم كريم 15 جم\"}]\n43:         },\n44:         {\n45:             \"case_id\": \"TEST-03-PACK-SIZE\",\n46:             \"requested_name\": \"دوليبران 1000 مجم 15 قرص\",\n47:             \"catalog_id\": \"W1\",\n48:             \"candidates\": [{\"id\": \"W1-003\", \"name\": \"دوليبران 1 جم 60 قرص\"}]\n49:         },\n50:         {\n51:             \"case_id\": \"TEST-04-OCR-CORRUPTION\",\n52:             \"requested_name\": \"فورسيجا 10 مجم أقراص\",\n53:             \"catalog_id\": \"W1\",\n54:             \"candidates\": [{\"id\": \"W1-004\", \"name\": \"فورسجا 10 مجم أقراص\"}]\n55:         },\n56:         {\n57:             \"case_id\": \"TEST-05-GENERIC-ALT\",\n58:             \"requested_name\": \"بنادول 500 مجم أقراص\",\n59:             \"catalog_id\": \"W1\",\n60:             \"candidates\": [{\"id\": \"W1-005\", \"name\": \"سيتال 500 مجم أقراص\"}]\n61:         }\n62:     ]\n63: \n64:     # Replicate exactly 50 cases (10 replicates of 5 canonical rules)\n65:     cases_50 = []\n66:     for i in range(10):\n67:         for idx, base in enumerate(test_cases):\n68:             cid = f\"TEST-{i*5 + idx + 1:02d}\"\n69:             c = dict(base)\n70:             c[\"case_id\"] = cid\n71:             cases_50.append(c)\n72: \n73:     assert len(cases_50) == 50, f\"Expected 50 cases, got {len(cases_50)}\"\n74:     print(f\"\\n[+] Built exactly 50-case batch (10 replicates of 5 canonical rules).\")\n75: \n76:     # 3. Call Pharmacy Coordinator\n77:     cfg = Config(unstructured_api_key=\"dummy\", gemini_api_key=\"dummy\")\n78:     cfg.local_api_url = API_URL\n79:     cfg.local_api_key = API_KEY\n80:     cfg.local_model = \"gemini-3.8-flash\"\n81:     coord = FastCoordinator(cfg)\n82: \n83:     print(f\"\\n[*] Dispatching 50 cases to MSEMAX Gateway...\")\n84:     t0 = time.time()\n85:     try:\n86:         results = coord._call_local_api({\"cases\": cases_50})\n87:         dur = time.time() - t0\n88:         print(f\"\\n[✓] SUCCESS: Coordinator received response in {dur:.2f}s!\")\n89:         print(f\"    - Results count: {len(results)}\")\n90:         print(f\"    - Raw response length: {len(coord.last_raw_response)} characters\")\n91:         \n92:         # Verify all 50 case_ids are returned\n93:         returned_ids = {r.get(\"case_id\") for r in results}\n94:         expected_ids = {c[\"case_id\"] for c in cases_50}\n95:         missing = expected_ids - returned_ids\n96:         print(f\"    - Returned Case IDs: {len(returned_ids)} / 50\")\n97:         if missing:\n98:             print(f\"    [!] Missing case IDs: {missing}\")\n99:             sys.exit(1)\n100:         else:\n101:             print(f\"    [✓] EXACT MATCH: All 50 case IDs returned successfully!\")\n102: \n103:         # Check compliance with canonical rules across the batch\n104:         strength_decisions = [r for r in results if int(r.get(\"case_id\", \"\").split(\"-\")[1]) % 5 == 1]\n105:         dosage_decisions = [r for r in results if int(r.get(\"case_id\", \"\").split(\"-\")[1]) % 5 == 2]\n106:         pack_decisions = [r for r in results if int(r.get(\"case_id\", \"\").split(\"-\")[1]) % 5 == 3]\n107:         ocr_decisions = [r for r in results if int(r.get(\"case_id\", \"\").split(\"-\")[1]) % 5 == 4]\n108:         generic_decisions = [r for r in results if int(r.get(\"case_id\", \"\").split(\"-\")[1]) % 5 == 0]\n109: \n110:         print(f\"\\n[✓] Rule Compliance Verification across 50 cases:\")\n111:         str_ok = all(r.get('status') == 'no_match' for r in strength_decisions)\n112:         dos_ok = all(r.get('status') == 'review' for r in dosage_decisions