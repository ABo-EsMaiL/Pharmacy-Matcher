1:     return name[:max_len]\n92: \n93: \n94: def _format_confidence(conf_raw: str) -> str:\n95:     \"\"\"تحويل قيم درجة التطابق الإنجليزية والتقنية إلى مصطلحات عربية واضحة.\"\"\"\n96:     if not conf_raw:\n97:         return \"\"\n98:     conf_str = str(conf_raw).strip()\n99:     conf_lower = conf_str.lower()\n100:     if conf_lower == \"exact\":\n101:         return \"تطابق تام (100%)\"\n102:     elif conf_lower == \"llm\":\n103:         return \"مطابقة ذكية (AI)\"\n104:     elif conf_lower.startswith(\"high\"):\n105:         m = re.search(r\"([\\d\\.]+)\", conf_str)\n106:         if m:\n107:             pct = int(float(m.group(1)) * 100)\n108:             return f\"تطابق نصي دقيق ({pct}%)\"\n109:         return \"تطابق نصي دقيق\"\n110:     elif conf_str == \"تأكيد يدوي (مراجعة)\":\n111:         return conf_str\n112:     return conf_str\n113: \n114: \n115: def write_results_excel(results: dict, output_path: Path) -> Path:\n116:     \"\"\"\n117:     إنشاء ملف Excel منظم يحتوي على:\n118:         - ملخص ديناميكي مربوط بمعادلات Excel التلقائية\n119:         - ورقة لكل مخزن تحتوي على المطابقات المؤكدة\n120:         - ورقة للأصناف التي تحتاج مراجعة\n121:         - ورقة للأصناف التي لم يُعثر عليها\n122: \n123:     المعاملات:\n124:         results: قاموس يحتوي على:\n125:             - warehouse_results: نتائج كل مخزن\n126:             - not_found: الأصناف غير الموجودة\n127:             - summary: ملخص إحصائي\n128:         output_path: مسار ملف Excel الناتج.\n129:     \"\"\"\n130:     wb = Workbook()\n131: \n132:     # ────────────────────────────────────────\n133:     # ورقة الملخص (ديناميكية مربوطة بالمعادلات)\n134:     # ────────────────────────────────────────\n135:     ws_summary = wb.active\n136:     ws_summary.title = \"ملخص\"\n137: \n138:     summary = results.get(\"summary\", {})\n139:     warehouse_results = results.get(\"warehouse_results\", {})\n140: \n141:     summary_headers = [\"البند\", \"العدد\", \"النسبة\"]\n142:     ws_summary.append(summary_headers)\n143:     _apply_header_style(ws_summary, len(summary_headers))\n144: \n145:     raw_total = summary.get(\"total_shortages\", 0)\n146:     unique_total = summary.get(\"unique_shortages\", 0)\n147: \n148:     # Row 2: إجمالي طلبات النواقص (الأسطر الأصلية)\n149:     ws_summary.append([\"إجمالي طلبات النواقص (الأسطر)\", raw_total, \"-\"])\n150: \n151:     # Row 3: إجمالي الأصناف الفريدة\n152:     ws_summary.append([\"إجمالي الأصناف الفريدة (المطلوبة)\", unique_total, \"100%\"])\n153: \n154:     # Row 4: تم مطابقتها (مجموع مطابقة المخازن)\n155:     num_wh = len(warehouse_results)\n156:     wh_sum_formula = f\"=SUM(B9:B{8 + num_wh})\" if num_wh > 0 else \"0\"\n157:     ws_summary.append([\"تم مطابقتها (مجموع المخازن)\", wh_sum_formula, \"=IF(B3>0, B4/B3, 0)\"])\n158: \n159:     # Row 5: لم يُعثر عليها\n160:     ws_summary.append([\"لم يُعثر عليها\", \"=MAX(0, COUNTA('لم يُعثر عليه'!A:A)-1)\", \"=IF(B3>0, B5/B3, 0)\"])\n161: \n162:     # Row 6: تحتاج مراجعة\n163:     ws_summary.append([\"تحتاج مراجعة\", \"=MAX(0, COUNTA('يحتاج مراجعة'!B:B)-1)\", \"=IF(B3>0, B6/B3, 0)\"])\n164: \n165:     # Row 7: صف فارغ\n166:     ws_summary.append([])\n167: \n168:     # Row 8: جدول تفاصيل كل مخزن\n169:     ws_summary.append([\"─── تفاصيل المخازن ───\", \"عدد المطابقات\", \"أصناف للمراجعة\"])\n170:     for c_idx in range(1, 4):\n171:         c = ws_summary.cell(row=8, column=c_idx)\n172:         c.fill = _HEADER_FILL\n173:         c.font = _HEADER_FONT\n174:         c.alignment = _HEADER_ALIGNMENT\n175:         c.border = _THIN_BORDER\n176: \n177:     # صفوف المخازن (Rows 9+)\n178:     detail_row = 9\n179:     for wh_name in warehouse_results.keys():\n180:         sheet_name = _truncate_sheet_name(wh_name)\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
