== \"review\" for d in decisions)}\n26: \n27: \n28: def sheet_name(value, used):\n29:     base = re.sub(r\"[\\x00-\\x1f\\\\/*?:\\[\\]]\", \"_\", str(value)).strip().strip(\"'\") or \"مخزن\"\n30:     base = base[:31]\n31:     result, index = base, 2\n32:     while result.casefold() in used:\n33:         suffix = f\" ({index})\"\n34:         result = base[:31-len(suffix)] + suffix\n35:         index += 1\n36:     used.add(result.casefold())\n37:     return result\n38: \n39: \n40: def export_outputs(output_dir, requests, suppliers, decisions, context):\n41:     from openpyxl import Workbook, load_workbook\n42:     from openpyxl.styles import Alignment, Font, PatternFill\n43: \n44:     outcomes, counts = summarize(requests, suppliers, decisions)\n45:     workbook = Workbook()\n46:     workbook.remove(workbook.active)\n47:     used = {\"النواقص\".casefold()}\n48:     sheet_map, sheet_rows = {}, {}\n49: \n50:     def add_sheet(title, header, names):\n51:         sheet = workbook.create_sheet(title)\n52:         for row_number, value in enumerate([header, *names], 1):\n53:             cell = sheet.cell(row_number, 1)\n54:             cell.value = value\n55:             cell.data_type = \"s\"  # Product text must never become an Excel formula.\n56:         sheet.sheet_view.rightToLeft = True\n57:         sheet.freeze_panes = \"A2\"\n58:         sheet.auto_filter.ref = sheet.dimensions\n59:         sheet.column_dimensions[\"A\"].width = 85\n60:         sheet.row_dimensions[1].height = 34\n61:         for row in sheet:\n62:             cell = row[0]\n63:             cell.alignment = Alignment(horizontal=\"right\", vertical=\"center\", wrap_text=True)\n64:             cell.font = Font(name=\"Arial\", size=12, bold=cell.row == 1,\n65:                              color=\"FFFFFF\" if cell.row == 1 else \"172B3A\")\n66:             if cell.row == 1:\n67:                 cell.fill = PatternFill(\"solid\", fgColor=\"164E63\")\n68:             elif cell.row % 2 == 0:\n69:                 cell.fill = PatternFill(\"solid\", fgColor=\"F0F7FA\")\n70:             if cell.row > 1:\n71:                 sheet.row_dimensions[cell.row].height = 32\n72:         sheet_rows[title] = len(names)\n73: \n74:     for supplier in suppliers:\n75:         by_id = {p[\"id\"]: p for p in supplier[\"items\"]}\n76:         selected = set()\n77:         for decision in decisions:\n78:             if decision[\"supplier_id\"] == supplier[\"id\"] and decision[\"status\"] == \"match\":\n79:                 if not decision[\"item_ids\"] or not set(decision[\"item_ids\"]).issubset(by_id):\n80:                     raise ValueError(\"Invalid supplier product reference. No workbook exported.\")\n81:                 selected.update(decision[\"item_ids\"])\n82:         names, seen_names = [], set()\n83:         for product in supplier[\"items\"]:\n84:             if product[\"id\"] in selected and product[\"name_raw\"] not in seen_names:\n85:                 names.append(product[\"name_raw\"])\n86:                 seen_names.add(product[\"name_raw\"])\n87:         title = sheet_name(supplier[\"name\"], used)\n88:         sheet_map[supplier[\"id\"]] = title\n89:         add_sheet(title, \"اسم الصنف\", names)\n90:     missing_names = [r[\"name_raw\"] for r in requests if outcomes[r[\"id\"]] == \"not_found\"]\n91:     add_sheet(\"النواقص\", \"الصنف المطلوب غير الموجود في المخازن المختارة\", missing_names)\n92:     workbook.properties.title = \"مطابقة النواقص مع المخازن المختارة\"\n93:     workbook.properties.description = \"المخازن: \" + \"، \".join(w[\"name\"] for w in suppliers)\n94:     temporary = output_dir / \"orders.tmp.xlsx\"\n95:     workbook.save(temporary)\n96:     workbook.close()\n97:     # A meaningful export check during the USER's run: row counts and text types.\n98:     check = load_workbook(temporary, read_only=True, data_only=False)\n99:     try:\n100:         if check.sheetnames != list(sheet_rows):\n101:             raise ValueError(\"Workbook sheet verification failed.\")\n102:         for sheet in check:\n103:             if sheet.max_row - 1 != sheet_rows[sheet.title]:\n104:                 raise ValueError(\"Workbook row count verification failed.\")\n105:             if any(cell.data_type == \"f\" for row in sheet for cell in row):\n106:                 raise ValueError(\"Unexpected formula in product output.\")\n107:     finally:\n108:         check.close()\n109:     temporary.replace(output_dir / \"orders.xlsx\")\n110: \n111:     escape = lambda value: html.escape(str(value))\n112:     request_map = {r[\"id\"]: r for r in requests}\n113:     supplier_map = {w[\"id\"]: w for w in suppliers}\n114:     sections = []\n115:     # A separate audit allows the friend to inspect proposed matches as well.\n116:     for status, label in ((\"review\", \"حالات تحتاج مراجعة — غير مدرجة كطلبات شراء\"),\n117:                           (\"match\", \"المطابقات المدرجة في شيتات المخازن\")):\n118:         sections.append(f\"<h2>{label}</h2><div class='scroll'><table><tr><th>المطلوب</th><th>المخزن</th>\"\n119:                         \"<th>الصنف في المخزن</th><th>سبب القرار</th></tr>\")\n120:         relevant = [d for d in decisions if d[\"status\"] == status]\n121:         if not relevant:\n122:             sections.append(\"<tr><td colspan='4'>لا توجد حالات.</td></tr>\")\n123:         for decision in relevant:\n124:             request = request_map[decision[\"request_id\"]]\n125:             supplier = supplier_map[decision[\"supplier_id\"]]\n126:             by_id = {p[\"id\"]: p for p in supplier[\"items\"]}\n127:             names = \"<br>\".join(f\"<bdi>{escape(by_id[i]['name_raw'])}</bdi>\" for i in decision[\"item_ids\"]) or \"—\"\n128:             note = escape(decision[\"reason\"])\n129:             if status == \"review\" and outcomes[request[\"id\"]] == \"found\":\n130:                 note += \"<br><strong>له مطابقة في مخزن آخر؛ مراجعة هذا المخزن ما زالت مطلوبة.</strong>\"\n131:             sections.append(f\"<tr><td><bdi>{escape(request['name_raw'])}</bdi></td>\"\n132:                             f\"<td>{escape(supplier['name'])}</td><td>{names}</td><td>{note}</td></tr>\")\n133:         sections.append(\"</table></div>\")\n134:     document = \"\"\"<!doctype html><html lang=\"ar\" dir=\"rtl\"><head><meta charset=\"utf-8\">\n135: <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n136: <meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'none'; style-src 'unsafe-inline'\">\n137: <title>مراجعة نتيجة النواقص</title><style>\n138: body{font:16px/1.8 Tahoma,Arial,sans-serif;background:#f1f5f9;color:#172b3a;padding:24px}\n139: main{max-width:1400px;margin:auto}header,.scroll{background:white;padding:20px;margin-bottom:24px;border-radius:10px}\n140: .scroll{overflow:auto}table{border-collapse:collapse;width:100%;min-width:780px}td,th{border:1px solid #cbd5e1;padding:12px;text-align:right;vertical-align:top}\n141: th{background:#e2e8f0}tr:nth-child(even){background:#f8fafc}.note{background:#fff3cd;padding:12px}</style></head><body><main><header>\n142: <h1>نتيجة مطابقة النواقص</h1><p class=\"note\">الحالات غير المحسومة تظهر هنا منفصلة عن Excel.\n143: المطابقات المقترحة تعتمد على الأوصاف المستخرجة وتحتاج مراجعتك قبل اعتماد الطلبات؛ اكتمال المعالجة لا يثبت دقة كل اسم.</p>\"\"\"\n144:     document += \"<p>المخازن الداخلة في هذه النتيجة: \" + \"، \".join(escape(w[\"name\"]) for w in suppliers) + \".</p>\"\n145:     document += (f\"<p>عدد الأصناف المطلوبة المميزة: {len(requests)}. وجدنا مطابقة لـ{counts['found']}، \"\n146:                  f\"و{counts['needs_review_without_match']} تحتاج مراجعة دون مطابقة مؤكدة، \"\n147:                  f\"و{counts['not_found_in_selected_suppliers']} لم نجدها في المخازن المختارة.</p>\")\n148:     document += \"<p>أي مخزن خارج القائمة أعلاه لم يدخل في الحكم على النواقص. لم نُسقط الحالات غير المحسومة بصمت أو نعتبرها غير موجودة.</p></header>\"\n149:     (output_dir / \"review.html\").write_text(document + \"\".join(sections) + \"</main></body></html>\", encoding=\"utf-8\")\n150:     summary = {**counts, \"processing_complete\": True, \"human_review_required\": True,\n151:                \"suppliers\": [{\"id\": w[\"id\"], \"name\": w[\"name\"], \"sheet\": sheet_map[w[\"id\"]]} for w in suppliers],\n152:                \"sheet_rows\": sheet_rows, \"context\": context,\n153:                \"note\": \"Unresolved cases are only in review.html and results.json, not in the workbook's shortage sheet.\"}\n154:     (output_dir / \"summary.json\").write_text(json.dumps(summary, ensure_ascii=False, indent=2), encoding=\"utf-8\")\n155:     return summary\n156: \nThe above content shows the entire, complete file contents of the requested file.\n"}
