     load_dotenv(project_root / \".env\")\n50: \n51:     # قراءة المفاتيح المطلوبة\n52:     unstructured_key = os.getenv(\"UNSTRUCTURED_API_KEY\", \"\").strip()\n53:     gemini_key = os.getenv(\"GEMINI_API_KEY\", \"\").strip()\n54: \n55:     # التحقق من وجود المفاتيح\n56:     missing: list[str] = []\n57:     if not unstructured_key or unstructured_key == \"your_key_here\":\n58:         missing.append(\"UNSTRUCTURED_API_KEY\")\n59:     if not gemini_key or gemini_key == \"your_key_here\":\n60:         missing.append(\"GEMINI_API_KEY\")\n61: \n62:     if missing:\n63:         raise ValueError(\n64:             f\"⚠️ مفاتيح API التالية مفقودة أو غير مُعيَّنة في ملف .env:\\n\"\n65:             f\"  {', '.join(missing)}\\n\"\n66:             f\"يرجى نسخ .env.example إلى .env وتعبئة المفاتيح.\"\n67:         )\n68: \n69:     return Config(\n70:         unstructured_api_key=unstructured_key,\n71:         gemini_api_key=gemini_key,\n72:     )\n73: \nThe above content shows the entire, complete file contents of the requested file.\n"}
