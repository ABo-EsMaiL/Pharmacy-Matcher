{"step_index":88,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-21T15:36:29Z","content":"Created At: 2026-09-21T18:36:29+03:00\nCompleted At: 2026-09-21T18:36:30+03:00\nFile Path: `file:///d:/AI_Engineer/Pharmacy-agy/src/extract/excel_reader.py`\nTotal Lines: 226\nTotal Bytes: 8764\nShowing lines 1 to 226\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"\"\"\n2: وحدة قراءة ملفات Excel - قراءة قوائم النقص وقوائم المستودعات.\n3: Excel reader module - reads shortage lists and warehouse inventory files.\n4: \"\"\"\n5: \n6: from pathlib import Path\n7: from openpyxl import load_workbook\n8: from openpyxl.worksheet.worksheet import Worksheet\n9: import re\n10: \n11: \n12: # كلمات مفتاحية تدل على عمود أسماء الأدوية\n13: _DRUG_NAME_KEYWORDS = [\n14:     \"صنف\", \"اسم\", \"دواء\", \"مادة\", \"الصنف\", \"الاسم\", \"الدواء\",\n15:     \"اسم الصنف\", \"اسم المادة\", \"اسم الدواء\", \"المادة\",\n16:     \"name\", \"item\", \"drug\", \"product\", \"description\",\n17: ]\n18: \n19: \n20: def read_excel(filepath: Path) -> list[dict]:\n21:     \"\"\"\n22:     قراءة ملف Excel وإرجاع البيانات كقائمة من القواميس.\n23: \n24:     - يكتشف تلقائياً الورقة التي تحتوي على بيانات (يتخطى الأوراق الفارغة).\n25:     - يكتشف تلقائياً صف العناوين (أول صف يحتوي على خلايا متعددة غير فارغة).\n26:     - يحافظ على جميع القيم الأصلية كما هي (نصوص، أرقام).\n27: \n28:     Args:\n29:         filepath: مسار ملف Excel.\n30: \n31:     Returns:\n32:         قائمة من القواميس حيث مفاتيح كل قاموس هي أسماء الأعمدة.\n33: \n34:     Raises:\n35:         FileNotFoundError: إذا لم يُوجد الملف.\n36:         ValueError: إذا لم يتمكن من العثور على بيانات في الملف.\n37:     \"\"\"\n38:     filepath = Path(filepath)\n39:     if not filepath.exists():\n40:         raise FileNotFoundError(f\"❌ الملف غير موجود: {filepath}\")\n41: \n42:     print(f\"📖 جارٍ قراءة ملف Excel: {filepath.name}\")\n43:     wb = load_workbook(filepath, read_only=True, data_only=True)\n44: \n45:     # البحث عن أول ورقة تحتوي على بيانات\n46:     sheet = _find_data_sheet(wb)\n47:     if sheet is None:\n48:         wb.close()\n49:         raise ValueError(f\"❌ لم يتم العثور على بيانات في الملف: {filepath.name}\")\n50: \n51:     print(f\"  📄 الورقة المستخدمة: {sheet.title}\")\n52: \n53:     # اكتشاف صف العناوين\n54:     header_row_idx, headers = _find_header_row(sheet)\n55:     if header_row_idx is None:\n56:         wb.close()\n57:         raise ValueError(\n58:             f\"❌ لم يتم العثور على صف عناوين في الورقة: {sheet.title}\"\n59:         )\n60: \n61:     print(f\"  📋 صف العناوين: {header_row_idx} → {headers}\")\n62: \n63:     # قراءة البيانات\n64:     rows: list[dict] = []\n65:     for row_idx, row in enumerate(sheet.iter_rows(min_row=header_row_idx + 1), start=header_row_idx + 1):\n66:         values = [cell.value for cell in row[: len(headers)]]\n67: \n68:         # تخطي الصفوف الفارغة بالكامل\n69:         if all(v is None or (isinstance(v, str) and v.strip() == \"\") for v in values):\n70:             continue\n71: \n72:         row_dict = {}\n73:         for col_name, value in zip(headers, values):\n74:             row_dict[col_name] = value\n75:         row_dict[\"_source_row\"] = row_idx\n76:         rows.append(row_dict)\n77: \n78:     wb.close()\n79:     print(f\"  ✅ تم قراءة {len(rows)} صف من البيانات\")\n80:     return rows\n81: \n82: \n83: def extract_item_names(\n84:     rows: list[dict],\n85:     source_file: str = \"\",\n86:     name_column: str | None = None,\n87: ) -> list[dict]:\n88:     \"\"\"\n89:     استخراج أسماء الأصناف (الأدوية) من البيانات المقروءة.\n90: \n91:     - إذا حُدِّد name_column يستخدمه مباشرة.\n92:     - وإلا يكتشف تلقائياً العمود الأكثر احتمالاً لاحتواء أسماء الأدوية.\n93: \n94:     Args:\n95:         rows: البيانات المقروءة من read_excel.\n96:         source_file: اسم الملف المصدر.\n97:         name_column: اسم عمود أسماء الأدوية (اختياري).\n98: \n99:     Returns:\n100:         قائمة من القواميس بالشكل:\n101:         {\"item_name_raw\": str, \"source_row\": int, \"source_file\": str}\n102:     \"\"\"\n103:     if not rows:\n104:         return []\n105: \n106:     # الحصول على أسماء الأعمدة (باستثناء الأعمدة الداخلية)\n107:     columns = [k for k in rows[0].keys() if not k.startswith(\"_\")]\n108: \n109:     # اكتشاف عمود أسماء الأدوية\n110:     if name_column is None:\n111:         name_column = _detect_name_column(columns, rows)\n112:         print(f\"  🔍 العمود المكتشف لأسماء الأدوية: {name_column}\")\n113:     else:\n114:         if name_column not in columns:\n115:             raise ValueError(\n116:                 f\"❌ العمود '{name_column}' غير موجود. الأعمدة المتاحة: {columns}\"\n117:             )\n118: \n119:     # استخراج الأسماء\n120:     items: list[dict] = []\n121:     for row in rows:\n122:         raw_name = row.get(name_column)\n123:         if raw_name is None:\n124:             continue\n125: \n126:         # تحويل إلى نص مع الحفاظ على القيمة الأصلية كاملة\n127:         raw_name_str = str(raw_name).strip()\n128:         if not raw_name_str:\n129:             continue\n130: \n131:         items.append({\n132:             \"item_name_raw\": raw_name_str,\n133:             \"source_row\": row.get(\"_source_row\", 0),\n134:             \"source_file\": source_file,\n135:         })\n136: \n137:     print(f\"  ✅ تم استخراج {len(items)} اسم صنف من العمود '{name_column}'\")\n138:     return items\n139: \n140: \n141: # ──────────────────────── دوال مساعدة داخلية ────────────────────────\n142: \n143: \n144: def _find_data_sheet(wb) -> Worksheet | None:\n145:     \"\"\"البحث عن أول ورقة تحتوي على بيانات فعلية.\"\"\"\n146:     for sheet_name in wb.sheetnames:\n147:         sheet = wb[sheet_name]\n148:         # فحص أول 10 صفوف للتأكد من وجود بيانات\n149:         non_empty_count = 0\n150:         for row in sheet.iter_rows(max_row=10):\n151:             for cell in row:\n152:                 if cell.value is not None and str(cell.value).strip():\n153:                     non_empty_count += 1\n154:             if non_empty_count >= 3:\n155:                 return sheet\n156:     return None\n157: \n158: \n159: def _find_header_row(sheet: Worksheet) -> tuple[int | None, list[str]]:\n160:     \"\"\"\n161:     اكتشاف صف العناوين: أول صف يحتوي على عدة خلايا نصية غير فارغة.\n162:     يُرجع (رقم الصف، قائمة العناوين).\n163:     \"\"\"\n164:     for row_idx, row in enumerate(sheet.iter_rows(max_row=20), start=1):\n165:         values = [cell.value for cell in row]\n166:         non_empty = [v for v in values if v is not None and str(v).strip()]\n167: \n168:         # صف العناوين يجب أن يحتوي على خليتين نصيتين على الأقل\n169:         text_cells = [v for v in non_empty if isinstance(v, str)]\n170:         if len(text_cells) >= 2:\n171:             # بناء قائمة العناوين حتى آخر عمود غير فارغ\n172:             headers: list[str] = []\n173:             last_non_empty = 0\n174:             for i, v in enumerate(values):\n175:                 if v is not None and str(v).strip():\n176:                     last_non_empty = i\n177: \n178:             for i, v in enumerate(values[: last_non_empty + 1]):\n179:                 if v is not None and str(v).strip():\n180:                     headers.append(str(v).strip())\n181:                 else:\n182:                     headers.append(f\"_col_{i}\")\n183: \n184:             return row_idx, headers\n185: \n186:     return None, []\n187: \n188: \n189: def _detect_name_column(columns: list[str], rows: list[dict]) -> str:\n190:     \"\"\"\n191:     اكتشاف العمود الأكثر احتمالاً لاحتواء أسماء الأدوية.\n192: \n193:     الاستراتيجية:\n194:     1. البحث عن كلمات مفتاحية في أسماء الأعمدة.\n195:     2. إذا لم يُعثر عليها، اختيار العمود الذي يحتوي على أكبر نسبة نصوص عربية.\n196:     \"\"\"\n197:     # 1. البحث بالكلمات المفتاحية\n198:     for col in columns:\n199:         col_lower = col.strip().lower()\n200:         for keyword in _DRUG_NAME_KEYWORDS:\n201:             if keyword in col_lower:\n202:                 return col\n203: \n204:     # 2. البحث عن العمود الذي يحتوي على أكبر نسبة نصوص عربية طويلة\n205:     arabic_pattern = re.compile(r\"[\\u0600-\\u06FF]\")\n206:     best_col = columns[0]\n207:     best_score = 0\n208: \n209:     for col in columns:\n210:         score = 0\n211:         for row in rows[:20]:  # فحص أول 20 صف فقط\n212:             val = row.get(col)\n213:             if val is None:\n214:                 continue\n215:             val_str = str(val)\n216:             # حساب النتيجة: طول النص × نسبة الأحرف العربية\n217:             arabic_chars = len(arabic_pattern.findall(val_str))\n218:             if arabic_chars > 0:\n219:                 score += len(val_str) * (arabic_chars / max(len(val_str), 1))\n220: \n221:         if score > best_score:\n222:             best_score = score\n223:             best_col = col\n224: \n225:     return best_col\n226: \nThe above content shows the entire, complete file contents of the requested file.\n"}
