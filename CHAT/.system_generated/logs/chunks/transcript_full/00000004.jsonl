ata.get(\"source\") or {}).get(\"filename\") or path.name\n64:         for index, item in enumerate(items, 1):\n65:             if not isinstance(item, dict):\n66:                 raise ValueError(f\"Invalid Extract item {index}.\")\n67:             name, page = item.get(\"item_name_raw\"), item.get(\"source_page\")\n68:             if not isinstance(name, str) or not name.strip():\n69:                 raise ValueError(f\"Empty/invalid product name at item {index}.\")\n70:             if page is not None and (type(page) is not int or page < 1 or\n71:                     (type(page_count) is int and page > page_count)):\n72:                 raise ValueError(f\"Invalid source page at item {index}.\")\n73:             entries.append({\"name_raw\": name, \"source_file\": document_name,\n74:                             \"page\": page, \"row\": index, \"sheet\": None})\n75:         if data.get(\"warnings\"):\n76:             raise ValueError(\"Extract has service warnings. Review them before this matching trial.\")\n77:     elif path.suffix.lower() == \".pdf\":\n78:         raise ValueError(\"This trial uses the PDF's saved Extract JSON. Direct PDF extraction is the next integration step.\")\n79:     else:\n80:         raise ValueError(f\"Supported trial inputs: .xlsx or saved Extract .json; received {path.suffix}.\")\n81:     if not entries:\n82:         raise ValueError(f\"No product names read from {path.name}.\")\n83:     return entries, {\"path\": str(path), \"sha256\": digest, \"document_name\": document_name,\n84:                      \"product_rows\": len(entries)}\n85: \nThe above content shows the entire, complete file contents of the requested file.\n"}
