{"step_index":74,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-21T15:35:33Z","content":"Created At: 2026-09-21T18:35:33+03:00\nCompleted At: 2026-09-21T18:35:33+03:00\nFile Path: `file:///d:/AI_Engineer/Pharmacy/review/match_guards.py`\nTotal Lines: 118\nTotal Bytes: 5859\nShowing lines 1 to 118\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"\"\"Conservative review flags, not a complete pharmaceutical identity validator.\n2: \n3: Never approve a match. Preserve source text and the model response. Recognize\n4: common explicit measurements/counts; ambiguous units and compound strengths\n5: still require separate review. An exact Arabic-token reversal is only a hint.\n6: \"\"\"\n7: \n8: from collections import Counter\n9: from decimal import Decimal\n10: import re\n11: import unicodedata\n12: \n13: \n14: def normalize(text):\n15:     text = unicodedata.normalize(\"NFKC\", text).lower().replace(\"ـ\", \"\")\n16:     text = \"\".join(str(unicodedata.decimal(c)) if c.isdecimal() else c for c in text)\n17:     return re.sub(r\"[\\u064b-\\u065f\\u0670]\", \"\", text).replace(\"٫\", \".\")\n18: \n19: \n20: UNITS = {}\n21: for aliases, kind, factor in [\n22:     (\"مجم ملجم ملغ مج mg milligram milligrams\", \"mass_mg\", \"1\"),\n23:     (\"جم جرام غرام غم g gm gram grams\", \"mass_mg\", \"1000\"),\n24:     (\"ميكروجرام ميكروغرام mcg ug µg\", \"mass_mg\", \"0.001\"),\n25:     (\"مل ملل مللي مللى ملليلتر ملليتر ml milliliter milliliters\", \"volume_ml\", \"1\"),\n26:     (\"لتر l liter liters\", \"volume_ml\", \"1000\"),\n27:     (\"قرص اقراص أقراص tablet tablets tab tabs\", \"tablets\", \"1\"),\n28:     (\"كبسول كبسوله كبسولة كبسولات capsule capsules cap caps\", \"capsules\", \"1\"),\n29:     (\"امبول أمبول امبوله امبولة أمبولة امبولات أمبولات ampoule ampoules amp amps\", \"ampoules\", \"1\"),\n30:     (\"شريط شرائط strip strips\", \"strips\", \"1\"),\n31:     (\"كيس اكياس أكياس sachet sachets\", \"sachets\", \"1\"),\n32:     (\"% ٪\", \"percent\", \"1\"),\n33: ]:\n34:     for alias in aliases.split():\n35:         UNITS[normalize(alias)] = (kind, Decimal(factor))\n36: \n37: UNIT_PATTERN = \"|\".join(re.escape(unit) for unit in sorted(UNITS, key=len, reverse=True))\n38: MEASURE = re.compile(r\"(?<![\\d.,])(?P<number>\\d+(?:\\.\\d+)?)\\s*(?P<unit>\" + UNIT_PATTERN + r\")(?![a-z\\u0621-\\u064a])\")\n39: TOKENS = re.compile(r\"[\\u0621-\\u064a]+|[a-z]+|\\d+(?:\\.\\d+)?|[%/]\")\n40: NUMBERS = re.compile(r\"\\d+(?:\\.\\d+)?\")\n41: FORMS = {\n42:     \"cream\": \"كريم cream\", \"ointment\": \"مرهم ointment\",\n43:     \"tablets\": \"قرص اقراص أقراص tablet tablets tab tabs\",\n44:     \"capsules\": \"كبسول كبسولة كبسوله كبسولات capsule capsules cap caps\",\n45:     \"syrup\": \"شراب syrup\", \"drops\": \"قطرة قطره نقط drops\",\n46:     \"spray\": \"بخاخ بخاخة بخاخه spray\", \"gel\": \"جل gel\",\n47:     \"ampoules\": \"امبول أمبول امبوله امبولة أمبولة امبولات ampoule ampoules\",\n48:     \"vial\": \"فيال vial vials\", \"suppository\": \"لبوس اقماع أقماع suppository suppositories\",\n49: }\n50: \n51: \n52: def product_text(text):\n53:     # Only explicitly labelled prices are excluded; unlabeled digits remain evidence.\n54:     return re.sub(r\"(?:سعر(?:\\s*(?:جديد|قديم))?|price)\\s*[:=]?\\s*\\d+(?:\\.\\d+)?\", \" \", normalize(text))\n55: \n56: \n57: def bare_numbers(text):\n58:     remaining = MEASURE.sub(\" \", product_text(text))\n59:     return Counter(Decimal(value) for value in NUMBERS.findall(remaining))\n60: \n61: \n62: def dosage_forms(text):\n63:     tokens = set(TOKENS.findall(product_text(text)))\n64:     return {form for form, aliases in FORMS.items() if tokens.intersection(normalize(a) for a in aliases.split())}\n65: \n66: \n67: def measurements(text):\n68:     found = Counter()\n69:     for match in MEASURE.finditer(product_text(text)):\n70:         kind, factor = UNITS[match[\"unit\"]]\n71:         found[(kind, Decimal(match[\"number\"]) * factor)] += 1\n72:     return found\n73: \n74: \n75: def reversal_hint(request, candidate):\n76:     left, right = TOKENS.findall(normalize(request)), TOKENS.findall(normalize(candidate))\n77:     if len(left) != len(right):\n78:         return False\n79:     changed = False\n80:     for a, b in zip(left, right):\n81:         if a == b:\n82:             continue\n83:         if len(a) >= 4 and re.fullmatch(r\"[\\u0621-\\u064a]+\", a) and a == b[::-1]:\n84:             changed = True\n85:         else:\n86:             return False\n87:     return changed\n88: \n89: \n90: def guard_decision(case, decision, catalog):\n91:     result = {**decision, \"model_status\": decision[\"status\"],\n92:               \"model_item_ids\": list(decision[\"item_ids\"]), \"model_reason\": decision[\"reason\"],\n93:               \"guard_notes\": []}\n94:     by_id = {p[\"id\"]: p[\"name\"] for p in catalog}\n95:     if decision[\"status\"] == \"match\":\n96:         required = measurements(case[\"requested_name\"])\n97:         for item_id in decision[\"item_ids\"]:\n98:             missing = required - measurements(by_id[item_id])\n99:             if missing:\n100:                 result[\"guard_notes\"].append(\n101:                     \"الوصف المطلوب فيه قياس أو عدد صريح لم يثبت بنفس القيمة والوحدة في وصف المخزن: \" + item_id)\n102:             if bare_numbers(case[\"requested_name\"]) - bare_numbers(by_id[item_id]):\n103:                 result[\"guard_notes\"].append(\"يوجد رقم إضافي في وصف الطلب لم تُثبت دلالته ومقابلته في وصف المخزن: \" + item_id)\n104:             requested_forms, supplied_forms = dosage_forms(case[\"requested_name\"]), dosage_forms(by_id[item_id])\n105:             if requested_forms - supplied_forms or (requested_forms and supplied_forms - requested_forms):\n106:                 result[\"guard_notes\"].append(\"الشكل المذكور صراحةً في الطلب غير مثبت أو متعارض مع وصف المخزن: \" + item_id)\n107:         if result[\"guard_notes\"]:\n108:             result[\"status\"] = \"review\"\n109:     elif decision[\"status\"] == \"no_match\":\n110:         possible = [p[\"id\"] for p in catalog if reversal_hint(case[\"requested_name\"], p[\"name\"])]\n111:         if possible:\n112:             result[\"status\"] = \"review\"\n113:             result[\"item_ids\"] = possible\n114:             result[\"guard_notes\"].append(\"الكود وجد احتمال اسم بحروف عربية معكوسة مع تطابق بقية الكلمات والأرقام؛ يلزم فحصه.\")\n115:     if result[\"guard_notes\"]:\n116:         result[\"reason\"] = \" | \".join(result[\"guard_notes\"])\n117:     return result\n118: \nThe above content shows the entire, complete file contents of the requested file.\n"}
