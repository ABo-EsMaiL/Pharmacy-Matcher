{"step_index":10595,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-25T14:53:06Z","content":"Created At: 2026-09-25T17:53:06+03:00\nCompleted At: 2026-09-25T17:53:06+03:00\nFile Path: `file:///d:/AI_Engineer/Pharmacy-agy-vision/desktop_app/templates/index.html`\nTotal Lines: 3611\nTotal Bytes: 148368\nShowing lines 3250 to 3330\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n3250: async function loadServersUI() {\n3251:     if (!window.pywebview || !window.pywebview.api) return;\n3252:     const t = I18N[currentLang] || I18N.ar;\n3253:     \n3254:     try {\n3255:         const infoStr = await window.pywebview.api.get_servers_info();\n3256:         const info = JSON.parse(infoStr);\n3257:         const servers = info.servers || {};\n3258:         const activeKey = info.active_server || 'gaistudio';\n3259:         \n3260:         // 1. Update 1-Click Provider Switcher Pills\n3261:         const pillGai = document.getElementById('pill-provider-gaistudio');\n3262:         const pillChat = document.getElementById('pill-provider-chatgpt');\n3263:         if (pillGai) pillGai.classList.toggle('active', activeKey === 'gaistudio');\n3264:         if (pillChat) pillChat.classList.toggle('active', activeKey === 'chatgpt');\n3265: \n3266:         // Backward compatibility for hidden elements\n3267:         const activeSrv = servers[activeKey];\n3268:         const bannerTitle = document.getElementById('active-banner-title');\n3269:         const bannerSub = document.getElementById('active-banner-sub');\n3270:         if (bannerTitle && activeSrv) {\n3271:             bannerTitle.innerHTML = currentLang === 'en'\n3272:                 ? `Active Matching Provider: <strong>${activeSrv.name}</strong> (Port: ${activeSrv.port} • Model: ${activeSrv.default_model})`\n3273:                 : `المزود النشط حالياً لعمليات المطابقة: <strong>${activeSrv.name}</strong> (منفذ: ${activeSrv.port} • موديل: ${activeSrv.default_model})`;\n3274:         }\n3275:         if (bannerSub) {\n3276:             bannerSub.textContent = currentLang === 'en'\n3277:                 ? `All shortage batches will be dispatched directly to ${activeSrv ? activeSrv.name : activeKey}.`\n3278:                 : `سيتم توجيه جميع دفعات مطابقة النواقص تلقائياً إلى هذا السيرفر (${activeSrv ? activeSrv.name : activeKey}).`;\n3279:         }\n3280: \n3281:         // 2. Update each server card\n3282:         ['gaistudio', 'chatgpt'].forEach(key => {\n3283:             const srv = servers[key];\n3284:             if (!srv) return;\n3285: \n3286:             const card = document.getElementById(`card-server-${key}`);\n3287:             const badgeStatus = document.getElementById(`badge-status-${key}`);\n3288:             const badgeActive = document.getElementById(`badge-active-${key}`);\n3289:             const btnActive = document.getElementById(`btn-active-${key}`);\n3290:             const btnToggle = document.getElementById(`btn-toggle-${key}`);\n3291:             const valModel = document.getElementById(`val-model-${key}`);\n3292: \n3293:             if (valModel) valModel.textContent = srv.default_model;\n3294: \n3295:             const isRunning = !!srv.running;\n3296:             const isExternal = !!srv.is_external;\n3297:             const isManaged = !!srv.is_managed;\n3298:             const isActive = (key === activeKey);\n3299: \n3300:             // Active Card Highlight & Badge\n3301:             if (card) {\n3302:                 card.classList.toggle('is-active-provider', isActive);\n3303:             }\n3304:             if (badgeActive) {\n3305:                 badgeActive.style.display = isActive ? 'inline-flex' : 'none';\n3306:                 badgeActive.textContent = t.btn_already_active || '⭐ المزود النشط';\n3307:             }\n3308: \n3309:             // Running Status Badge\n3310:             if (badgeStatus) {\n3311:                 if (isManaged) {\n3312:                     badgeStatus.className = 'badge-pill status-online';\n3313:                     badgeStatus.textContent = currentLang === 'en' ? `🟢 Online (${srv.port})` : `🟢 متصل ومُدار (${srv.port})`;\n3314:                 } else if (isExternal) {\n3315:                     badgeStatus.className = 'badge-pill status-warning';\n3316:                     badgeStatus.textContent = currentLang === 'en' ? `⚠️ Occupied (${srv.port})` : `⚠️ محجوز خارجياً (${srv.port})`;\n3317:                 } else {\n3318:                     badgeStatus.className = 'badge-pill status-offline';\n3319:                     badgeStatus.textContent = currentLang === 'en' ? '🔴 Stopped' : '🔴 متوقف';\n3320:                 }\n3321:             }\n3322: \n3323:             // Active Switch Button\n3324:             if (btnActive) {\n3325:                 if (isActive) {\n3326:                     btnActive.className = 'btn btn-small btn-outline';\n3327:                     btnActive.style.borderColor = 'var(--primary)';\n3328:                     btnActive.style.background = '#e0f2fe';\n3329:                     btnActive.style.color = 'var(--primary)';\n3330:                     btnActive.innerHTML = `<i class=\"ph-fill ph-star\"></i> <span>${t.btn_already_active || 'المزود النشط'}</span>`;\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
