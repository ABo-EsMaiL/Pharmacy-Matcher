:             shortage_paths = json.loads(shortage_paths_json)\n338:             warehouse_paths = json.loads(warehouse_paths_json)\n339:             \n340:             shortage_filenames = [Path(p).name for p in shortage_paths]\n341:             warehouse_filenames = [Path(p).name for p in warehouse_paths]\n342:             \n343:             process_id = self._db.create_process(shortage_filenames, warehouse_filenames)\n344:             \n345:             with self._worker_lock:\n346:                 if self._worker_thread and self._worker_thread.is_alive():\n347:                     self._db.update_process(process_id, status='queued')\n348:                     self._process_queue.append((process_id, shortage_paths, warehouse_paths))\n349:                     self.add_log(f\"[QUEUE] Process [{process_id}] added to queue (position #{len(self._process_queue)})\")\n350:                     return {\"success\": True, \"process_id\": process_id, \"queued\": True, \"position\": len(self._process_queue)}\n351:                 else:\n352:                     self._worker_thread = threading.Thread(target=self._process_worker, args=(process_id, shortage_paths, warehouse_paths))\n353:                     self._worker_thread.daemon = True\n354:                     self._worker_thread.start()\n355:                     return {\"success\": True, \"process_id\": process_id, \"queued\": False}\n356:                     \n357:         except Exception as e:\n358:             return {\"success\": False, \"error\": str(e)}\n359: \n360:     def restart_process(self, process_id: str) -> dict:\n361:         with self._worker_lock:\n362:             if self._worker_thread and self._worker_thread.is_alive():\n363:                 return {\"success\": False, \"error\": \"توجد عملية مطابقة قيد التشغيل حالياً، يرجى الانتظار حتى تنتهي\"}\n364: \n365:             try:\n366:                 workspace = PROJECT_ROOT / 'data' / 'inputs' / process_id\n367:                 if not workspace.exists()