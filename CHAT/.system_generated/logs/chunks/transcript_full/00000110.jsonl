for req, cand in test_cases:\n    ok, reason = is_safe_auto_match(req, cand)\n    print(f\"[{req}]  <--->  [{cand}]\")\n    print(f\"   -> Result: {'AUTO MATCH (Level 2)' if ok else 'LEVEL 3 (LLM/Review)'} (Reason: {reason})\")\n","Description":"Run verification on brand families","Overwrite":true,"TargetFile":"C:\\Users\\kakak\\.gemini\\antigravity\\brain\\916274de-7f92-49fc-a0a8-d291664b474a\\scratch\\verify_tricky_pairs.py","toolAction":"Writing verification script","toolSummary":"Test tricky pairs for brand family protection"}}]}
