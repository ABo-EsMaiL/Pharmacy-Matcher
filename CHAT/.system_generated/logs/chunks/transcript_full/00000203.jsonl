     \"\"\"\n46:     # تحميل متغيرات البيئة من ملف .env\n47:     if env_path:\n48:         load_dotenv(env_path)\n49:     else:\n50:         # البحث عن .env في جذر المشروع\n51:         project_root = Path(__file__).resolve().parent.parent\n52:         load_dotenv(project_root / \".env\")\n53: \n54:     # قراءة المفاتيح المطلوبة\n55:     unstructured_key = os.getenv(\"UNSTRUCTURED_API_KEY\", \"\").strip()\n56:     gemini_key = os.getenv(\"GEMINI_API_KEY\", \"\").strip()\n57: \n58:     # التحقق من وجود المفاتيح\n59:     missing: list[str] = []\n60:     if not unstructured_key or unstructured_key == \"your_key_here\":\n61:         missing.append(\"UNSTRUCTURED_API_KEY\")\n62:     if not gemini_key or gemini_key == \"your_key_here\":\n63:         missing.append(\"GEMINI_API_KEY\")\n64: \n65:     if missing:\n66:         raise ValueError(\n67:             f\"⚠️ مفاتيح API التالية مفقودة أو غير مُعيَّنة في ملف .env:\\n\"\n68:             f\"  {', '.join(missing)}\\n\"\n69:             f\"يرجى نسخ .env.example إلى .env وتعبئة المفاتيح.\"\n70:         )\n71: \n72:     return Config(\n73:         unstructured_api_key=unstructured_key,\n74:         gemini_api_key=gemini_key,\n75:     )\n76: \nThe above content shows the entire, complete file contents of the requested file.\n"}
