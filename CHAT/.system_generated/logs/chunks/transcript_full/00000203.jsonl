{"step_index":9885,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-25T13:28:53Z","content":"Created At: 2026-09-25T16:28:53+03:00\nCompleted At: 2026-09-25T16:28:54+03:00\nFile Path: `file:///d:/AI_Engineer/Pharmacy-agy-vision/src/extract/file_handler.py`\nTotal Lines: 125\nTotal Bytes: 4029\nShowing lines 1 to 125\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"\"\"\n2: File handler module - detects file type and routes to appropriate reader.\n3: \"\"\"\n4: \n5: import json\n6: from pathlib import Path\n7: \n8: from .excel_reader import read_excel, extract_item_names\n9: from .pdf_reader import extract_items_from_pdf, parse_structured_result\n10: \n11: _EXCEL_EXTENSIONS = {\".xlsx\", \".xls\", \".xlsm\"}\n12: _PDF_EXTENSIONS = {\".pdf\"}\n13: _JSON_EXTENSIONS = {\".json\"}\n14: \n15: \n16: from concurrent.futures import ThreadPoolExecutor, as_completed\n17: \n18: \n19: def _process_single_file(\n20:     filepath: Path,\n21:     api_key: str | None,\n22:     base_url: str,\n23:     gemini_api_key: str | None,\n24:     profile: str\n25: ) -> tuple[str, list[dict]]:\n26:     filepath = Path(filepath)\n27:     ext = filepath.suffix.lower()\n28:     print(f\"\\n  -> [START] Processing file: {filepath.name} (Type: {ext})\")\n29:     try:\n30:         if ext in _EXCEL_EXTENSIONS:\n31:             items = _process_excel_file(filepath)\n32:         elif ext in _PDF_EXTENSIONS:\n33:             items = _process_pdf_file(filepath, api_key, base_url, gemini_api_key, profile)\n34:         elif ext in _JSON_EXTENSIONS:\n35:             items = _process_json_file(filepath)\n36:         else:\n37:             print(f\"[!] Unsupported extension: {ext} for {filepath.name}\")\n38:             return filepath.name, []\n39: \n40:         print(f\"  -> [DONE] {filepath.name}: {len(items)} items extracted.\")\n41:         return filepath.name, items\n42:     except Exception as e:\n43:         print(f\"[!] Exception processing {filepath.name}: {e}\")\n44:         return filepath.name, []\n45: \n46: \n47: def read_input_files(\n48:     filepaths: list[Path],\n49:     role: str,\n50:     api_key: str | None = None,\n51:     base_url: str = \"https://transform.unstructured.io\",\n52:     gemini_api_key: str | None = None,\n53:     profile: str = \"balanced\",\n54: ) -> dict[str, list[dict]]:\n55:     role_label = \"Shortages\" if role == \"shortages\" else \"Warehouse\"\n56:     print(f\"\\n{'='*60}\")\n57:     print(f\"[*] Processing {role_label} files ({len(filepaths)} file(s)) [PARALLEL WORKERS]\")\n58:     print(f\"{'='*60}\")\n59: \n60:     results: dict[str, list[dict]] = {}\n61: \n62:     if not filepaths:\n63:         return results\n64: \n65:     if len(filepaths) == 1:\n66:         fname, items = _process_single_file(filepaths[0], api_key, base_url, gemini_api_key, profile)\n67:         results[fname] = items\n68:     else:\n69:         # Run in parallel across worker threads\n70:         max_workers = min(len(filepaths), 8)\n71:         with ThreadPoolExecutor(max_workers=max_workers) as executor:\n72:             futures = {\n73:                 executor.submit(_process_single_file, fp, api_key, base_url, gemini_api_key, profile): Path(fp).name\n74:                 for fp in filepaths\n75:             }\n76:             for future in as_completed(futures):\n77:                 fname = futures[future]\n78:                 try:\n79:                     name, items = future.result()\n80:                     results[name] = items\n81:                 except Exception as e:\n82:                     print(f\"[!] Worker failed for {fname}: {e}\")\n83:                     results[fname] = []\n84: \n85:     total = sum(len(items) for items in results.values())\n86:     print(f\"\\n{'='*60}\")\n87:     print(f\"[+] Completed {role_label}: {total} items from {len(results)} file(s)\")\n88:     print(f\"{'='*60}\\n\")\n89: \n90:     return results\n91: \n92: \n93: def _process_excel_file(filepath: Path) -> list[dict]:\n94:     rows = read_excel(filepath)\n95:     items = extract_item_names(rows, source_file=filepath.name)\n96:     return items\n97: \n98: \n99: def _process_pdf_file(\n100:     filepath: Path,\n101:     api_key: str | None,\n102:     base_url: str,\n103:     gemini_api_key: str | None = None,\n104:     profile: str = \"balanced\",\n105: ) -> list[dict]:\n106:     if not api_key:\n107:         raise ValueError(\n108:             f\"[!] Unstructured API Key required for PDF files.\\n\"\n109:             f\"    Please set UNSTRUCTURED_API_KEY in .env\"\n110:         )\n111: \n112:     items = extract_items_from_pdf(filepath, api_key, base_url, gemini_api_key, profile=profile)\n113:     return items\n114: \n115: \n116: def _process_json_file(filepath: Path) -> list[dict]:\n117:     \"\"\"Process cached Unstructured JSON to save API limits.\"\"\"\n118:     with open(filepath, \"r\", encoding=\"utf-8-sig\") as f:\n119:         data = json.load(f)\n120:     \n121:     # We now assume the JSON is a saved ExtractionResult\n122:     items = parse_structured_result(data, filepath.name)\n123:     \n124:     return items\n125: \nThe above content shows the entire, complete file contents of the requested file.\n"}
