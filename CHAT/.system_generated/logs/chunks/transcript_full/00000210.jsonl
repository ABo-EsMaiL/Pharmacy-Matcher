{"step_index":10184,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-25T14:23:37Z","content":"Created At: 2026-09-25T17:23:37+03:00\nCompleted At: 2026-09-25T17:23:37+03:00\nFile Path: `file:///d:/AI_Engineer/MSEMAX-GAIStudio-vision/app.py`\nTotal Lines: 1653\nTotal Bytes: 79837\nShowing lines 1 to 150\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"\"\"\n2: MSEMAX — Google AI Studio Web Hook Gateway (FastAPI Server)\n3: \n4: A 100% free, OpenAI-compatible API gateway that drives the Google AI Studio\n5: Web Interface (https://aistudio.google.com) using a persistent Chromium\n6: browser profile (./chrome_profile).\n7: \n8: No official API key is required. Uses real-time DOM stream capture to\n9: provide instant Server-Sent Events (SSE) responses compatible with any\n10: OpenAI client, LangChain, n8n, etc.\n11: \n12: Default Model: gemini-3.8-flash (Thinking: High)\n13: \n14: Author: Mohamed (MSEMAX) & Antigravity\n15: License: MIT\n16: \"\"\"\n17: \n18: import os\n19: import re\n20: import time\n21: import json\n22: import uuid\n23: import base64\n24: import asyncio\n25: import logging\n26: from typing import AsyncGenerator, Optional, Any, List, Dict, Union, Tuple\n27: from contextlib import asynccontextmanager\n28: \n29: from fastapi import FastAPI, Request, HTTPException, Depends, Header\n30: from fastapi.responses import StreamingResponse, JSONResponse\n31: from fastapi.middleware.cors import CORSMiddleware\n32: from pydantic import BaseModel\n33: from slowapi import Limiter, _rate_limit_exceeded_handler\n34: from slowapi.util import get_remote_address\n35: from slowapi.errors import RateLimitExceeded\n36: from dotenv import load_dotenv\n37: from playwright.async_api import async_playwright, BrowserContext, Page\n38: \n39: # Load environment\n40: load_dotenv()\n41: \n42: logging.basicConfig(\n43:     level=logging.INFO,\n44:     format=\"%(asctime)s - %(name)s - %(levelname)s - %(message)s\"\n45: )\n46: logger = logging.getLogger(\"msemax.webhook\")\n47: \n48: # ------------------------------------------------------------------------------\n49: # Configuration\n50: # ------------------------------------------------------------------------------\n51: API_KEY = os.getenv(\"MSE_MAX_KEY\", \"\").strip()\n52: CHROME_PROFILE_DIR = os.getenv(\"CHROME_PROFILE_DIR\", \"./chrome_profile\")\n53: BASE_DIR = os.path.dirname(os.path.abspath(__file__))\n54: if not os.path.isabs(CHROME_PROFILE_DIR):\n55:     CHROME_PROFILE_DIR = os.path.normpath(os.path.join(BASE_DIR, CHROME_PROFILE_DIR))\n56: TEMP_UPLOADS_DIR = os.path.join(BASE_DIR, \"temp_uploads\")\n57: os.makedirs(TEMP_UPLOADS_DIR, exist_ok=True)\n58: HEADLESS = os.getenv(\"HEADLESS\", \"true\").lower() in (\"true\", \"1\", \"yes\")\n59: DEFAULT_MODEL = os.getenv(\"DEFAULT_MODEL\", \"gemini-3.8-flash\").strip()\n60: THINKING_MODE = os.getenv(\"THINKING_MODE\", \"high\").strip().lower()\n61: ENABLE_SEARCH_GROUNDING = os.getenv(\"ENABLE_SEARCH_GROUNDING\", \"false\").lower() in (\"true\", \"1\", \"yes\")\n62: CLEAR_CHAT_ON_REQUEST = os.getenv(\"CLEAR_CHAT_ON_REQUEST\", \"true\").lower() in (\"true\", \"1\", \"yes\")\n63: REQUEST_TIMEOUT = float(os.getenv(\"MSE_REQUEST_TIMEOUT\", \"180\"))\n64: RATE_LIMIT = os.getenv(\"MSE_RATE_LIMIT\", \"30/minute\").strip()\n65: MAX_CONCURRENT = int(os.getenv(\"MSE_MAX_CONCURRENT\", \"1\"))\n66: PORT = int(os.getenv(\"PORT\", \"8001\"))\n67: TARGET_URL = \"https://aistudio.google.com/prompts/new_chat\"\n68: \n69: # ------------------------------------------------------------------------------\n70: # Browser Automation Manager (Playwright Persistent Context)\n71: # ------------------------------------------------------------------------------\n72: class WebHookBrowserManager:\n73:     def __init__(self):\n74:         self.playwright = None\n75:         self.context: Optional[BrowserContext] = None\n76:         self.page: Optional[Page] = None\n77:         self.lock = asyncio.Lock()\n78:         self.is_ready = False\n79:         self.is_shutting_down = False\n80:         self.active_model = \"\"\n81:         self.model_verified = False\n82:         self.active_thinking = \"\"\n83:         self.thinking_verified = False\n84:         self.google_search_enabled = False\n85:         self.search_verified = False\n86:         self.last_tool_calls_count = 0\n87: \n88:     async def start(self):\n89:         logger.info(f\"Launching persistent Chromium context from: {CHROME_PROFILE_DIR} (headless={HEADLESS}, start-maximized)\")\n90:         self.playwright = await async_playwright().start()\n91: \n92:         args = [\n93:             \"--disable-blink-features=AutomationControlled\",\n94:             \"--start-maximized\"\n95:         ]\n96: \n97:         try:\n98:             self.context = await self.playwright.chromium.launch_persistent_context(\n99:                 user_data_dir=CHROME_PROFILE_DIR,\n100:                 headless=HEADLESS,\n101:                 no_viewport=True,\n102:                 args=args,\n103:                 ignore_default_args=[\"--enable-automation\"]\n104:             )\n105:         except Exception as e:\n106:             logger.error(f\"Failed to launch browser: {e}\")\n107:             logger.error(\"Please ensure no other Chromium process is currently using ./chrome_profile.\")\n108:             raise e\n109: \n110:         self.page = self.context.pages[0] if self.context.pages else await self.context.new_page()\n111: \n112:         # Removed stealth.min.js injection. \n113:         # Relying entirely on native Playwright events and default browser state to pass BotGuard.\n114: \n115:         # Attach network response listener to capture any Google backend errors\n116:         async def handle_response(response):\n117:             try:\n118:                 url = response.url\n119:                 if any(k in url.lower() for k in [\"alkali\", \"generatecontent\", \"runprompt\", \"clients6.google.com\", \"streamgeneratecontent\"]):\n120:                     if response.status >= 400:\n121:                         try:\n122:                             body = await response.text()\n123:                             logger.error(f\"[Google Backend Error {response.status}] URL: {url[:80]} | Response Body: {body[:600]}\")\n124:                         except Exception:\n125:                             logger.error(f\"[Google Backend Error {response.status}] URL: {url[:80]}\")\n126:                     elif \"generatecontent\" in url.lower() or \"runprompt\" in url.lower():\n127:                         logger.info(f\"[Google Backend Status {response.status}] URL: {url[:80]}\")\n128:             except Exception:\n129:                 pass\n130: \n131:         self.page.on(\"response\", handle_response)\n132:         self.page.on(\"pageerror\", lambda err: logger.warning(f\"[Browser Page Error]: {err}\"))\n133: \n134:         logger.info(f\"Navigating to {TARGET_URL} to ensure clean environment...\")\n135:         try:\n136:             await self.page.goto(TARGET_URL, timeout=60000, wait_until=\"domcontentloaded\")\n137:             await asyncio.sleep(2)\n138:         except Exception as e:\n139:             logger.warning(f\"Initial page navigation warning: {e}. Page will be ready on demand.\")\n140: \n141:         # Check if user needs to log in\n142:         if \"accounts.google.com\" in self.page.url or \"welcome\" in self.page.url:\n143:             logger.warning(\"=\" * 65)\n144:             logger.warning(\"[ACTION REQUIRED] Google AI Studio requires Google Account login!\")\n145:             logger.warning(\"Please sign into your Google account in the Chromium window.\")\n146:             logger.warning(\"Waiting for login completion...\")\n147:             logger.warning(\"=\" * 65)\n148:             \n149:             