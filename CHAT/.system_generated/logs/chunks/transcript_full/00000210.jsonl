or.execute('SELECT id FROM processes ORDER BY id DESC LIMIT 1')\n42:         row = cursor.fetchone()\n43:         if row:\n44:             last_id = row['id']\n45:             try:\n46:                 num = int(last_id.split('-')[1]) + 1\n47:             except:\n48:                 num = 1\n49:             return f'PROC-{num:03d}'\n50:         return 'PROC-001'\n51: \n52:     def create_process(self, shortage_filenames: list[str], warehouse_filenames: list[str]) -> str:\n53:         process_id = self.get_next_id()\n54:         created_at = datetime.now().isoformat()\n55:         status = 'processing'\n56:         \n57:         proc_dir = PROCESSES_DIR / process_id\n58:         (proc_dir / 'input_shortages').mkdir(parents=True, exist_ok=True)\n59:         (proc_dir / 'input_warehouses').mkdir(parents=True, exist_ok=True)\n60:         (proc_dir / 'output').mkdir(parents=True, exist_ok=True)\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
