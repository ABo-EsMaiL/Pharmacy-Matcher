== \"user\":\n1180:                             user_lines.append(t)\n1181:                 elif p_type == \"image_url\":\n1182:                     img_info = part.get(\"image_url\", {})\n1183:                     url = img_info.get(\"url\", \"\") if isinstance(img_info, dict) else str(img_info)\n1184:                     url = url.strip()\n1185:                     if not url:\n1186:                         continue\n1187:                     if url.startswith(\"data:image/\"):\n1188:                         try:\n1189:                             # format: data:image/webp;base64,...\n1190:                             header, b64_data = url.split(\";base64,\", 1)\n1191:                             ext = header.split(\"data:image/\", 1)[1].split(\";\")[0].strip()\n1192:                             if not ext or ext == \"*\":\n1193:                                 ext = \"webp\"\n1194:                             elif ext.lower() == \"jpeg\":\n1195:                                 ext = \"jpg\"\n1196:                             filename = f\"upload_{uuid.uuid4().hex[:12]}.{ext}\"\n1197:                             file_path = os.path.join(TEMP_UPLOADS_DIR, filename)\n1198:                             with open(file_path, \"wb\") as f_img:\n1199:                                 f_img.write(base64.b64decode(b64_data))\n1200:                             image_paths.append(file_path)\n1201:                             logger.info(f\"Saved incoming Base64 image to: {file_path} ({os.path.getsize(file_path)} bytes)\")\n1202:                         except Exception as e:\n1203:                             logger.error(f\"Failed to decode base64 image: {e}\")\n1204:                     elif os.path.exists(url):\n1205:                         image_paths.append(os.path.abspath(url))\n1206:                     elif url.startswith(\"http://\") or url.startswith(\"https://\"):\n1207:                         try:\n1208:                             import urllib.request\n1209:  