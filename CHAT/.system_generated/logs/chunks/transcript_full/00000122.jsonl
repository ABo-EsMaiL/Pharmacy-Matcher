pt Exception as e:\n130:             self.log(f\"[SYSTEM ERROR] {str(e)}\")\n131:             return {\"success\": False, \"output\": str(e)}\n132: \n133:     def get_status(self) -> dict:\n134:         return {\n135:             \"running\": self.is_running(),\n136:             \"pid\": self.process.pid if self.is_running() else None\n137:         }\n138: \n139:     def cleanup(self):\n140:         self.stop()\n141: \nThe above content shows the entire, complete file contents of the requested file.\n"}
