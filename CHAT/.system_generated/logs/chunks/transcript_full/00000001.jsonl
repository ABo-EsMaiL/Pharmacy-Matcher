{"step_index":23,"source":"SYSTEM","type":"SYSTEM_MESSAGE","status":"DONE","created_at":"2026-09-21T10:16:43Z","content":"The following is a <SYSTEM_MESSAGE> not actually sent by the user. It is provided by the system as important information to pay attention to.\n\n<SYSTEM_MESSAGE>\n[Message] timestamp=2026-09-21T10:15:31Z sender=863513b0-dc57-4adf-99c5-10dba189e750 priority=MESSAGE_PRIORITY_HIGH content=Here are the complete contents of all 9 requested files:\n\n================================================================================\n1. d:\\AI_Engineer\\Pharmacy\\review\\parse_unstructured_api.py\n================================================================================\nr\"\"\"User-run Unstructured Transform API trial: best quality, elements output.\n\n    python .\\review\\parse_unstructured_api.py \".\\جملة العمروووو.pdf\"\n    python .\\review\\parse_unstructured_api.py --from-json .\\saved-result.json\n\nUploads the selected PDF to Unstructured. Reads the API key from the environment\nor a hidden local prompt. Does not install packages or run local OCR models.\nEach normal invocation starts a new extraction; --resume only polls an existing job.\nThe full response is kept before attempting to render its tables.\n--from-json rebuilds only local previews: no API key, upload, or network call.\n\"\"\"\n\nimport argparse\nfrom datetime import datetime\nimport getpass\nimport hashlib\nimport json\nimport os\nfrom pathlib import Path\nimport sys\nimport time\nfrom urllib.parse import urljoin, urlsplit\n\nfrom render_unstructured import prepare_preview\n\n\nBASE_URL = \"https://transform.unstructured.io\"\nPARSE_URL = BASE_URL + \"/api/v2/parse\"\nOUTPUT_ROOT = Path(__file__).resolve().parent / \"unstructured_api\"\n\n\ndef write_json(path, data):\n    path.write_text(json.dumps(data, ensure_ascii=False, indent=2), encoding=\"utf-8\")\n\n\ndef checked_poll_url(value, base=PARSE_URL):\n    url = urljoin(base, value)\n    parsed = urlsplit(url)\n    if (parsed.scheme != \"https\" or parsed.hostname != \"transform.unstructured.io\"\n            or parsed.port not in (None, 443) or parsed.username or parsed.password\n            or not parsed.path.startswith(\"/api/\")):\n        raise ValueError(\"Unexpected job URL. Stopped before sending the API key to it.\")\n    return url\n\n\ndef completed_result(payload):\n    \"\"\"Accept the direct Parse result, or the result inside a completed job.\"\"\"\n    if payload.get(\"status\") != \"completed\":\n        return None\n    if isinstance(payload.get(\"elements\"), list):\n        return payload\n    result = payload.get(\"result\")\n    if isinstance(result, dict) and isinstance(result.get(\"elements\"), list):\n        return {\"status\": \"completed\", **result}\n    raise ValueError(\"Job completed, but its result format needs inspection. The response is saved.\")\n\n\ndef collect_response(session, response, run_dir, api_key, poll_url=None):\n    deadline = time.monotonic() + 1800\n    while True:\n        # Never save request headers or the API key, including in an error response.\n        raw = response.content.replace(api_key.encode(\"utf-8\"), b\"[API_KEY_REDACTED]\")\n        (run_dir / \"response.json\").write_bytes(raw)\n        if response.status_code not in (200, 201, 202):\n            raise RuntimeError(f\"Unstructured returned HTTP {response.status_code}. See response.json.\")\n        payload = json.loads(raw.decode(\"utf-8-sig\"))\n        if not isinstance(payload, dict):\n            raise ValueError(\"Unexpected response format; see the saved response.json.\")\n        location = response.headers.get(\"Location\")\n        if location:\n            poll_url = checked_poll_url(location, response.url)\n        state = {\"poll_url\": poll_url, \"id\": payload.get(\"id\"), \"status\": payload.get(\"status\")}\n        write_json(run_dir / \"job.json\", state)\n        if payload.get(\"status\") in (\"failed\", \"cancelled\", \"canceled\"):\n            raise RuntimeError(\"Unstructured reported a failed or cancelled job. See response.json.\")\n        result = completed_result(payload)\n        if result is not None:\n            return result\n        pending = response.status_code == 202 or payload.get(\"status\") in (\n            \"pending\", \"queued\", \"running\", \"processing\", \"in_progress\"\n        )\n        if not pending:\n            raise ValueError(\"Unrecognized response status; see response.json before retrying.\")\n        if not poll_url:\n            raise RuntimeError(\"Request accepted without a follow-up URL. Check this job in the website; do not resubmit yet.\")\n        if time.monotonic() >= deadline:\n            raise TimeoutError(\"Still processing after 30 minutes. Use --resume to continue the same job.\")\n        print(f\"Job status: {payload.get('status', 'pending')}. Waiting 10 seconds...\", flush=True)\n        time.sleep(10)\n        response = session.get(poll_url, timeout=(30, 120), allow_redirects=False)\n\n\ndef save_preview(result, run_dir):\n    \"\"\"Publish a reviewable preview even when table cells are unavailable.\"\"\"\n    document, tables = prepare_preview(result)\n    (run_dir / \"preview.html\").write_text(document, encoding=\"utf-8\")\n    write_json(run_dir / \"tables.json\", tables)\n    OUTPUT_ROOT.mkdir(parents=True, exist_ok=True)\n    (OUTPUT_ROOT / \"latest.html\").write_text(document, encoding=\"utf-8\")\n    write_json(run_dir / \"preview_status.json\", {\n        \"status\": tables[\"preview_status\"], \"result_id\": result.get(\"id\"),\n        \"issue_count\": len(tables[\"preview_issues\"]),\n        \"note\": \"Table structure review only; OCR accuracy has not been verified.\",\n    })\n    print(f\"Preview: {run_dir / 'preview.html'}\", flush=True)\n    if tables[\"preview_issues\"]:\n        print(\n            f\"PREVIEW READY - NEEDS REVIEW: {len(tables['preview_issues'])} elements have unavailable table structure. \"\n            \"The saved extraction was not changed. This result is not ready for row-based matching.\", flush=True\n        )\n    else:\n        print(\"DONE. Review the preview against the original PDF.\", flush=True)\n    print(f'Open it: Invoke-Item \"{run_dir / \"preview.html\"}\"', flush=True)\n    if result.get(\"warnings\"):\n        print(\"The API returned warnings; they are preserved in result.json.\", flush=True)\n    return 2 if tables[\"preview_issues\"] else 0\n\n\ndef save_completed_result(result, run_dir):\n    write_json(run_dir / \"result.json\", result)\n    if isinstance(result.get(\"markdown\"), str):\n        (run_dir / \"result.md\").write_text(result[\"markdown\"], encoding=\"utf-8\")\n    if result.get(\"profile\") != \"best\":\n        raise ValueError(\"The saved result does not confirm profile=best. Inspect result.json before continuing.\")\n    print(f\"Result JSON: {run_dir / 'result.json'}\", flush=True)\n    return save_preview(result, run_dir)\n\n\ndef main():\n    if hasattr(sys.stdout, \"reconfigure\"):\n        sys.stdout.reconfigure(encoding=\"utf-8\", errors=\"replace\")\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument(\"pdf\", type=Path, nargs=\"?\", help=\"PDF to send to Unstructured\")\n    parser.add_argument(\"--resume\", type=Path, help=\"Existing job.json; polls without uploading again\")\n    parser.add_argument(\"--from-json\", type=Path, help=\"Rebuild previews from a saved result, entirely offline\")\n    args = parser.parse_args()\n    if sum(value is not None for value in (args.pdf, args.resume, args.from_json)) != 1:\n        parser.error(\"Choose exactly one: a PDF, --resume job.json, or --from-json result.json.\")\n    if Path(sys.prefix).name.lower() != \"venv\":\n        parser.error(\"Activate the main conda environment: conda activate venv\")\n    if args.from_json:\n        source = args.from_json.resolve()\n        result = json.loads(source.read_text(encoding=\"utf-8-sig\"))\n        # Keep the original JSON intact and rebuild only derived review files.\n        run_dir = source.parent / (source.stem + \"_preview\")\n        run_dir.mkdir(parents=True, exist_ok=True)\n        print(f\"Offline preview from: {source}\", flush=True)\n        print(\"No API call, upload, or local OCR. No account pages used.\", flush=True)\n        return save_preview(result, run_dir)\n    import requests\n\n    poll_url = None\n    if args.resume:\n        job_file = args.resume.resolve()\n        job = json.loads(job_file.read_text(encoding=\"utf-8-sig\"))\n        if not job.get(\"poll_url\"):\n            raise ValueError(\"No saved polling URL. Inspect the job in the website first.\")\n        poll_url = checked_poll_url(job[\"poll_url\"])\n        run_dir = job_file.parent\n    else:\n        pdf = args.pdf.resolve()\n        if not pdf.is_file() or pdf.suffix.lower() != \".pdf\":\n            parser.error(\"Provide an existing PDF file.\")\n        content = pdf.read_bytes()\n        if not content.startswith(b\"%PDF-\"):\n            parser.error(\"The selected file does not start with a PDF header.\")\n        print(f\"PDF: {pdf}\", flush=True)\n        print(\"This run sends the PDF to Unstructured: profile=best, output=elements.\", flush=True)\n        print(\"A new extraction uses your account's page allowance.\", flush=True)\n\n    api_key = os.environ.get(\"UNSTRUCTURED_API_KEY\", \"\").strip()\n    if not api_key:\n        api_key = getpass.getpass(\"Paste your Unstructured API key (hidden), then press Enter: \").strip()\n    if not api_key:\n        raise ValueError(\"No API key entered. Nothing was submitted.\")\n    if not args.resume:\n        run_dir = OUTPUT_ROOT / datetime.now().strftime(\"run_%Y%m%d_%H%M%S_%f\")\n        run_dir.mkdir(parents=True, exist_ok=False)\n        write_json(run_dir / \"request.json\", {\n            \"source_file\": str(pdf), \"sha256\": hashlib.sha256(content).hexdigest(),\n            \"profile\": \"best\", \"output\": \"elements\", \"endpoint\": PARSE_URL,\n        })\n    print(f\"Saved responses: {run_dir}\", flush=True)\n    try:\n        with requests.Session() as session:\n            session.headers.update({\"unstructured-api-key\": api_key, \"Accept\": \"application/json\"})\n            if poll_url:\n                print(\"Checking the existing job; no new upload.\", flush=True)\n                response = session.get(poll_url, timeout=(30, 120), allow_redirects=False)\n            else:\n                print(\"Uploading and waiting for the result. Large files can take several minutes...\", flush=True)\n                # A POST is attempted only once. No automatic resubmission on timeout.\n                response = session.post(\n                    PARSE_URL, data={\"profile\": \"best\", \"output\": \"elements\"},\n                    files={\"input\": (pdf.name, content, \"application/pdf\")},\n                    timeout=(30, 900), allow_redirects=False,\n                )\n            result = collect_response(session, response, run_dir, api_key, poll_url)\n        return save_completed_result(result, run_dir)\n    except Exception as error:\n        message = str(error).replace(api_key, \"[API_KEY_REDACTED]\")\n        (run_dir / \"error.txt\").write_text(message, encoding=\"utf-8\")\n        print(f\"STOPPED: {message}\", flush=True)\n        print(f\"Saved information: {run_dir}\", flush=True)\n        job_path = run_dir / \"job.json\"\n        if job_path.is_file():\n            job = json.loads(job_path.read_text(encoding=\"utf-8\"))\n            if job.get(\"poll_url\") and job.get(\"status\") not in (\"completed\", \"failed\", \"cancelled\", \"canceled\"):\n                print(f'Resume this job: python \"{Path(__file__).resolve()}\" --resume \"{job_path}\"', flush=True)\n        if isinstance(error, requests.RequestException):\n            print(\"The server may already have received the request. Check the website before starting another extraction.\", flush=True)\n        raise SystemExit(1)\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n\n================================================================================\n2. d:\\AI_Engineer\\Pharmacy\\review\\render_unstructured.py\n================================================================================\nr\"\"\"Render an existing Unstructured Transform JSON locally; no API or OCR calls.\n\nUsage (inside conda venv):\n    python .\\review\\render_unstructured.py .\\transform-result-....json\nAll source rows, including headers and totals, are retained for inspection.\nThis is an extraction preview, not a shortage-matching or ordering program.\n\"\"\"\n\nimport argparse\nimport html\nfrom html.parser import HTMLParser\nimport json\nfrom pathlib import Path\nimport re\nimport sys\n\n\nclass TableReader(HTMLParser):\n    \"\"\"Read cell text and spans without executing or rendering source HTML.\"\"\"\n\n    def __init__(self):\n        super().__init__(convert_charrefs=True)\n        self.tables = []\n        self.table = self.row = self.cell = None\n        self.fragments = []\n\n    def handle_starttag(self, tag, attrs):\n        if tag == \"table\":\n            if self.table is not None:\n                raise ValueError(\"Nested tables need a separate review.\")\n            self.table = []\n        elif tag == \"tr\" and self.table is not None:\n            if self.row is not None:\n                raise ValueError(\"An unclosed table row was found.\")\n            self.row = []\n        elif tag in (\"td\", \"th\") and self.row is not None:\n            if self.cell is not None:\n                raise ValueError(\"An unclosed table cell was found.\")\n            attrs = dict(attrs)\n            self.cell = {\"text\": \"\", \"header\": tag == \"th\"}\n            for attribute in (\"rowspan\", \"colspan\"):\n                value = int(attrs.get(attribute, \"1\"))\n                if not 1 <= value <= 1000:\n                    raise ValueError(\"An unsupported cell span was found.\")\n                self.cell[attribute] = value\n            self.fragments = []\n        elif tag == \"br\" and self.cell is not None:\n            self.fragments.append(\"\\n\")\n\n    def handle_data(self, data):\n        if self.cell is not None:\n            self.fragments.append(data)\n\n    def handle_endtag(self, tag):\n        if tag in (\"td\", \"th\") and self.cell is not None:\n            self.cell[\"text\"] = \"\".join(self.fragments)\n            self.row.append(self.cell)\n            self.cell = None\n        elif tag == \"tr\" and self.row is not None:\n            if self.cell is not None:\n                raise ValueError(\"A row ended before its cell was closed.\")\n            self.table.append(self.row)\n            self.row = None\n        elif tag == \"table\" and self.table is not None:\n            if self.row is not None:\n                raise ValueError(\"A table ended before its row was closed.\")\n            self.tables.append(self.table)\n            self.table = None\n\n\ndef read_tables(markup):\n    parser = TableReader()\n    parser.feed(markup)\n    parser.close()\n    if parser.table is not None or parser.row is not None or parser.cell is not None:\n        raise ValueError(\"Incomplete table HTML; source JSON has not been changed.\")\n    if not parser.tables:\n        raise ValueError(\"No HTML table was found.\")\n    return parser.tables\n\n\ndef render_table(rows):\n    parts = ['<div class=\"table-wrap\"><table dir=\"rtl\">']\n    for row in rows:\n        parts.append(\"<tr>\")\n        for cell in row:\n            tag = \"th\" if cell[\"header\"] else \"td\"\n            numeric = bool(re.fullmatch(r\"[\\d.,+%:/\\s-]+\", cell[\"text\"]))\n            direction = \"ltr\" if numeric else \"auto\"\n            parts.append(\n                f'<{tag} rowspan=\"{cell[\"rowspan\"]}\" colspan=\"{cell[\"colspan\"]}\" '\n                f'dir=\"{direction}\">{html.escape(cell[\"text\"])}</{tag}>'\n            )\n        parts.append(\"</tr>\")\n    parts.append(\"</table></div>\")\n    return \"\".join(parts)\n\n\ndef prepare_preview(data):\n    if not isinstance(data, dict) or not isinstance(data.get(\"elements\"), list):\n        raise ValueError(\"Expected a complete Transform JSON response with an elements list.\")\n    if data.get(\"status\") != \"completed\":\n        raise ValueError(\"This response is not marked completed; inspect its status first.\")\n    if not data[\"elements\"]:\n        raise ValueError(\"The elements list is empty; a Markdown-only export is insufficient.\")\n    labels = {\"Image\": \"نص الصورة\", \"NarrativeText\": \"نص\", \"Title\": \"عنوان\",\n              \"Header\": \"رأس الصفحة\", \"Form\": \"بيانات المستند\",\n              \"Table\": \"عنصر مصنّف كجدول\", \"Footer\": \"تذييل الصفحة\"}\n    cards, exported_tables, issues = [], [], []\n    for index, element in enumerate(data[\"elements\"]):\n        kind = element.get(\"type\", \"Unknown\")\n        metadata = element.get(\"metadata\") or {}\n        markup = metadata.get(\"text_as_html\")\n        issue_context = {\"element_index\": index, \"element_id\": element.get(\"element_id\"),\n                         \"page_number\": metadata.get(\"page_number\"), \"element_type\": kind}\n        content = '<pre dir=\"auto\">' + html.escape(element.get(\"text\") or \"\") + '</pre>'\n        if markup:\n            try:\n                tables = read_tables(markup)\n                content = \"\".join(render_table(rows) for rows in tables)\n                exported_tables.append({\n                    \"element_id\": element.get(\"element_id\"), \"element_type\": kind,\n                    \"page_number\": metadata.get(\"page_number\"), \"tables\": tables,\n                })\n            except (TypeError, ValueError) as error:\n                issues.append({**issue_context, \"error\": str(error),\n                               \"source_text\": element.get(\"text\") or \"\"})\n                content = '<p class=\"warning\">تعذّر عرض بنية الجدول؛ النص أدناه للمراجعة فقط.</p>' + content\n        elif kind == \"Table\":\n            issues.append({**issue_context, \"error\": \"Table has no text_as_html.\",\n                           \"source_text\": element.get(\"text\") or \"\"})\n            content = '<p class=\"warning\">هذا الجدول موجود كنص فقط؛ لا نفترض حدود صفوفه.</p>' + content\n        title = html.escape(labels.get(kind, kind))\n        page = html.escape(str(metadata.get(\"page_number\", \"—\")))\n        cards.append(f'<section><h2>{title} <small>— صفحة {page}</small></h2>{content}</section>')\n    source_name = (data.get(\"source\") or {}).get(\"filename\", \"غير محدد\")\n    warnings = data.get(\"warnings\", [])\n    warnings_text = json.dumps(warnings, ensure_ascii=False) if warnings else \"لا توجد تحذيرات في الرد\"\n    document = '''<!doctype html>\n<html lang=\"ar\" dir=\"rtl\"><head><meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'none'; style-src 'unsafe-inline'\">\n<title>مراجعة نتيجة Unstructured</title><style>\nbody{font-family:Tahoma,Arial,sans-serif;background:#f3f6fa;color:#182636;margin:0;padding:28px}\nmain{max-width:1200px;margin:auto}h1{font-size:26px}h2{font-size:19px}\nsection,.intro{background:#fff;border:1px solid #d5dfeb;border-radius:10px;padding:20px;margin:18px 0}\np{line-height:1.9}small{font-weight:normal;color:#526478}.table-wrap{overflow-x:auto}\ntable{border-collapse:collapse;width:100%}th,td{padding:11px;border:1px solid #cdd8e5;text-align:start;white-space:pre-wrap}\nth{background:#e8f0fa}tr:nth-child(even){background:#f7faff}td[dir=ltr]{text-align:center}\npre{white-space:pre-wrap;unicode-bidi:plaintext;font:16px/1.9 Tahoma,Arial,sans-serif}\n.warning{background:#fff1dc;padding:12px}code{direction:ltr;unicode-bidi:isolate}\n</style></head><body><main><h1>مراجعة نتيجة Unstructured</h1><div class=\"intro\">\n<p>معاينة محلية من ملف JSON الموجود، من غير OCR أو اتصال بالـAPI.</p>\n<p>النص والأرقام محفوظان كما وردا. لم نصحح أسماء الأصناف، ولم نستنتج أرقامًا ناقصة.\nتظهر أعمدة المصدر وصفوف العناوين والإجماليات للمراجعة؛ هذه ليست قائمة طلبات الشراء.</p>'''\n    document += '<p>المصدر: <bdi>' + html.escape(str(source_name)) + '</bdi></p>'\n    document += '<p>عدد صفحات الرد: ' + html.escape(str((data.get(\"metadata\") or {}).get(\"page_count\", \"—\"))) + '</p>'\n    document += '<p>معرّف النتيجة: <bdi>' + html.escape(str(data.get(\"id\", \"—\"))) + '</bdi></p>'\n    document += '<p>إعداد الجودة: <bdi>' + html.escape(str(data.get(\"profile\", \"—\"))) + '</bdi></p>'\n    document += '<p>' + html.escape(warnings_text) + '؛ غياب التحذيرات لا يضمن دقة القراءة.</p>'\n    if issues:\n        document += (\n            '<p class=\"warning\"><strong>الاستخراج محفوظ والمعاينة متاحة، لكن بنية الجداول تحتاج مراجعة.</strong><br>'\n            'عدد العناصر التي تعذّر الحصول على خلاياها: ' + str(len(issues)) + '. '\n            'النص أدناه من الرد الأصلي؛ لم نخمّن حدود الصفوف أو نربط الأرقام بالأصناف. '\n            'تصنيف العنصر كجدول لا يعني أنه جدول أدوية؛ قد يشمل عنوانًا أو تذييلًا.</p>'\n        )\n    document += '</div>'\n    document += \"\".join(cards) + '</main></body></html>'\n    return document, {\"result_id\": data.get(\"id\"), \"source\": data.get(\"source\"),\n                      \"note\": \"Available HTML table cells retain headers, totals and spans. Unstructured text is retained in preview_issues; no missing row boundaries are inferred. No medicine matching.\",\n                      \"preview_status\": \"needs_review\" if issues else \"structured\",\n                      \"tables\": exported_tables, \"preview_issues\": issues}\n\n\ndef main():\n    if hasattr(sys.stdout, \"reconfigure\"):\n        sys.stdout.reconfigure(encoding=\"utf-8\", errors=\"replace\")\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument(\"input\", type=Path, help=\"Existing Transform result JSON\")\n    args = parser.parse_args()\n    source = args.input.resolve()\n    data = json.loads(source.read_text(encoding=\"utf-8-sig\"))\n    document, tables = prepare_preview(data)\n    output_dir = Path(__file__).resolve().parent / \"unstructured_preview\" / source.stem\n    output_dir.mkdir(parents=True, exist_ok=True)\n    (output_dir / \"preview.html\").write_text(document, encoding=\"utf-8\")\n    (output_dir / \"tables.json\").write_text(json.dumps(tables, ensure_ascii=False, indent=2), encoding=\"utf-8\")\n    print(f\"Preview: {output_dir / 'preview.html'}\")\n    print(f\"Table cells: {output_dir / 'tables.json'}\")\n    if tables[\"preview_issues\"]:\n        print(\"Some tables need review. See preview_issues in tables.json.\")\n        raise SystemExit(2)\n    print(\"DONE. This checks the saved structure, not OCR accuracy.\")\n\n\nif __name__ == \"__main__\":\n    main()\n\n================================================================================\n3. d:\\AI_Engineer\\Pharmacy\\review\\build_preview.py\n================================================================================\n\"\"\"Build a diagnostic workbook from existing extraction; never invent stock.\"\"\"\nfrom pathlib import Path\nimport json, re\nfrom openpyxl import Workbook, load_workbook\nfrom openpyxl.styles import Font, PatternFill, Alignment\nfrom openpyxl.utils import get_column_letter\n\nBASE = Path(__file__).resolve().parent.parent\nOUT = BASE / 'review'\nwb = Workbook()\nintro = wb.active\nintro.title = 'ابدأ هنا'\nintro.append(['المحتوى', 'التوضيح'])\nfor row in [\n    ('نوع الملف', 'عينة فعلية من الاستخراج وأمثلة مطابقة أصناف؛ ليست نتيجة مطابقة شاملة نهائية.'),\n    ('النواقص الأصلية', 'نقلت أسطر الطلبات الـ993 كما هي دون حذف تكرار أو تعديل كمية.'),\n    ('أوراق المخازن', 'تحتوي كل الأسطر غير الفارغة المستخرجة، بما فيها رؤوس الصفحات والأجزاء التالفة.'),\n    ('فصل الأعمدة', 'الاسم والسعر والخصم مفصولة مبدئيًا في السلام والمكرومي وكيور؛ النص الخام محفوظ للمقارنة.'),\n    ('نطاق المطلوب', 'مطابقة الأصناف فقط حسب توضيحك الأخير، دون توزيع كميات أو اختيار مخزن واحد.'),\n    ('الهضبة والحياة', 'النص التالف ظاهر كما خرج من القارئ، حتى يمكن رؤية المشكلة قبل إصلاحها.'),\n    ('العمرو', 'عمود الكمية في طلبية التوريد محفوظ بمعناه الأصلي؛ لم أحوله إلى رصيد مخزن.'),\n    ('أمثلة المطابقة', 'أمثلة مقروءة من البيانات لشرح اختلاف الكتابة والمواصفات؛ ليست ناتج تشغيل آلي شامل.'),\n]: intro.append(row)\n\nsource = load_workbook(BASE / '0913.xlsx', data_only=True)['ورقة2']\nrequests = wb.create_sheet('النواقص الأصلية')\nrequests.append(['صف المصدر', 'اسم العميل', 'اسم الصنف', 'التاريخ', 'الكمية المطلوبة كما المصدر'])\nfor n in range(7, 1000):\n    values = [source.cell(n, c).value for c in range(1, 5)]\n    requests.append([n, *values])\n    requests.cell(requests.max_row, 4).number_format = 'yyyy-mm-dd'\n\nlabels = {1:'السلام - استخراج', 2:'المكرومي - استخراج', 3:'الهضبة - نص تالف', 4:'العمرو - طلبية', 5:'كيور - استخراج', 6:'الحياة - نص متقطع'}\nnumeric = r'([0-9]+(?:\\.[0-9