{"step_index":8083,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-24T17:15:16Z","tool_calls":[{"name":"write_to_file","args":{"ArtifactMetadata":{"RequestFeedback":false,"Summary":"Verification script for batch size 50 and chunking verification","UserFacing":false},"CodeContent":"\"\"\"\nTest script to verify batch size 50 in FastCoordinator and MSEMAX Gateway.\n\"\"\"\nimport json\nimport time\nimport requests\nimport sys\nimport openpyxl\n\n# Ensure Pharmacy is in python path\nsys.path.insert(0, r\"D:\\AI_Engineer\\Pharmacy-agy\")\nfrom src.fast_match.coordinator import FastCoordinator, SYSTEM_PROMPT\nfrom src.config import Config\n\nAPI_URL = \"http://127.0.0.1:8001/v1/chat/completions\"\nAPI_KEY = \"[REDACTED_CREDENTIAL]\"\n\ndef main():\n    print(\"=\" * 80)\n    print(\"VERIFYING BATCH SIZE 50 IN PHARMACY MATCHER & MSEMAX GATEWAY\")\n    print(\"=\" * 80)\n\n    # 1. Health check\n    h = requests.get(\"http://127.0.0.1:8001/health\", timeout=5).json()\n    print(f\"[✓] Gateway: {h.get('gateway')}\")\n    print(f\"[✓] Active Model: {h.get('active_model')[:30]}... (Verified: {h.get('model_verified')})\")\n    print(f\"[✓] Thinking Mode: {h.get('active_thinking')} (Verified: {h.get('thinking_verified')})\")\n    print(f\"[✓] Clear Chat On Request: {h.get('clear_chat_on_request')}\")\n\n    # 2. Build 5 canonical test cases covering core business rules\n    test_cases = [\n        {\n            \"case_id\": \"TEST-01-STRENGTH\",\n            \"requested_name\": \"نوفاكس 250 مجم 20 قرص\",\n            \"catalog_id\": \"W1\",\n            \"candidates\": [{\"id\": \"W1-001\", \"name\": \"نوفاكس 500 مجم 20 قرص\"}]\n        },\n        {\n            \"case_id\": \"TEST-02-DOSAGE-FORM\",\n            \"requested_name\": \"بيتاديرم مرهم 15 جم\",\n            \"catalog_id\": \"W1\",\n            \"candidates\": [{\"id\": \"W1-002\", \"name\": \"بيتاديرم كريم 15 جم\"}]\n        },\n        {\n            \"case_id\": \"TEST-03-PACK-SIZE\",\n            \"requested_name\": \"دوليبران 1000 مجم 15 قرص\",\n            \"catalog_id\": \"W1\",\n            \"candidates\": [{\"id\": \"W1-003\", \"name\": \"دوليبران 1 جم 60 قرص\"}]\n        },\n        {\n            \"case_id\": \"TEST-04-OCR-CORRUPTION\",\n            \"requested_name\": \"فورسيجا 10 مجم أقراص\",\n            \"catalog_id\": \"W1\",\n            \"candidates\": [{\"id\": \"W1-004\", \"name\": \"فورسجا 10 مجم أقراص\"}]\n        },\n        {\n            \"case_id\": \"TEST-05-GENERIC-ALT\",\n            \"requested_name\": \"بنادول 500 مجم أقراص\",\n            \"catalog_id\": \"W1\",\n            \"candidates\": [{\"id\": \"W1-005\", \"name\": \"سيتال 500 مجم أقراص\"}]\n        }\n    ]\n\n    # Replicate exactly 50 cases (10 replicates of 5 canonical rules)\n    cases_50 = []\n    for i in range(10):\n        for idx, base in enumerate(test_cases):\n            cid = f\"TEST-{i*5 + idx + 1:02d}\"\n            c = dict(base)\n            c[\"case_id\"] = cid\n            cases_50.append(c)\n\n    assert len(cases_50) == 50, f\"Expected 50 cases, got {len(cases_50)}\"\n    print(f\"\\n[+] Built exactly 50-case batch (10 replicates of 5 canonical rules).\")\n\n    # 3. Call Pharmacy Coordinator\n    cfg = Config(unstructured_api_key=\"dummy\", gemini_api_key=\"dummy\")\n    cfg.local_api_url = API_URL\n    cfg.local_api_key = API_KEY\n    cfg.local_model = \"gemini-3.8-flash\"\n    coord = FastCoordinator(cfg)\n\n    print(f\"\\n[*] Dispatching 50 cases to MSEMAX Gateway...\")\n    t0 = time.time()\n    try:\n        results = coord._call_local_api({\"cases\": cases_50})\n        dur = time.time() - t0\n        print(f\"\\n[✓] SUCCESS: Coordinator received response in {dur:.2f}s!\")\n        print(f\"    - Results count: {len(results)}\")\n        print(f\"    - Raw response length: {len(coord.last_raw_response)} characters\")\n        \n        # Verify all 50 case_ids are returned\n        returned_ids = {r.get(\"case_id\") for r in results}\n        expected_ids = {c[\"case_id\"] for c in cases_50}\n        missing = expected_ids - returned_ids\n        print(f\"    - Returned Case IDs: {len(returned_ids)} / 50\")\n        if missing:\n            print(f\"    [!] Missing case IDs: {missing}\")\n            sys.exit(1)\n        else:\n            print(f\"    [✓] EXACT MATCH: All 50 case IDs returned successfully!\")\n\n        # Check compliance with canonical rules across the batch\n        strength_decisions = [r for r in results if int(r.get(\"case_id\", \"\").split(\"-\")[1]) % 5 == 1]\n        dosage_decisions = [r for r in results if int(r.get(\"case_id\", \"\").split(\"-\")[1]) % 5 == 2]\n        pack_decisions = [r for r in results if int(r.get(\"case_id\", \"\").split(\"-\")[1]) % 5 == 3]\n        ocr_decisions = [r for r in results if int(r.get(\"case_id\", \"\").split(\"-\")[1]) % 5 == 4]\n        generic_decisions = [r for r in results if int(r.get(\"case_id\", \"\").split(\"-\")[1]) % 5 == 0]\n\n        print(f\"\\n[✓] Rule Compliance Verification across 50 cases:\")\n        str_ok = all(r.get('status') == 'no_match' for r in strength_decisions)\n        dos_ok = all(r.get('status') == 'review' for r in dosage_decisions)\n        pck_ok = all(r.get('status') == 'match' for r in pack_decisions)\n        ocr_ok = all(r.get('status') == 'match' for r in ocr_decisions)\n        gen_ok = all(r.get('status') == 'no_match' for r in generic_decisions)\n\n        print(f\"    - Strength mismatch -> no_match: {str_ok} ({len(strength_decisions)} cases)\")\n        print(f\"    - Dosage form diff  -> review:   {dos_ok} ({len(dosage_decisions)} cases)\")\n        print(f\"    - Pack size diff    -> match:    {pck_ok} ({len(pack_decisions)} cases)\")\n        print(f\"    - OCR corruption    -> match:    {ocr_ok} ({len(ocr_decisions)} cases)\")\n        print(f\"    - Generic / diff brand -> no_match: {gen_ok} ({len(generic_decisions)} cases)\")\n\n        assert str_ok and dos_ok and pck_ok and ocr_ok and gen_ok, \"Some rule compliance checks failed!\"\n        print(\"\\n[✓] ALL 50 CASES FULLY VALIDATED AND COMPLIANT!\")\n\n    except Exception as e:\n        print(f\"\\n[X] FAILURE in Batch 50 test: {e}\")\n        import traceback\n        traceback.print_exc()\n        sys.exit(1)\n\n    # 4. Verify batch chunking logic in FastCoordinator (105 items should be 3 batches: 50, 50, 5)\n    print(\"\\n\" + \"=\" * 80)\n    print(\"VERIFYING FAST_COORDINATOR BATCH CHUNKING LOGIC\")\n    print(\"=\" * 80)\n    dummy_cases = [{\"requested_name\": f\"Item {i}\", \"candidates\": []} for i in range(105)]\n    batch_size = 50\n    batches = [dummy_cases[i:i + batch_size] for i in range(0, len(dummy_cases), batch_size)]\n    print(f\"Total dummy items: {len(dummy_cases)}\")\n    print(f\"Calculated batches count: {len(batches)}\")\n    for i, b in enumerate(batches):\n        print(f\"  - Batch {i+1}: {len(b)} items\")\n    assert len(batches) == 3 and len(batches[0]) == 50 and len(batches[1]) == 50 and len(batches[2]) == 5\n    print(\"[✓] Batch chunking arithmetic for 50 items verified successfully!\")\n\nif __name__ == \"__main__\":\n    main()\n","Description":"Update verification script to test 50-case batch and verify batch chunking logic","Overwrite":true,"TargetFile":"C:\\Users\\kakak\\.gemini\\antigravity\\brain\\916274de-7f92-49fc-a0a8-d291664b474a\\scratch\\verify_large_batch_timing.py","toolAction":"Updating verify_large_batch_timing.py","toolSummary":"Update verification script for batch 50"}}]}
