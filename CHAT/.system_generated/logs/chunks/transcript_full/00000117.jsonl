nt += 1\r\n307:             else:\r\n308:                 top_candidates = finder.search(shortage_name, top_k=6)\r\n309:                 if not top_candidates:\r\n310:                     continue\r\n311:                     \r\n312:                 best_score = top_candidates[0][\"score\"]\r\n313:                 best_name = top_candidates[0][\"name\"]\r\n314:                 \r\n315:                 # Level 2: Deterministic High-Confidence Auto-Match\r\n316:                 is_auto, _ = is_safe_auto_match(shortage_name, best_name)\r\n317:                         \r\n318:                 if is_auto:\r\n319:                     matched.append({\r\n320:                         \"shortage_item\": shortage_name,\r\n321:                         \"warehouse_item\": best_name,\r\n322:                         \"confidence\": f\"high ({best_score:.2f})\",\r\n323:                         \"method\": \"auto_rule\"\r\n324:                     })\r\n325:                     auto_match_count += 1\r\n326:                 else:\r\n327:                     # Level 3: Ambiguous items sent to LLM with top 5 candidates\r\n328:                     candidates_for_llm = [{\"id\": c[\"id\"], \"name\": c[\"name\"]} for c in top_candidates[:5]]\r\n329:                     llm_cases.append({\r\n330:                         \"case_id\": f\"Q{idx:05}\",\r\n331:                         \"requested_name\": shortage_name,\r\n332:                         \"candidates\": candidates_for_llm\r\n333:                     })\r\n334:                     candidates_by_shortage[shortage_name] = top_candidates\r\n335: \r\n336:         print(f\"  -> Exact Matches: {exact_count}\")\r\n337:         print(f\"  -> Deterministic Auto-Matches: {auto_match_count}\")\r\n338:         \r\n339:         # 3. Process via LLM in large optimal chunks (75 items per message)\r\n340:         if llm_cases and hasattr(self.config, 'local_api_url'):\r\n341:             batch_size = 75\r\n342:             batches = [llm_cases[i:i + batch_size] for i in range(0, len(llm_cases), batch_size)]\r\n343:             print(f\"  -> Sending {len(llm_cases)} ambiguous items to Local API (MSEMAX) in {len(batches)} large batch(es) (Max ~75 items/msg)...\")\r\n344:             \r\n345:             def process_chunk(cases_chunk, chunk_name):\r\n346:                 max_retries = 3\r\n347:                 for attempt in range(max_retries):\r\n348:                     try:\r\n349:                         time.sleep(2)\r\n350:                         raw_results = self._call_local_api({\"cases\": cases_chunk})\r\n351:                         parsed = []\r\n352:                         matched_in_chunk = 0\r\n353:                         review_in_chunk = 0\r\n354:                         for case, decision in zip(cases_chunk, raw_results):\r\n355:                             shortage_name = case[\"requested_name\"]\r\n356:                             status = decision.get(\"status\", \"no_match\")\r\n357:                             item_id = decision.get(\"item_id\", \"\")\r\n358:                             warehouse_item = catalog_by_id.get(item_id, \"\")\r\n359:                             reason = decision.get(\"reason\", \"\")\r\n360:                             \r\n361:                             if status in (\"match\", \"review\") and not warehouse_item:\r\n362:                                 if case.get(\"candidates\"):\r\n363:                                     warehouse_item = case[\"candidates\"][0][\"name\"]\r\n364:                                 else:\r\n365:                                     status = \"no_match\"\r\n366:                                     \r\n367:                             if status in (\"match\", \"review\"):\r\n368:                                 # 1. Dosage form conflict\r\n369:                                 req_form = extract_form_group(shortage_name)\r\n370:                                 wh_form = extract_form_group(warehouse_item)\r\nThe above content does