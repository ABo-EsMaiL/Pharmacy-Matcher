f\" \\\n92:           -o parse.json\n93: \n94:         PARSE_ID=$(jq -er '.id' parse.json)\n95:         jq -n --arg id \"$PARSE_ID\" '{\n96:           parse_id: $id,\n97:           schema: {\n98:             type: \"object\",\n99:             properties: {invoice_number: {type: \"string\"}},\n100:             required: [\"invoice_number\"],\n101:             additionalProperties: false\n102:           }\n103:         }' > extract-request.json\n104: \n105:         curl --fail-with-body -sS \\\n106:           https://transform.unstructured.io/api/v2/extract \\\n107:           -H \"unstructured-api-key: $UNSTRUCTURED_API_KEY\" \\\n108:           -H \"Content-Type: application/json\" \\\n109:           --data-binary @extract-request.json \\\n110:           -o extract.json\n111:         cat extract.json\n112:         ```\n113:       </Tab>\n114:     </Tabs>\n115:   </Tab>\n116: \n117:   <Tab title=\"Asynchronous\">\n118:     Use this path when Parse should return before processing finishes. Each example submits Parse asynchronously, polls until it completes, then sends the completed Parse result ID to a blocking Extract request.\n119: \n120:     <Tabs>\n121:       <Tab title=\"Python\">\n122:         ```python wrap theme={null}\n123:         import time\n124: \n125:         from unstructured_transform_client import TransformClient\n126: \n127:         schema = {\n128:             \"type\": \"object\",\n129:             \"properties\": {\"invoice_number\": {\"type\": \"string\"}},\n130:             \"required\": [\"invoice_number\"],\n131:             \"additionalProperties\": False,\n132:         }\n133: \n134:         with TransformClient() as client:\n135:             accepted = client.parse.run(input=\"document.pdf\", wait_seconds=0)\n136:             job = client.jobs.get(accepted.id)\n137:             while job.status in (\"queued\", \"processing\"):\n138:                 time.sleep(2)\n139:                 job = client.jobs.get(accepted.id)\n140:             if job.status not in (\"completed\", \"completed_with_warnings\"):\n141:                 raise RuntimeError(job.error)\n142: \n143:             extraction = client.extract.run(parse_id=job.result.id, schema=schema)\n144:             print(extraction.extracted_data)\n145:         ```\n146:       </Tab>\n147: \n148:       <Tab title=\"TypeScript\">\n149:         ```typescript wrap theme={null}\n150:         import { readFile } from \"node:fs/promises\";\n151:         import { TransformClient } from \"unstructured-transform-client\";\n152: \n153:         const client = new TransformClient();\n154:         const schema = {\n155:           type: \"object\",\n156:           properties: { invoice_number: { type: \"string\" } },\n157:           required: [\"invoice_number\"],\n158:           additionalProperties: false,\n159:         };\n160:         const file = new File([await readFile(\"document.pdf\")], \"document.pdf\");\n161:         const accepted = await client.parse.run({ input: file, waitSeconds: 0 });\n162:         if (accepted.status !== 202) throw new Error(\"Parse did not return a job handle\");\n163: \n164:         let job = await client.jobs.get(accepted.body.id);\n165:         while (job.status === \"queued\" || job.status === \"processing\") {\n166:           await new Promise((resolve) => setTimeout(resolve, 2000));\n167:           job = await client.jobs.get(accepted.body.id);\n168:         }\n169:         if (job.status !== \"completed\" && job.status !== \"completed_with_warnings\") {\n170:           throw new Error(`Parse stopped: ${job.status}`);\n171:         }\n172:         if (!job.result) throw new Error(\"Parse completed without a result\");\n173: \n174:         const extraction = await client.extract.run({\n175:           parseId: job.result.id,\n176:           schema,\n177:         });\n178:         if (extraction.status !== 200) throw new Error(\"Extract did not complete\");\n179:         console.log(extraction.body.extractedData);\n180:         ```\n181:       </Tab>\n182: \n183:       <Tab title=\"cURL\">\n184:         ```bash wrap theme={null}\n185:         # Run in zsh. This example requires jq.\n186:         API_BASE_URL=\"https://transform.unstructured.io\"\n187:         curl --fail-with-body -sS \\\n188:           \"$API_BASE_URL/api/v2/parse\" \\\n189:           -H \"unstructured-api-key: $UNSTRUCTURED_API_KEY\" \\\n190:           -H \"Prefer: wait=0\" \\\n191:           -D parse-headers.txt \\\n192:           -F \"input=@document.pdf\" \\\n193:           -o parse-accepted.json\n194: \n195:         POLL_PATH=$(awk 'tolower($1) == \"location:\" {sub(/\\r$/, \"\", $2); print $2; exit}' parse-headers.txt)\n196:         POLL_URL=\"${API_BASE_URL}${POLL_PATH}\"\n197:         while :; do\n198:           curl --fail-with-body -sS \\\n199:             \"$POLL_URL\" \\\n200:             -H \"unstructured-api-key: $UNSTRUCTURED_API_KEY\" \\\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
