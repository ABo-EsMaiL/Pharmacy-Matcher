= 'processing') viewProcess(item.id); };\n            \n            card.innerHTML = `\n                <div class=\"history-info\">\n                    <div class=\"history-header\">\n                        <h4>العملية ${item.id.substring(0,8)}...</h4>\n                        <span class=\"badge-status ${statusClass}\">${statusText}</span>\n                    </div>\n                    <div class=\"history-date\"><i class=\"ph ph-calendar\"></i> ${date}</div>\n                    <div class=\"history-files\">\n                        <span><i class=\"ph-fill ph-files\"></i> ${JSON.parse(item.shortage_files || '[]').length} نواقص</span>\n                        <span><i class=\"ph-fill ph-folders\"></i> ${JSON.parse(item.warehouse_files || '[]').length} مخازن</span>\n                    </div>\n                </div>\n                <div class=\"history-actions\">\n                    <button class=\"btn btn-icon text-danger\" onclick=\"event.stopPropagation(); deleteProcess('${item.id}')\">\n                        <i class=\"ph ph-trash\"></i>\n                    </button>\n                </div>\n            `;\n            listEl.appendChild(card);\n        });\n    } catch (e) {\n        console.error(e);\n        listEl.innerHTML = '<div class=\"empty-state text-danger\"><i class=\"ph-fill ph-warning\"></i><p>خطأ في جلب السجل</p></div>';\n    }\n}","StartLine":1371,"TargetContent":"// --- History Logic ---\nasync function loadHistory() {\n    const listEl = document.getElementById('history-list');\n    listEl.innerHTML = '<div class=\"spinner\"></div>';\n    \n    try {\n        const historyStr = await window.pywebview.api.get_history();\n        const history = JSON.parse(historyStr);\n        \n        if (!history || history.length === 0) {\n            listEl.innerHTML = '<div class=\"empty-state\"><i class=\"ph-fill ph-empty\"></i><p>لا توجد عمليات سابقة مسجلة.</p></div>';\n            return;\n        }\n        \n        listEl.innerHTML = '';\n