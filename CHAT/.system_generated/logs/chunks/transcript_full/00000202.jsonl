{"step_index":9819,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-25T13:24:54Z","content":"Created At: 2026-09-25T16:24:54+03:00\nCompleted At: 2026-09-25T16:24:54+03:00\nFile Path: `file:///d:/AI_Engineer/Pharmacy-agy/src/extract/pdf_reader.py`\nTotal Lines: 394\nTotal Bytes: 17945\nShowing lines 1 to 100\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"\"\"\n2: PDF extraction module using Unstructured Transform Client.\n3: Handles direct single-step extraction, server-side caching, and local caching.\n4: \"\"\"\n5: \n6: from pathlib import Path\n7: import json\n8: import hashlib\n9: import time\n10: \n11: def _get_file_hash(filepath: Path) -> str:\n12:     hasher = hashlib.md5()\n13:     with open(filepath, 'rb') as f:\n14:         buf = f.read(65536)\n15:         while len(buf) > 0:\n16:             hasher.update(buf)\n17:             buf = f.read(65536)\n18:     return hasher.hexdigest()\n19: \n20: def extract_items_from_pdf(\n21:     filepath: Path,\n22:     api_key: str,\n23:     base_url: str = \"https://transform.unstructured.io\",\n24:     gemini_api_key: str = None,\n25:     profile: str = \"balanced\",\n26: ) -> list[dict]:\n27:     \"\"\"\n28:     Extract drug product items from PDF using Unstructured API.\n29:     Checks local cache first, then existing server jobs, and finally uploads if new.\n30:     \"\"\"\n31:     filepath = Path(filepath)\n32:     if not filepath.exists():\n33:         raise FileNotFoundError(f\"PDF file not found: {filepath}\")\n34: \n35:     print(f\"[*] Processing PDF file: {filepath.name}\")\n36: \n37:     # 0. Alongside JSON Check (Instant load from previous runs)\n38:     alongside_json = filepath.with_suffix('.json')\n39:     if alongside_json.exists():\n40:         try:\n41:             with open(alongside_json, \"r\", encoding=\"utf-8\") as f:\n42:                 result_data = json.load(f)\n43:             cached_items = parse_structured_result(result_data, filepath.name)\n44:             if len(cached_items) > 0:\n45:                 print(f\"[+] Loaded {len(cached_items)} items from alongside JSON: {alongside_json.name}\")\n46:                 return cached_items\n47:         except Exception as e:\n48:             print(f\"[*] Could not read alongside JSON: {e}\")\n49: \n50:     # 1. Local Cache Check\n51:     file_hash = _get_file_hash(filepath)\n52:     cache_dir = filepath.parent.parent.parent / 'data' / '.unstructured_cache'\n53:     cache_dir.mkdir(parents=True, exist_ok=True)\n54:     cache_file = cache_dir / f\"{file_hash}_extract.json\"\n55:     \n56:     if cache_file.exists():\n57:         try:\n58:             with open(cache_file, \"r\", encoding=\"utf-8\") as f:\n59:                 result_data = json.load(f)\n60:             cached_items = parse_structured_result(result_data, filepath.name)\n61:             if len(cached_items) > 0:\n62:                 print(f\"[+] Loaded {len(cached_items)} items from local cache: {filepath.name}\")\n63:                 return cached_items\n64:             else:\n65:                 print(f\"[*] Local cache has 0 items for {filepath.name}. Checking server...\")\n66:         except Exception:\n67:             print(f\"[*] Local cache invalid for {filepath.name}. Checking server...\")\n68: \n69:     try:\n70:         from unstructured_transform_client import TransformClient\n71:     except ImportError:\n72:         print(\"⚠️ unstructured-transform-client not found. Please install it:\")\n73:         print(\"pip install unstructured-transform-client\")\n74:         raise RuntimeError(\"unstructured-transform-client is required to process PDFs\")\n75: \n76:     client = TransformClient(\n77:         api_key=api_key,\n78:         server_url=base_url,\n79:     )\n80: \n81:     schema = {\n82:         \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n83:         \"title\": \"Supplier Product Names\",\n84:         \"description\": \"Extract product entries from all pages as source data only. Return one entry per source product row, preserving duplicates and different strengths. Include products even when price or quantity is blank or zero. Copy names faithfully without spelling repair or inferred digits. Do not infer stock, requested quantities or shortage matches.\",\n85:         \"type\": \"object\",\n86:         \"properties\": {\n87:             \"items\": {\n88:                 \"type\": \"array\",\n89:                 \"description\": \"Every product entry from every page, in document order. Keep repeated entries. Exclude document headers, footers, contact details, column labels and totals.\",\n90:                 \"items\": {\n91:                     \"type\": \"object\",\n92:                     \"properties\": {\n93:                         \"item_name_raw\": {\n94:                             \"type\": \"string\",\n95:                             \"description\": \"Copy the complete product name/description exactly as present in the source, preserving Arabic, English, mixed text, spelling, strengths, units, dosage form, pack numbers, punctuation and manufacturer text. Do not correct, translate or complete it. Exclude values belonging to separate price, discount or quantity columns, but retain numbers written inside the name itself.\",\n96:                         },\n97:                         \"source_page\": {\n98:                             \"type\": [\n99:                                 \"integer\",\n100:                                 \"null\",\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
