{"step_index":5913,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-24T00:46:02Z","tool_calls":[{"name":"replace_file_content","args":{"AllowMultiple":false,"Description":"Replace server_manager.py with MultiServerManager supporting both ChatGPT and Google AI Studio with live status, testing, and switching","EndLine":141,"Instruction":"Upgrade server_manager to MultiServerManager","ReplacementContent":"\"\"\"\nMulti-Server Manager for Pharmacy Matcher.\nSupports dual local AI servers:\n1. MSEMAX ChatGPT (OpenAI Web Hook) on Port 8000\n2. MSEMAX Google AI Studio (Gemini Web Hook) on Port 8001\n\nProvides start, stop, test (live latency & ping), session login, and 1-click active switching.\n\"\"\"\n\nimport subprocess\nimport os\nimport signal\nimport time\nimport sys\nimport threading\nimport socket\nfrom pathlib import Path\nimport requests\n\nDEFAULT_SERVERS = {\n    \"chatgpt\": {\n        \"name\": \"MSEMAX (ChatGPT / OpenAI)\",\n        \"default_dir\": r\"D:\\AI_Engineer\\MSEMAX\",\n        \"port\": 8000,\n        \"default_model\": \"gpt-4o\",\n        \"url\": \"http://127.0.0.1:8000/v1/chat/completions\",\n        \"api_key\": \"[REDACTED_CREDENTIAL]\"\n    },\n    \"gaistudio\": {\n        \"name\": \"MSEMAX (Google AI Studio)\",\n        \"default_dir\": r\"D:\\AI_Engineer\\MSEMAX-GAIStudio\",\n        \"port\": 8001,\n        \"default_model\": \"gemini-3.8-flash\",\n        \"url\": \"http://127.0.0.1:8001/v1/chat/completions\",\n        \"api_key\": \"[REDACTED_CREDENTIAL]\"\n    }\n}\n\ndef is_port_listening(port: int, host: str = \"127.0.0.1\", timeout: float = 0.5) -> bool:\n    try:\n        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:\n            s.settimeout(timeout)\n            return s.connect_ex((host, port)) == 0\n    except Exception:\n        return False\n\nclass ServerInstance:\n    def __init__(self, key: str, config: dict, logger_callback=None):\n        self.key = key\n        self.name = config.get(\"name\", key)\n        self.dir = config.get(\"dir\", config.get(\"default_dir\", \"\"))\n        self.port = int(config.get(\"port\", 8000))\n        self.default_model = config.get(\"default_model\", \"gpt-4o\")\n        self.url = config.get(\"url\", f\"http://127.0.0.1:{self.port}/v1/chat/completions\")\n        self.api_key = config.get(\"api_key\", \"[REDACTED_CREDENTIAL]\")\n        self.process = None\n        self.logger = logger_callback\n\n    def log(self, message: str):\n        prefix = f\"[{self.name}]\"\n        if self.logger:\n            self.logger(f\"{prefix} {message}\")\n        else:\n            print(f\"{prefix} {message}\")\n\n    def is_running(self) -> bool:\n        if self.process is not None and self.process.poll() is None:\n            return True\n        return is_port_listening(self.port)\n\n    def _read_output(self, pipe):\n        try:\n            for line in iter(pipe.readline, ''):\n                if line:\n                    self.log(line.strip())\n        except Exception:\n            pass\n        finally:\n            pipe.close()\n\n    def start(self) -> dict:\n        if self.is_running():\n            self.log(f\"Server is already running on port {self.port}.\")\n            return {\"success\": True, \"message\": \"already running\", \"port\": self.port}\n\n        target_dir = Path(self.dir)\n        if not target_dir.exists():\n            self.log(f\"Error: Directory not found: {self.dir}\")\n            return {\"success\": False, \"message\": f\"Directory not found: {self.dir}\"}\n\n        app_script = target_dir / \"app.py\"\n        if not app_script.exists():\n            self.log(f\"Error: app.py not found in {self.dir}\")\n            return {\"success\": False, \"message\": f\"app.py not found in {self.dir}\"}\n\n        try:\n            creationflags = 0\n            if os.name == 'nt':\n                creationflags = subprocess.CREATE_NO_WINDOW\n\n            self.log(f\"Starting server in {self.dir} on port {self.port}...\")\n            self.process = subprocess.Popen(\n                [sys.executable, \"app.py\"],\n                cwd=str(target_dir),\n                creationflags=creationflags,\n                stdout=subprocess.PIPE,\n                stderr=subprocess.STDOUT,\n                text=True,\n                bufsize=1\n            )\n\n            t = threading.Thread(target=self._read_output, args=(self.process.stdout,), daemon=True)\n            t.start()\n\n            # Brief check for early crash\n            time.sleep(1.5)\n            if self.process.poll() is not None:\n                return {\"success\": False, \"message\": f\"Process exited early with code {self.process.returncode}\"}\n\n            self.log(f\"Server process started successfully (PID: {self.process.pid}).\")\n            return {\"success\": True, \"message\": \"started\", \"pid\": self.process.pid, \"port\": self.port}\n        except Exception as e:\n            self.log(f\"Failed to start server: {e}\")\n            return {\"success\": False, \"message\": str(e)}\n\n    def stop(self) -> dict:\n        try:\n            self.log(\"Stopping server...\")\n            if self.process is not None:\n                if os.name == 'nt':\n                    subprocess.run(['taskkill', '/F', '/T', '/PID', str(self.process.pid)], capture_output=True)\n                else:\n                    os.killpg(os.getpgid(self.process.pid), signal.SIGTERM)\n                self.process = None\n\n            # If port is still listening by another orphaned instance, try to find and terminate it\n            if is_port_listening(self.port) and os.name == 'nt':\n                try:\n                    res = subprocess.run(\n                        f'netstat -ano | findstr \":{self.port} \"',\n                        shell=True, capture_output=True, text=True\n                    )\n                    for line in res.stdout.strip().splitlines():\n                        parts = line.strip().split()\n                        if len(parts) >= 5 and \"LISTENING\" in line:\n                            pid = parts[-1]\n                            subprocess.run(['taskkill', '/F', '/PID', pid], capture_output=True)\n                except Exception:\n                    pass\n\n            self.log(\"Server stopped.\")\n            return {\"success\": True, \"message\": \"stopped\"}\n        except Exception as e:\n            self.log(f\"Failed to stop server: {e}\")\n            return {\"success\": False, \"message\": str(e)}\n\n    def test(self) -> dict:\n        \"\"\"Sends a test ping to the server to check connectivity and response time.\"\"\"\n        t0 = time.time()\n        try:\n            # First check health endpoint\n            health_url = f\"http://127.0.0.1:{self.port}/health\"\n            health_info = {}\n            try:\n                r_h = requests.get(health_url, timeout=3)\n                if r_h.status_code == 200:\n                    health_info = r_h.json()\n            except Exception:\n                pass\n\n            # Next, test chat completions\n            payload = {\n                \"model\": self.default_model,\n                \"messages\": [\n                    {\"role\": \"user\", \"content\": \"Reply with only the exact word: PONG\"}\n                ],\n                \"stream\": False\n            }\n            r = requests.post(\n                self.url,\n                headers={\n                    \"Authorization\": f\"Bearer {self.api_key}\",\n                    \"Content-Type\": \"application/json\"\n                },\n                json=payload,\n                timeout=25\n            )\n            elapsed_ms = int((time.time() - t0) * 1000)\n\n            if r.status_code == 200:\n                resp = r.json()\n                reply = resp.get(\"choices\", [{}])[0].get(\"message\", {}).get(\"content\", \"\").strip()\n                return {\n                    \"success\": True,\n                    \"latency_ms\": elapsed_ms,\n                    \"reply\": reply,\n                    \"model\": self.default_model,\n                    \"port\": self.port,\n                    \"health\": health_info\n                }\n            else:\n                return {\n                    \"success\": False,\n                    \"latency_ms\": elapsed_ms,\n                    \"error\": f\"HTTP {r.status_code}: {r.text[:200]}\",\n                    \"port\": self.port\n                }\n        except Exception as e:\n            elapsed_ms = int((time.time() - t0) * 1000)\n            return {\n                \"success\": False,\n                \"latency_ms\": elapsed_ms,\n                \"error\": str(e),\n                \"port\": self.port\n            }\n\n    def run_get_session(self) -> dict:\n        try:\n            self.log(\"Launching get_session.py...\")\n            creationflags = 0\n            if os.name == 'nt':\n                creationflags = subprocess.CREATE_NEW_CONSOLE\n\n            script_file = Path(self.dir) / \"get_session.py\"\n            if not script_file.exists():\n                return {\"success\": False, \"output\": f\"get_session.py not found in {self.dir}\"}\n\n            subprocess.Popen(\n                [sys.executable, \"get_session.py\"],\n                cwd=str(self.dir),\n                creationflags=creationflags\n            )\n            return {\"success\": True, \"output\": f\"Session browser opened for {self.name}.\"}\n        except Exception as e:\n            self.log(f\"Failed to launch session: {e}\")\n            return {\"success\": False, \"output\": str(e)}\n\n    def get_status(self) -> dict:\n        running = self.is_running()\n        pid = self.process.pid if self.process and self.process.poll() is None else None\n        return {\n            \"key\": self.key,\n            \"name\": self.name,\n            \"running\": running,\n            \"pid\": pid,\n            \"port\": self.port,\n            \"dir\": self.dir,\n            \"model\": self.default_model,\n            \"url\": self.url\n        }\n\nclass MultiServerManager:\n    def __init__(self, settings: dict, logger_callback=None):\n        self.logger = logger_callback\n        self.servers = {}\n\n        # 1. ChatGPT Server configuration\n        c_dir = settings.get(\"msemax_chatgpt_dir\") or settings.get(\"msemax_dir\") or DEFAULT_SERVERS[\"chatgpt\"][\"default_dir\"]\n        c_conf = dict(DEFAULT_SERVERS[\"chatgpt\"])\n        c_conf[\"dir\"] = c_dir\n        self.servers[\"chatgpt\"] = ServerInstance(\"chatgpt\", c_conf, logger_callback=self.logger)\n\n        # 2. Google AI Studio Server configuration\n        g_dir = settings.get(\"msemax_gaistudio_dir\") or DEFAULT_SERVERS[\"gaistudio\"][\"default_dir\"]\n        g_conf = dict(DEFAULT_SERVERS[\"gaistudio\"])\n        g_conf[\"dir\"] = g_dir\n        self.servers[\"gaistudio\"] = ServerInstance(\"gaistudio\", g_conf, logger_callback=self.logger)\n\n    def get_server(self, key: str) -> ServerInstance | None:\n        return self.servers.get(key)\n\n    def get_all_status(self, active_key: str = \"chatgpt\") -> dict:\n        return {\n            k: {**srv.get_status(), \"is_active\": (k == active_key)}\n            for k, srv in self.servers.items()\n        }\n\n    def start(self, key: str = \"chatgpt\") -> dict:\n        srv = self.get_server(key)\n        if srv:\n            return srv.start()\n        return {\"success\": False, \"message\": f\"Server {key} not found\"}\n\n    def stop(self, key: str = \"chatgpt\") -> dict:\n        srv = self.get_server(key)\n        if srv:\n            return srv.stop()\n        return {\"success\": False, \"message\": f\"Server {key} not found\"}\n\n    def is_running(self, key: str = \"chatgpt\") -> bool:\n        srv = self.get_server(key)\n        return srv.is_running() if srv else False\n\n    def test(self, key: str = \"chatgpt\") -> dict:\n        srv = self.get_server(key)\n        if srv:\n            return srv.test()\n        return {\"success\": False, \"error\": f\"Server {key} not found\"}\n\n    def run_get_session(self, key: str = \"chatgpt\") -> dict:\n        srv = self.get_server(key)\n        if srv:\n            return srv.run_get_session()\n        return {\"success\": False, \"output\": f\"Server {key} not found\"}\n\n    def cleanup(self):\n        for srv in self.servers.values():\n            if srv.process is not None:\n                srv.stop()\n\n# Backward compatibility alias\nMSEMAXServerManager = MultiServerManager\n","StartLine":1,"TargetContent":"import subprocess\nimport os\nimport signal\nimport time\nimport sys\nimport threading\nfrom pathlib import Path\n\nclass MSEMAXServerManager:\n    def __init__(self, msemax_dir: str, logger_callback=None):\n        self.msemax_dir = msemax_dir\n        self.process = None\n        self.logger = logger_callback\n\n    def log(self, message):\n        if self.logger:\n            self.logger(message)\n        else:\n            print(message)\n\n    def is_running(self) -> bool:\n        if self.process is None:\n            return False\n        return self.process.poll() is None\n\n    def _read_output(self, pipe, prefix):\n        try:\n            for line in iter(pipe.readline, ''):\n                if line:\n                    self.log(f\"{prefix} {line.strip()}\")\n        except Exception:\n            pass\n        finally:\n            pipe.close()\n\n    def start(self) -> dict:\n        if self.is_running():\n            self.log(\"[SYSTEM] Server is already running.\")\n            return {\"success\": True, \"message\": \"already running\"}\n            \n        try:\n            creationflags = 0\n            if os.name == 'nt':\n                creationflags = subprocess.CREATE_NO_WINDOW\n                \n            self.log(\"[SYSTEM] Starting MSEMAX Server...\")\n            self.process = subprocess.Popen(\n                [sys.executable, \"app.py\"],\n                cwd=self.msemax_dir,\n                creationflags=creationflags,\n                stdout=subprocess.PIPE,\n                stderr=subprocess.STDOUT,\n                text=True,\n                bufsize=1\n            )\n            \n            t = threading.Thread(target=self._read_output, args=(self.process.stdout, \"[SERVER]\"), daemon=True)\n            t.start()\n            \n            self.log(\"[SYSTEM] Server process started successfully.\")\n            return {\"success\": True, \"message\": \"started\"}\n        except Exception as e:\n            self.log(f\"[SYSTEM ERROR] Failed to start server: {str(e)}\")\n            return {\"success\": False, \"message\": str(e)}\n\n    def stop(self) -> dict:\n        if not self.is_running():\n            return {\"success\": True, \"message\": \"not running\"}\n            \n        try:\n            self.log(\"[SYSTEM] Stopping server...\")\n            if os.name == 'nt':\n                subprocess.run(['taskkill', '/F', '/T', '/PID', str(self.process.pid)], capture_output=True)\n            else:\n                os.killpg(os.getpgid(self.process.pid), signal.SIGTERM)\n                \n            self.process = None\n            self.log(\"[SYSTEM] Server stopped.\")\n            return {\"success\": True, \"message\": \"stopped\"}\n        except Exception as e:\n            self.log(f\"[SYSTEM ERROR] Failed to stop server: {str(e)}\")\n            return {\"success\": False, \"message\": str(e)}\n\n    def install_requirements(self) -> dict:\n        try:\n            self.log(\"[SYSTEM] Installing MSEMAX requirements...\")\n            result = subprocess.run(\n                [sys.executable, \"-m\", \"pip\", \"install\", \"-r\", \"requirements.txt\"],\n                cwd=self.msemax_dir,\n                capture_output=True,\n                text=True\n            )\n            out = result.stdout + \"\\n\" + result.stderr\n            self.log(f\"[PIP] {out.strip()}\")\n            return {\"success\": result.returncode == 0, \"output\": out}\n        except Exception as e:\n            self.log(f\"[SYSTEM ERROR] {str(e)}\")\n            return {\"success\": False, \"output\": str(e)}\n\n    def run_get_session(self) -> dict:\n        try:\n            self.log(\"[SYSTEM] Launching get_session.py...\")\n            creationflags = 0\n            if os.name == 'nt':\n                creationflags = subprocess.CREATE_NEW_CONSOLE\n                \n            subprocess.Popen(\n                [sys.executable, \"get_session.py\"],\n                cwd=self.msemax_dir,\n                creationflags=creationflags\n            )\n            return {\"success\": True, \"output\": \"Browser session started. Please complete login.\"}\n        except Exception as e:\n            self.log(f\"[SYSTEM ERROR] {str(e)}\")\n            return {\"success\": False, \"output\": str(e)}\n\n    def install_playwright(self) -> dict:\n        try:\n            self.log(\"[SYSTEM] Installing playwright browsers...\")\n            result = subprocess.run(\n                [sys.executable, \"-m\", \"playwright\", \"install\", \"chromium\"],\n                cwd=self.msemax_dir,\n                capture_output=True,\n                text=True\n            )\n            out = result.stdout + \"\\n\" + result.stderr\n            self.log(f\"[PLAYWRIGHT] {out.strip()}\")\n            return {\"success\": result.returncode == 0, \"output\": out}\n        except Exception as e:\n            self.log(f\"[SYSTEM ERROR] {str(e)}\")\n            return {\"success\": False, \"output\": str(e)}\n\n    def get_status(self) -> dict:\n        return {\n            \"running\": self.is_running(),\n            \"pid\": self.process.pid if self.is_running() else None\n        }\n\n    def cleanup(self):\n        self.stop()","TargetFile":"D:\\AI_Engineer\\Pharmacy-agy\\desktop_app\\server_manager.py","toolAction":"Upda