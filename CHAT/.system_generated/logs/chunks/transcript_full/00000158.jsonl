{"step_index":7568,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-24T16:10:36Z","thinking":"Health check indicates the system is operational. Confirmed that the gateway, version, and necessary components like the browser and session files are in a ready state. The active and default models are specified and verified.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"ArtifactMetadata":{"RequestFeedback":false,"Summary":"Test script for verifying large batch adaptive timeout, 3-state machine, and timing logs in MSEMAX and Pharmacy Coordinator","UserFacing":false},"CodeContent":"\"\"\"\nTest script to verify MSEMAX Adaptive Timeout & Lifecycle State Machine for large batches (75 cases).\n\"\"\"\nimport json\nimport time\nimport requests\nimport sys\n\n# Ensure Pharmacy is in python path\nsys.path.insert(0, r\"D:\\AI_Engineer\\Pharmacy-agy\")\nfrom src.fast_match.coordinator import FastCoordinator, SYSTEM_PROMPT\nfrom src.config import Config\n\nAPI_URL = \"http://127.0.0.1:8001/v1/chat/completions\"\nAPI_KEY = \"[REDACTED_CREDENTIAL]\"\n\ndef main():\n    print(\"=\" * 80)\n    print(\"VERIFYING MSEMAX LARGE BATCH (75 CASES) ADAPTIVE TIMEOUT & STATE MACHINE\")\n    print(\"=\" * 80)\n\n    # 1. Health check\n    h = requests.get(\"http://127.0.0.1:8001/health\", timeout=5).json()\n    print(f\"[✓] Gateway: {h.get('gateway')}\")\n    print(f\"[✓] Active Model: {h.get('active_model')[:30]}... (Verified: {h.get('model_verified')})\")\n    print(f\"[✓] Thinking Mode: {h.get('active_thinking')} (Verified: {h.get('thinking_verified')})\")\n    print(f\"[✓] Clear Chat On Request: {h.get('clear_chat_on_request')}\")\n\n    # 2. Build 5 distinct test cases (simulating a batch)\n    test_cases = [\n        {\n            \"case_id\": \"TEST-01-STRENGTH\",\n            \"requested_name\": \"نوفاكس 250 مجم 20 قرص\",\n            \"catalog_id\": \"W1\",\n            \"candidates\": [{\"id\": \"W1-001\", \"name\": \"نوفاكس 500 مجم 20 قرص\"}]\n        },\n        {\n            \"case_id\": \"TEST-02-DOSAGE-FORM\",\n            \"requested_name\": \"بيتاديرم مرهم 15 جم\",\n            \"catalog_id\": \"W1\",\n            \"candidates\": [{\"id\": \"W1-002\", \"name\": \"بيتاديرم كريم 15 جم\"}]\n        },\n        {\n            \"case_id\": \"TEST-03-PACK-SIZE\",\n            \"requested_name\": \"دوليبران 1000 مجم 15 قرص\",\n            \"catalog_id\": \"W1\",\n            \"candidates\": [{\"id\": \"W1-003\", \"name\": \"دوليبران 1 جم 60 قرص\"}]\n        },\n        {\n            \"case_id\": \"TEST-04-OCR-CORRUPTION\",\n            \"requested_name\": \"فورسيجا 10 مجم أقراص\",\n            \"catalog_id\": \"W1\",\n            \"candidates\": [{\"id\": \"W1-004\", \"name\": \"فورسجا 10 مجم أقراص\"}]\n        },\n        {\n            \"case_id\": \"TEST-05-GENERIC-ALT\",\n            \"requested_name\": \"بنادول 500 مجم أقراص\",\n            \"catalog_id\": \"W1\",\n            \"candidates\": [{\"id\": \"W1-005\", \"name\": \"سيتال 500 مجم أقراص\"}]\n        }\n    ]\n\n    # Replicate up to 75 cases to test true 75-case load!\n    cases_75 = []\n    for i in range(15):\n        for idx, base in enumerate(test_cases):\n            cid = f\"TEST-{i*5 + idx + 1:02d}\"\n            c = dict(base)\n            c[\"case_id\"] = cid\n            cases_75.append(c)\n\n    assert len(cases_75) == 75, f\"Expected 75 cases, got {len(cases_75)}\"\n    print(f\"\\n[+] Built full batch of {len(cases_75)} realistic cases for testing.\")\n\n    # 3. Call Pharmacy Coordinator's _call_local_api\n    cfg = Config()\n    cfg.local_api_url = API_URL\n    cfg.local_api_key = API_KEY\n    cfg.local_model = \"gemini-3.8-flash\"\n    coord = FastCoordinator(cfg)\n\n    print(f\"\\n[*] Dispatching {len(cases_75)} cases to MSEMAX Gateway...\")\n    t0 = time.time()\n    try:\n        results = coord._call_local_api({\"cases\": cases_75})\n        dur = time.time() - t0\n        print(f\"\\n[✓] SUCCESS: Coordinator received response in {dur:.2f}s!\")\n        print(f\"    - Results count: {len(results)}\")\n        print(f\"    - Sample 1: {results[0]}\")\n        print(f\"    - Sample 2: {results[1]}\")\n        print(f\"    - Sample 3: {results[2]}\")\n        print(f\"    - Sample 4: {results[3]}\")\n        print(f\"    - Sample 5: {results[4]}\")\n        \n        # Verify all 75 case_ids are returned\n        returned_ids = {r.get(\"case_id\") for r in results}\n        expected_ids = {c[\"case_id\"] for c in cases_75}\n        missing = expected_ids - returned_ids\n        print(f\"    - Returned Case IDs: {len(returned_ids)} / 75\")\n        if missing:\n            print(f\"    [!] Missing case IDs: {missing}\")\n        else:\n            print(f\"    [✓] EXACT MATCH: All 75 case IDs returned successfully!\")\n\n    except Exception as e:\n        print(f\"\\n[X] FAILURE: {e}\")\n        import traceback\n        traceback.print_exc()\n\nif __name__ == \"__main__\":\n    main()\n","Description":"Create verify_large_batch_timing.py scratch script","Overwrite":true,"TargetFile":"C:\\Users\\kakak\\.gemini\\antigravity\\brain\\916274de-7f92-49fc-a0a8-d291664b474a\\scratch\\verify_large_batch_timing.py","toolAction":"Writing file","toolSummary":"Create scratch script to verify 75-case batch"}}]}
