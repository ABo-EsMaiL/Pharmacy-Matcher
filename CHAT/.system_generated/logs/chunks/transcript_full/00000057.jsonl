 مجم 30 كبسول س ج\", \"ايزوتريتينوين 10 مجم 3 شريط -28\", \"كتالوج عمرو\"),\n    (\"ايزوتريتينوين 20 كبسول\", \"ايزوتريتينوين 20م جديد -50\", \"كتالوج عمرو\"),\n    (\"بانادول اكسترا 24 قرص س ج\", \"بانادول اكسترا 48 قرص-96ب\", \"كتالوج عمرو\"),\n    (\"بانثينول النيل2%كريم وسط\", \"بانثينول كريم كبير سعر قديم باكو 25\", 646),\n    (\"ترايكوفايت 100 مجم اقراص س ج\", \"ترايكوفايت 100مجم 3شريط\", \"كتالوج عمرو\"),\n    (\"رانسيف 500 اقراص س ج\", \"رانسيف 500 مجم قرص جديديد45\", \"كتالوج عمرو\"),\n    (\"ستيمولان 400مجم كبسول س ج\", \"ستيمولان 400مجم كبسول\", \"كتالوج عمرو\"),\n    (\"كليكسان 40 حقن س ج\", \"كليكسان 40مجم-84\", \"كتالوج عمرو\"),\n    (\"لوفير 400 اقراص س ج\", \"لوفير 400 سعر جديد باكو 45\", \"كتالوج عمرو\"),\n    (\"لوفير 800 اقراص س ج\", \"لوفير 800 سعر جديد-باكو25\", \"كتالوج عمرو\"),\n    (\"ليفوفلوكساسين 750 فيال باكو 12 كرتونه 144\", \"ليفوفلوكساسين 750 فيال باكو 12 كرتونه 144\", 150),\n    (\"لبن هيرو بيبي 1 عادي س ج\", \"هيرو 111 عادي جديد -12ب لا يفرط\", \"كتالوج عمرو\"),\n    (\"لبن هيرو بيبي 2 س ج\", \"هيرو 222 نيوترادينس 384\", 568)\n]\n\nfor sh_name, wh_name, src in amr_list:\n    orig = shortages_by_row.get(src, {}) if isinstance(src, int) else {}\n    add_entry({\n        \"client\": orig.get(\"client\", \"ص ايه شكر/الحدين 3\"),\n        \"name\": sh_name,\n        \"date\": orig.get(\"date\", datetime(2026, 9, 13, 0, 0)),\n        \"qty\": orig.get(\"qty\", 1),\n        \"source_0913_row\": src if isinstance(src, int) else \"-\",\n        \"target_warehouse\": \"جملة العمروووو\",\n        \"expected_wh_match\": wh_name,\n        \"type\": \"مطابقة مع مخزن عمرو\"\n    })\n\nprint(f\"Amr items added: {len(audit_entries)}\")\n\n# --- PART 2: Salam items (150 distinct items) ---\nverified_salam = [\n    (7, \"ماريفان3مجم3شريط س ج\", \"ماريفان ١ مجم اقراص\"),\n    (16, \"ميبو مرهم 15جم صغير س ج\", \"ميبو مرهم ٣٠ جم/جلفار\"),\n    (127, \"ديوراسيف  250مجم شراب س ج\", \"ديوراسيف ٥٠٠ شراب/سكويب\"),\n    (154, \"ديكساتوبرين مرهم س ج\", \"ديكساتوبرين مرهم/ايكو\"),\n    (205, \"بيتادين  مطهر النيل 60مل صغير س ج\", \"بيتادين مطهر/النيل\"),\n    (217, \"نيتروماك ريتارد2.5مجم كبسول\", \"نيتروماك ريتارد كبسول\"),\n    (229, \"دوكسي بروكت بلس مرهم س ج\", \"دوكسيروكوت بلس مرهم/ميانفارم\"),\n    (237, \"دوليبران1000مجم 15قرص\", \"دولبران ١٠٠٠ اقراص/ساندوز\"),\n    (321, \"زوفيراكس400مجم اقراص س ج\", \"زوفيراكس ٤٠٠ اقراص/جلاكسو\"),\n    (330, \"ديجستين 20قرص س ج\", \"ديجستين اقراص/فاركو\"),\n    (339, \"ايفاستين اقراص2 شريط س ج\", \"ايفاستين اقراص/كيمافارم\"),\n    (399, \"ادولور 30مجم 3امبول\", \"ادولور - ٣٠جم/٢ مللي امبول\"),\n    (402, \"برايم روز اي اقراص س ج\", \"برايم روز بلاس اقراص/ايفا فارم\"),\n    (450, \"اوجمنتين  457 شراب\", \"اوجمنتين ٦٠٠ اس شراب/المهن\"),\n    (451, \"اوجمنتين  625مجم اقراص\", \"اوجمنتين ١جم اقراص/المهن\"),\n    (490, \"برونشيكم شراب س ج\", \"برونشيكم شراب الكيسير/افنتس\"),\n    (505, \"جوسبرين اقراص 3شريط\", \"جوسبرين اقراص/اجفار\"),\n    (512, \"سيديبروكت كريم س ج\", \"سيدى بركت قمع/سيديكو\"),\n    (531, \"بيتافوس امبول\", \"بيتافوس حقن/ايبيكو\"),\n    (572, \"كلوسول سبراي س ج\", \"كلوسول سبراي/فاركو\"),\n    (593, \"جينوزول كريم س ج\", \"جينوزول ٤٠٠ لبوس/فاركو\"),\n    (611, \"برايم روز بلاس اقراص\", \"برايم روز بلاس اقراص/ايفا فارم\"),\n    (680, \"بيتاديرم مرهم س ج\", \"بيتاديرم كريم كبير\"),\n    (697, \"كيتولاك 5 امبوله\", \"كيتولاك امبول/العامرية\"),\n    (920, \"فاست فلام 50مجم 20قرص س ج\", \"فاست فلام ٥٠ اقراص/فاركو\"),\n    (974, \"سبازموفري امبول\", \"سبازموفري امبول/امون\")\n]\n\nfor r, sh_name, wh_name in verified_salam:\n    orig = shortages_by_row.get(r, {})\n    add_entry({\n        \"client\": orig.get(\"client\", \"ص ايه شكر/الحدين 3\"),\n        \"name\": sh_name,\n        \"date\": orig.get(\"date\", datetime(2026, 9, 13, 0, 0)),\n        \"qty\": orig.get(\"qty\", 1),\n        \"source_0913_row\": r,\n        \"target_warehouse\": \"السلام شبين\",\n        \"expected_wh_match\": wh_name,\n        \"type\": \"مطابقة مع مخزن السلام (حرفياً من 0913)\"\n    })\n\n# Add