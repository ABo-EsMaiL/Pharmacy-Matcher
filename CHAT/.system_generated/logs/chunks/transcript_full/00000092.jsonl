                        \"shortage_item\": result[\"shortage_name\"],\n297:                             \"warehouse_item\": result[\"warehouse_item\"],\n298:                             \"confidence\": \"llm\",\n299:                             \"method\": \"fast_llm\"\n300:                         })\n301:                     elif result[\"status\"] == \"review\":\n302:                         needs_review.append({\n303:                             \"shortage_item\": result[\"shortage_name\"],\n304:                             \"warehouse_item\": result[\"warehouse_item\"],\n305:                             \"reason\": result.get(\"reason\", \"\")\n306:                         })\n307: \n308:         print(f\"  -> Final Warehouse Result: {len(matched)} matched, {len(needs_review)} review\")\n309:         return {\"matched\": matched, \"needs_review\": needs_review}\n310: \n311:     def _call_local_api(self, inputs: dict) -> list[dict]:\n312:         model = getattr(self.config, 'local_model', 'gpt-4o')\n313:         \n314:         body = {\n315:             \"model\": model,\n316:             \"messages\": [\n317:                 {\"role\": \"system\", \"content\": SYSTEM_PROMPT},\n318:                 {\"role\": \"user\", \"content\": json.dumps(inputs, ensure_ascii=False)}\n319:             ]\n320:         }\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
