ElementById('progress-bar-fill').style.width = '5%';\n    startProgressTimer();\n    \n    const termEl = document.getElementById('pipeline-log-terminal');\n    if (termEl) termEl.innerHTML = '[System] Started pipeline...\\n';\n    \n    try {\n        const res = await window.pywebview.api.start_process(\n            JSON.stringify(selectedShortageFiles), \n            JSON.stringify(selectedWarehouseFiles)\n        );\n        if (res.success) {\n            currentProcessId = res.process_id;\n            \n            // If the backend detected an identical exact match that was already completed!\n            if (res.existing) {\n                showToast(t.process_existing, 'info');\n                // Simulate process_complete event\n                setTimeout(() => {\n                    window.dispatchEvent(new CustomEvent('process_complete', {\n                        detail: {\n                            process_id: res.process_id,\n                            success: true,\n                            stats: res.stats\n                        }\n                    }));\n                }, 500);\n            } else {\n                // Background process started\n                showToast(t.toast_started, 'success');\n            }\n        } else {\n            showToast((currentLang === 'en' ? 'Error: ' : 'خطأ: ') + res.error, 'error');\n            btn.classList.remove('hidden');\n            progressModal.style.display = 'none';\n            stopProgressTimer();\n        }\n    } catch (error) {\n        showToast(currentLang === 'en' ? 'Connection error' : 'حدث خطأ أثناء الاتصال', 'error');\n        btn.classList.remove('hidden');\n        progressModal.style.display = 'none';\n        stopProgressTimer();\n    }\n}\n\n// --- Process Events ---\nwindow.addEventListener('process_update', (e) => {\n    const data = e.detail;\n    const progressModal = document.getElementById('progress-modal');\n    if (progressModal && progressModal.style.display === 'flex' && data.process_id === currentProcessId) {\n        const msgEl = document.getElementById('progress-text');\n        \n        if (msgEl && data.message) {\n            msgEl.innerText = data.message;\n        }\n        \n        const pb = document.getElementById('progress-bar-fill');\n        if (pb) {\n            // Very simple heuristic to advance progress bar based on text\n            let pct = 10;\n            if (data.message.includes('استخراج') || data.message.includes('Extracting')) pct = 30;\n            if (data.message.includes('مطابقة') || data.message.includes('Matching')) pct = 60;\n            if (data.message.includes('حفظ') || data.message.includes('Saving')) pct = 90;\n            pb.style.width = pct + '%';\n        }\n    }\n});\n\nwindow.addEventListener('process_complete', (e) => {\n    const data = e.detail;\n    \n    if (data.process_id === currentProcessId) {\n        const btn = document.getElementById('btn-submit');\n        const progressModal = document.getElementById('progress-modal');\n        const t = I18N[currentLang] || I18N.ar;\n        \n        btn.classList.remove('hidden');\n        progressModal.style.display = 'none';\n        stopProgressTimer();\n        \n        if (data.success) {\n            showToast(t.toast_matching_done, 'success');\n            if (data.stats) {\n                loadResults(data.stats);\n            }\n            window.showScreen('screen-results');\n        } else {\n            showToast((currentLang === 'en' ? 'Matching failed: ' : 'فشلت عملية المطابقة: ') + data.error, 'error');\n        }\n    }\n});","StartLine":1722,"TargetContent":"async function submitProcess() {\n    if (selectedShortageFiles.length === 0 || selectedWarehouseFiles.length === 0) {\n        showToast('يرجى اختيار ملف نواقص وملف مخزن واحد على الأقل', 'error');\n        return;\n    }\n    \n    const btn = document.getElementById('btn-submit');\n    const progressModal = document.getElementById('progress-modal');\n    \n    // UI Loading state\n    btn.classList.add('hidden');\n    progressModal.style.display = 'flex';\n    document.getElementById('progress-text').innerText = 'جاري تهيئة العملية...';\n    document.getElementById('progress-bar-fill').style.width = '5%';\n    \n    const termEl = document.getElementById('pipeline-log-terminal');\n    if (termEl) termEl.innerHTML = '[System] Started pipeline...\\n';\n    \n    try {\n        const res = await window.pywebview.api.start_process(\n            JSON.stringify(selectedShortageFiles), \n            JSON.stringify(selectedWarehouseFiles)\n        );\n        if (res.success) {\n            currentProcessId = res.process_id;\n            \n            // If the backend detected an identical exact match that was already completed!\n            if (res.existing) {\n                showToast('هذه العملية مسجلة بالفعل، جاري عرض النتائج...', 'info');\n                // Simulate process_complete event\n                setTimeout(() => {\n                    window.dispatchEvent(new CustomEvent('process_complete', {\n                        detail: {\n                            process_id: res.process_id,\n                            success: true,\n                            stats: res.stats\n                        }\n                    }));\n                }, 500);\n            } else {\n                // Background process started\n                showToast('بدأت العملية بنجاح في الخلفية', 'success');\n            }\n        } else {\n            showToast('خطأ: ' + res.error, 'error');\n            btn.classList.remove('hidden');\n            progressModal.style.display = 'none';\n        }\n    } catch (error) {\n        showToast('حدث خطأ أثناء الاتصال', 'error');\n        btn.classList.remove('hidden');\n        progressModal.style.display = 'none';\n    }\n}\n\n// --- Process Events ---\nwindow.addEventListener('process_update', (e) => {\n    const data = e.detail;\n    const progressModal = document.getElementById('progress-modal');\n    if (progressModal && progressModal.style.display === 'flex' && data.process_id === currentProcessId) {\n        const msgEl = document.getElementById('progress-text');\n        \n        if (msgEl && data.message) {\n            msgEl.innerText = data.message;\n        }\n        \n        const pb = document.getElementById('progress-bar-fill');\n        if (pb) {\n            // Very simple heuristic to advance progress bar based on text\n            let pct = 10;\n            if (data.message.includes('استخراج') || data.message.includes('Extracting')) pct = 30;\n            if (data.message.includes('مطابقة') || data.message.includes('Matching')) pct = 60;\n            if (data.message.includes('حفظ') || data.message.includes('Saving')) pct = 90;\n            pb.style.width = pct + '%';\n        }\n    }\n});\n\nwindow.addEventListener('process_complete', (e) => {\n    const data = e.detail;\n    \n    if (data.process_id === currentProcessId) {\n        const btn = document.getElementById('btn-submit');\n        const progressModal = document.getElementById('progress-modal');\n        \n        btn.classList.remove('hidden');\n        progressModal.style.display = 'none';\n        \n        if (data.success) {\n            showToast('تمت المطابقة بنجاح!', 'success');\n            if (data.stats) {\n                loadResults(data.stats);\n            }\n            window.showScreen('screen-results');\n        } else {\n            showToast('فشلت عملية المطابقة: ' + data.error, 'error');\n        }\n    }\n});","TargetFile":"d:/AI_Engineer/Pharmacy-agy/desktop_app/templates/index.html","toolAction":"Editing file","toolSummary":"Update submitProcess and process events"}}]}
