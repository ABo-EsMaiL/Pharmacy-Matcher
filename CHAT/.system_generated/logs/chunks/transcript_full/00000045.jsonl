) as f:\n124:                             json.dump(job_data, f, ensure_ascii=False, indent=2, default=str)\n125:                         return items\n126:     except Exception as e:\n127:         print(f\"[*] Note: Server job lookup skipped: {e}\")\n128: \n129:     # 3. Upload and Extract in One Single Operation\n130:     try:\n131:         print(f\"[*] Uploading and extracting {filepath.name} via Unstructured AI (Profile: {profile.upper()})...\")\n132:         with open(filepath, \"rb\") as f:\n133:             result = client.extract.from_document(\n134:                 input=f,\n135:                 schema=schema,\n136:                 profile=profile,\n137:                 wait_seconds=600\n138:             )\n139: \n140:         if hasattr(result, 'model_dump'):\n141:             result_data = result.model_dump()\n142:         elif hasattr(result, '__dict__'):\n143:             result_data = result.__dict__\n144:         else:\n145:             result_data = dict(result)\n146: \n147:         # Handle asynchronous job if returned 202 Accepted\n148:         status_str = str(result_data.get(\"status\", \"\")).lower()\n149:         if any(s in status_str for s in (\"queued\", \"processing\", \"in_progress\")):\n150:             job_id = result_data.get(\"id\") or result_data.get(\"job_id\")\n151:             if job_id:\n152:                 print(f\"[*] Processing on server (Job ID: {job_id}). Waiting for completion...\")\n153:                 attempts = 0\n154:                 while attempts < 120:  # Up to 20 minutes\n155:                     time.sleep(8)\n156:                     attempts += 1\n157:                     job_res = client.jobs.get(job_id)\n158:                     if hasattr(job_res, 'model_dump'):\n159:                         job_data = job_res.model_dump()\n160:                     elif hasattr(job_res, '__dict__'):\n161:                         job_data = job_res.__dict__\n162:                     else:\n163:                         job_data = dict(job_res)\n164: \n165:                     cur_status = str(job_data.get(\"status\", \"\")).lower()\n166:                     if \"completed\" in cur_status:\n167:                         result_data = job_data\n168:                         break\n169:                     elif \"failed\" in cur_status or \"error\" in cur_status:\n170:                         raise RuntimeError(f\"Extraction failed on server: {job_data.get('error', '')}\")\n171: \n172:                     if attempts % 3 == 0:\n173:                         print(f\"[*] Current status: {job_data.get('status')} ... ({attempts * 8}s)\")\n174: \n175:                 if attempts >= 120:\n176:                     raise RuntimeError(\"Timeout reached (20 minutes) without job completion on server.\")\n177: \n178:         items = parse_structured_result(result_data, filepath.name)\n179: \n180:         # Cache only if items extracted\n181:         if len(items) > 0:\n182:             with open(cache_file, \"w\", encoding=\"utf-8\") as f:\n183:                 json.dump(result_data, f, ensure_ascii=False, indent=2, default=str)\n184:             print(f\"[+] Saved valid local cache for: {filepath.name} ({len(items)} items)\")\n185: \n186:         # Save local json copy\n187:         json_path = filepath.with_suffix(\".json\")\n188:         try:\n189:             with open(json_path, \"w\", encoding=\"utf-8\") as f:\n190:                 json.dump(result_data, f, ensure_ascii=False, indent=2, default=str)\n191:         except Exception:\n192:             pass\n193: \n194:         print(f\"[+] Successfully extracted {len(items)} items from {filepath.name}\")\n195:         return items\n196: \n197:     except Exception as e:\n198:         print(f\"[!] Extraction error for {filepath.name}: {e}\")\n199:         raise\n200: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n