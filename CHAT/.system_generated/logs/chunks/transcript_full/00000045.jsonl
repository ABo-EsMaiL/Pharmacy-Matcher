{"step_index":1874,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-22T10:45:56Z","content":"Created At: 2026-09-22T13:45:56+03:00\nCompleted At: 2026-09-22T13:45:56+03:00\nFile Path: `file:///d:/AI_Engineer/Pharmacy-agy/src/extract/pdf_reader.py`\nTotal Lines: 232\nTotal Bytes: 10176\nShowing lines 1 to 100\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"\"\"\n2: PDF extraction module using Unstructured Transform Client.\n3: Handles direct single-step extraction, server-side caching, and local caching.\n4: \"\"\"\n5: \n6: from pathlib import Path\n7: import json\n8: import hashlib\n9: import time\n10: \n11: def _get_file_hash(filepath: Path) -> str:\n12:     hasher = hashlib.md5()\n13:     with open(filepath, 'rb') as f:\n14:         buf = f.read(65536)\n15:         while len(buf) > 0:\n16:             hasher.update(buf)\n17:             buf = f.read(65536)\n18:     return hasher.hexdigest()\n19: \n20: def extract_items_from_pdf(\n21:     filepath: Path,\n22:     api_key: str,\n23:     base_url: str = \"https://transform.unstructured.io\",\n24:     gemini_api_key: str = None,\n25:     profile: str = \"best\",\n26: ) -> list[dict]:\n27:     \"\"\"\n28:     Extract drug product items from PDF using Unstructured API.\n29:     Checks local cache first, then existing server jobs, and finally uploads if new.\n30:     \"\"\"\n31:     filepath = Path(filepath)\n32:     if not filepath.exists():\n33:         raise FileNotFoundError(f\"PDF file not found: {filepath}\")\n34: \n35:     print(f\"[*] Processing PDF file: {filepath.name}\")\n36: \n37:     # 1. Local Cache Check\n38:     file_hash = _get_file_hash(filepath)\n39:     cache_dir = filepath.parent.parent.parent / 'data' / '.unstructured_cache'\n40:     cache_dir.mkdir(parents=True, exist_ok=True)\n41:     cache_file = cache_dir / f\"{file_hash}_extract.json\"\n42:     \n43:     if cache_file.exists():\n44:         try:\n45:             with open(cache_file, \"r\", encoding=\"utf-8\") as f:\n46:                 result_data = json.load(f)\n47:             cached_items = parse_structured_result(result_data, filepath.name)\n48:             if len(cached_items) > 0:\n49:                 print(f\"[+] Loaded {len(cached_items)} items from local cache: {filepath.name}\")\n50:                 return cached_items\n51:             else:\n52:                 print(f\"[*] Local cache has 0 items for {filepath.name}. Checking server...\")\n53:         except Exception:\n54:             print(f\"[*] Local cache invalid for {filepath.name}. Checking server...\")\n55: \n56:     try:\n57:         from unstructured_transform_client import TransformClient\n58:     except ImportError:\n59:         print(\"⚠️ unstructured-transform-client not found. Please install it:\")\n60:         print(\"pip install unstructured-transform-client\")\n61:         raise RuntimeError(\"unstructured-transform-client is required to process PDFs\")\n62: \n63:     client = TransformClient(\n64:         api_key=api_key,\n65:         server_url=base_url,\n66:     )\n67: \n68:     schema = {\n69:         \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n70:         \"title\": \"Supplier Product Names\",\n71:         \"description\": \"Extract product entries from all pages as source data only. Return one entry per source product row, preserving duplicates and different strengths. Include products even when price or quantity is blank or zero. Copy names faithfully without spelling repair or inferred digits. Do not infer stock, requested quantities or shortage matches.\",\n72:         \"type\": \"object\",\n73:         \"properties\": {\n74:             \"items\": {\n75:                 \"type\": \"array\",\n76:                 \"description\": \"Every product entry from every page, in document order. Keep repeated entries. Exclude document headers, footers, contact details, column labels and totals.\",\n77:                 \"items\": {\n78:                     \"type\": \"object\",\n79:                     \"properties\": {\n80:                         \"item_name_raw\": {\n81:                             \"type\": \"string\",\n82:                             \"description\": \"Copy the complete product name/description exactly as present in the source, preserving Arabic, English, mixed text, spelling, strengths, units, dosage form, pack numbers, punctuation and manufacturer text. Do not correct, translate or complete it. Exclude values belonging to separate price, discount or quantity columns, but retain numbers written inside the name itself.\",\n83:                         },\n84:                         \"source_page\": {\n85:                             \"type\": [\n86:                                 \"integer\",\n87:                                 \"null\",\n88:                             ],\n89:                             \"description\": \"The 1-based source page containing this product entry, taken from the source page metadata. Return null when unavailable; do not guess.\",\n90:                         },\n91:                     },\n92:                     \"required\": [\n93:                         \"item_name_raw\",\n94:                         \"source_page\",\n95:                     ],\n96:                     \"additionalProperties\": False,\n97:                 },\n98:             },\n99:         },\n100:         \"required\": [\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
