{res.latency}s` : `تم الاتصال بنجاح! زمن الاستجابة: ${res.latency} ثانية`, 'success');\n+        } else {\n+            const failReport = `[${doneTime}] ❌ FAILED: Server '${serverKey}' test failed!\\n` +\n+                `--------------------------------------------------\\n` +\n+                `• Error Details : ${res.error}\\n` +\n+                `--------------------------------------------------\\n` +\n+                `💡 Suggestion: Ensure the server is started and that port ${res.port || '8000/8001'} is listening.`;\n+            if (outputEl) outputEl.innerText = failReport;\n+            showToast((currentLang === 'en' ? 'Ping failed: ' : 'فشل اختبار الاتصال: ') + res.error, 'error');\n+        }\n+    } catch (e) {\n+        if (outputEl) outputEl.innerText += `\\n❌ Unexpected client error during test: ${e.message}`;\n+        showToast(currentLang === 'en' ? 'Test error' : 'حدث خطأ أثناء الاختبار', 'error');\n+    } finally {\n+        if (btn) {\n+            btn.disabled = false;\n+            btn.innerHTML = originalHtml;\n+        }\n+        await loadServersUI();\n+    }\n+}\n+\n+async function openServerSession(serverKey) {\n+    const t = I18N[currentLang] || I18N.ar;\n+    try {\n+        showToast(currentLang === 'en' ? `Opening login session for ${serverKey}...` : `جاري فتح متصفح تسجيل الدخول لسيرفر ${serverKey}...`, 'success');\n+        const res = await window.pywebview.api.run_server_session(serverKey);\n+        if (res.success) {\n+            showToast(currentLang === 'en' ? 'Browser session window opened' : 'تم فتح نافذة المتصفح لتسجيل الدخول بنجاح', 'success');\n+        } else {\n+            showToast((currentLang === 'en' ? 'Session error: ' : 'خطأ في فتح الجلسة: ') + res.error, 'error');\n+        }\n+    } catch (e) {\n+        showToast(currentLang === 'en' ? 'Error opening session' : 'حدث خطأ أثناء فتح الجلسة', 'error');\n+    }\n+}\n+\n+function clearServerTestLog() {\n+    const outputEl = document.getElementById('server-test-output');\n+    const t = I18N[currentLang] || I18N.ar;\n+    if (outputEl) {\n+        outputEl.innerText = t.test_panel_empty || 'اضغط على زر \"اختبار الاتصال السريع\" في أي سيرفر لقياس زمن الاستجابة والتأكد من جاهزيته...';\n+    }\n+}\n     </script>\n     <script>\n         // Override showScreen to handle active states on sidebar\n@@ -2953,6 +2953,8 @@\n                 resetNewProcessForm();\n             } else if (screenId === 'screen-logs' || screenId === 'screen-settings') {\n                 loadLogs();\n+            } else if (screenId === 'screen-servers') {\n+                loadServersUI();\n             }\n         };\n         // Auto select first nav item and initialize language\n[diff_block_end]\n\nPlease note that the above snippet only shows the MODIFIED lines from the last change. It shows up to 3 lines of unchanged lines before and after the modified lines. The actual file contents may have many more lines not shown."}
