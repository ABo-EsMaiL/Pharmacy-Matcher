{"step_index":6003,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-24T00:50:49Z","content":"Created At: 2026-09-24T03:50:49+03:00\nCompleted At: 2026-09-24T03:50:49+03:00\nThe following changes were made by the replace_file_content tool to: d:\\AI_Engineer\\Pharmacy-agy\\desktop_app\\templates\\index.html. If relevant, proactively run terminal commands to execute this code for the USER. Don't ask for permission.\n[diff_block_start]\n@@ -2906,6 +2906,12 @@\n     if (topText) {\n         topText.textContent = isRunning ? t.server_running : t.server_stopped;\n     }\n+\n+    // Also auto-refresh servers screen if it is active\n+    const srvScreen = document.getElementById('screen-servers');\n+    if (srvScreen && srvScreen.classList.contains('active')) {\n+        loadServersUI();\n+    }\n }\n \n async function toggleServer() {\n@@ -2925,6 +2925,229 @@\n \n const btnToggle = document.getElementById('btn-toggle-server');\n if (btnToggle) btnToggle.addEventListener('click', toggleServer);\n+\n+// --- AI Servers Manager Logic ---\n+async function loadServersUI() {\n+    if (!window.pywebview || !window.pywebview.api) return;\n+    const t = I18N[currentLang] || I18N.ar;\n+    \n+    try {\n+        const infoStr = await window.pywebview.api.get_servers_info();\n+        const info = JSON.parse(infoStr);\n+        const servers = info.servers || {};\n+        const activeKey = info.active_server || 'gaistudio';\n+        \n+        // Update Active Provider Banner\n+        const activeSrv = servers[activeKey];\n+        const bannerTitle = document.getElementById('active-banner-title');\n+        const bannerSub = document.getElementById('active-banner-sub');\n+        if (bannerTitle && activeSrv) {\n+            bannerTitle.innerHTML = currentLang === 'en'\n+                ? `Active Matching Provider: <strong>${activeSrv.name}</strong> (Port: ${activeSrv.port} • Model: ${activeSrv.default_model})`\n+                : `المزود النشط حالياً لعمليات المطابقة: <strong>${activeSrv.name}</strong> (منفذ: ${activeSrv.port} • موديل: ${activeSrv.default_model})`;\n+        }\n+        if (bannerSub) {\n+            bannerSub.textContent = currentLang === 'en'\n+                ? `All shortage batches will be dispatched directly to ${activeSrv ? activeSrv.name : activeKey}.`\n+                : `سيتم توجيه جميع دفعات مطابقة النواقص تلقائياً إلى هذا السيرفر (${activeSrv ? activeSrv.name : activeKey}).`;\n+        }\n+\n+        // Update each server card\n+        ['gaistudio', 'chatgpt'].forEach(key => {\n+            const srv = servers[key];\n+            if (!srv) return;\n+\n+            const card = document.getElementById(`card-server-${key}`);\n+            const badgeStatus = document.getElementById(`badge-status-${key}`);\n+            const badgeActive = document.getElementById(`badge-active-${key}`);\n+            const btnActive = document.getElementById(`btn-active-${key}`);\n+            const btnToggle = document.getElementById(`btn-toggle-${key}`);\n+            const valModel = document.getElementById(`val-model-${key}`);\n+\n+            if (valModel) valModel.textContent = srv.default_model;\n+\n+            const isRunning = !!srv.running;\n+            const isActive = (key === activeKey);\n+\n+            // Active Card Highlight & Badge\n+            if (card) {\n+                card.classList.toggle('is-active-provider', isActive);\n+            }\n+            if (badgeActive) {\n+                badgeActive.style.display = isActive ? 'inline-flex' : 'none';\n+                badgeActive.textContent = t.btn_already_active;\n+            }\n+\n+            // Running Status Badge\n+            if (badgeStatus) {\n+                badgeStatus.className = isRunning ? 'badge-pill status-online' : 'badge-pill status-offline';\n+                badgeStatus.textContent = isRunning \n+                    ? (currentLang === 'en' ? `🟢 Online (Port ${srv.port})` : `🟢 متصل ومستمع (${srv.port})`) \n+                    : (currentLang === 'en' ? '🔴 Stopped' : '🔴 متوقف');\n+            }\n+\n+            // Active Switch Button\n+            if (btnActive) {\n+                if (isActive) {\n+                    btnActive.className = 'btn btn-outline';\n+                    btnActive.style.borderColor = 'var(--primary)';\n+                    btnActive.style.background = '#e0f2fe';\n+                    btnActive.style.color = 'var(--primary)';\n+                    btnActive.innerHTML = `<i class=\"ph-fill ph-star\"></i> <span>${t.btn_already_active}</span>`;\n+                    btnActive.disabled = true;\n+                } else {\n+                    btnActive.className = 'btn btn-outline';\n+                    btnActive.style.borderColor = '';\n+                    btnActive.style.background = '';\n+                    btnActive.style.color = '';\n+                    btnActive.innerHTML = `<i class=\"ph-bold ph-check\"></i> <span>${t.btn_set_as_active}</span>`;\n+                    btnActive.disabled = false;\n+                }\n+            }\n+\n+            // Toggle Run / Stop Button\n+            if (btnToggle) {\n+                if (isRunning) {\n+                    btnToggle.className = 'btn btn-outline-secondary text-danger';\n+                    btnToggle.innerHTML = `<i class=\"ph-bold ph-stop\"></i> <span>${t.btn_stop_instance}</span>`;\n+                    btnToggle.onclick = () => toggleServerInstance(key, false);\n+                } else {\n+                    btnToggle.className = 'btn btn-primary';\n+                    btnToggle.innerHTML = `<i class=\"ph-bold ph-play\"></i> <span>${t.btn_start_instance}</span>`;\n+                    btnToggle.onclick = () => toggleServerInstance(key, true);\n+                }\n+            }\n+        });\n+    } catch (e) {\n+        console.error('Failed to load servers UI:', e);\n+    }\n+}\n+\n+async function toggleServerInstance(serverKey, startIt) {\n+    const t = I18N[currentLang] || I18N.ar;\n+    const btn = document.getElementById(`btn-toggle-${serverKey}`);\n+    if (btn) {\n+        btn.disabled = true;\n+        btn.innerHTML = `<i class=\"ph-fill ph-spinner-gap spinner\"></i> <span>${currentLang === 'en' ? 'Processing...' : 'جاري المعالجة...'}</span>`;\n+    }\n+\n+    try {\n+        let res;\n+        if (startIt) {\n+            showToast(currentLang === 'en' ? `Starting ${serverKey}...` : `جاري تشغيل سيرفر ${serverKey}...`, 'success');\n+            res = await window.pywebview.api.start_server_instance(serverKey);\n+        } else {\n+            showToast(currentLang === 'en' ? `Stopping ${serverKey}...` : `جاري إيقاف سيرفر ${serverKey}...`, 'success');\n+            res = await window.pywebview.api.stop_server_instance(serverKey);\n+        }\n+\n+        if (res.success) {\n+            showToast(res.message || (currentLang === 'en' ? 'Operation successful' : 'تمت العملية بنجاح'), 'success');\n+        } else {\n+            showToast((currentLang === 'en' ? 'Error: ' : 'خطأ: ') + (res.error || 'Failed'), 'error');\n+        }\n+    } catch (e) {\n+        showToast(currentLang === 'en' ? 'Connection error' : 'حدث خطأ في الاتصال', 'error');\n+        console.error(e);\n+    } finally {\n+        await loadServersUI();\n+        await updateServerStatus();\n+    }\n+}\n+\n+async function setActiveServer(serverKey) {\n+    const t = I18N[currentLang] || I18N.ar;\n+    try {\n+        const res = await window.pywebview.api.set_active_ai_server(serverKey);\n+        if (res.success) {\n+            const srvName = serverKey === 'gaistudio' ? 'Google AI Studio (Port 8001)' : 'ChatGPT (Port 8000)';\n+            showToast(currentLang === 'en' ? `Activated ${srvName} for matching!` : `تم تعيين ${srvName} كمزود نشط لعمليات المطابقة بنجاح!`, 'success');\n+            await loadServersUI();\n+            await loadSettings();\n+            await updateServerStatus();\n+        } else {\n+            showToast((currentLang === 'en' ? 'Activation