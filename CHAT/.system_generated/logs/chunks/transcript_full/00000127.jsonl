ers.get(key)\n271: \n272:     def get_all_status(self, active_key: str = \"chatgpt\") -> dict:\n273:         return {\n274:             k: {**srv.get_status(), \"is_active\": (k == active_key)}\n275:             for k, srv in self.servers.items()\n276:         }\n277: \n278:     def start(self, key: str = \"chatgpt\") -> dict:\n279:         srv = self.get_server(key)\n280:         if srv:\n281:             return srv.start()\n282:         return {\"success\": False, \"message\": f\"Server {key} not found\"}\n283: \n284:     def stop(self, key: str = \"chatgpt\") -> dict:\n285:         srv = self.get_server(key)\n286:         if srv:\n287:             return srv.stop()\n288:         return {\"success\": False, \"message\": f\"Server {key} not found\"}\n289: \n290:     def is_running(self, key: str = \"chatgpt\") -> bool:\n291:         srv = self.get_server(key)\n292:         return srv.is_running() if srv else False\n293: \n294:     def test(self, key: str = \"chatgpt\") -> dict:\n295:         srv = self.get_server(key)\n296:         if srv:\n297:             return srv.test()\n298:         return {\"success\": False, \"error\": f\"Server {key} not found\"}\n299: \n300:     def run_get_session(self, key: str = \"chatgpt\") -> dict:\n301:         srv = self.get_server(key)\n302:         if srv:\n303:             return srv.run_get_session()\n304:         return {\"success\": False, \"output\": f\"Server {key} not found\"}\n305: \n306:     def cleanup(self):\n307:         for srv in self.servers.values():\n308:             if srv.process is not None:\n309:                 srv.stop()\n310: \n311: # Backward compatibility alias\n312: MSEMAXServerManager = MultiServerManager\n313: \n314: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
