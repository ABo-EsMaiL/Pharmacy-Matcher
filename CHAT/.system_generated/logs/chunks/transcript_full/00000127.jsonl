 socket.SOCK_STREAM) as s:\n42:             s.settimeout(timeout)\n43:             return s.connect_ex((host, port)) == 0\n44:     except Exception:\n45:         return False\n46: \n47: class ServerInstance:\n48:     def __init__(self, key: str, config: dict, logger_callback=None):\n49:         self.key = key\n50:         self.name = config.get(\"name\", key)\n51:         self.dir = config.get(\"dir\", config.get(\"default_dir\", \"\"))\n52:         self.port = int(config.get(\"port\", 8000))\n53:         self.default_model = config.get(\"default_model\", \"gpt-4o\")\n54:         self.url = config.get(\"url\", f\"http://127.0.0.1:{self.port}/v1/chat/completions\")\n55:         self.api_key = config.get(\"api_key\", \"[REDACTED_CREDENTIAL]\")\n56:         self.process = None\n57:         self.logger = logger_callback\n58: \n59:     def log(self, message: str):\n60:         prefix = f\"[{self.name}]\"\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
