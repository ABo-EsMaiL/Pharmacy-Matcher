ate run_app.bat in root of dist\n89:     run_bat_content = \"\"\"@echo off\n90: chcp 65001 > nul\n91: title Pharmacy Matcher - فارما ماتش\n92: \n93: echo ========================================================\n94: echo    تشغيل برنامج فارما ماتش (Pharmacy Matcher)\n95: echo ========================================================\n96: echo.\n97: \n98: :: Check Python installation\n99: where python >nul 2>nul\n100: if %errorlevel% neq 0 (\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
