{"step_index":7823,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-24T16:33:17Z","thinking":"Adding functionality to the timing script to extract and display key timing metrics from the responses, including pre-execution time, generation time, and total roundtrip time, should provide better insight. Ensuring the response is valid JSON and logging its length will enhance debugging and data validation. The script will be expanded to use a real-world dataset to assess performance under practical conditions.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"ArtifactMetadata":{"RequestFeedback":false,"Summary":"Verification script for 75-case stress batch and real-world shortage batch","UserFacing":false},"CodeContent":"\"\"\"\nTest script to verify MSEMAX Adaptive Timeout, State Machine, Latency Elimination, and Real-world batches.\n\"\"\"\nimport json\nimport time\nimport requests\nimport sys\nimport openpyxl\n\n# Ensure Pharmacy is in python path\nsys.path.insert(0, r\"D:\\AI_Engineer\\Pharmacy-agy\")\nfrom src.fast_match.coordinator import FastCoordinator, SYSTEM_PROMPT\nfrom src.config import Config\n\nAPI_URL = \"http://127.0.0.1:8001/v1/chat/completions\"\nAPI_KEY = \"[REDACTED_CREDENTIAL]\"\n\ndef main():\n    print(\"=\" * 80)\n    print(\"PHASE 1: VERIFYING MSEMAX LARGE BATCH (75 CASES) ADAPTIVE TIMEOUT & STATE MACHINE\")\n    print(\"=\" * 80)\n\n    # 1. Health check\n    h = requests.get(\"http://127.0.0.1:8001/health\", timeout=5).json()\n    print(f\"[✓] Gateway: {h.get('gateway')}\")\n    print(f\"[✓] Active Model: {h.get('active_model')[:30]}... (Verified: {h.get('model_verified')})\")\n    print(f\"[✓] Thinking Mode: {h.get('active_thinking')} (Verified: {h.get('thinking_verified')})\")\n    print(f\"[✓] Clear Chat On Request: {h.get('clear_chat_on_request')}\")\n\n    # 2. Build 5 canonical test cases covering core business rules\n    test_cases = [\n        {\n            \"case_id\": \"TEST-01-STRENGTH\",\n            \"requested_name\": \"نوفاكس 250 مجم 20 قرص\",\n            \"catalog_id\": \"W1\",\n            \"candidates\": [{\"id\": \"W1-001\", \"name\": \"نوفاكس 500 مجم 20 قرص\"}]\n        },\n        {\n            \"case_id\": \"TEST-02-DOSAGE-FORM\",\n            \"requested_name\": \"بيتاديرم مرهم 15 جم\",\n            \"catalog_id\": \"W1\",\n            \"candidates\": [{\"id\": \"W1-002\", \"name\": \"بيتاديرم كريم 15 جم\"}]\n        },\n        {\n            \"case_id\": \"TEST-03-PACK-SIZE\",\n            \"requested_name\": \"دوليبران 1000 مجم 15 قرص\",\n            \"catalog_id\": \"W1\",\n            \"candidates\": [{\"id\": \"W1-003\", \"name\": \"دوليبران 1 جم 60 قرص\"}]\n        },\n        {\n            \"case_id\": \"TEST-04-OCR-CORRUPTION\",\n            \"requested_name\": \"فورسيجا 10 مجم أقراص\",\n            \"catalog_id\": \"W1\",\n            \"candidates\": [{\"id\": \"W1-004\", \"name\": \"فورسجا 10 مجم أقراص\"}]\n        },\n        {\n            \"case_id\": \"TEST-05-GENERIC-ALT\",\n            \"requested_name\": \"بنادول 500 مجم أقراص\",\n            \"catalog_id\": \"W1\",\n            \"candidates\": [{\"id\": \"W1-005\", \"name\": \"سيتال 500 مجم أقراص\"}]\n        }\n    ]\n\n    # Replicate up to 75 cases to test true 75-case streaming stability & throughput\n    cases_75 = []\n    for i in range(15):\n        for idx, base in enumerate(test_cases):\n            cid = f\"TEST-{i*5 + idx + 1:02d}\"\n            c = dict(base)\n            c[\"case_id\"] = cid\n            cases_75.append(c)\n\n    assert len(cases_75) == 75, f\"Expected 75 cases, got {len(cases_75)}\"\n    print(f\"\\n[+] Built 75-case stress batch (15 replicates of 5 canonical rules).\")\n\n    # 3. Call Pharmacy Coordinator\n    cfg = Config(unstructured_api_key=\"dummy\", gemini_api_key=\"dummy\")\n    cfg.local_api_url = API_URL\n    cfg.local_api_key = API_KEY\n    cfg.local_model = \"gemini-3.8-flash\"\n    coord = FastCoordinator(cfg)\n\n    print(f\"\\n[*] Dispatching 75 cases to MSEMAX Gateway...\")\n    t0 = time.time()\n    try:\n        results = coord._call_local_api({\"cases\": cases_75})\n        dur = time.time() - t0\n        print(f\"\\n[✓] SUCCESS: Coordinator received response in {dur:.2f}s!\")\n        print(f\"    - Results count: {len(results)}\")\n        print(f\"    - Raw response length: {len(coord.last_raw_response)} characters\")\n        \n        # Verify all 75 case_ids are returned\n        returned_ids = {r.get(\"case_id\") for r in results}\n        expected_ids = {c[\"case_id\"] for c in cases_75}\n        missing = expected_ids - returned_ids\n        print(f\"    - Returned Case IDs: {len(returned_ids)} / 75\")\n        if missing:\n            print(f\"    [!] Missing case IDs: {missing}\")\n        else:\n            print(f\"    [✓] EXACT MATCH: All 75 case IDs returned successfully!\")\n\n        # Check compliance with canonical rules across the batch\n        strength_decisions = [r for r in results if \"TEST-01\" in r.get(\"case_id\", \"\") or (int(r.get(\"case_id\", \"\").split(\"-\")[1]) % 5 == 1)]\n        dosage_decisions = [r for r in results if \"TEST-02\" in r.get(\"case_id\", \"\") or (int(r.get(\"case_id\", \"\").split(\"-\")[1]) % 5 == 2)]\n        pack_decisions = [r for r in results if \"TEST-03\" in r.get(\"case_id\", \"\") or (int(r.get(\"case_id\", \"\").split(\"-\")[1]) % 5 == 3)]\n        ocr_decisions = [r for r in results if \"TEST-04\" in r.get(\"case_id\", \"\") or (int(r.get(\"case_id\", \"\").split(\"-\")[1]) % 5 == 4)]\n        generic_decisions = [r for r in results if \"TEST-05\" in r.get(\"case_id\", \"\") or (int(r.get(\"case_id\", \"\").split(\"-\")[1]) % 5 == 0)]\n\n        print(f\"\\n[✓] Rule Compliance Verification across 75 cases:\")\n        print(f\"    - Strength mismatch -> no_match: {all(r.get('status') == 'no_match' for r in strength_decisions)} ({len(strength_decisions)} cases)\")\n        print(f\"    - Dosage form diff  -> review:   {all(r.get('status') == 'review' for r in dosage_decisions)} ({len(dosage_decisions)} cases)\")\n        print(f\"    - Pack size diff    -> match:    {all(r.get('status') == 'match' for r in pack_decisions)} ({len(pack_decisions)} cases)\")\n        print(f\"    - OCR corruption    -> match:    {all(r.get('status') == 'match' for r in ocr_decisions)} ({len(ocr_decisions)} cases)\")\n        print(f\"    - Generic / diff brand -> no_match: {all(r.get('status') == 'no_match' for r in generic_decisions)} ({len(generic_decisions)} cases)\")\n\n    except Exception as e:\n        print(f\"\\n[X] FAILURE in Phase 1: {e}\")\n        import traceback\n        traceback.print_exc()\n        return\n\n    # PHASE 2: REAL-WORLD SHORTAGES BATCH FROM test_shortages_200.xlsx\n    print(\"\\n\" + \"=\" * 80)\n    print(\"PHASE 2: REAL-WORLD SHORTAGES FROM data/test_shortages_200.xlsx\")\n    print(\"=\" * 80)\n    \n    wb = openpyxl.load_workbook(r\"D:\\AI_Engineer\\Pharmacy-agy\\data\\test_shortages_200.xlsx\", read_only=True)\n    sheet = wb.active\n    real_shortages = []\n    for i, row in enumerate(sheet.iter_rows(values_only=True)):\n        if i >= 6 and row and row[1]:\n            real_shortages.append(str(row[1]).strip())\n        if len(real_shortages) >= 15:\n            break\n\n    print(f\"[+] Loaded {len(real_shortages)} real shortage names from Excel:\")\n    for idx, s in enumerate(real_shortages[:5]):\n        print(f\"    {idx+1}. {s}\")\n\n    # Build real-world candidate scenarios for these real shortages\n    real_cases = []\n    for idx, s in enumerate(real_shortages):\n        cid = f\"REAL-{idx+1:02d}\"\n        real_cases.append({\n            \"case_id\": cid,\n            \"requested_name\": s,\n            \"catalog_id\": \"W1\",\n            \"candidates\": [\n                {\"id\": f\"W1-R{idx+1}\", \"name\": s} # exact match\n            ]\n        })\n\n    print(f\"\\n[*] Dispatching {len(real_cases)} real-world shortage cases to MSEMAX Gateway...\")\n    t0 = time.time()\n    try:\n        real_results = coord._call_local_api({\"cases\": real_cases})\n        dur = time.time() - t0\n        print(f\"\\n[✓] SUCCESS: Real-world batch received in {dur:.2f}s!\")\n        print(f\"    - Results count: {len(real_results)} / {len(real_cases)}\")\n        print(f\"    - All matches valid: {all(r.get('status') == 'match' for r in real_results)}\")\n        for r in real_results[:3]:\n            print(f\"    Sample result: {r}\")\n    except Exception as e:\n        print(f\"\\n[X] FAILURE in Phase 2: {e}\")\n        import traceback\n        traceback.print_exc()\n\nif __name__ == \"__main__\":\n    main()\n","Description":"Comprehensive verification script for 75 cases and real-world batch","Overwrite":true,"TargetFile":"C:\\Users\\kakak\\.gemini\\antigravity\\brain\\916274de-7f92-49fc-a0a8-d291664b474a\\scratch\\verify_large_batch_timing.py","toolAction":"Update verify_large_batch_timing.py","toolSummary":"Update verification script"}}]}
