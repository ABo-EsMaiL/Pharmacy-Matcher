\\n\"\n187:             \"2. انقل اسم الصنف كاملاً كما هو في الصورة بالضبط في (item_name_raw) مع الاحتفاظ بالاسم والتركيز والهيئة الدوائية والشركة.\\n\"\n188:             \"3. تجنب تصحيح الأخطاء الإملائية أو ترجمة الكلمات أو تغيير الأرقام. احتفظ بالأرقام الموجودة داخل الاسم.\\n\"\n189:             \"4. لا تُدرج أسعار أو كميات أو خصومات داخل اسم الصنف.\\n\"\n190:             \"5. الحروف باللغة العربية والإنجليزية السليمة فقط.\\n\"\n191:             f\"6. الرد يجب أن يكون كائن JSON صالح فقط: {{\\\"items\\\": [{{\\\"item_name_raw\\\": \\\"اسم الصنف بالضبط\\\", \\\"source_page\\\": {page_num}}}]}}\"\n192:         )\n193: \n194:         payload = {\n195:             \"model\": model,\n196:             \"messages\": [\n197:                 {\n198:                     \"role\": \"user\",\n199:                     \"content\": [\n200:                         {\"type\": \"text\", \"text\": prompt},\n201:                         {\n202:                             \"type\": \"image_url\",\n203:                             \"image_url\": {\n204:                                 \"url\": f\"data:image/webp;base64,{img_b64}\"\n205:                             }\n206:                         }\n207:                     ]\n208:                 }\n209:             ],\n210:             \"stream\": False\n211:         }\n212: \n213:         headers = {\n214:             \"Authorization\": f\"Bearer {api_key}\",\n215:             \"Content-Type\": \"application/json\"\n216:         }\n217: \n218:         # 4. Send request with retry loop\n219:         success = False\n220:         for attempt in range(1, max_retries + 1):\n221:             t0 = time.time()\n222:             try:\n223:                 print(f\"     [*] Sending Vision request to gateway (Attempt {attempt}/{max_retries})...\")\n224:                 with _GATEWAY_MUTEX:\n225:                     resp = requests.post(api_url, json=payload, headers=headers, timeout=240)\n226:                 elapsed = time.time() - t0\n227: \n228:                 if resp.status_code == 200:\n229:                     data = resp.json()\n230:                     raw_content = data.get(\"choices\", [{}])[0].get(\"message\", {}).get(\"content\", \"\")\n231:                     parsed = _clean_json_response(raw_content)\n232: \n233:                     items = parsed.get(\"items\", [])\n234:                     # Verify page number\n235:                     for item in items:\n236:                         item[\"source_page\"] = page_num\n237:                         item[\"source_file\"] = filepath.name\n238: \n239:                     # Save to page result cache\n240:                     with open(page_res_path, \"w\", encoding=\"utf-8\") as f_out:\n241:                         json.dump({\"page\": page_num, \"items\": items}, f_out, ensure_ascii=False, indent=2)\n242: \n243:                     # Update manifest\n244:                     if page_num not in completed_set:\n245:                         completed_set.add(page_num)\n246:                     manifest[\"completed_pages\"] = sorted(list(completed_set))\n247:                     manifest[\"updated_at\"] = datetime.now().isoformat()\n248:                     with open(manifest_path, \"w\", encoding=\"utf-8\") as f_m:\n249:                         json.dump(manifest, f_m, ensure_ascii=False, indent=2)\n250: \n251:                     print(f\"     [+] [Page {page_num}] Succeeded in {elapsed:.1f}s -> {len(items)} items extracted.\")\n252:                     success = True\n253:                     break\n254:                 elif resp.status_code == 429:\n255:                     print(f\"     [!] [Page {page_num}] Gateway busy (browser tab in use). Waiting 5s before attempt {attempt+1}/{max_retries}...\")\n256:                     time.sleep(5.0)\n257:                     continue\n258:                 else:\n259:                     print(f\"     [!] [Page {page_num}] HTTP Error {resp.status_code}: {resp.text[:200]}\")\n260:             except Exception as e:\n261:                 print(f\"     [!] [Page {page_num}] Exception on attempt {attempt}: {e}\")\n262: \n263:             time.sleep(2.0)\n264: \n265:         if not success:\n266:             raise RuntimeError(f\"Failed to extract page {page_num} of {filepath.name} after {max_retries} attempts.\")\n267: \n268:     # All pages finished!\n269:     manifest[\"status\"] = \"completed\"\n270:     manifest[\"updated_at\"] = datetime.now().isoformat()\n271:     with open(manifest_path, \"w\", encoding=\"utf-8\") as f_m:\n272:         json.dump(manifest, f_m, ensure_ascii=False, indent=2)\n273: \n274:     # Collect and return all items\n275:     all_items = []\n276:     for p in range(1, total_pages + 1):\n277:         res_file = cache_dir / \"results\" / f\"page_{p}.json\"\n278:         if res_file.exists():\n279:             with open(res_file, \"r\", encoding=\"utf-8\") as f:\n280:                 p_data = json.load(f)\n281:                 all_items.extend(p_data.get(\"items\", []))\n282: \n283:     print(f\"\\n[+] [VISION EXTRACTOR] Successfully completed all {total_pages} pages for {filepath.name}!\")\n284:     print(f\"[+] Total items extracted: {len(all_items)}\")\n285:     return all_items\n286: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
