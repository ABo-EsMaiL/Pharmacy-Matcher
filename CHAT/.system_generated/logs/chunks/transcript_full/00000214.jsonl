{"step_index":10429,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-25T14:42:58Z","content":"Created At: 2026-09-25T17:42:58+03:00\nCompleted At: 2026-09-25T17:42:58+03:00\nFile Path: `file:///d:/AI_Engineer/Pharmacy-agy-vision/src/extract/gemini_vision_extractor.py`\nTotal Lines: 286\nTotal Bytes: 11952\nShowing lines 1 to 160\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"\"\"\n2: Gemini Vision Extraction Engine.\n3: Extracts pharmaceutical items from PDF files page-by-page using Google AI Studio Vision Gateway.\n4: Features:\n5: - WebP high-resolution compressed rendering (pypdfium2 at scale 2.5)\n6: - Process-isolated structured cache (manifest.json, pages/, results/)\n7: - Full resume & interruption capability (resumes from incomplete page)\n8: - SHA-256 fingerprinting for instant cache reloads\n9: \"\"\"\n10: \n11: import base64\n12: import hashlib\n13: import json\n14: import re\n15: import time\n16: from datetime import datetime\n17: from pathlib import Path\n18: import threading\n19: import pypdfium2 as pdfium\n20: import requests\n21: \n22: _GATEWAY_MUTEX = threading.Lock()\n23: \n24: \n25: def _compute_file_hash(filepath: Path) -> str:\n26:     \"\"\"Computes SHA-256 checksum of a file.\"\"\"\n27:     hasher = hashlib.sha256()\n28:     with open(filepath, \"rb\") as f:\n29:         while chunk := f.read(65536):\n30:             hasher.update(chunk)\n31:     return hasher.hexdigest()\n32: \n33: \n34: def _get_cache_dir(filepath: Path) -> Path:\n35:     \"\"\"\n36:     Finds or creates an organized cache directory for this file.\n37:     If the file is inside a process folder (data/processes/PROC-XXX),\n38:     places cache under data/processes/PROC-XXX/cache/vision/<file_slug>_<hash[:10]>.\n39:     Otherwise places it under <parent>/.vision_cache/<file_slug>_<hash[:10]>.\n40:     \"\"\"\n41:     filepath = Path(filepath).resolve()\n42:     file_hash = _compute_file_hash(filepath)\n43:     file_slug = re.sub(r\"[^\\w\\-]\", \"_\", filepath.stem)[:25]\n44:     folder_name = f\"{file_slug}_{file_hash[:10]}\"\n45: \n46:     # Check if inside a process directory\n47:     parts = filepath.parts\n48:     proc_idx = -1\n49:     for i, p in enumerate(parts):\n50:         if p.startswith(\"PROC-\"):\n51:             proc_idx = i\n52:             break\n53: \n54:     if proc_idx != -1:\n55:         proc_root = Path(*parts[:proc_idx + 1])\n56:         cache_dir = proc_root / \"cache\" / \"vision\" / folder_name\n57:     else:\n58:         cache_dir = filepath.parent / \".vision_cache\" / folder_name\n59: \n60:     (cache_dir / \"pages\").mkdir(parents=True, exist_ok=True)\n61:     (cache_dir / \"results\").mkdir(parents=True, exist_ok=True)\n62:     return cache_dir\n63: \n64: \n65: def _clean_json_response(raw_text: str) -> dict:\n66:     \"\"\"Cleans markdown fences or surrounding noise to extract valid JSON.\"\"\"\n67:     text = raw_text.strip()\n68:     # Strip markdown codeblocks\n69:     if \"```\" in text:\n70:         match = re.search(r\"```(?:json)?\\s*([\\s\\S]*?)\\s*```\", text)\n71:         if match:\n72:             text = match.group(1).strip()\n73: \n74:     # Find enclosing json object\n75:     start = text.find(\"{\")\n76:     end = text.rfind(\"}\")\n77:     if start != -1 and end != -1 and end > start:\n78:         text = text[start:end+1]\n79: \n80:     return json.loads(text)\n81: \n82: \n83: def extract_items_from_pdf_vision(\n84:     filepath: Path,\n85:     api_url: str = \"http://127.0.0.1:8001/v1/chat/completions\",\n86:     api_key: str = \"[REDACTED_CREDENTIAL]\",\n87:     model: str = \"gemini-3.8-flash\",\n88:     scale: float = 2.5,\n89:     quality: int = 85,\n90:     max_retries: int = 10,\n91: ) -> list[dict]:\n92:     \"\"\"\n93:     Extracts all drug items from a PDF using page-by-page Gemini Vision.\n94:     Supports smart resumption and isolated disk caching.\n95:     \"\"\"\n96:     filepath = Path(filepath)\n97:     if not filepath.exists():\n98:         raise FileNotFoundError(f\"PDF file not found: {filepath}\")\n99: \n100:     print(f\"\\n{'='*60}\")\n101:     print(f\"[*] [VISION EXTRACTOR] File: {filepath.name}\")\n102:     print(f\"{'='*60}\")\n103: \n104:     file_hash = _compute_file_hash(filepath)\n105:     cache_dir = _get_cache_dir(filepath)\n106:     manifest_path = cache_dir / \"manifest.json\"\n107: \n108:     # Read PDF metadata\n109:     pdf = pdfium.PdfDocument(filepath)\n110:     total_pages = len(pdf)\n111:     print(f\"  -> Total pages: {total_pages}\")\n112:     print(f\"  -> Cache location: {cache_dir.relative_to(filepath.parents[3]) if len(filepath.parents) >= 4 else cache_dir}\")\n113: \n114:     # Load or initialize manifest\n115:     manifest = {\n116:         \"file_name\": filepath.name,\n117:         \"file_hash\": file_hash,\n118:         \"total_pages\": total_pages,\n119:         \"completed_pages\": [],\n120:         \"status\": \"in_progress\",\n121:         \"created_at\": datetime.now().isoformat(),\n122:         \"updated_at\": datetime.now().isoformat()\n123:     }\n124: \n125:     if manifest_path.exists():\n126:         try:\n127:             with open(manifest_path, \"r\", encoding=\"utf-8\") as f:\n128:                 loaded_manifest = json.load(f)\n129:             if loaded_manifest.get(\"file_hash\") == file_hash and loaded_manifest.get(\"total_pages\") == total_pages:\n130:                 manifest = loaded_manifest\n131:                 print(f\"  -> Found existing cache manifest (Completed pages: {len(manifest.get('completed_pages', []))}/{total_pages})\")\n132:         except Exception as e:\n133:             print(f\"  [!] Could not parse manifest, re-initializing: {e}\")\n134: \n135:     # Check if completely finished\n136:     completed_set = set(manifest.get(\"completed_pages\", []))\n137:     all_pages_cached = (len(completed_set) == total_pages and \n138:                         all((cache_dir / \"results\" / f\"page_{p}.json\").exists() for p in range(1, total_pages + 1)))\n139: \n140:     if all_pages_cached:\n141:         print(f\"[+] All {total_pages} pages previously extracted in cache. Loading instantly...\")\n142:         all_items = []\n143:         for p in range(1, total_pages + 1):\n144:             res_file = cache_dir / \"results\" / f\"page_{p}.json\"\n145:             with open(res_file, \"r\", encoding=\"utf-8\") as f:\n146:                 p_data = json.load(f)\n147:                 items = p_data.get(\"items\", [])\n148:                 for it in items:\n149:                     it[\"source_file\"] = filepath.name\n150:                     if \"source_page\" not in it:\n151:                         it[\"source_page\"] = p\n152:                 all_items.extend(items)\n153:         print(f\"[+] Loaded {len(all_items)} items from cache in 0.05s.\")\n154:         return all_items\n155: \n156:     # Process pending pages\n157:     print(f\"[*] Starting/Resuming Vision extraction across {total_pages} page(s)...\")\n158: \n159:     for page_num in range(1, total_pages + 1):\n160:         page_res_path = cache_dir / \"results\" / f\"page_{page_num}.json\"\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
