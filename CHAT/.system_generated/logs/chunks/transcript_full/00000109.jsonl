tical search with full OCR support.\"\"\"\n62:     if not text:\n63:         return \"\"\n64:     text = str(text).lower()\n65:     text = re.sub(r'[\\u064B-\\u065F\\u0670\\u0640]', '', text)  # Remove Arabic diacritics and tatweel\n66:     text = re.sub(r'[أإآٱ]', 'ا', text)\n67:     text = re.sub(r'ة', 'ه', text)\n68:     text = re.sub(r'[ىي\\u06CC]', 'ي', text)  # Arabic Yeh, Alef Maqsura, Farsi Yeh\n69:     ocr_map = {\n70:         '\\u06A9': 'ك', '\\u067E': 'ب', '\\u06AF': 'ك', '\\u0686': 'ج',\n71:         '\\u06BA': 'ن', '\\u0679': 'ت', '\\u0688': 'د', '\\u0698': 'ز',\n72:         '\\u06C0': 'ه', '\\u06C1': 'ه'\n73:     }\n74:     for k_c, v_c in ocr_map.items():\n75:         text = text.replace(k_c, v_c)\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
