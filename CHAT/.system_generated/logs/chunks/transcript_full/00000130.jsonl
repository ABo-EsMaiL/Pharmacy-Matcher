{"step_index":6237,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-24T01:14:53Z","content":"Created At: 2026-09-24T04:14:53+03:00\nCompleted At: 2026-09-24T04:14:53+03:00\nFile Path: `file:///D:/AI_Engineer/Pharmacy-agy/desktop_app/server_manager.py`\nTotal Lines: 322\nTotal Bytes: 12142\nShowing lines 1 to 322\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"\"\"\n2: Multi-Server Manager for Pharmacy Matcher.\n3: Supports dual local AI servers:\n4: 1. MSEMAX ChatGPT (OpenAI Web Hook) on Port 8000\n5: 2. MSEMAX Google AI Studio (Gemini Web Hook) on Port 8001\n6: \n7: Provides start, stop, test (live latency & ping), session login, and 1-click active switching.\n8: \"\"\"\n9: \n10: import subprocess\n11: import os\n12: import signal\n13: import time\n14: import sys\n15: import threading\n16: import socket\n17: from pathlib import Path\n18: import requests\n19: \n20: DEFAULT_SERVERS = {\n21:     \"chatgpt\": {\n22:         \"name\": \"MSEMAX (ChatGPT / OpenAI)\",\n23:         \"default_dir\": r\"D:\\AI_Engineer\\MSEMAX\",\n24:         \"port\": 8000,\n25:         \"default_model\": \"gpt-4o\",\n26:         \"url\": \"http://127.0.0.1:8000/v1/chat/completions\",\n27:         \"api_key\": \"[REDACTED_CREDENTIAL]\"\n28:     },\n29:     \"gaistudio\": {\n30:         \"name\": \"MSEMAX (Google AI Studio)\",\n31:         \"default_dir\": r\"D:\\AI_Engineer\\MSEMAX-GAIStudio\",\n32:         \"port\": 8001,\n33:         \"default_model\": \"gemini-3.8-flash\",\n34:         \"url\": \"http://127.0.0.1:8001/v1/chat/completions\",\n35:         \"api_key\": \"[REDACTED_CREDENTIAL]\"\n36:     }\n37: }\n38: \n39: def is_port_listening(port: int, host: str = \"127.0.0.1\", timeout: float = 0.5) -> bool:\n40:     try:\n41:         with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:\n42:             s.settimeout(timeout)\n43:             return s.connect_ex((host, port)) == 0\n44:     except Exception:\n45:         return False\n46: \n47: class ServerInstance:\n48:     def __init__(self, key: str, config: dict, logger_callback=None):\n49:         self.key = key\n50:         self.name = config.get(\"name\", key)\n51:         self.dir = config.get(\"dir\", config.get(\"default_dir\", \"\"))\n52:         self.port = int(config.get(\"port\", 8000))\n53:         self.default_model = config.get(\"default_model\", \"gpt-4o\")\n54:         self.url = config.get(\"url\", f\"http://127.0.0.1:{self.port}/v1/chat/completions\")\n55:         self.api_key = config.get(\"api_key\", \"[REDACTED_CREDENTIAL]\")\n56:         self.process = None\n57:         self.logger = logger_callback\n58: \n59:     def log(self, message: str):\n60:         prefix = f\"[{self.name}]\"\n61:         if self.logger:\n62:             self.logger(f\"{prefix} {message}\")\n63:         else:\n64:             print(f\"{prefix} {message}\")\n65: \n66:     def is_running(self) -> bool:\n67:         if self.process is not None and self.process.poll() is None:\n68:             return True\n69:         return is_port_listening(self.port)\n70: \n71:     def _read_output(self, pipe):\n72:         try:\n73:             for line in iter(pipe.readline, ''):\n74:                 if line:\n75:                     self.log(line.strip())\n76:         except Exception:\n77:             pass\n78:         finally:\n79:             pipe.close()\n80: \n81:     def start(self) -> dict:\n82:         if self.is_running():\n83:             self.log(f\"Server is already running on port {self.port}.\")\n84:             return {\"success\": True, \"message\": \"already running\", \"port\": self.port}\n85: \n86:         target_dir = Path(self.dir)\n87:         if not target_dir.exists():\n88:             self.log(f\"Error: Directory not found: {self.dir}\")\n89:             return {\"success\": False, \"message\": f\"Directory not found: {self.dir}\"}\n90: \n91:         app_script = target_dir / \"app.py\"\n92:         if not app_script.exists():\n93:             self.log(f\"Error: app.py not found in {self.dir}\")\n94:             return {\"success\": False, \"message\": f\"app.py not found in {self.dir}\"}\n95: \n96:         try:\n97:             creationflags = 0\n98:             if os.name == 'nt':\n99:                 creationflags = subprocess.CREATE_NO_WINDOW\n100: \n101:             self.log(f\"Starting server in {self.dir} on port {self.port}...\")\n102:             self.process = subprocess.Popen(\n103:                 [sys.executable, \"app.py\"],\n104:                 cwd=str(target_dir),\n105:                 creationflags=creationflags,\n106:                 stdout=subprocess.PIPE,\n107:                 stderr=subprocess.STDOUT,\n108:                 text=True,\n109:                 bufsize=1\n110:             )\n111: \n112:             t = threading.Thread(target=self._read_output, args=(self.process.stdout,), daemon=True)\n113:             t.start()\n114: \n115:             # Brief check for early crash\n116:             time.sleep(1.5)\n117:             if self.process.poll() is not None:\n118:                 return {\"success\": False, \"message\": f\"Process exited early with code {self.process.returncode}\"}\n119: \n120:             self.log(f\"Server process started successfully (PID: {self.process.pid}).\")\n121:             return {\"success\": True, \"message\": \"started\", \"pid\": self.process.pid, \"port\": self.port}\n122:         except Exception as e:\n123:             self.log(f\"Failed to start server: {e}\")\n124:             return {\"success\": False, \"message\": str(e)}\n125: \n126:     def stop(self) -> dict:\n127:         try:\n128:             self.log(\"Stopping server...\")\n129:             if self.process is not None:\n130:                 if os.name == 'nt':\n131:                     subprocess.run(['taskkill', '/F', '/T', '/PID', str(self.process.pid)], capture_output=True)\n132:                 else:\n133:                     os.killpg(os.getpgid(self.process.pid), signal.SIGTERM)\n134:                 self.process = None\n135: \n136:             # If port is still listening by another orphaned instance, try to find and terminate it\n137:             if is_port_listening(self.port) and os.name == 'nt':\n138:                 try:\n139:                     res = subprocess.run(\n140:                         f'netstat -ano | findstr \":{self.port} \"',\n141:                         shell=True, capture_output=True, text=True\n142:                     )\n143:                     for line in res.stdout.strip().splitlines():\n144:                         parts = line.strip().split()\n145:                         if len(parts) >= 5 and \"LISTENING\" in line:\n146:                             pid = parts[-1]\n147:                             subprocess.run(['taskkill', '/F', '/PID', pid], capture_output=True)\n148:                 except Exception:\n149:                     pass\n150: \n151:             self.log(\"Server stopped.\")\n152:             return {\"success\": True, \"message\": \"stopped\"}\n153:         except Exception as e:\n154:             self.log(f\"Failed to stop server: {e}\")\n155:             return {\"success\": False, \"message\": str(e)}\n156: \n157:     def test(self) -> dict:\n158:         \"\"\"Sends a test ping to the server to check connectivity and response time.\"\"\"\n159:         t0 = time.time()\n160:         try:\n161:             # First check health endpoint\n162:             health_url = f\"http://127.0.0.1:{self.port}/health\"\n163:             health_info = {}\n164:             try:\n165:                 r_h = requests.get(health_url, timeout=3)\n166:                 if r_h.status_code == 200:\n167:                     health_info = r_h.json()\n168:             except Exception:\n169:                 pass\n170: \n171:             # Next, test chat completions\n172:             payload = {\n173:                 \"model\": self.default_model,\n174:                 \"messages\": [\n175:                     {\"role\": \"user\", \"content\": \"Reply with only the exact word: PONG\"}\n176:                 ],\n177:                 \"stream\": False\n178:             }\n179:             r = requests.post(\n180:                 self.url,\n181:                 headers={\n182:                     \"Authorization\": f\"Bearer {self.api_key}\",\n183:                     \"Content-Type\": \"application/json\"\n184:                 },\n185:                 json=payload,\n186:                 timeout=25\n187:             )\n188:             elapsed_ms = int((time.time() - t0) * 1000)\n189: \n190:             if r.status_code == 200:\n191:                 resp = r.json()\n192:                 reply = resp.get(\"choices\", [{}])[0].get(\"message\", {}).get(\"content\", \"\").strip()\n193:                 return {\n194:                     \"success\": True,\n195:                     \"latency_ms\": elapsed_ms,\n196:                     \"reply\": reply,\n197:                     \"model\": self.default_model,\n198:                     \"port\": self.port,\n199:                     \"health\": health_info\n200:                 }\n201:             else:\n202:                 return {\n203:                     \"success\": False,\n204:                     \"latency_ms\": elapsed_ms,\n205:                     \"error\": f\"HTTP {r.status_code}: {r.text[:200]}\",\n206:                     \"port\": self.port\n207:                 }\n208:         except Exception as e:\n209:             elapsed_ms = int((time.time() - t0) * 1000)\n210:             return {\n211:                 \"success\": False,\n212:                 \"latency_ms\": elapsed_ms,\n213:                 \"error\": str(e),\n214:                 \"port\": self.port\n215:             }\n216: \n217:     def run_get_session(self) -> dict:\n218:         try:\n219:             self.log(\"Launching get_session.py...\")\n220:             creationflags = 0\n221:             if os.name == 'nt':\n222:                 creationflags = subprocess.CREATE_NEW_CONSOLE\n223: \n224:             script_file = Path(self.dir) / \"get_session.py\"\n225:             if not script_file.exists():\n226:                 return {\"success\": False, \"output\": f\"get_session.py not found in {self.dir}\"}\n227: \n228:             subprocess.Popen(\n229:                 [sys.executable, \"get_session.py\"],\n230:                 cwd=str(self.dir),\n231:                 creationflags=creationflags\n232:             )\n233:             return {\"success\": True, \"output\": f\"Session browser opened for {self.name}.\"}\n234:         except Exception as e:\n235:             self.log(f\"Failed to launch session: {e}\")\n236:             return {\"success\": False, \"output\": str(e)}\n237: \n238:     def get_status(self) -> dict:\n239:         running = self.is_running()\n240:         pid = self.process.pid if self.process and self.process.poll() is None else None\n241:         return {\n242:             \"key\": self.key,\n243:             \"name\": self.name,\n244:             \"running\": running,\n245:             \"pid\": pid,\n246:             \"port\": self.port,\n247:             \"dir\": self.dir,\n248:             \"model\": self.default_model,\n249:             \"url\": self.url\n250:         }\n251: \n252: class MultiServerManager:\n253:     def __init__(self, settings: dict, logger_callback=None):\n254:         self.logger = logger_callback\n255:         self.servers = {}\n256: \n257:         # 1. ChatGPT Server configuration\n258:         default_c_dir = DEFAULT_SERVERS[\"chatgpt\"][\"default_dir\"]\n259:         explicit_c_dir = settings.get(\"msemax_chatgpt_dir\")\n260:         if not explicit_c_dir and settings.get(\"msemax_dir\") and \"gaistudio\" not in settings.get(\"msemax_dir\").lower():\n261:             explicit_c_dir