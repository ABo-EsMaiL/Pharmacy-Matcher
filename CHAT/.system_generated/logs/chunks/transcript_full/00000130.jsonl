 '_')]).rstrip()\n91:             if not safe_name:\n92:                 safe_name = \"dropped_file.tmp\"\n93:                 \n94:             file_path = temp_dir / safe_name\n95:             with open(file_path, \"wb\") as f:\n96:                 f.write(data)\n97:                 \n98:             return str(file_path)\n99:         except Exception as e:\n100:             self.add_log(f\"Error saving dropped file: {e}\")\n101:             return \"\"\n102: \n103:     def exit_app(self):\n104:         try:\n105:             self.on_closing()\n106:         except:\n107:             pass\n108:         # os._exit guarantees immediate shutdown without blocking background threads like uvicorn\n109:         os._exit(0)\n110:             \n111:     def get_settings(self) -> dict:\n112:         if self._settings_file.exists():\n113:             try:\n114:                 with open(self._settings_file, 'r', encoding='utf-8') as f:\n115:                     data = json.load(f)\n116:                     # Normalize local_api_url if missing /chat/completions\n117:                     if \"local_api_url\" in data:\n118:                         raw = str(data[\"local_api_url\"]).strip().rstrip(\"/\")\n119:                         if not raw.endswith(\"/chat/completions\"):\n120:                             if raw.endswith(\"/v1\"):\n121:                                 data[\"local_api_url\"] = f\"{raw}/chat/completions\"\n122:                             else:\n123:                                 data[\"local_api_url\"] = f\"{raw}/v1/chat/completions\"\n124:                     return data\n125:             except:\n126:                 pass\n127:         return {\n128:             \"unstructured_api_key\": \"\",\n129:             \"local_api_url\": \"http://127.0.0.1:8001/v1/chat/completions\",\n130:             \"local_api_key\": \"[REDACTED_CREDENTIAL]\",\n131:             \"local_model\": \"gemini-3.8-flash\",\n132:             \"active_server\": \"gaistudio\",\n133:             \"msemax_dir\": r\"D:\\AI_Engineer\\MSEMAX\",\n134:             \"msemax_chatgpt_dir\": r\"D:\\AI_Engineer\\MSEMAX\",\n135:             \"msemax_gaistudio_dir\": r\"D:\\AI_Engineer\\MSEMAX-GAIStudio\",\n136:             \"unstructured_profile\": \"balanced\"\n137:         }\n138: \n139:     def save_settings(self, settings_json: str) -> dict:\n140:         try:\n141:             settings = json.loads(settings_json)\n142:             # Ensure URL has /chat/completions\n143:             if \"local_api_url\" in settings:\n144:                 raw = str(settings[\"local_api_url\"]).strip().rstrip(\"/\")\n145:                 if not raw.endswith(\"/chat/completions\"):\n146:                     if raw.endswith(\"/v1\"):\n147:                         settings[\"local_api_url\"] = f\"{raw}/chat/completions\"\n148:                     else:\n149:                         settings[\"local_api_url\"] = f\"{raw}/v1/chat/completions\"\n150: \n151:             self._settings_file.parent.mkdir(parents=True, exist_ok=True)\n152:             with open(self._settings_file, 'w', encoding='utf-8') as f:\n153:                 json.dump(settings, f, ensure_ascii=False, indent=2)\n154:             \n155:             # Refresh server manager with latest settings\n156:             self._server_manager = MSEMAXServerManager(settings, logger_callback=self.add_log)\n157:             return {\"success\": True}\n158:         except Exception as e:\n159:             return {\"success\": False, \"error\": str(e)}\n160: \n161:     def get_servers_info(self) -> str:\n162:         \"\"\"Returns JSON of all servers status and configuration.\"\"\"\n163:         settings = self.get_settings()\n164:         active_key = settings.get(\"active_server\", \"gaistudio\")\n165:         statuses = self._server_manager.get_all_status(active_key=active_key)\n166:         return json.dumps({\n167:             \"servers\": statuses,\n168:             \"active_server\": active_key,\n169:             \"current_url\": settings.get(\"local_api_url\", \"\"),\n170:             \"current_model\": settings.get(\"local_model\", \"\")\n171:         }, ensure_ascii=False)\n172: \n173:     def start_server_instance(self, server_key: str) -> dict:\n174:         \"\"\"Starts a specific server by key ('chatgpt' or 'gaistudio').\"\"\"\n175:         return self._server_manager.start(server_key)\n176: \n177:     def stop_server_instance(self, server_key: str) -> dict:\n178:         \"\"\"Stops a specific server by key.\"\"\"\n179:         return self._server_manager.stop(server_key)\n180: \n181:     def test_server_instance(self, server_key: str) -> dict:\n182:         \"\"\"Sends a test ping to the specified server and measures latency.\"\"\"\n183:         return self._server_manager.test(server_key)\n184: \n185:     def run_server_session(self, server_key: str) -> dict:\n186:         \"\"\"Launches get_session.py for the specified server.\"\"\"\n187:         return self._server_manager.run_get_session(server_key)\n188: \n189:     def set_active_ai_server(self, server_key: str) -> dict:\n190:         \"\"\"\n191:         1-Click Active Switch:\n192:         Switches which server will receive matching batches.\n193:         Updates settings.json (local_api_url, local_model, active_server) automatically.\n194:         \"\"\"\n195:         try:\n196:             settings = self.get_settings()\n197:             srv = self._server_manager.get_server(server_key)\n198:             if not srv:\n199:                 return {\"success\": False, \"error\": f\"Server {server_key} not found\"}\n200: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
