 \r\n148:     # 2. Combination check (كو / بلس)\r\n149:     if has_co(req) != has_co(cand):\r\n150:         return \"reject\", \"combination_mismatch\"\r\n151:         \r\n152:     # 3. Strength check (التركيز خط أحمر - zero tolerance)\r\n153:     str_r = get_strength_pattern(req)\r\n154:     str_c = get_strength_pattern(cand)\r\n155:     if str_r and str_c:\r\n156:         try:\r\n157:             if float(str_r) != float(str_c):\r\n158:                 return \"reject\", f\"strength_conflict_{str_r}_vs_{str_c}\"\r\n159:         except:\r\n160:             if str_r != str_c:\r\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
