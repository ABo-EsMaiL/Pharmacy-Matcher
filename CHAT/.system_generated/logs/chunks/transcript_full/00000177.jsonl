NTA('{sheet_name}'!A:A)-1)\"\n182:         review_formula = f'=COUNTIF(\\'يحتاج مراجعة\\'!D:D, \"{wh_name}\")'\n183:         ws_summary.append([wh_name, matched_formula, review_formula])\n184:         detail_row += 1\n185: \n186:     # تطبيق التنسيق والخطوط على كل خلايا الملخص\n187:     for r in range(2, detail_row):\n188:         if r == 7 or r == 8:\n189:             continue\n190:         for c in range(1, 4):\n191:             cell = ws_summary.cell(row=r, column=c)\n192:             cell.font = _CELL_FONT\n193:             cell.alignment = _CELL_ALIGNMENT\n194:             cell.border = _THIN_BORDER\n195: \n196:     # تنسيق النسب المئوية كـ %\n197:     ws_summary.cell(row=2, column=3).alignment = _CELL_ALIGNMENT\n198:     ws_summary.cell(row=3, column=3).alignment = _CELL_ALIGNMENT\n199:     ws_summary.cell(row=4, column=3).number_format = \"0.0%\"\n200:     ws_summary.cell(row=5, column=3).number_format = \"0.0%\"\n201:     ws_summary.cell(row=6, column=3).number_format = \"0.0%\"\n202: \n203:     _format_sheet(ws_summary, len(summary_headers))\n204: \n205:     # ────────────────────────────────────────\n206:     # ورقة لكل مخزن (المطابقات المؤكدة فقط)\n207:     # ────────────────────────────────────────\n208:     for wh_name, wh_data in warehouse_results.items():\n209:         sheet_name = _truncate_sheet_name(wh_name)\n210:         ws_wh = wb.create_sheet(title=sheet_name)\n211: \n212:         headers = [\"اسم الصنف المطلوب\", \"اسم الصنف في المخزن\", \"درجة التطابق\"]\n213:         ws_wh.append(headers)\n214:         _apply_header_style(ws_wh, len(headers))\n215: \n216:         matched_items = wh_data.get(\"matched\", [])\n217:         rows = []\n218:         for match in matched_items:\n219:             shortage_name = match.get(\"shortage_item\", \"\")\n220:             warehouse_item = match.get(\"warehouse_item\", \"\")\n221:             confidence = _format_confidence(match.get(\"confidence\", \"\"))\n222:             rows.append([shortage_name, wareho