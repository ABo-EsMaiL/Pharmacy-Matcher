�────────────────────────────────\n15: # أنماط التنسيق\n16: # ──────────────────────────────────────────────\n17: _HEADER_FILL = PatternFill(start_color=\"00695C\", end_color=\"00695C\", fill_type=\"solid\")\n18: _HEADER_FONT = Font(name=\"Arial\", bold=True, color=\"FFFFFF\", size=11)\n19: _HEADER_ALIGNMENT = Alignment(\n20:     horizontal=\"center\", vertical=\"center\", wrap_text=True\n21: )\n22: _CELL_FONT = Font(name=\"Arial\", size=10)\n23: _CELL_ALIGNMENT = Alignment(horizontal=\"right\", vertical=\"center\", wrap_text=True)\n24: _THIN_BORDER = Border(\n25:     left=Side(style=\"thin\"),\n26:     right=Side(style=\"thin\"),\n27:     top=Side(style=\"thin\"),\n28:     bottom=Side(style=\"thin\"),\n29: )\n30: \n31: \n32: def _apply_header_style(ws, num_cols: int) -> None:\n33:     \"\"\"تطبيق تنسيق الرأس على الصف الأول.\"\"\"\n34:     for col_idx in range(1, num_cols + 1):\n35:         cell = ws.cell(row=1, column=col_idx)\n36:         cell.fill = _HEADER_FILL\n37:         cell.font = _HEADER_FONT\n38:         cell.alignment = _HEADER_ALIGNMENT\n39:         cell.border = _THIN_BORDER\n40: \n41: \n42: def _format_sheet(ws, num_cols: int) -> None:\n43:     \"\"\"تنسيق الورقة: تجميد الصف الأول، فلتر تلقائي، RTL، عرض الأعمدة.\"\"\"\n44:     # تجميد الصف الأول\n45:     ws.freeze_panes = \"A2\"\n46: \n47:     # فلتر تلقائي\n48:     if ws.max_row > 0 and num_cols > 0:\n49:         last_col_letter = get_column_letter(num_cols)\n50:         ws.auto_filter.ref = f\"A1:{last_col_letter}{ws.max_row}\"\n51: \n52:     # اتجاه الورقة من اليمين لليسار\n53:     ws.sheet_view.rightToLeft = True\n54: \n55:     # عرض الأعمدة التلقائي (تقدير بسيط)\n56:     for col_idx in range(1, num_cols + 1):\n57:         max_length = 0\n58:         col_letter = get_column_letter(col_idx)\n59:         for row in ws.iter_rows(\n60:             min_col=col_idx, max_col=col_idx, min_row=1, max_row=ws.max_row\n61:         ):\n62:             for cell in row:\n63:                 if cell.value:\n64:                     # حساب العرض التقريبي (الحروف العربية أعرض)\n65:                     cell_len = len(str(cell.value))\n66:                     max_length = max(max_length, cell_len)\n67:         # حد أدنى 12، حد أقصى 60\n68:         adjusted_width = min(max(max_length + 4, 12), 60)\n69:         ws.column_dimensions[col_letter].width = adjusted_width\n70: \n71: \n72: def _add_data_rows(ws, rows: list[list], start_row: int = 2) -> None:\n73:     \"\"\"إضافة صفوف البيانات مع التنسيق.\"\"\"\n74:     for row_idx, row_data in enumerate(rows, start=start_row):\n75:         for col_idx, value in enumerate(row_data, start=1):\n76:             cell = ws.cell(row=row_idx, column=col_idx, value=value)\n77:             cell.font = _CELL_FONT\n78:             cell.alignment = _CELL_ALIGNMENT\n79:             cell.border = _THIN_BORDER\n80: \n81: \n82: def _truncate_sheet_name(name: str, max_len: int = 31) -> str:\n83:     \"\"\"\n84:     اقتطاع اسم الورقة ليتوافق مع حد Excel (31 حرفاً).\n85:     يزيل أيضاً الأحرف غير المسموح بها في أسماء الأوراق.\n86:     \"\"\"\n87:     # إزالة الأحرف غير المسموح بها في أسماء أوراق Excel\n88:     invalid_chars = r\"[]:*?/\\\\\"\n89:     for ch in invalid_chars:\n90:         name = name.replace(ch, \"_\")\n91:     return name[:max_len]\n92: \n93: \n94: def _format_confidence(conf_raw: str) -> str:\n95:     \"\"\"تحويل قيم درجة التطابق الإنجليزية والتقنية إلى مصطلحات عربية واضحة.\"\"\"\n96:     if not conf_raw:\n97:         return \"\"\n98:     conf_str = str(conf_raw).strip()\n99:     conf_lower = conf_str.lower()\n100:     if conf_lower == \"exact\":\n101:         return \"تطابق تام (100%)\"\n102:     elif conf_lower == \"llm\":\n103:         return \"مطابقة ذكية (AI)\"\n104:     elif conf_lower.startswith(\"high\"):\n105:         m = re.search(r\"([\\d\\.]+)\", conf_str)\n106:         if m:\n107:             pct = int(float(m.group(1)) * 100)\n108:             return f\"تطابق نصي دقيق ({pct}%)\"\n109:         return \"تطابق نصي دقيق\"\n110:     elif conf_str == \"تأكيد يدوي (مراجعة)\":\n111:         return conf_str\n112:     return conf_str\n113: \n114: \n115: def write_results_excel(results: dict, output_path: Path) -> Path:\n116:     \"\"\"\n117:     إنشاء ملف Excel منظم يحتوي على:\n118:         - ملخص ديناميكي مربوط بمعادلات Excel التلقائية\n119:         - ورقة لكل مخزن تحتوي على المطابقات المؤكدة\n120:         - ورقة للأصناف التي تحتاج مراجعة\n121:         - ورقة للأصناف التي لم يُعثر عليها\n122: \n123:     المعاملات:\n124:         results: قاموس يحتوي على:\n125:             - warehouse_results: نتائج كل مخزن\n126:             - not_found: الأصناف غير الموجودة\n127:             - summary: ملخص إحصائي\n128:         output_path: مسار ملف Excel الناتج.\n129:     \"\"\"\n130:     wb = Workbook()\n131: \n132:     # ────────────────────────────────────────\n133:     # ورقة الملخص (ديناميكية مربوطة بالمعادلات)\n134:     # ────────────────────────────────────────\n135:     ws_summary = wb.active\n136:     ws_summary.title = \"ملخص\"\n137: \n138:     summary = results.get(\"summary\", {})\n139:     warehouse_results = results.get(\"warehouse_results\", {})\n140: \n141:     summary_headers = [\"البند\", \"العدد\", \"النسبة\"]\n142:     ws_summary.append(summary_headers)\n143:     _apply_header_style(ws_summary, len(summary_headers))\n144: \n145:     raw_total = summary.get(\"total_shortages\", 0)\n146:     unique_total = summary.get(\"unique_shortages\", 0)\n147: \n148:     # Row 2: إجمالي طلبات النواقص (الأسطر الأصلية)\n149:     ws_summary.append([\"إجمالي طلبات النواقص (الأسطر)\", raw_total, \"-\"])\n150: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
