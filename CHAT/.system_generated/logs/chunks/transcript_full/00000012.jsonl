{"step_index":331,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-21T22:18:42Z","content":"Created At: 2026-09-22T01:18:42+03:00\nCompleted At: 2026-09-22T01:18:42+03:00\nFile Path: `file:///d:/AI_Engineer/Pharmacy-agy/src/extract/pdf_reader.py`\nTotal Lines: 363\nTotal Bytes: 12958\nShowing lines 1 to 363\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"\"\"\n2: وحدة قراءة ملفات PDF - استخراج أسماء الأدوية باستخدام Unstructured API.\n3: PDF reader module - extracts drug names using the Unstructured API.\n4: \"\"\"\n5: \n6: from pathlib import Path\n7: import json\n8: import re\n9: import time\n10: import requests\n11: \n12: \n13: # الحد الأقصى لعدد محاولات الاستعلام عن حالة المهمة غير المتزامنة\n14: _MAX_POLL_ATTEMPTS = 60\n15: # الفاصل الزمني بين محاولات الاستعلام (بالثواني)\n16: _POLL_INTERVAL_SECONDS = 5\n17: \n18: \n19: def extract_from_pdf(\n20:     filepath: Path,\n21:     api_key: str,\n22:     base_url: str = \"https://transform.unstructured.io\",\n23: ) -> dict:\n24:     \"\"\"\n25:     رفع ملف PDF إلى Unstructured API واستخراج العناصر المهيكلة.\n26: \n27:     يدعم كلاً من الاستجابة الفورية (200) والمهام غير المتزامنة (202).\n28: \n29:     Args:\n30:         filepath: مسار ملف PDF.\n31:         api_key: مفتاح Unstructured API.\n32:         base_url: عنوان خادم Unstructured API.\n33: \n34:     Returns:\n35:         استجابة API كاملة (قاموس أو قائمة عناصر).\n36: \n37:     Raises:\n38:         FileNotFoundError: إذا لم يُوجد الملف.\n39:         RuntimeError: إذا فشل الاتصال بـ API أو انتهت مهلة الانتظار.\n40:     \"\"\"\n41:     filepath = Path(filepath)\n42:     if not filepath.exists():\n43:         raise FileNotFoundError(f\"❌ ملف PDF غير موجود: {filepath}\")\n44: \n45:     print(f\"📄 جارٍ رفع ملف PDF إلى Unstructured API: {filepath.name}\")\n46: \n47:     url = f\"{base_url.rstrip('/')}/api/v2/parse\"\n48:     headers = {\"unstructured-api-key\": api_key}\n49: \n50:     # رفع الملف مع إعدادات الاستخراج\n51:     with open(filepath, \"rb\") as f:\n52:         files = {\n53:             \"input\": (filepath.name, f, \"application/pdf\"),\n54:         }\n55:         data = {\n56:             \"profile\": \"best\",\n57:             \"output\": \"elements\",\n58:         }\n59: \n60:         response = requests.post(url, headers=headers, files=files, data=data)\n61: \n62:     # معالجة الاستجابة\n63:     if response.status_code == 200:\n64:         # استجابة فورية - النتائج جاهزة\n65:         print(\"  ✅ تم استخراج البيانات فوراً\")\n66:         result = response.json()\n67: \n68:     elif response.status_code == 202:\n69:         # مهمة غير متزامنة - يجب الانتظار\n70:         poll_url = response.headers.get(\"Location\")\n71:         if not poll_url:\n72:             raise RuntimeError(\n73:                 \"❌ استجابة 202 بدون رابط Location للاستعلام عن حالة المهمة\"\n74:             )\n75: \n76:         print(f\"  ⏳ المهمة غير متزامنة، جارٍ الانتظار...\")\n77:         result = _poll_for_result(poll_url, headers)\n78: \n79:     else:\n80:         raise RuntimeError(\n81:             f\"❌ فشل الاتصال بـ Unstructured API\\n\"\n82:             f\"  الحالة: {response.status_code}\\n\"\n83:             f\"  الرد: {response.text[:500]}\"\n84:         )\n85: \n86:     # حفظ الاستجابة الخام كملف JSON بجانب ملف PDF\n87:     json_path = filepath.with_suffix(\".json\")\n88:     with open(json_path, \"w\", encoding=\"utf-8\") as jf:\n89:         json.dump(result, jf, ensure_ascii=False, indent=2)\n90:     print(f\"  💾 تم حفظ الاستجابة الخام: {json_path.name}\")\n91: \n92:     return result\n93: \n94: \n95: def parse_items_from_response(response: dict | list) -> list[dict]:\n96:     elements = _normalize_response(response)\n97: \n98:     items = _try_extracted_data(elements)\n99:     if items:\n100:         print(f\"     -> Extracted {len(items)} items from structured data\")\n101:         return items\n102: \n103:     items = _try_html_tables(elements)\n104:     if items:\n105:         print(f\"     -> Extracted {len(items)} items from HTML tables\")\n106:         return items\n107: \n108:     items = _try_text_content(elements)\n109:     print(f\"     -> Extracted {len(items)} items from raw text content\")\n110:     return items\n111: \n112: \n113: def extract_items_from_pdf(\n114:     filepath: Path,\n115:     api_key: str,\n116:     base_url: str = \"https://transform.unstructured.io\",\n117: ) -> list[dict]:\n118:     \"\"\"\n119:     استخراج أسماء الأصناف من ملف PDF (الدالة الرئيسية).\n120: \n121:     تجمع بين رفع الملف وتحليل الاستجابة.\n122: \n123:     Args:\n124:         filepath: مسار ملف PDF.\n125:         api_key: مفتاح Unstructured API.\n126:         base_url: عنوان خادم Unstructured API.\n127: \n128:     Returns:\n129:         قائمة من القواميس بالشكل:\n130:         {\"item_name_raw\": str, \"source_page\": int|None, \"source_file\": str}\n131:     \"\"\"\n132:     filepath = Path(filepath)\n133: \n134:     # استخراج البيانات من PDF\n135:     response = extract_from_pdf(filepath, api_key, base_url)\n136: \n137:     # تحليل الاستجابة\n138:     items = parse_items_from_response(response)\n139: \n140:     # إضافة اسم الملف المصدر لكل عنصر\n141:     for item in items:\n142:         item[\"source_file\"] = filepath.name\n143: \n144:     return items\n145: \n146: \n147: # ──────────────────────── دوال مساعدة داخلية ────────────────────────\n148: \n149: \n150: def _poll_for_result(poll_url: str, headers: dict) -> dict:\n151:     \"\"\"\n152:     الاستعلام المتكرر عن حالة مهمة غير متزامنة حتى اكتمالها.\n153:     \"\"\"\n154:     for attempt in range(1, _MAX_POLL_ATTEMPTS + 1):\n155:         time.sleep(_POLL_INTERVAL_SECONDS)\n156:         resp = requests.get(poll_url, headers=headers)\n157: \n158:         if resp.status_code != 200:\n159:             print(f\"  ⚠️ خطأ في الاستعلام (محاولة {attempt}): {resp.status_code}\")\n160:             continue\n161: \n162:         data = resp.json()\n163:         status = data.get(\"status\", \"\")\n164: \n165:         if status == \"completed\":\n166:             print(f\"  ✅ اكتملت المهمة (بعد {attempt * _POLL_INTERVAL_SECONDS} ثانية)\")\n167:             # النتائج قد تكون في data[\"elements\"] أو data نفسه\n168:             return data.get(\"elements\", data)\n169: \n170:         if status in (\"failed\", \"error\"):\n171:             raise RuntimeError(\n172:                 f\"❌ فشلت مهمة Unstructured API: {data.get('error', 'خطأ غير معروف')}\"\n173:             )\n174: \n175:         print(\n176:             f\"  ⏳ الحالة: {status} (محاولة {attempt}/{_MAX_POLL_ATTEMPTS})\"\n177:         )\n178: \n179:     raise RuntimeError(\n180:         f\"❌ انتهت مهلة الانتظار ({_MAX_POLL_ATTEMPTS * _POLL_INTERVAL_SECONDS} ثانية) \"\n181:         f\"للمهمة غير المتزامنة\"\n182:     )\n183: \n184: \n185: def _normalize_response(response: dict | list) -> list[dict]:\n186:     \"\"\"تحويل الاستجابة إلى قائمة عناصر موحدة.\"\"\"\n187:     if isinstance(response, list):\n188:         return response\n189:     if isinstance(response, dict):\n190:         # قد تكون العناصر في مفتاح 'elements' أو الاستجابة نفسها عنصر واحد\n191:         if \"elements\" in response:\n192:             return response[\"elements\"]\n193:         return [response]\n194:     return []\n195: \n196: \n197: def _try_extracted_data(elements: list[dict]) -> list[dict]:\n198:     \"\"\"محاولة استخراج الأصناف من حقل extracted_data.\"\"\"\n199:     items: list[dict] = []\n200:     for elem in elements:\n201:         extracted = elem.get(\"extracted_data\")\n202:         if not extracted:\n203:             continue\n204: \n205:         # extracted_data قد يكون قائمة أو قاموس\n206:         if isinstance(extracted, list):\n207:             for entry in extracted:\n208:                 name = entry.get(\"name\") or entry.get(\"item_name\") or entry.get(\"text\", \"\")\n209:                 name = str(name).strip()\n210:                 if name:\n211:                     page = elem.get(\"metadata\", {}).get(\"page_number\")\n212:                     items.append({\"item_name_raw\": name, \"source_page\": page})\n213:         elif isinstance(extracted, dict):\n214:             # قد يحتوي على items أو rows\n215:             for key in (\"items\", \"rows\", \"data\"):\n216:                 if key in extracted and isinstance(extracted[key], list):\n217:                     for entry in extracted[key]:\n218:                         if isinstance(entry, dict):\n219:                             name = (\n220:                                 entry.get(\"name\")\n221:                                 or entry.get(\"item_name\")\n222:                                 or entry.get(\"text\", \"\")\n223:                             )\n224:                         else:\n225:                             name = str(entry)\n226:                         name = str(name).strip()\n227:                         if name:\n228:                             page = elem.get(\"metadata\", {}).get(\"page_number\")\n229:                             items.append({\"item_name_raw\": name, \"source_page\": page})\n230: \n231:     return items\n232: \n233: \n234: def _try_html_tables(elements: list[dict]) -> list[dict]:\n235:     \"\"\"\n236:     محاولة استخراج الأصناف من جداول HTML في عناصر Table.\n237: \n238:     يبحث عن العمود الذي يحتوي على أسماء الأدوية (نص عربي أو أطول النصوص).\n239:     \"\"\"\n240:     items: list[dict] = []\n241:     arabic_pattern = re.compile(r\"[\\u0600-\\u06FF]\")\n242: \n243:     for elem in elements:\n244:         if elem.get(\"type\") != \"Table\":\n245:             continue\n246: \n247:         html = elem.get(\"metadata\", {}).get(\"text_as_html\", \"\")\n248:         if not html:\n249:             continue\n250: \n251:         page = elem.get(\"metadata\", {}).get(\"page_number\")\n252:         table_items = _parse_html_table(html, arabic_pattern)\n253: \n254:         for name in table_items:\n255:             items.append({\"item_name_raw\": name, \"source_page\": page})\n256: \n257:     return items\n258: \n259: \n260: def _parse_html_table(html: str, arabic_pattern: re.Pattern) -> list[str]:\n261:     \"\"\"\n262:     تحليل جدول HTML بسيط واستخراج أسماء الأدوية.\n263: \n264:     يبحث عن العمود الذي يحتوي على نصوص عربية أو أطول النصوص.\n265:     \"\"\"\n266:     # استخراج الصفوف: كل <tr>...</tr>\n267:     row_pattern = re.compile(r\"<tr[^>]*>(.*?)</tr>\", re.DOTALL | re.IGNORECASE)\n268:     cell_pattern = re.compile(r\"<t[dh][^>]*>(.*?)</t[dh]>\", re.DOTALL | re.IGNORECASE)\n269:     tag_stripper = re.compile(r\"<[^>]+>\")\n270: \n271:     rows_html = row_pattern.findall(html)\n272:     if not rows_html:\n273:         return []\n274: \n275:     # تحليل جميع الصفوف إلى قائمة من قوائم الخلايا\n276:     parsed_rows: list[list[str]] = []\n277:     for row_html in rows_html:\n278:         cells = cell_pattern.findall(row_html)\n279:         cleaned = [tag_stripper.sub(\"\", c).strip() for c in cells]\n280:         parsed_rows.append(cleaned)\n281: \n282:     if len(parsed_rows) < 2:\n283:         return []\n284: \n285:     # تحديد عدد الأعمدة\n286:     num_cols = max(len(row) for row in parsed_rows)\n287:     if num_cols == 0:\n288:         return []\n289: \n290:     # البحث عن عمود أسماء الأدوية\n291:     # تخطي الصف الأول (عناوين) وفحص بقية الصفوف\n292:     data_rows = parsed_rows[1:]\n293:     best_col = 0\n294:     best_score = -1\n295: \n296:     for col_idx in range(num_cols):\n297:         score = 0\n298:         for row in data_rows:\n299:             if col_idx >= len(row):\n300:                 continue\n301:             cell_text = row[col_idx]\n302:             arabic_count = len(arabic_pattern.findall(cell_text))\n303:             if arabic_count > 0:\n304:                 score += len(cell_text) * (arabic_count / max(len(cell_text), 1))\n305: \n306:         if score > best_score:\n307:             best_score = score\n308:             best_col = col_idx\n309: \n310:     # إذا لم يُعثر على نص عربي، اختيار العمود الأطول\n311:     if best_score <= 0:\n312:         col_lengths = [0] * num_cols\n313:         for row in data_rows:\n314:             for col_idx, cell in enumerate(row):\n315:                 col_lengths[col_idx] += len(cell)\n316:         best_col = col_lengths.index(max(col_lengths)) if col_lengths else 0\n317: \n318:     # استخراج القيم من العمود المحدد\n319:     names: list[str] = []\n320:     for row in data_rows:\n321:         if best_col < len(row):\n322:             name = row[best_col].strip()\n323:             if name:\n324:                 names.append(name)\n325: \n326:     return names\n327: \n328: \n329: def _try_text_content(elements: list[dict]) -> list[dict]:\n330:     \"\"\"\n331:     محاولة استخراج الأصناف من المحتوى النصي.\n332: \n333:     يجمع النصوص من عناصر NarrativeText وTitle ويفصلها بالأسطر.\n334:     \"\"\"\n335:     items: list[dict] = []\n336:     arabic_pattern = re.compile(r\"[\\u0600-\\u06FF]\")\n337: \n338:     for elem in elements:\n339:         elem_type = elem.get(\"type\", \"\")\n340:         if elem_type not in (\"NarrativeText\", \"Title\", \"ListItem\", \"UncategorizedText\"):\n341:             continue\n342: \n343:         text = elem.get(\"text\", \"\").strip()\n344:         if not text:\n345:             continue\n346: \n347:         page = elem.get(\"metadata\", {}).get(\"page_number\")\n348: \n349:         # تقسيم النص إلى أسطر وفحص كل سطر\n350:         for line in text.split(\"\\n\"):\n351:             line = line.strip()\n352:             if not line or len(line) < 3:\n353:                 continue\n354: \n355:             # قبول الأسطر التي تحتوي على نص عربي أو أسماء أدوية (حروف لاتينية + أرقام)\n356:             has_arabic = bool(arabic_pattern.search(line))\n357:             has_drug_chars = bool(re.search(r\"[a-zA-Z]{3,}\", line))\n358: \n359:             if has_arabic or has_drug_chars:\n360:                 items.append({\"item_name_raw\": line, \"source_page\": page})\n361: \n362:     return items\n363: \nThe above content shows the entire, complete file contents of the requested file.\n"}
