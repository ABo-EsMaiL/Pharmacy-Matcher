{"step_index":6383,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-24T01:21:18Z","tool_calls":[{"name":"replace_file_content","args":{"AllowMultiple":false,"Description":"Implement server terminal log functions and robust test/toggle logic","EndLine":3302,"Instruction":"Update toggleServerInstance, testServerInstance, add appendServerLog, loadServerLogs, clearServerLogs, and screen-servers handler","ReplacementContent":"async function toggleServerInstance(serverKey, startIt) {\n    const t = I18N[currentLang] || I18N.ar;\n    const btn = document.getElementById(`btn-toggle-${serverKey}`);\n    if (btn) {\n        btn.disabled = true;\n        btn.innerHTML = `<i class=\"ph-fill ph-spinner-gap spinner\"></i> <span>${currentLang === 'en' ? 'Processing...' : 'جاري المعالجة...'}</span>`;\n    }\n\n    try {\n        let res;\n        if (startIt) {\n            showToast(currentLang === 'en' ? `Starting ${serverKey}...` : `جاري تشغيل سيرفر ${serverKey}...`, 'info');\n            appendServerLog(`[SYSTEM] Starting server instance '${serverKey}'...`);\n            res = await window.pywebview.api.start_server_instance(serverKey);\n        } else {\n            showToast(currentLang === 'en' ? `Stopping ${serverKey}...` : `جاري إيقاف سيرفر ${serverKey}...`, 'info');\n            appendServerLog(`[SYSTEM] Stopping server instance '${serverKey}'...`);\n            res = await window.pywebview.api.stop_server_instance(serverKey);\n        }\n\n        if (res.success) {\n            appendServerLog(`[SYSTEM] Server '${serverKey}' operation succeeded: ${res.message || 'OK'}`);\n            showToast(res.message || (currentLang === 'en' ? 'Operation successful' : 'تمت العملية بنجاح'), 'success');\n        } else {\n            appendServerLog(`[WARNING] Server '${serverKey}' stop/start: ${res.message || res.error || 'Failed'}`);\n            if (res.elevated) {\n                showCustomConfirm(\n                    currentLang === 'en' ? 'Administrator Process' : 'تنبيه: السيرفر يعمل كمسؤول',\n                    res.message || 'السيرفر يعمل في نافذة PowerShell سابقة بصلاحيات المسؤول. يرجى إغلاقه يدوياً.',\n                    () => {}\n                );\n            } else {\n                showToast((currentLang === 'en' ? 'Error: ' : 'خطأ: ') + (res.message || res.error || 'Failed'), 'error');\n            }\n        }\n    } catch (e) {\n        appendServerLog(`[ERROR] Connection error with server '${serverKey}': ${e.message}`);\n        showToast(currentLang === 'en' ? 'Connection error' : 'حدث خطأ في الاتصال', 'error');\n        console.error(e);\n    } finally {\n        await loadServersUI();\n        await updateServerStatus();\n    }\n}\n\nasync function setActiveServer(serverKey) {\n    const t = I18N[currentLang] || I18N.ar;\n    try {\n        const res = await window.pywebview.api.set_active_ai_server(serverKey);\n        if (res.success) {\n            const srvName = serverKey === 'gaistudio' ? 'Google AI Studio (Port 8001)' : 'ChatGPT (Port 8000)';\n            appendServerLog(`[SYSTEM] Switched active matching provider to: ${srvName}`);\n            showToast(currentLang === 'en' ? `Activated ${srvName} for matching!` : `تم تعيين ${srvName} كمزود نشط لعمليات المطابقة بنجاح!`, 'success');\n            await loadServersUI();\n            await loadSettings();\n            await updateServerStatus();\n        } else {\n            showToast((currentLang === 'en' ? 'Activation failed: ' : 'فشل التفعيل: ') + res.error, 'error');\n        }\n    } catch (e) {\n        showToast(currentLang === 'en' ? 'Connection error' : 'خطأ في الاتصال', 'error');\n        console.error(e);\n    }\n}\n\nfunction appendServerLog(line) {\n    const term = document.getElementById('ai-server-terminal');\n    if (!term) return;\n    const now = new Date().toLocaleTimeString('en-US', { hour12: false });\n    term.value += `[${now}] ${line}\\n`;\n    term.scrollTop = term.scrollHeight;\n}\n\nasync function loadServerLogs() {\n    const term = document.getElementById('ai-server-terminal');\n    if (!term || !window.pywebview?.api?.get_server_logs) return;\n    try {\n        const raw = await window.pywebview.api.get_server_logs();\n        const logs = JSON.parse(raw || '[]');\n        if (logs.length > 0) {\n            term.value = logs.join('\\n') + '\\n';\n        } else if (!term.value.trim()) {\n            term.value = '--- شاشة سجلات وخادم الذكاء الاصطناعي (AI Server Console) جاهزة ---\\nاضغط على \"اختبار الاتصال\" أو قم بتشغيل أي سيرفر لمشاهدة المخرجات هنا مباشرة.\\n';\n        }\n        term.scrollTop = term.scrollHeight;\n    } catch (e) {\n        console.error('Failed to load server logs', e);\n    }\n}\n\nasync function clearServerLogs() {\n    const term = document.getElementById('ai-server-terminal');\n    if (term) term.value = '';\n    try {\n        if (window.pywebview?.api?.clear_server_logs) {\n            await window.pywebview.api.clear_server_logs();\n        }\n        showToast(currentLang === 'en' ? 'Server logs cleared' : 'تم مسح سجل السيرفرات بنجاح', 'success');\n    } catch (e) {\n        console.error(e);\n    }\n}\n\n// Live Server Log Event Listener\nwindow.addEventListener('new_server_log', (event) => {\n    appendServerLog(event.detail);\n});\n\nasync function testServerInstance(serverKey) {\n    const t = I18N[currentLang] || I18N.ar;\n    const btn = document.getElementById(`btn-test-${serverKey}`);\n    const originalHtml = btn ? btn.innerHTML : '';\n    \n    if (btn) {\n        btn.disabled = true;\n        btn.innerHTML = `<i class=\"ph-fill ph-spinner-gap spinner\"></i> <span>${t.server_testing || 'جاري الفحص...'}</span>`;\n    }\n\n    appendServerLog(`Sending test ping to server instance '${serverKey}'...`);\n\n    try {\n        const res = await window.pywebview.api.test_server_instance(serverKey);\n        if (res.success) {\n            const latencyStr = res.latency_ms ? `${res.latency_ms} ms` : `${res.latency || 0}s`;\n  