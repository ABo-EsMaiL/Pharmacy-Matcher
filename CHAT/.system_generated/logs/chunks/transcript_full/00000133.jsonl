--\\n` +\n                `• Error Details : ${res.error}\\n` +\n                `--------------------------------------------------\\n` +\n                `💡 Suggestion: Ensure the server is started and that port ${res.port || '8000/8001'} is listening.`;\n            if (outputEl) outputEl.innerText = failReport;\n            showToast((currentLang === 'en' ? 'Ping failed: ' : 'فشل اختبار الاتصال: ') + res.error, 'error');\n        }\n    } catch (e) {\n        if (outputEl) outputEl.innerText += `\\n❌ Unexpected client error during test: ${e.message}`;\n        showToast(currentLang === 'en' ? 'Test error' : 'حدث خطأ أثناء الاختبار', 'error');\n    } finally {\n        if (btn) {\n            btn.disabled = false;\n            btn.innerHTML = originalHtml;\n        }\n        await loadServersUI();\n    }\n}\n\nasync function openServerSession(serverKey) {\n    const t = I18N[currentLang] || I18N.ar;\n    try {\n        showToast(currentLang === 'en' ? `Opening login session for ${serverKey}...` : `جاري فتح متصفح تسجيل الدخول لسيرفر ${serverKey}...`, 'success');\n        const res = await window.pywebview.api.run_server_session(serverKey);\n        if (res.success) {\n            showToast(currentLang === 'en' ? 'Browser session window opened' : 'تم فتح نافذة المتصفح لتسجيل الدخول بنجاح', 'success');\n        } else {\n            showToast((currentLang === 'en' ? 'Session error: ' : 'خطأ في فتح الجلسة: ') + res.error, 'error');\n        }\n    } catch (e) {\n        showToast(currentLang === 'en' ? 'Error opening session' : 'حدث خطأ أثناء فتح الجلسة', 'error');\n    }\n}\n\nfunction clearServerTestLog() {\n    const outputEl = document.getElementById('server-test-output');\n    const t = I18N[currentLang] || I18N.ar;\n    if (outputEl) {\n        outputEl.innerText = t.test_panel_empty || 'اضغط على زر \"اختبار الاتصال السريع\" في أي سيرفر لقياس زمن الاستجابة والتأكد من جاهزيته...';\n    }\n}\n    </script>\n    <script>\n        // Override showScreen to handle active states on sidebar\n        const originalShowScreen = window.showScreen;\n        window.showScreen = function(screenId, element = null) {\n            // Call original if it exists\n            if (typeof originalShowScreen === 'function') {\n                originalShowScreen(screenId);\n            } else {\n                document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));\n                const target = document.getElementById(screenId);\n                if (target) target.classList.add('active');\n            }\n            \n            // Update sidebar active class\n            if (element) {\n                document.querySelectorAll('.nav-item').forEach(btn => btn.classList.remove('active'));\n                element.classList.add('active');\n            }\n\n            // Update top bar heading\n            if (typeof updateTopBarHeading === 'function') {\n                updateTopBarHeading(screenId);\n            }\n\n            if (screenId === 'screen-new') {\n                resetNewProcessForm();\n            } else if (screenId === 'screen-logs' || screenId === 'screen-settings') {\n                loadLogs();\n            } else if (screenId === 'screen-servers') {\n                loadServersUI();\n            }\n        };","TargetFile":"D:\\AI_Engineer\\Pharmacy-agy\\desktop_app\\templates\\index.html","toolAction":"Updating JS server functions and live terminal","toolSummary":"Update JS for server terminal and testing"}}]}
