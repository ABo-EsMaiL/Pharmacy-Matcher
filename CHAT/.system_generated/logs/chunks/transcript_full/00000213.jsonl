' stop/start: ${res.message || res.error || 'Failed'}`);\n3383:             if (res.elevated) {\n3384:                 showCustomConfirm(\n3385:                     currentLang === 'en' ? 'Administrator Process' : 'تنبيه: السيرفر يعمل كمسؤول',\n3386:                     res.message || 'السيرفر يعمل في نافذة PowerShell سابقة بصلاحيات المسؤول. يرجى إغلاقه يدوياً.',\n3387:                     () => {}\n3388:                 );\n3389:             } else {\n3390:                 showToast((currentLang === 'en' ? 'Error: ' : 'خطأ: ') + (res.message || res.error || 'Failed'), 'error');\n3391:             }\n3392:         }\n3393:     } catch (e) {\n3394:         appendServerLog(`[ERROR] Connection error with server '${serverKey}': ${e.message}`);\n3395:         showToast(currentLang === 'en' ? 'Connection error' : 'حدث خطأ في الاتصال', 'error');\n3396:         console.error(e);\n3397:     } finally {\n3398:         await loadServersUI();\n3399:         await updateServerStatus();\n3400:     }\n3401: }\n3402: \n3403: async function setActiveServer(serverKey) {\n3404:     const t = I18N[currentLang] || I18N.ar;\n3405:     try {\n3406:         const res = await window.pywebview.api.set_active_ai_server(serverKey);\n3407:         if (res.success) {\n3408:             const srvName = serverKey === 'gaistudio' ? 'Google AI Studio (Port 8001)' : 'ChatGPT (Port 8000)';\n3409:             appendServerLog(`[SYSTEM] Switched active matching provider to: ${srvName}`);\n3410:             showToast(currentLang === 'en' ? `Activated ${srvName} for matching!` : `تم تعيين ${srvName} كمزود نشط لعمليات المطابقة بنجاح!`, 'success');\n3411:             await loadServersUI();\n3412:             await loadSettings();\n3413:             await updateServerStatus();\n3414:         } else {\n3415:             showToast((currentLang === 'en' ? 'Activation failed: ' : 'فشل التفعيل: ') + res.error, 'error');\n3416:         }\n3417:     } catch (e) {\n3418:         showToast(currentLang === 'en' ? 'Connection error' : 'خطأ في الاتصال', 'error');\n3419:         console.error(e);\n3420:     }\n3421: }\n3422: \n3423: function appendServerLog(line) {\n3424:     const term = document.getElementById('ai-server-terminal');\n3425:     if (!term) return;\n3426:     const now = new Date().toLocaleTimeString('en-US', { hour12: false });\n3427:     term.value += `[${now}] ${line}\\n`;\n3428:     term.scrollTop = term.scrollHeight;\n3429: }\n3430: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
