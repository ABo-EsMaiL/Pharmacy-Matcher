{"step_index":10408,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-25T14:41:12Z","content":"Created At: 2026-09-25T17:41:12+03:00\nCompleted At: 2026-09-25T17:41:12+03:00\nFile Path: `file:///d:/AI_Engineer/Pharmacy-agy-vision/desktop_app/templates/index.html`\nTotal Lines: 3602\nTotal Bytes: 146634\nShowing lines 3058 to 3110\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n3058: async function loadSettings() {\n3059:     try {\n3060:         const settings = await window.pywebview.api.get_settings();\n3061:         if (settings) {\n3062:             document.getElementById('setting-unstructured-key').value = settings.unstructured_api_key || '';\n3063:             const profileEl = document.getElementById('setting-unstructured-profile');\n3064:             if (profileEl) profileEl.value = settings.unstructured_profile || 'balanced';\n3065:             const visionUrlEl = document.getElementById('setting-vision-url');\n3066:             if (visionUrlEl) visionUrlEl.value = settings.vision_api_url || 'http://127.0.0.1:8001/v1/chat/completions';\n3067:             const visionModelEl = document.getElementById('setting-vision-model');\n3068:             if (visionModelEl) visionModelEl.value = settings.vision_model || 'gemini-3.8-flash';\n3069:             document.getElementById('setting-local-url').value = settings.local_api_url || 'http://127.0.0.1:8001/v1/chat/completions';\n3070:             document.getElementById('setting-local-key').value = settings.local_api_key || '';\n3071:             document.getElementById('setting-model-name').value = settings.local_model || 'gemini-3.8-flash';\n3072:             document.getElementById('setting-msemax-dir').value = settings.msemax_dir || '';\n3073:         }\n3074:     } catch (error) {\n3075:         console.error('Failed to load settings', error);\n3076:     }\n3077: }\n3078: \n3079: async function saveSettings() {\n3080:     const profileEl = document.getElementById('setting-unstructured-profile');\n3081:     const visionUrlEl = document.getElementById('setting-vision-url');\n3082:     const visionModelEl = document.getElementById('setting-vision-model');\n3083:     const settings = {\n3084:         unstructured_api_key: document.getElementById('setting-unstructured-key')?.value || '',\n3085:         unstructured_profile: profileEl ? profileEl.value : 'balanced',\n3086:         vision_api_url: visionUrlEl ? visionUrlEl.value.trim() : 'http://127.0.0.1:8001/v1/chat/completions',\n3087:         vision_model: visionModelEl ? visionModelEl.value.trim() : 'gemini-3.8-flash',\n3088:         local_api_url: document.getElementById('setting-local-url')?.value || '',\n3089:         local_api_key: document.getElementById('setting-local-key')?.value || '',\n3090:         local_model: document.getElementById('setting-model-name')?.value || '',\n3091:         msemax_dir: document.getElementById('setting-msemax-dir')?.value || ''\n3092:     };\n3093:     \n3094:     try {\n3095:         await window.pywebview.api.save_settings(JSON.stringify(settings));\n3096:         showToast(I18N[currentLang]?.toast_saved || 'تم حفظ الإعدادات بنجاح', 'success');\n3097:     } catch (error) {\n3098:         showToast(currentLang === 'en' ? 'Error saving settings' : 'حدث خطأ أثناء حفظ الإعدادات', 'error');\n3099:     }\n3100: }\n3101: \n3102: async function selectMsemaxDir() {\n3103:     try {\n3104:         const dirPath = await window.pywebview.api.select_directory();\n3105:         if (dirPath) {\n3106:             document.getElementById('setting-msemax-dir').value = dirPath;\n3107:         }\n3108:     } catch (error) {\n3109:         console.error(error);\n3110:     }\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
