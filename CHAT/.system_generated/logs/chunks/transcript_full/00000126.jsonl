rAll('.screen').forEach(s => s.classList.remove('active'));\n2939:                 const target = document.getElementById(screenId);\n2940:                 if (target) target.classList.add('active');\n2941:             }\n2942:             \n2943:             // Update sidebar active class\n2944:             if (element) {\n2945:                 document.querySelectorAll('.nav-item').forEach(btn => btn.classList.remove('active'));\n2946:                 element.classList.add('active');\n2947:             }\n2948: \n2949:             // Update top bar heading\n2950:             if (typeof updateTopBarHeading === 'function') {\n2951:                 updateTopBarHeading(screenId);\n2952:             }\n2953: \n2954:             if (screenId === 'screen-new') {\n2955:                 resetNewProcessForm();\n2956:             } else if (screenId === 'screen-logs' || screenId === 'screen-settings') {\n2957:                 loadLogs();\n2958:             }\n2959:         };\n2960:         // Auto select first nav item and initialize language\n2961:         document.addEventListener(\"DOMContentLoaded\", () => {\n2962:             setLanguage(currentLang);\n2963:             const firstNav = document.querySelector('.nav-item');\n2964:             if (firstNav) firstNav.classList.add('active');\n2965:         });\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
{"step_index":6002,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-24T00:50:38Z","tool_calls":[{"name":"replace_file_content","args":{"AllowMultiple":false,"Description":"Add AI Servers manager JS functions and screen switcher hooks","EndLine":2960,"Instruction":"Add loadServersUI, toggleServerInstance, setActiveServer, testServerInstance, openServerSession, clearServerTestLog and integrate with showScreen","ReplacementContent":"    // Update top bar server badge\n    const topBadge = document.getElementById('top-bar-server-badge');\n    const topText = document.getElementById('top-bar-server-text');\n    if (topBadge) {\n        topBadge.className = isRunning ? 'server-badge-pill running' : 'server-badge-pill stopped';\n    }\n    if (topText) {\n        topText.textContent = isRunning ? t.server_running : t.server_stopped;\n    }\n\n    // Also auto-refresh servers screen if it is active\n    const srvScreen = document.getElementById('screen-servers');\n    if (srvScreen && srvScreen.classList.contains('active')) {\n        loadServersUI();\n    }\n}\n\nasync function toggleServer() {\n    try {\n        const status = await window.pywebview.api.get_server_status();\n        if (status.running) {\n            await window.pywebview.api.stop_server();\n            showToast('تم إيقاف السيرفر', 'success');\n        } else {\n            await window.pywebview.api.start_server();\n            showToast('تم تشغيل السيرفر', 'success');\n        }\n        updateServerStatus();\n    } catch (error) {\n        showToast('حدث خطأ أثناء تبديل حالة السيرفر', 'error');\n    }\n}\n\nconst btnToggle = document.getElementById('btn-toggle-server');\nif (btnToggle) btnToggle.addEventListener('click', toggleServer);\n\n// --- AI Servers Manager Logic ---\nasync function loadServersUI() {\n    if (!window.pywebview || !window.pywebview.api) return;\n    const t = I18N[currentLang] || I18N.ar;\n    \n    try {\n        const infoStr = await window.pywebview.api.get_servers_info();\n        const info = JSON.parse(infoStr);\n        const servers = info.servers || {};\n        const activeKey = info.active_server || 'gaistudio';\n        \n        // Update Active Provider Banner\n        const activeSrv = servers[activeKey];\n        const bannerTitle = document.getElementById('active-banner-title');\n        const bannerSub = document.getElementById('active-banner-sub');\n        if (bannerTitle && activeSrv) {\n            bannerTitle.innerHTML = currentLang === 'en'\n                ? `Active Matching Provider: <strong>${activeSrv.name}</strong> (Port: ${activeSrv.port} • Model: ${activeSrv.default_model})`\n                : `المزود النشط حالياً لعمليات المطابقة: <strong>${activeSrv.name}</strong> (منفذ: ${activeSrv.port} • موديل: ${activeSrv.default_model})`;\n        }\n        if (bannerSub) {\n            bannerSub.textContent = currentLang === 'en'\n                ? `All shortage batches will be dispatched directly to ${activeSrv ? activeSrv.name : activeKey}.`\n                : `سيتم توجيه جميع دفعات مطابقة النواقص تلقائياً إلى هذا السيرفر (${activeSrv ? activeSrv.name : activeKey}).`;\n        }\n\n        // Update each server card\n        ['gaistudio', 'chatgpt'].forEach(key => {\n            const srv = servers[key];\n            if (!srv) return;\n\n            const card = document.getElementById(`card-server-${key}`);\n            const badgeStatus = document.getElementById(`badge-status-${key}`);\n            const badgeActive = document.getElementById(`badge-active-${key}`);\n            const btnActive = document.getElementById(`btn-active-${key}`);\n            const btnToggle = document.getElementById(`btn-toggle-${key}`);\n            const valModel = document.getElementById(`val-model-${key}`);\n\n            if (valModel) valModel.textContent = srv.default_model;\n\n            const isRunning = !!srv.running;\n            const isActive = (key === activeKey);\n\n            // Active Card Highlight & Badge\n            if (card) {\n                card.classList.toggle('is-active-provider', isActive);\n            }\n            if (badgeActive) {\n                badgeActive.style.display = isActive ? 'inline-flex' : 'none';\n                badgeActive.textContent = t.btn_already_active;\n            }\n\n            // Running Status Badge\n            if (badgeStatus) {\n                badgeStatus.className = isRunning ? 'badge-pill status-online' : 'badge-pill status-offline';\n                badgeStatus.textContent = isRunning \n                    ? (currentLang === 'en' ? `🟢 Online (Port ${srv.port})` : `🟢 متصل ومستمع (${srv.port})`) \n                    : (currentLang === 'en' ? '🔴 Stopped' : '🔴 متوقف');\n            }\n\n            // Active Switch Button\n            if (btnActive) {\n                if (isActive) {\n                    btnActive.className = 'btn btn-outline';\n                    btnActive.style.borderColor = 'var(--primary)';\n                    btnActive.style.background = '#e0f2fe';\n                    btnActive.style.color = 'var(--primary)';\n                    btnActive.innerHTML = `<i class=\"ph-fill ph-star\"></i> <span>${t.btn_already_active}</span>`;\n                    btnActive.disabled = true;\n                } else {\n                    btnActive.className = 'btn btn-outline';\n                    btnActive.style.borderColor = '';\n                    btnActive.style.background = '';\n                    btnActive.style.color = '';\n                    btnActive.innerHTML = `<i class=\"ph-bold ph-check\"></i> <span>${t.btn_set_as_active}</span>`;\n                    btnActive.disabled = false;\n                }\n            }\n\n            // Toggle Run / Stop Button\n            if (btnToggle) {\n                if (isRunning) {\n                    btnToggle.className = 'btn btn-outline-secondary text-danger';\n                    btnToggle.innerHTML = `<i class=\"ph-bold ph-stop\"></i> <span>${t.btn_stop_instance}</span>`;\n                    btnToggle.onclick = () => toggleServerInstance(key, false);\n                } else {\n                    btnToggle.className = 'btn btn-primary';\n                    btnToggle.innerHTML = `<i class=\"ph-bold ph-play\"></i> <span>${t.btn_start_instance}</span>`;\n                    btnToggle.onclick = () => toggleServerInstance(key, true);\n                }\n            }\n        });\n    } catch (e) {\n        console.error('Failed to load servers UI:', e);\n    }\n}\n\nasync function toggleServerInstance(serverKey, startIt) {\n    const t = I18N[currentLang] || I18N.ar;\n    const btn = document.getElementById(`btn-toggle-${serverKey}`);\n    if (btn) {\n        btn.disabled = true;\n        btn.innerHTML = `<i class=\"ph-fill ph-spinner-gap spinner\"></i> <span>${currentLang === 'en' ? 'Processing...' : 'جاري المعالجة...'}</span>`;\n    }\n\n    try {\n        let res;\n        if (startIt) {\n            showToast(currentLang === 'en' ? `Starting ${serverKey}...` : `جاري تشغيل سيرفر ${serverKey}...`, 'success');\n            res = await window.pywebview.api.start_server_instance(serverKey);\n        } else {\n            showToast(currentLang === 'en' ? `Stopping ${serverKey}...` : `جاري إيقاف سيرفر ${serverKey}...`, 'success');\n            res = await window.pywebview.api.stop_server_instance(serverKey);\n        }\n\n        if (res.success) {\n            showToast(res.message || (currentLang === 'en' ? 'Operation successful' : 'تمت العملية بنجاح'), 'success');\n        } else {\n            showToast((currentLang === 'en' ? 'Error: ' : 'خطأ: ') + (res.error || 'Failed'), 'error');\n        }\n    } catch (e) {\n        showToast(currentLang === 'en' ? 'Connection error' : 'حدث خطأ في الاتصال', 'error');\n        console.error(e);\n    } finally {\n        await loadServersUI();\n        await updateServerStatus();\n    }\n}\n\nasync function setActiveServer(serverKey) {\n    const t = I18N[currentLang] || I18N.ar;\n    try {\n        const res = await window.pywebview.api.set_active_ai_server(serverKey);\n        if (res.success) {\n            const srvName = serverKey === 'gaistudio' ? 'Google AI Studio (Port 8001)' : 'ChatGPT (Port 8000)';\n            showToast(currentLang === 'en' ? `Activated ${srvName} for matching!` : `تم تعيين ${srvName} كمزود نشط لعمليات المطابقة بنجاح!`, 'success');\n            await loadServersUI();\n            await loadSettings();\n            await updateServerStatus();\n        } else {\n            showToast((currentLang === 'en' ? 'Activation failed: ' : 'فشل التفعيل: ') + res.error, 'error');\n        }\n    } catch (e) {\n        showToast(currentLang === 'en' ? 'Connection error' : 'خطأ في الاتصال', 'error');\n        console.error(e);\n    }\n}\n\nasync function testServerInstance(serverKey) {\n    const t = I18N[currentLang] || I18N.ar;\n    const btn = document.getElementById(`btn-test-${serverKey}`);\n    const originalHtml = btn ? btn.innerHTML : '';\n    const outputEl = document.getElementById('server-test-output');\n    \n    if (btn) {\n        btn.disabled = true;\n        btn.innerHTML = `<i class=\"ph-fill ph-spinner-gap spinner\"></i> <span>${t.server_testing || 'Testing...'}</span>`;\n    }\n\n    const timestamp = new Date().toLocaleTimeString();\n    if (outputEl) {\n        outputEl.innerText = `[${timestamp}] Initiating live ping test to server instance '${serverKey}'...\\nConnecting to endpoint and measuring latency... Please wait.\\n`;\n    }\n\n    try {\n        const res = await window.pywebview.api.test_server_instance(serverKey);\n        const doneTime = new Date().toLocaleTimeString();\n        if (res.success) {\n            const report = `[${doneTime}] ✅ SUCCESS: Server '${res.name}' responded successfully!\\n` +\n                `--------------------------------------------------\\n` +\n                `• Health Status : HTTP 200 OK\\n` +\n                `• Response Time : ${res.latency} seconds\\n` +\n                `• Gateway Info  : ${res.health?.gateway || 'MSEMAX Gateway'}\\n` +\n                `• Default Model : ${res.health?.default_model || res.default_model}\\n` +\n                `• Test AI Reply : \"${res.reply}\"\\n` +\n                `--------------------------------------------------\\n` +\n                `✓ This server is 100% operational and ready to process shortage matching batches.`;\n            if (outputEl) outputEl.innerText = report;\n            showToast(currentLang === 'en' ? `Ping success! Latency: ${res.latency}s` : `تم الاتصال بنجاح! زمن الاستجابة: ${res.latency} ثانية`, 'success');\n        } else {\n            const failReport = `[${doneTime}] ❌ FAILED: Server '${serverKey}' test failed!\\n` +\n                `--------------------------------------------------\\n` +\n                `• Error Details : ${res.error}\\n` +\n                `--------------------------------------------------\\n` +\n                `💡 Suggestion: Ensure the server is started and that port ${res.port || '8000/8001'} is listening.`;\n            if (outputEl) outputEl.innerText = failReport;\n            showToast((currentLang === 'en' ? 'Ping failed: ' : 'فشل اختبار الاتصال: ') + res.error, 'error');\n        }\n    } catch (e) {\n        if (outputEl) outputEl.innerText += `\\n❌ Unexpected client error during test: ${e.message}`;\n        showToast(currentLang === 'en' ? 'Test error' : 'حدث خطأ أثناء الاختبار', 'error');\n    } finally {\n        if (btn) {\n            btn.disabled = false;\n            btn.innerHTML = originalHtml;\n        }\n        await loadServersUI();\n    }\n}\n\nasync function openServerSession(serverKey) {\n    const t = I18N[currentLang] || I18N.ar;\n    try {\n        showToast(currentLang === 'en' ? `Opening login session for ${serverKey}...` : `جاري فتح متصفح تسجيل الدخول لسيرفر ${serverKey}...`, 'success');\n        const res = await window.pywebview.api.run_server_session(serverKey);\n        if (res.success) {\n            showToast(currentLang === 'en' ? 'Browser session window opened' : 'تم فتح نافذة المتصفح لتسجيل الدخول بنجاح', 'success');\n        } else {\n            showToast((currentLang === 'en' ? 'Session error: ' : 'خطأ في فتح الجلسة: ') + res.error, 'error');\n        }\n    } catch (e) {\n        showToast(currentLang === 'en' ? 'Error opening session' : 'حدث خطأ أثناء فتح الجلسة', 'error');\n    }\n}\n\nfunction clearServerTestLog() {\n    const outputEl = document.getElementById('server-test-output');\n    const t = I18N[currentLang] || I18N.ar;\n    if (outputEl) {\n        outputEl.innerText = t.test_panel_empty || 'اضغط على زر \"اختبار الاتصال السريع\" في أي سيرفر لقياس زمن الاستجابة والتأكد من جاهزيته...';\n    }\n}\n    </script>\n    <script>\n        // Override showScreen to handle active states on sidebar\n        const originalShowScreen = window.showScreen;\n        window.showScreen = function(screenId, element = null) {\n            // Call original if it exists\n            if (typeof originalShowScreen === 'function') {\n                originalShowScreen(screenId);\n            } else {\n                document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));\n                const target = document.getElementById(screenId);\n                if (target) target.classList.add('active');\n            }\n            \n            // Update sidebar active class\n            if (element) {\n                document.querySelectorAll('.nav-item').forEach(btn => btn.classList.remove('active'));\n                element.classList.add('active');\n            }\n\n            // Update top bar heading\n            if (typeof updateTopBarHeading === 'function') {\n                updateTopBarHeading(screenId);\n            }\n\n            if (screenId === 'screen-new') {\n                resetNewProcessForm();\n            } else if (screenId === 'screen-logs' || screenId === 'screen-settings') {\n              