liseconds\n129:                 top_candidates = finder.search(shortage_name, top_k=5)\n130:                 \n131:                 if not top_candidates:\n132:                     continue\n133:                     \n134:                 best_score = top_candidates[0][\"score\"]\n135:                 best_name = top_candidates[0][\"name\"]\n136:                 \n137:                 # Rule 1: Very high confidence -> Auto Match (Bypass API entirely!)\n138:                 if best_score >= 0.85:\n139:                     matched.append({\n140:                         \"shortage_item\": shortage_name,\n141:                         \"warehouse_item\": best_name,\n142:                         \"confidence\": f\"high ({best_score:.2f})\",\n143:                         \"method\": \"fast_tfidf\"\n144:                     })\n145:                     tfidf_match_count += 1\n146:                 \n147:                 # Rule 2: Medium confidence -> Ask LLM to decide\n148:                 elif best_score >= 0.35:\n149:                     candidates_for_llm = [{\"id\": c[\"id\"], \"name\": c[\"name\"]} for c in top_candidates[:3]]\n150:                     llm_cases.append({\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
