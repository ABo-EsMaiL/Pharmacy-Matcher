namr_data = json.load(open('d:/AI_Engineer/Pharmacy-agy/data/processes/PROC-002/input_warehouses/جملة العمروووو.json', encoding='utf-8'))\namr_items = parse_structured_result(amr_data, 'amr')\n\nprint(\"--- Amr Catalog in JSON ---\")\nfor idx, it in enumerate(amr_items):\n    print(f\"[{idx}] {it['item_name_raw']}\")\n\nfinder = FastCandidateFinder()\nwh_catalog = [{\"id\": f\"W-{i:05}\", \"name\": item.get(\"item_name_raw\", \"\")} for i, item in enumerate(amr_items)]\nfinder.fit(wh_catalog)\n\ntest_queries = [\n    \"بنادول اكسترا احمر 24قرص س ج\",\n    \"كليكسان 40 حقن س ج\",\n    \"رانسيف 500 كبسول س ج\",\n    \"ايزوتريتينوين 20 كبسول\",\n    \"تريكوفيت لوشن قطاره\",\n    \"بيبي درينك اعشاب اكياس\",\n    \"سيتال 500 اقراص س ج\",\n    \"ترايكتين اقراص س ج\",\n    \"بريزولين قطره عين\",\n    \"افيروكوكسيب90مجم20قرص س ج\",\n    \"امبوفير 5امبول س ج\",\n    \"ستيمولان امبول\",\n    \"بانثينول النيل2%كريم وسط\",\n    \"ليفوفلوكساسين750مجم 5قرص س ج\",\n    \"لبن هيرو بيبي 2\"\n]\n\nprint(\"\\n--- Candidate Search Scores for Amr items ---\")\nfor q in test_queries:\n    cands = finder.search(q, top_k=3)\n    if cands:\n        best = cands[0]\n        print(f\"Query: '{q}'\\n  -> Best Cand: '{best['name']}' (Score: {best['score']:.3f})\")\n    else:\n        print(f\"Query: '{q}'\\n  -> NO CANDIDATE!\")\n","Description":"Inspect FastCandidateFinder results on Amr queries","Overwrite":true,"TargetFile":"d:\\AI_Engineer\\Pharmacy-agy\\scratch_test_search_amr.py","toolAction":"Writing candidate search test","toolSummary":"Write scratch_test_search_amr.py"}}]}
