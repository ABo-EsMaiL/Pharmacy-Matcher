السيرفر (${activeSrv ? activeSrv.name : activeKey}).`;\n3072:         }\n3073: \n3074:         // Update each server card\n3075:         ['gaistudio', 'chatgpt'].forEach(key => {\n3076:             const srv = servers[key];\n3077:             if (!srv) return;\n3078: \n3079:             const card = document.getElementById(`card-server-${key}`);\n3080:             const badgeStatus = document.getElementById(`badge-status-${key}`);\n3081:             const badgeActive = document.getElementById(`badge-active-${key}`);\n3082:             const btnActive = document.getElementById(`btn-active-${key}`);\n3083:             const btnToggle = document.getElementById(`btn-toggle-${key}`);\n3084:             const valModel = document.getElementById(`val-model-${key}`);\n3085: \n3086:             if (valModel) valModel.textContent = srv.default_model;\n3087: \n3088:             const isRunning = !!srv.running;\n3089:             const isActive = (key === activeKey);\n3090: \n3091:             // Active Card Highlight & Badge\n3092:             if (card) {\n3093:                 card.classList.toggle('is-active-provider', isActive);\n3094:             }\n3095:             if (badgeActive) {\n3096:                 badgeActive.style.display = isActive ? 'inline-flex' : 'none';\n3097:                 badgeActive.textContent = t.btn_already_active;\n3098:             }\n3099: \n3100:             // Running Status Badge\n3101:             if (badgeStatus) {\n3102:                 badgeStatus.className = isRunning ? 'badge-pill status-online' : 'badge-pill status-offline';\n3103:                 badgeStatus.textContent = isRunning \n3104:                     ? (currentLang === 'en' ? `🟢 Online (Port ${srv.port})` : `🟢 متصل ومستمع (${srv.port})`) \n3105:                     : (currentLang === 'en' ? '🔴 Stopped' : '🔴 متوقف');\n3106:             }\n3107: \n3108:             // Active Switch Button\n3109:             if (btnActive) {\n3110:                 if (isActive) {\n3111:                     btnActive.className = 'btn btn-outline';\n3112:                     btnActive.style.borderColor = 'var(--primary)';\n3113:                     btnActive.style.background = '#e0f2fe';\n3114:                     btnActive.style.color = 'var(--primary)';\n3115:                     btnActive.innerHTML = `<i class=\"ph-fill ph-star\"></i> <span>${t.btn_already_active}</span>`;\n3116:                     btnActive.disabled = true;\n3117:                 } else {\n3118:                     btnActive.className = 'btn btn-outline';\n3119:                     btnActive.style.borderColor = '';\n3120:                     btnActive.style.background = '';\n3121:                     btnActive.style.color = '';\n3122:                     btnActive.innerHTML = `<i class=\"ph-bold ph-check\"></i> <span>${t.btn_set_as_active}</span>`;\n3123:                     btnActive.disabled = false;\n3124:                 }\n3125:             }\n3126: \n3127:             // Toggle Run / Stop Button\n3128:             if (btnToggle) {\n3129:                 if (isRunning) {\n3130:                     btnToggle.className = 'btn btn-outline-secondary text-danger';\n3131:                     btnToggle.innerHTML = `<i class=\"ph-bold ph-stop\"></i> <span>${t.btn_stop_instance}</span>`;\n3132:                     btnToggle.onclick = () => toggleServerInstance(key, false);\n3133:                 } else {\n3134:                     btnToggle.className = 'btn btn-primary';\n3135:                     btnToggle.innerHTML = `<i class=\"ph-bold ph-play\"></i> <span>${t.btn_start_instance}</span>`;\n3136:                     btnToggle.onclick = () => toggleServerInstance(key, true);\n3137:                 }\n3138:             }\n3139:         });\n3140:     } catch (e) {\n3141:         console.error('Failed to load servers UI:', e);\n3142:     }\n3143: }\n3144: \n3145: async function toggleServerInstance(serverKey, startIt) {\n3146:     const t = I18N[currentLang] || I18N.ar;\n3147:     const btn = document.getElementById(`btn-toggle-${serverKey}`);\n3148:     if (btn) {\n3149:         btn.disabled = true;\n3150:         btn.innerHTML = `<i class=\"ph-fill ph-spinner-gap spinner\"></i> <span>${currentLang === 'en' ? 'Processing...' : 'جاري المعالجة...'}</span>`;\n3151:     }\n3152: \n3153:     try {\n3154:         let res;\n3155:         if (startIt) {\n3156:             showToast(currentLang === 'en' ? `Starting ${serverKey}...` : `جاري تشغيل سيرفر ${serverKey}...`, 'info');\n3157:             appendServerLog(`[SYSTEM] Starting server instance '${serverKey}'...`);\n3158:             res = await window.pywebview.api.start_server_instance(serverKey);\n3159:         } else {\n3160:             showToast(currentLang === 'en' ? `Stopping ${serverKey}...` : `جاري إيقاف سيرفر ${serverKey}...`, 'info');\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
