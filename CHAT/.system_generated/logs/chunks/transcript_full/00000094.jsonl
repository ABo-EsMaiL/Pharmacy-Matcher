ن ٢٠ قرص\"}]},\n    {\"case_id\": \"C8\", \"requested_name\": \"افيروكوكسيب90مجم20قرص س ج\", \"candidates\": [{\"item_id\": \"W8\", \"name\": \"افيرو كوكسبيب 90مجم-32ب\"}]},\n    {\"case_id\": \"C9\", \"requested_name\": \"نيوكاربون30قرص س ج\", \"candidates\": [{\"item_id\": \"W9\", \"name\": \"نیوکاربن ۳۰کپسول\"}]},\n    {\"case_id\": \"C10\", \"requested_name\": \"ليفانوكس2شريط س ج\", \"candidates\": [{\"item_id\": \"W10\", \"name\": \"ليفانوكس كبسول/باكت 200\"}]},\n    {\"case_id\": \"C11\", \"requested_name\": \"لاكتيز 15 ملل نقط 750مجم\", \"candidates\": [{\"item_id\": \"W11\", \"name\": \"لاكتيز نقط بالفم ٥ مل ١٩٠\"}]},\n]\n\n# We need to simulate how chunk processing works inside _match_warehouse\n# Let's inspect the chunk processing logic by running process_chunk equivalent:\nllm_out = coord._call_local_api({\"cases\": cases})\nprint(\"RAW LLM OUTPUT:\")\nprint(json.dumps(llm_out, ensure_ascii=False, indent=2))\n\n# Now test the python deterministic filter:\nfrom src.fast_match.search import extract_form_group, extract_brand_tokens\nfrom rapidfuzz import fuzz\nimport re\n\nprint(\"\\n--- FINAL DECISION AFTER SAFETY FILTER ---\")\ncase_map = {c[\"case_id\"]: c for c in cases}\nfor res in llm_out:\n    cid = res.get(\"case_id\")\n    c = case_map.get(cid, {})\n    shortage_name = c.get(\"requested_name\", \"\")\n    warehouse_item = c.get(\"candidates\", [{}])[0].get(\"name\", \"\")\n    status = res.get(\"status\")\n    reason = res.get(\"reason\", \"\")\n    \n    if status in (\"match\", \"review\"):\n        req_form = extract_form_group(shortage_name)\n        wh_form = extract_form_group(warehouse_item)\n        if req_form and wh_form and req_form != wh_form:\n            status = \"no_match\"\n            \n        slash_req = re.search(r'\\b(\\d+(?:\\.\\d+)?\\/\\d+(?:\\.\\d+)?)\\b', shortage_name)\n        slash_wh = re.search(r'\\b(\\d+(?:\\.\\d+)?\\/\\d+(?:\\.\\d+)?)\\b', warehouse_item)\n        if slash_req and not slash_wh:\n            status = \"no_match\"\n        elif slash_wh and not slash_req:\n            status = \"no_match\"\n        elif slash_req and slash_wh and slash_req.group(1) != slash_wh.group(1):\n            status = \"no_match\"\n            \n        is_req_co = bool(re.search(r'\\b(كو|بلس|بلاس|كومب|co|plus|comp)\\b', shortage_name.lower()))\n        is_wh_co = bool(re.search(r'\\b(كو|بلس|بلاس|كومب|co|plus|comp)\\b', warehouse_item.lower()))\n        if is_req_co != is_wh_co:\n            status = \"no_match\"\n            \n        is_req_new = bool(re.search(r'\\b(نيو|new)\\b', shortage_name.lower()))\n        is_wh_new = bool(re.search(r'\\b(نيو|new)\\b', warehouse_item.lower()))\n        if is_req_new != is_wh_new:\n            status = \"no_match\"\n            \n        req_b = extract_brand_tokens(shortage_name)\n        wh_b = extract_brand_tokens(warehouse_item)\n        if req_b and wh_b:\n            words_r = req_b.split()\n            words_w = wh_b.split()\n            if len(words_r) > 1 or len(words_w) > 1:\n                b_sim = fuzz.token_sort_ratio(req_b, wh_b)\n            else:\n                b_sim = fuzz.ratio(req_b, wh_b)\n            if req_b.startswith(wh_b) or wh_b.startswith(req_b):\n                b_sim = max(b_sim, 80)\n            if b_sim < 65:\n                status = \"no_match\"\n                \n        distinct_pairs = {\n            ('امبوفير', 'اميفير'), ('اميفير', 'امبوفير'),\n            ('جرانتريل', 'جرانتيل'), ('جرانتيل', 'جرانتريل'),\n            ('ديباكين', 'ديبيكان'), ('ديبيكان', 'ديباكين'),\n            ('اولفن', 'البيران'), ('البيران', 'اولفن'),\n        }\n        for p1, p2 in distinct_pairs:\n            if p1 in req_b and p2 in wh_b:\n                status = \"no_match\"\n                \n    print(f\"{cid}: Shortage: '{shortage_name}' vs Cand: '{warehouse_item}' -> Final Status: {status} (Reason: {reason})\")\n","Description":"Test all 11 critical clinical safety cases","Overwrite":true,"TargetFile":"C:\\Users\\kakak\\.gemini\