{"step_index":7089,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-24T15:03:17Z","content":"Created At: 2026-09-24T18:03:17+03:00\nCompleted At: 2026-09-24T18:03:17+03:00\nFile Path: `file:///C:/Users/kakak/.gemini/antigravity/brain/916274de-7f92-49fc-a0a8-d291664b474a/scratch/e2e_runtime_verification.py`\nTotal Lines: 187\nTotal Bytes: 7155\nShowing lines 1 to 110\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"\"\"\n2: End-to-End Runtime Verification Script\n3: Pharmacy -> Local MSEMAX -> Google AI Studio -> Gemini -> JSON Response -> Pharmacy Parser & Guards\n4: \"\"\"\n5: \n6: import json\n7: import time\n8: import requests\n9: import sys\n10: import os\n11: \n12: # Ensure project root is in path\n13: sys.path.insert(0, r\"D:\\AI_Engineer\\Pharmacy-agy\")\n14: from src.fast_match.coordinator import FastCoordinator, SYSTEM_PROMPT\n15: from src.config import Config\n16: \n17: API_URL = \"http://127.0.0.1:8001/v1/chat/completions\"\n18: API_KEY = \"[REDACTED_CREDENTIAL]\"\n19: \n20: def run_verification():\n21:     print(\"=\" * 75)\n22:     print(\"           PHARMACY & MSEMAX END-TO-END RUNTIME VERIFICATION\")\n23:     print(\"=\" * 75)\n24: \n25:     # 1. Check Gateway Health\n26:     print(\"\\n[Step 1] Querying Gateway Health...\")\n27:     health_resp = requests.get(\"http://127.0.0.1:8001/health\", timeout=5).json()\n28:     print(\"  -> Gateway:\", health_resp.get(\"gateway\"))\n29:     print(\"  -> Browser Ready:\", health_resp.get(\"browser_ready\"))\n30:     print(\"  -> Active Thinking Level:\", health_resp.get(\"active_thinking\"))\n31:     print(\"  -> Context Isolation (Fresh Chat):\", health_resp.get(\"clear_chat_on_request\"))\n32:     print(\"  -> Default Model:\", health_resp.get(\"default_model\"))\n33: \n34:     # 2. Build the 5 Critical Test Cases\n35:     cases = [\n36:         {\n37:             \"case_id\": \"TEST-01-STRENGTH\",\n38:             \"requested_name\": \"نوفاكس 250 مجم 20 قرص\",\n39:             \"catalog_id\": \"W1\",\n40:             \"candidates\": [{\"id\": \"W1-001\", \"name\": \"نوفاكس 500 مجم 20 قرص\"}],\n41:             \"expected\": \"no_match\",\n42:             \"rule\": \"Strength conflict -> NO_MATCH (Red line)\"\n43:         },\n44:         {\n45:             \"case_id\": \"TEST-02-DOSAGE-FORM\",\n46:             \"requested_name\": \"بيتاديرم مرهم 15 جم\",\n47:             \"catalog_id\": \"W1\",\n48:             \"candidates\": [{\"id\": \"W1-002\", \"name\": \"بيتاديرم كريم 15 جم\"}],\n49:             \"expected\": \"review\",\n50:             \"rule\": \"Dosage form difference with same product & strength -> REVIEW\"\n51:         },\n52:         {\n53:             \"case_id\": \"TEST-03-PACK-SIZE\",\n54:             \"requested_name\": \"دوليبران 1000 مجم 15 قرص\",\n55:             \"catalog_id\": \"W1\",\n56:             \"candidates\": [{\"id\": \"W1-003\", \"name\": \"دوليبران 1 جم 60 قرص\"}],\n57:             \"expected\": \"match\",\n58:             \"rule\": \"Pack size difference only -> MATCH\"\n59:         },\n60:         {\n61:             \"case_id\": \"TEST-04-OCR-CORRUPTION\",\n62:             \"requested_name\": \"فورسيجا 10 مجم أقراص\",\n63:             \"catalog_id\": \"W1\",\n64:             \"candidates\": [{\"id\": \"W1-004\", \"name\": \"فورسجا 10 مجم أقراص\"}],\n65:             \"expected\": \"match\",\n66:             \"rule\": \"OCR corruption in name (same commercial brand) -> MATCH\"\n67:         },\n68:         {\n69:             \"case_id\": \"TEST-05-GENERIC-ALT\",\n70:             \"requested_name\": \"بنادول 500 مجم أقراص\",\n71:             \"catalog_id\": \"W1\",\n72:             \"candidates\": [{\"id\": \"W1-005\", \"name\": \"سيتال 500 مجم أقراص\"}],\n73:             \"expected\": \"no_match\",\n74:             \"ru