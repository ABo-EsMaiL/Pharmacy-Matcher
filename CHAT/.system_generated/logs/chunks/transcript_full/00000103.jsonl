                    \"item_name_raw\": str(name).strip(),\n322:                             \"source_page\": item.get(\"source_page\"),\n323:                             \"source_file\": filename\n324:                         })\n325: \n326:     # 2. Try markdown HTML tables if no items extracted yet\n327:     if not items and \"markdown\" in result_data and result_data[\"markdown\"]:\n328:         md = str(result_data[\"markdown\"])\n329:         rows = re.findall(r\"<tr>(.*?)</tr>\", md, re.DOTALL | re.IGNORECASE)\n330:         if rows:\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
