95:             header_lower = str(header).lower()\n96:             \n97:             if any(kw in header_lower for kw in keywords):\n98:                 score += 50\n99:                 \n100:             sample_vals = [str(r.get(header, \"\")) for r in rows[:10] if r.get(header)]\n101:             if sample_vals:\n102:                 avg_len = sum(len(v) for v in sample_vals) / len(sample_vals)\n103:                 score += min(avg_len, 30)\n104:                 \n105:                 arabic_count = sum(1 for v in sample_vals if arabic_pattern.search(v))\n106:                 if arabic_count > 0:\n107:                     score += (arabic_count / len(sample_vals)) * 20\n108:             \n109:             if score > best_score:\n110:                 best_score = score\n111:                 best_col = header\n112:                 \n113:         if best_col:\n114:             name_column = best_col\n115:         else:\n116:             name_column = headers[0]\n117:             \n118:         print(f\"  -> Auto-detected drug name column: {name_column}\")\n119:     else:\n120:         if name_column not in headers:\n121:             raise ValueError(f\"Column '{name_column}' not found. Available columns: {headers}\")\n122: \n123:     items = []\n124:     for i, row in enumerate(rows, start=1):\n125:         val = row.get(name_column)\n126:         if val:\n127:             items.append({\n128:                 \"item_name_raw\": str(val),\n129:                 \"source_row\": i,\n130:                 \"source_file\": source_file,\n131:             })\n132: \n133:     print(f\"  -> Extracted {len(items)} items from column '{name_column}'\")\n134:     return items\n135: \nThe above content shows the entire, complete file contents of the requested file.\n"}
