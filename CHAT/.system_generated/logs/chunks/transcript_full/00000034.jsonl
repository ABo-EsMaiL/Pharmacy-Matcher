ide the name itself.\",\n                    },\n                    \"source_page\": {\n                        \"type\": [\n                            \"integer\",\n                            \"null\",\n                        ],\n                        \"description\": \"The 1-based source page containing this product entry, taken from the source page metadata. Return null when unavailable; do not guess.\",\n                    },\n                },\n                \"required\": [\n                    \"item_name_raw\",\n                    \"source_page\",\n                ],\n                \"additionalProperties\": False,\n            },\n        },\n    },\n    \"required\": [\n        \"items\",\n    ],\n    \"additionalProperties\": False,\n}\n\ntry:\n    with open(\"d:/AI_Engineer/Pharmacy-agy/dummy.txt\", \"rb\") as f:\n        res = client.extract.from_document(input=f, schema=schema)\n        print(\"Type:\", type(res))\n        print(\"Dir:\", dir(res))\n        if hasattr(res, 'extracted_data'):\n            for x in res.extracted_data:\n                print(\"Extracted Data element:\", dir(x))\n                if hasattr(x, 'data'):\n                    print(\"Data:\", x.data)\nexcept Exception as e:\n    print(f\"Exception: {e}\")\n","Description":"Test TransformClient actual schema","Overwrite":true,"TargetFile":"d:\\AI_Engineer\\Pharmacy-agy\\test_unstructured.py","toolAction":"Write test script 8","toolSummary":"Write test script 8"}}]}
