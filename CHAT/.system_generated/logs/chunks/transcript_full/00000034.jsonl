{"step_index":1302,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-22T01:30:37Z","thinking":"**Confirming Library Installation**\n\nOkay, so I just confirmed that `fpdf` is indeed something I need. I'm going to install it using pip, or I could call the API directly, as I'm certain it works. On second thought, the user has the `unstructured_transform_client` already installed, so I am good to proceed!\n\n\n","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"\"\"\"\nوحدة قراءة ملفات PDF - استخراج أسماء الأدوية باستخدام Unstructured API (Extraction Workflow).\n\"\"\"\n\nfrom pathlib import Path\nimport json\nimport hashlib\n\ndef _get_file_hash(filepath: Path) -> str:\n    hasher = hashlib.md5()\n    with open(filepath, 'rb') as f:\n        buf = f.read(65536)\n        while len(buf) > 0:\n            hasher.update(buf)\n            buf = f.read(65536)\n    return hasher.hexdigest()\n\ndef extract_items_from_pdf(\n    filepath: Path,\n    api_key: str,\n    base_url: str = \"https://transform.unstructured.io\",\n    gemini_api_key: str = None,\n) -> list[dict]:\n    \"\"\"\n    استخراج أسماء الأصناف من ملف PDF باستخدام خدمة Extraction في Unstructured.\n    \"\"\"\n    filepath = Path(filepath)\n    if not filepath.exists():\n        raise FileNotFoundError(f\"❌ ملف PDF غير موجود: {filepath}\")\n\n    print(f\"📄 جارٍ معالجة ملف PDF باستخدام Unstructured AI: {filepath.name}\")\n\n    # Check cache\n    file_hash = _get_file_hash(filepath)\n    cache_dir = filepath.parent.parent.parent / 'data' / '.unstructured_cache'\n    cache_dir.mkdir(parents=True, exist_ok=True)\n    cache_file = cache_dir / f\"{file_hash}_extract.json\"\n    \n    if cache_file.exists():\n        print(f\"📄 تم العثور على الملف في الذاكرة المؤقتة (Cache): {filepath.name}\")\n        with open(cache_file, \"r\", encoding=\"utf-8\") as f:\n            result_data = json.load(f)\n        items = _parse_structured_result(result_data, filepath.name)\n        return items\n\n    try:\n        from unstructured_transform_client import TransformClient\n    except ImportError:\n        print(\"⚠️ لم يتم العثور على مكتبة unstructured-transform-client. يرجى تثبيتها:\")\n        print(\"pip install unstructured-transform-client\")\n        raise RuntimeError(\"مكتبة unstructured-transform-client مطلوبة لمعالجة ملفات PDF\")\n\n    client = TransformClient(\n        api_key=api_key,\n        server_url=base_url,\n    )\n\n    schema = {\n        \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n        \"title\": \"Supplier Product Names\",\n        \"description\": \"Extract product entries from all pages as source data only. Return one entry per source product row, preserving duplicates and different strengths. Include products even when price or quantity is blank or zero. Copy names faithfully without spelling repair or inferred digits. Do not infer stock, requested quantities or shortage matches.\",\n        \"type\": \"object\",\n        \"properties\": {\n            \"items\": {\n                \"type\": \"array\",\n                \"description\": \"Every product entry from every page, in document order. Keep repeated entries. Exclude document headers, footers, contact details, column labels and totals.\",\n                \"items\": {\n                    \"type\": \"object\",\n                    \"properties\": {\n                        \"item_name_raw\": {\n                            \"type\": \"string\",\n                            \"description\": \"Copy the complete product name/description exactly as present in the source, preserving Arabic, English, mixed text, spelling, strengths, units, dosage form, pack numbers, punctuation and manufacturer text. Do not correct, translate or complete it. Exclude values belonging to separate price, discount or quantity columns, but retain numbers written inside the name itself.\",\n                        },\n                        \"source_page\": {\n                            \"type\": [\n                                \"integer\",\n                                \"null\",\n                            ],\n                            \"description\": \"The 1-based source page containing this product entry, taken from the source page metadata. Return null when unavailable; do not guess.\",\n                        },\n                    },\n                    \"required\": [\n                        \"item_name_raw\",\n                        \"source_page\",\n                    ],\n                    \"additionalProperties\": False,\n                },\n            },\n        },\n        \"required\": [\n            \"items\",\n        ],\n        \"additionalProperties\": False,\n    }\n\n    try:\n        print(f\"  ⏳ جاري رفع واستخراج البيانات من {filepath.name} ... قد يستغرق الأمر بعض الوقت.\")\n        with open(filepath, \"rb\") as f:\n            # We wait up to 10 minutes (600 seconds) for the extraction job\n            result = client.extract.from_document(\n                input=f,\n                schema=schema,\n                wait_seconds=600 \n            )\n\n        # Convert result to dict\n        if hasattr(result, 'model_dump'):\n            result_data = result.model_dump()\n        elif hasattr(result, '__dict__'):\n            result_data = result.__dict__\n        else:\n            result_data = dict(result)\n\n        # Cache the raw result\n        with open(cache_file, \"w\", encoding=\"utf-8\") as f:\n            json.dump(result_data, f, ensure_ascii=False, indent=2)\n\n        # Save locally for debugging too\n        json_path = filepath.with_suffix(\".json\")\n        with open(json_path, \"w\", encoding=\"utf-8\") as f:\n            json.dump(result_data, f, ensure_ascii=False, indent=2)\n\n        items = _parse_structured_result(result_data, filepath.name)\n        print(f\"  ✅ تم استخراج {len(items)} عنصر من {filepath.name}\")\n        return items\n\n    except Exception as e:\n        print(f\"❌ خطأ أثناء الاستخراج: {e}\")\n        raise\n\ndef _parse_structured_result(result_data: dict, filename: str) -> list[dict]:\n    items = []\n    \n    # result_data contains \"extracted_data\" array. \n    # Each element has \"data\" which matches our schema ({\"items\": [...]})\n    extracted_data = result_data.get(\"extracted_data\", [])\n    \n    for block in extracted_data:\n        data = block.get(\"data\", {})\n        if isinstance(data, dict) and \"items\" in data:\n            for item in data.get(\"items\", []):\n                if not isinstance(item, dict):\n                    continue\n                name = item.get(\"item_name_raw\")\n                if name:\n                    items.append({\n                        \"item_name_raw\": str(name).strip(),\n                        \"source_page\": item.get(\"source_page\"),\n                        \"source_file\": filename\n                    })\n    return items\n","Description":"Rewrite pdf_reader to use Unstructured Transform Client","Overwrite":true,"TargetFile":"d:\\AI_Engineer\\Pharmacy-agy\\src\\extract\\pdf_reader.py","toolAction":"Rewrite pdf_reader","toolSummary":"Rewrite pdf_reader"}}]}
