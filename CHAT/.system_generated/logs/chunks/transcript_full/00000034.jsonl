:         النص:\n156:         {full_text[:35000]}\n157:         \"\"\"\n158:         \n159:         response = client.models.generate_content(\n160:             model='gemini-2.5-flash',\n161:             contents=prompt,\n162:         )\n163:         text = response.text.strip()\n164:         \n165:         # Clean markdown\n166:         if text.startswith('```json'): text = text[7:-3]\n167:         elif text.startswith('```'): text = text[3:-3]\n168:         \n169:         import json\n170:         extracted = json.loads(text.strip())\n171:         \n172:         items = []\n173:         for name in extracted:\n174:             if isinstance(name, str) and name.strip():\n175:                 items.append({\"item_name_raw\": name.strip(), \"source_page\": 1})\n176:         return items\n177:     except Exception as e:\n178:         print(f\"     -> Gemini extraction failed: {e}\")\n179:         return []\n180: \n181: def extract_items_from_pdf(\n182:     filepath: Path,\n183:     api_key: str,\n184:     base_url: str = \"https://transform.unstructured.io\",\n185:     gemini_api_key: str = None,\n186: ) -> list[dict]:\n187:     \"\"\"\n188:     استخراج أسماء الأصناف من ملف PDF (الدالة الرئيسية).\n189: \n190:     تجمع بين رفع الملف وتحليل الاستجابة.\n191: \n192:     Args:\n193:         filepath: مسار ملف PDF.\n194:         api_key: مفتاح Unstructured API.\n195:         base_url: عنوان خادم Unstructured API.\n196: \n197:     Returns:\n198:         قائمة من القواميس بالشكل:\n199:         {\"item_name_raw\": str, \"source_page\": int|None, \"source_file\": str}\n200:     \"\"\"\n201:     filepath = Path(filepath)\n202: \n203:     # استخراج البيانات من PDF\n204:     result = extract_from_pdf(filepath, api_key, base_url)\n205: \n206:     # تحليل الاستجابة\n207:     items = parse_items_from_response(result, gemini_api_key)\n208: \n209:     # إضافة اسم الملف المصدر لكل عنصر\n210:     for item in items:\n211:         item[\"source_file\"] = filepath.name\n212: \n213:     return items\n214: \n215: \n216: # ──────────────────────── دوال مساعدة داخلية ────────────────────────\n217: \n218: \n219: def _poll_for_result(poll_url: str, headers: dict) -> dict:\n220:     \"\"\"\n221:     الاستعلام المتكرر عن حالة مهمة غير متزامنة حتى اكتمالها.\n222:     \"\"\"\n223:     for attempt in range(1, _MAX_POLL_ATTEMPTS + 1):\n224:         time.sleep(_POLL_INTERVAL_SECONDS)\n225:         resp = requests.get(poll_url, headers=headers)\n226: \n227:         if resp.status_code != 200:\n228:             print(f\"  ⚠️ خطأ في الاستعلام (محاولة {attempt}): {resp.status_code}\")\n229:             continue\n230: \n231:         data = resp.json()\n232:         status = data.get(\"status\", \"\")\n233: \n234:         if status == \"completed\":\n235:             print(f\"  ✅ اكتملت المهمة (بعد {attempt * _POLL_INTERVAL_SECONDS} ثانية)\")\n236:             # النتائج قد تكون في data[\"elements\"] أو data نفسه\n237:             return data.get(\"elements\", data)\n238: \n239:         if status in (\"failed\", \"error\"):\n240:             raise RuntimeError(\n241:                 f\"❌ فشلت مهمة Unstructured API: {data.get('error', 'خطأ غير معروف')}\"\n242:             )\n243: \n244:         print(\n245:             f\"  ⏳ الحالة: {status} (محاولة {attempt}/{_MAX_POLL_ATTEMPTS})\"\n246:         )\n247: \n248:     raise RuntimeError(\n249:         f\"❌ انتهت مهلة الانتظار ({_MAX_POLL_ATTEMPTS * _POLL_INTERVAL_SECONDS} ثانية) \"\n250:         f\"للمهمة غير المتزامنة\"\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
