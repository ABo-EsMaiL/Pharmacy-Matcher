mes) and sorted(db_warehouse) == sorted(warehouse_filenames):\n229:                     if p.get('status') in ['completed', 'reviewing']:\n230:                         # It's an identical process that finished\n231:                         stats = self.db.get_process_stats(p['id'])\n232:                         return {\"success\": True, \"existing\": True, \"process_id\": p['id'], \"stats\": stats}\n233:             \n234:             process_id = self.db.create_process(shortage_filenames, warehouse_filenames)\n235:             \n236:             thread = threading.Thread(target=self._process_worker, args=(process_id, shortage_paths, warehouse_paths))\n237:             thread.start()\n238:             \n239:             return {\"success\": True, \"process_id\": process_id}\n240:             \n241:         except Exception as e:\n242:             return {\"success\": False, \"error\": str(e)}\n243: \n244:     def restart_process(self, process_id: str) -> dict:\n245:         try:\n246:             workspace = PROJECT_ROOT / 'data' / 'inputs' / process_id\n247:             if not workspace.exists():\n248:                 return {\"success\": False, \"error\": \"ملفات العملية غير موجودة لإعادة التشغيل\"}\n249:             \n250:             # get process details\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
