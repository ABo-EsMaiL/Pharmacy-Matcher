for cell in row if cell is not None and str(cell).strip()]\n44:             if len(valid_cells) >= 2:\n45:                 header_row_idx = row_idx\n46:                 for idx, cell in enumerate(row):\n47:                     val = str(cell).strip() if cell is not None else f\"Column_{idx+1}\"\n48:                     if not val:\n49:                         val = f\"Column_{idx+1}\"\n50:                     headers.append(val)\n51:                 break\n52: \n53:         if not header_row_idx:\n54:             print(\"  [!] Could not detect a valid header row.\")\n55:             return []\n56: \n57:         print(f\"  -> Header row: {header_row_idx} -> {headers}\")\n58: \n59:         data = []\n60:         for row in sheet.iter_rows(min_row=header_row_idx + 1, values_only=True):\n61:             if all(cell is None or str(cell).strip() == \"\" for cell in row):\n62:                 continue\n63:             \n64:             row_dict = {}\n65:             for col_idx, header in enumerate(headers):\n66:                 val = row[col_idx] if col_idx < len(row) else None\n67:                 if val is not None and isinstance(val, str):\n68:                     val = val.strip()\n69:                 row_dict[header] = val\n70:                 \n71:             data.append(row_dict)\n72: \n73:         print(f\"  -> Extracted {len(data)} data rows\")\n74:         return data\n75: \n76:     finally:\n77:         wb.close()\n78: \n79: \n80: def extract_item_names(rows: list[dict], name_column: str = None, source_file: str = \"\") -> list[dict]:\n81:     if not rows:\n82:         return []\n83: \n84:     headers = list(rows[0].keys())\n85: \n86:     if not name_column:\n87:         best_col = \"\"\n88:         best_score = -1\n89: \n90:         keywords = [\"صنف\", \"اسم\", \"دواء\", \"البيان\", \"item\", \"name\", \"product\", \"drug\"]\n91:         arabic_pattern = re.compile(r\"[\\u0600-\\u06FF]\")\n92: \n93:         for header in headers:\n94:             score = 0\n95:             header_lower = str(header).lower()\n96:             \n97:             if any(kw in header_lower for kw in keywords):\n98:                 score += 50\n99:                 \n100:             sample_vals = [str(r.get(header, \"\")) for r in rows[:10] if r.get(header)]\n101:             if sample_vals:\n102:                 avg_len = sum(len(v) for v in sample_vals) / len(sample_vals)\n103:                 score += min(avg_len, 30)\n104:                 \n105:                 arabic_count = sum(1 for v in sample_vals if arabic_pattern.search(v))\n106:                 if arabic_count > 0:\n107:                     score += (arabic_count / len(sample_vals)) * 20\n108:             \n109:             if score > best_score:\n110:                 best_score = score\n111:                 best_col = header\n112:                 \n113:         if best_col:\n114:             name_column = best_col\n115:         else:\n116:             name_column = headers[0]\n117:             \n118:         print(f\"  -> Auto-detected drug name column: {name_column}\")\n119:     else:\n120:         if name_column not in headers:\n121:             raise ValueError(f\"Column '{name_column}' not found. Available columns: {headers}\")\n122: \n123:     items = []\n124:     for i, row in enumerate(rows, start=1):\n125:         val = row.get(name_column)\n126:         if val:\n127:             items.append({\n128:                 \"item_name_raw\": str(val),\n129:                 \"source_row\": i,\n130:                 \"source_file\": source_file,\n131:             })\n132: \n133:     print(f\"  -> Extracted {len(items)} items from column '{name_column}'\")\n134:     return items\n135: \nThe above content shows the entire, complete file contents of the requested file.\n"}
