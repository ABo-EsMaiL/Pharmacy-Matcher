     \"image_url\": {\n217:                                 \"url\": f\"data:image/webp;base64,{img_b64}\"\n218:                             }\n219:                         }\n220:                     ]\n221:                 }\n222:             ],\n223:             \"stream\": False\n224:         }\n225: \n226:         headers = {\n227:             \"Authorization\": f\"Bearer {api_key}\",\n228:             \"Content-Type\": \"application/json\"\n229:         }\n230: \n231:         # 4. Send request with retry loop\n232:         success = False\n233:         for attempt in range(1, max_retries + 1):\n234:             t0 = time.time()\n235:             try:\n236:                 print(f\"     [*] Sending Vision request to gateway (Attempt {attempt}/{max_retries})...\")\n237:                 with _GATEWAY_MUTEX:\n238:                     resp = requests.post(api_url, json=payload, headers=headers, timeout=240)\n239:                 elapsed = time.time() - t0\n240: \n241:                 if resp.status_code == 200:\n242:                     data = resp.json()\n243:                     raw_content = data.get(\"choices\", [{}])[0].get(\"message\", {}).get(\"content\", \"\")\n244:                     parsed = _clean_json_response(raw_content)\n245: \n246:                     items = parsed.get(\"items\", [])\n247:                     # Verify page number\n248:                     for item in items:\n249:                         item[\"source_page\"] = page_num\n250:                         item[\"source_file\"] = filepath.name\n251: \n252:                     # Save to page result cache\n253:                     with open(page_res_path, \"w\", encoding=\"utf-8\") as f_out:\n254:                         json.dump({\"page\": page_num, \"items\": items}, f_out, ensure_ascii=False, indent=2)\n255: \n256:                     # Update manifest\n257:                     if page_num not in completed_set:\n258:                         completed_set.add(page_num)\n259:             