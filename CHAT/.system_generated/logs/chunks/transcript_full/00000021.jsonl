'warehouse') {\n            selectedWarehouseFiles = [...selectedWarehouseFiles, ...validFiles];\n            updateFileList('warehouse', selectedWarehouseFiles);\n        } else {\n            selectedShortageFiles = [...selectedShortageFiles, ...validFiles];\n            updateFileList('shortage', selectedShortageFiles);\n        }\n        checkSubmitState();\n    }\n}","StartLine":1010,"TargetContent":"// --- Drag & Drop Logic ---\nwindow.activeDragZone = null;\n\nfunction processSelectedFiles(files, targetZone) {\n    const validShortageExts = ['.pdf', '.xlsx', '.xls', '.csv'];\n    const validWarehouseExts = ['.pdf', '.xlsx', '.xls', '.csv', '.json'];\n    \n    const validExts = targetZone === 'warehouse' ? validWarehouseExts : validShortageExts;\n    const validFiles = [];\n    const invalidFiles = [];\n    \n    files.forEach(f => {\n        const ext = f.substring(f.lastIndexOf('.')).toLowerCase();\n        if (validExts.includes(ext) || !f.includes('.')) {\n            validFiles.push(f);\n        } else {\n            invalidFiles.push(f);\n        }\n    });\n    \n    if (invalidFiles.length > 0) {\n        showToast(`تم تجاهل ${invalidFiles.length} ملفات غير مدعومة. المسموح: ${validExts.join(', ')}`, 'error');\n    }\n    \n    if (validFiles.length > 0) {\n        if (targetZone === 'warehouse') {\n            selectedWarehouseFiles = [...selectedWarehouseFiles, ...validFiles];\n            updateFileList('warehouse', selectedWarehouseFiles);\n        } else {\n            selectedShortageFiles = [...selectedShortageFiles, ...validFiles];\n            updateFileList('shortage', selectedShortageFiles);\n        }\n        checkSubmitState();\n    }\n}\n\nasync function handleNativeDrop(filesOverride) {\n    try {\n        let files = filesOverride;\n        if (!files) {\n            const filesStr = await window.pywebview.api.get_dropped_files();\n            files = JSON.parse(filesStr);\n        }\n        \n        if (files && files.length > 0) {\n            const zone = window.activeDragZone || 'shortage'; // Default to shortage if unknown\n            processSelectedFiles(files, zone);\n        }\n    } catch (e) {\n        console.error(\"Error handling native drop:\", e);\n    } finally {\n        ['zone-shortage', 'zone-warehouse'].forEach(id => {\n            const zone = document.getElementById(id);\n            if(zone) {\n                zone.style.borderColor = '';\n                zone.style.background = '';\n            }\n        });\n        window.activeDragZone = null;\n    }\n}","TargetFile":"d:\\AI_Engineer\\Pharmacy-agy\\desktop_app\\templates\\index.html","toolAction":"Remove handleNativeDrop logic","toolSummary":"Clean up Javascript"}}]}
