{"step_index":5681,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-23T19:46:40Z","content":"Created At: 2026-09-23T22:46:40+03:00\nCompleted At: 2026-09-23T22:46:40+03:00\nFile Path: `file:///C:/Users/kakak/.gemini/antigravity/brain/916274de-7f92-49fc-a0a8-d291664b474a/scratch/test_new_classifier.py`\nTotal Lines: 156\nTotal Bytes: 6445\nShowing lines 1 to 156\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: import sys\n2: sys.path.insert(0, \".\")\n3: import re\n4: from rapidfuzz import fuzz\n5: from src.fast_match.search import extract_brand_tokens, extract_form_group\n6: \n7: def norm_num(s: str) -> str:\n8:     s = str(s)\n9:     for e, w in zip('٠١٢٣٤٥٦٧٨٩', '0123456789'):\n10:         s = s.replace(e, w)\n11:     return s\n12: \n13: def get_strength_pattern(text: str) -> str | None:\n14:     text = norm_num(text.lower())\n15:     m = re.search(r'(\\d+(?:\\.\\d+)?)\\s*(مجم|مج|جم|جرام|gm|mg|mcg|مكجم)', text)\n16:     if m:\n17:         val = m.group(1)\n18:         unit = m.group(2)\n19:         if unit in ['جم', 'جرام', 'gm']:\n20:             try:\n21:                 val = str(float(val) * 1000)\n22:             except:\n23:                 pass\n24:         return val\n25:     m2 = re.search(r'\\b(1000|875|625|500|400|300|250|200|150|125|100|80|75|50|40|25|20|15|10|5|2.5|1)\\b', text)\n26:     if m2:\n27:         return m2.group(1)\n28:     if 'ربع' in text or '25.' in text:\n29:         return '0.25'\n30:     if 'نص' in text or 'نصف' in text or '.5' in text or '0.5' in text:\n31:         return '0.5'\n32:     return None\n33: \n34: def has_co(text: str) -> bool:\n35:     t = text.lower()\n36:     return bool(re.search(r'(?:^|[^\\w])(كو|بلس|بلاس|كومب|co|plus|comp)(?:[^\\w]|$)|كواقراص|كوأقراص|بلساقراص|بلسكبسول', t))\n37: \n38: def are_forms_identical(form1: str | None, form2: str | None) -> bool:\n39:     if not form1 or not form2:\n40:         return True\n41:     if form1 == form2:\n42:         return True\n43:     # Tablets and capsules are commercially identical oral solid units\n44:     if (form1, form2) in {('tablet', 'capsule'), ('capsule', 'tablet')}:\n45:         return True\n46:     return False\n47: \n48: BRAND_FAMILIES = {'بيتادين', 'هيرو', 'انسولين', 'ليمتلس', 'سيتال', 'لبن'}\n49: \n50: def classify_pair(req: str, cand: str) -> tuple[str, str]:\n51:     \"\"\"\n52:     Classifies a (requested, candidate) pair according to the user's exact algorithm:\n53:     - 'match': Same brand, same strength, same form.\n54:     - 'review': Same brand, same strength, but DIFFERENT form (e.g. cream vs ointment, drops vs tablets).\n55:     - 'reject': Different strength (التركيز خط أحمر), or different combination, or brand family violation.\n56:     - 'ambiguous': Brand similarity 60%-85% (OCR typos like برونفين vs بروفين) -> send to LLM.\n57:     \"\"\"\n58:     brand_r = extract_brand_tokens(req)\n59:     brand_c = extract_brand_tokens(cand)\n60:     if not brand_r or not brand_c:\n61:         return \"reject\", \"no_brand\"\n62:         \n63:     words_r = brand_r.split()\n64:     words_c = brand_c.split()\n65:     first_r = words_r[0] if words_r else \"\"\n66:     first_c = words_c[0] if words_c else \"\"\n67:     \n68:     # 1. Brand Family Protection\n69:     if first_r in BRAND_FAMILIES or first_c in BRAND_FAMILIES:\n70:         if fuzz.ratio(brand_r, brand_c) < 85:\n71:             return \"reject\", \"brand_family_conflict\"\n72:             \n73:     # 2. Combination check (كو / بلس)\n74:     if has_co(req) != has_co(cand):\n75:         return \"reject\", \"combination_mismatch\"\n76:         \n77:     # 3. Strength check (التركيز خط أحمر - no tolerance)\n78:     str_r = get_strength_pattern(req)\n79:     str_c = get_strength_pattern(cand)\n80:     if str_r and str_c:\n81:         try:\n82:             if float(str_r) != float(str_c):\n83:                 return \"reject\", f\"strength_conflict_{str_r}_vs_{str_c}\"\n84:         except:\n85:             if str_r != str_c:\n86:                 return \"reject\", f\"strength_conflict_{str_r}_vs_{str_c}\"\n87:                 \n88:     slash_r = re.search(r'(?:^|[^\\d/])(\\d+(?:\\.\\d+)?\\/\\d+(?:\\.\\d+)?)(?:[^\\d/]|$)', norm_num(req))\n89:     slash_c = re.search(r'(?:^|[^\\d/])(\\d+(?:\\.\\d+)?\\/\\d+(?:\\.\\d+)?)(?:[^\\d/]|$)', norm_num(cand))\n90:     if slash_r and slash_c and slash_r.group(1) != slash_c.group(1):\n91:         return \"reject\", \"slash_strength_conflict\"\n92:     if (slash_r and not slash_c) or (slash_c and not slash_r):\n93:         return \"reject\", \"slash_missing_conflict\"\n94: \n95:     # 4. Brand Similarity & Identity\n96:     b_sim = fuzz.ratio(brand_r, brand_c)\n97:     is_exact_brand = (brand_r == brand_c)\n98:     \n99:     if len(words_r) == 1 and len(words_c) == 1:\n100:         if first_r == first_c:\n101:             is_exact_brand = True\n102:         elif fuzz.ratio(first_r, first_c) >= 90:\n103:             is_exact_brand = True\n104:             \n105:     if len(words_r) == len(words_c) and len(words_r) > 1:\n106:         words_match = all(w_r == w_c or fuzz.ratio(w_r, w_c) >= 85 for w_r, w_c in zip(words_r, words_c))\n107:         if words_match:\n108:             is_exact_brand = True\n109:             \n110:     # If brand has 60% <= sim < 85% and not exact -> Ambiguous (needs LLM to check OCR)\n111:     if not is_exact_brand:\n112:         if b_sim >= 60:\n113:             return \"ambiguous\", f\"ocr_check_needed_{b_sim}%\"\n114:         else:\n115:             return \"reject\", f\"low_brand_sim_{b_sim}%\"\n116: \n117:     # 5. Form check for confirmed brand:\n118:     # If same brand and same strength:\n119:     form_r = extract_form_group(req)\n120:     form_c = extract_form_group(cand)\n121:     \n122:     is_r_drops = 'نقط' in req or 'قطره' in req or 'قطرة' in req\n123:     is_c_drops = 'نقط' in cand or 'قطره' in cand or 'قطرة' in cand\n124:     is_drops_conflict = (is_r_drops != is_c_drops)\n125:     \n126:     is_req_syrup = bool(re.search(r'\\b(شراب|شرب|معلق)\\b', req))\n127:     is_cand_syrup = bool(re.search(r'\\b(شراب|شرب|معلق)\\b', cand))\n128:     is_syrup_conflict = (is_req_syrup != is_cand_syrup)\n129:     \n130:     # Are forms identical?\n131:     if are_forms_identical(form_r, form_c) and not is_drops_conflict and not is_syrup_conflict:\n132:         return \"match\", \"exact_brand_and_form\"\n133:     else:\n134:         # Different form with same brand and non-conflicting strength -> REVIEW!\n135:         return \"review\", f\"different_form_{form_r}_vs_{form_c}\"\n136: \n137: # Test cases\n138: test_cases = [\n139:     (\"زنكترون 30 كبسولة\", \"زنكترون أقراص باكت 160\"),\n140:     (\"سيتال 1جم أقراص\", \"سيتال 500 أقراص\"),\n141:     (\"نويوريك 300 مجم\", \"نو-يوريك 100 مجم\"),\n142:     (\"ميبو كريم 15جم\", \"ميبو مرهم 15جم\"),\n143:     (\"كتافلام نقط\", \"كتافلام 50 اقراص\"),\n144:     (\"انسولين نوفورابيد\", \"انسولين اكترابيد\"),\n145:     (\"سينوبريت اقراص\", \"سينوبريل 2 مجم اقراص\"),\n146:     (\"برونفين 400مجم\", \"بروفين 400مجم\"),\n147:     (\"ماريفان 3مجم 3شريط س ج\", \"ماريفان ٣ مجم/جلاكسو\"),\n148:     (\"كلاريتين اقراص\", \"ترايكيتين اقراص\"),\n149: ]\n150: \n151: print(\"=== Testing New Classifier ===\")\n152: for r, c in test_cases:\n153:     res, reason = classify_pair(r, c)\n154:     print(f\"'{r}' vs '{c}'\")\n155:     print(f\"  -> [{res.upper()}]: {reason}\\n\")\n156: \nThe above content shows the entire, complete file contents of the requested file.\n"}
