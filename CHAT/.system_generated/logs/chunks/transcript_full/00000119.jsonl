{"step_index":5703,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-23T19:48:06Z","content":"Created At: 2026-09-23T22:48:06+03:00\nCompleted At: 2026-09-23T22:48:06+03:00\nFile Path: `file:///D:/AI_Engineer/Pharmacy-agy/scripts/package_production.py`\nTotal Lines: 193\nTotal Bytes: 7637\nShowing lines 1 to 193\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"\"\"\n2: Production Packaging Script for Pharmacy Matcher.\n3: Creates a clean, ready-to-deploy distribution folder for the pharmacy client machine.\n4: Excludes all development caches, test databases, scratch scripts, and temporary inputs.\n5: \"\"\"\n6: \n7: import os\n8: import shutil\n9: import sqlite3\n10: from pathlib import Path\n11: \n12: PROJECT_ROOT = Path(__file__).resolve().parent.parent\n13: DIST_DIR = PROJECT_ROOT / \"dist_production\"\n14: \n15: def package():\n16:     print(\"=\" * 60)\n17:     print(\"[*] Packaging Pharmacy Matcher for Production Deployment\")\n18:     print(\"=\" * 60)\n19: \n20:     if DIST_DIR.exists():\n21:         print(f\"[-] Removing existing {DIST_DIR.name}...\")\n22:         shutil.rmtree(DIST_DIR)\n23: \n24:     DIST_DIR.mkdir(parents=True, exist_ok=True)\n25: \n26:     # 1. Copy desktop_app\n27:     print(\"[+] Copying desktop_app/ ...\")\n28:     shutil.copytree(\n29:         PROJECT_ROOT / \"desktop_app\",\n30:         DIST_DIR / \"desktop_app\",\n31:         ignore=shutil.ignore_patterns(\"__pycache__\", \"*.pyc\", \".pytest_cache\")\n32:     )\n33: \n34:     # 2. Copy src\n35:     print(\"[+] Copying src/ ...\")\n36:     shutil.copytree(\n37:         PROJECT_ROOT / \"src\",\n38:         DIST_DIR / \"src\",\n39:         ignore=shutil.ignore_patterns(\"__pycache__\", \"*.pyc\", \".pytest_cache\")\n40:     )\n41: \n42:     # 3. Copy root essential files\n43:     essential_files = [\n44:         \"requirements.txt\",\n45:         \".env.example\",\n46:         \"fast_main.py\",\n47:     ]\n48:     for filename in essential_files:\n49:         src_file = PROJECT_ROOT / filename\n50:         if src_file.exists():\n51:             print(f\"[+] Copying {filename} ...\")\n52:             shutil.copy2(src_file, DIST_DIR / filename)\n53: \n54:     # 4. Create fresh data directory structure with clean database\n55:     data_dir = DIST_DIR / \"data\"\n56:     data_dir.mkdir(exist_ok=True)\n57:     (data_dir / \"processes\").mkdir(exist_ok=True)\n58:     (data_dir / \"inputs\").mkdir(exist_ok=True)\n59:     (data_dir / \".unstructured_cache\").mkdir(exist_ok=True)\n60:     \n61:     # Initialize fresh history.db in dist\n62:     db_path = data_dir / \"history.db\"\n63:     conn = sqlite3.connect(db_path)\n64:     cursor = conn.cursor()\n65:     cursor.execute(\"\"\"\n66:         CREATE TABLE IF NOT EXISTS processes (\n67:             id TEXT PRIMARY KEY,\n68:             created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,\n69:             shortage_files TEXT,\n70:             warehouse_files TEXT,\n71:             total_shortages INTEGER DEFAULT 0,\n72:             matched_count INTEGER DEFAULT 0,\n73:             review_count INTEGER DEFAULT 0,\n74:             not_found_count INTEGER DEFAULT 0,\n75:             status TEXT DEFAULT 'processing',\n76:             output_file TEXT\n77:         )\n78:     \"\"\")\n79:     conn.commit()\n80:     conn.close()\n81:     print(\"[+] Initialized clean history.db in data/\")\n82: \n83:     # Default production settings.json\n84:     settings_json = data_dir / \"settings.json\"\n85:     settings_json.write_text('{\\n  \"local_api_url\": \"http://127.0.0.1:8000/v1/chat/completions\",\\n  \"gemini_model\": \"gemini-2.5-flash\",\\n  \"match_threshold\": 0.75,\\n  \"msemax_dir\": \"\"\\n}', encoding=\"utf-8\")\n86:     print(\"[+] Created default settings.json\")\n87: \n88:     # 5. Create run_app.bat in root of dist\n89:     run_bat_content = \"\"\"@echo off\n90: chcp 65001 > nul\n91: title Pharmacy Matcher - فارما ماتش\n92: \n93: echo ========================================================\n94: echo    تشغيل برنامج فارما ماتش (Pharmacy Matcher)\n95: echo ========================================================\n96: echo.\n97: \n98: :: Check Python installation\n99: where python >nul 2>nul\n100: if %errorlevel% neq 0 (\n101:     echo [ERROR] Python غير مثبت على هذا الجهاز!\n102:     echo يرجى تثبيت Python 3.10 أو أحدث من https://www.python.org/\n103:     echo وتأكد من تحديد خيار \"Add Python to PATH\" أثناء التثبيت.\n104:     echo.\n105:     pause\n106:     exit /b 1\n107: )\n108: \n109: :: Check if virtual environment exists, if not create one\n110: if not exist \"venv\\\\Scripts\\\\activate.bat\" (\n111:     echo [*] جاري إنشاء البيئة الافتراضية لأول مرة (venv)...\n112:     python -m venv venv\n113:     call venv\\\\Scripts\\\\activate.bat\n114:     echo [*] جاري تثبيت الحزم المطلوبة من requirements.txt...\n115:     python -m pip install --upgrade pip\n116:     pip install -r requirements.txt\n117: ) else (\n118:     call venv\\\\Scripts\\\\activate.bat\n119: )\n120: \n121: :: Check if .env exists, if not copy from .env.example\n122: if not exist \".env\" (\n123:     if exist \".env.example\" (\n124:         echo [*] إنشاء ملف الإعدادات .env من النموذج...\n125:         copy .env.example .env > nul\n126:     )\n127: )\n128: \n129: echo [*] جاري تشغيل واجهة البرنامج...\n130: python desktop_app\\\\app.py\n131: \n132: if %errorlevel% neq 0 (\n133:     echo.\n134:     echo [!] حدث خطأ أثناء تشغيل البرنامج.\n135:     pause\n136: )\n137: \"\"\"\n138:     (DIST_DIR / \"run_app.bat\").write_text(run_bat_content, encoding=\"utf-8\")\n139:     print(\"[+] Created run_app.bat launcher\")\n140: \n141:     # 6. Create README_SETUP.md in Arabic\n142:     readme_content = \"\"\"# دليل تثبيت وتشغيل برنامج \"فارما ماتش\" على جهاز العميل / الصيدلية\n143: \n144: أهلاً بك! هذا المجلد يحتوي على النسخة الجاهزة للتشغيل (Production) لبرنامج مطابقة نواقص الصيدليات مع كشوف المخازن.\n145: \n146: ---\n147: \n148: ## الخطوة 1: متطلبات التشغيل الأساسية (لمرة واحدة فقط)\n149: 1. **تثبيت Python**:\n150:    - قم بتحميل وتثبيت **Python (الإصدار 3.10 أو 3.11 أو 3.12)** من الموقع الرسمي: [https://www.python.org/downloads/](https://www.python.org/downloads/)\n151:    - ⚠️ **هام جداً أثناء التثبيت**: ضع علامة صح على خيار **\"Add python.exe to PATH\"** في أسفل نافذة التثبيت الأولى.\n152: \n153: 2. **(اختياري) متصفح الويب WebView2**:\n154:    - نظام Windows 10 و 11 يحتوي على Microsoft Edge WebView2 مثبتاً مسبقاً بشكل افتراضي، وهو ما يعتمد عليه البرنامج لعرض الواجهة الحديثة.\n155: \n156: ---\n157: \n158: ## الخطوة 2: تشغيل البرنامج\n159: - ببساطة، اضغط ضغطتين مزدوجتين (Double Click) على ملف:\n160:   👉 **`run_app.bat`**\n161: \n162: - **في المرة الأولى فقط**: سيقوم الملف تلقائياً بإنشاء بيئة العمل وتثبيت المكتبات المطلوبة (قد يستغرق 1 - 2 دقيقة حسب سرعة الإنترنت).\n163: - **في المرات التالية**: سيفتح البرنامج فوراً في ثوانٍ معدودة.\n164: \n165: ---\n166: \n167: ## الخطوة 3: إعداد مفاتيح الـ API (إذا لزم)\n168: - يحتوي المجلد على ملف اسمه `.env` (أو قم بنسخ `.env.example` إلى `.env`).\n169: - افتح ملف `.env` بأي محرر نصوص (مثل المفكرة Notepad) وضع المفاتيح الخاصة بك:\n170:   ```env\n171:   UNSTRUCTURED_API_KEY=مفتاح_الموقع\n172:   GEMINI_API_KEY=مفتاح_جيميني_إذا_كنت_تستخدمه\n173:   ```\n174: - أو يمكنك إدخال وتعديل الإعدادات ورابط السيرفر المحلي مباشرة من شاشة **\"إعدادات النظام\"** داخل البرنامج نفسه.\n175: \n176: ---\n177: \n178: ## مكونات المجلد:\n179: - `desktop_app/`: ملفات الواجهة الرسومية وسطح المكتب.\n180: - `src/`: محرك المطابقة الذكي ومعالجة الإكسيل وملفات الـ PDF.\n181: - `data/`: مجلد حفظ العمليات والنتائج وقاعدة البيانات (يبدأ نظيفاً وخالياً).\n182: - `run_app.bat`: زر التشغيل السريع للبرنامج.\n183: \"\"\"\n184:     (DIST_DIR / \"README_SETUP.md\").write_text(readme_content, encoding=\"utf-8\")\n185:     print(\"[+] Created README_SETUP.md\")\n186: \n187:     print(\"\\n\" + \"=\" * 60)\n188:     print(f\"[SUCCESS] Production package successfully created at:\\n  {DIST_DIR}\")\n189:     print(\"=\" * 60)\n190: \n191: if __name__ == \"__main__\":\n192:     package()\n193: \nThe above content shows the entire, complete file contents of the requested file.\n"}
