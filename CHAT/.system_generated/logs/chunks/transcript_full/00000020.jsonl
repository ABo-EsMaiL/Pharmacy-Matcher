                 \n176:             if self.window:\n177:                 self.window.evaluate_js(\"window.dispatchEvent(new CustomEvent('process_update', {detail: {process_id: '%s', status: 'processing', message: 'جاري قراءة الملفات...'}}));\" % process_id)\n178:                 \n179:             # Import actual project modules\n180:             from src.config import load_config\n181:             from src.extract.file_handler import read_input_files\n182:             from src.fast_match.coordinator import FastCoordinator\n183:             from src.output.excel_writer import write_results_excel\n184:             \n185:             # Load and update config with current settings\n186:             settings = self.get_settings()\n187:             config = load_config()\n188:             config.unstructured_api_key = settings.get('unstructured_api_key', '') or config.unstructured_api_key\n189:             config.local_api_url = settings.get('local_api_url', '') or config.local_api_url\n190:             config.local_api_key = settings.get('local_api_key', '') or config.local_api_key\n191:             config.local_model = settings.get('local_model', '') or config.local_model\n192:             \n193:             self.add_log(\"[PROCESS] Config loaded.\")\n194:             if self.window:\n195:                 self.window.evaluate_js(\"window.dispatchEvent(new CustomEvent('process_update', {detail: {process_id: '%s', status: 'processing', message: 'جاري استخراج البيانات من الملفات...'}}));\" % process_id)\n196:             \n197:             # Read input files (this handles PDF→Unstructured API automatically)\n198:             api_key = settings.get('unstructured_api_key', '') or config.unstructured_api_key\n199:             self.add_log(\"[PROCESS] Reading Shortages files...\")\n200:             shortage_data = read_input_files(copied_shortages, role=\"shortages\", api_key=api_key)\n201:             self.add_log(f\"[PROCESS] Read {len(shortage_data)} shortage files.\")\n2