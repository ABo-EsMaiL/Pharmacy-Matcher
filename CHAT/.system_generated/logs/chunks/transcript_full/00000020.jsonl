ption as e:\n270:                 return {\"success\": False, \"error\": str(e)}\n271:         return {\"success\": False, \"error\": \"File not found\"}\n272: \n273:     def open_folder(self, process_id: str) -> dict:\n274:         try:\n275:             folder = self.db.get_process_dir(process_id)\n276:             if folder.exists():\n277:                 os.startfile(str(folder))\n278:                 return {\"success\": True}\n279:             return {\"success\": False, \"error\": \"Folder not found\"}\n280:         except Exception as e:\n281:             return {\"success\": False, \"error\": str(e)}\n282: \n283:     def open_file(self, filepath: str) -> dict:\n284:         try:\n285:             if os.path.exists(filepath):\n286:                 os.startfile(filepath)\n287:                 return {\"success\": True}\n288:             return {\"success\": False, \"error\": \"File not found\"}\n289:         except Exception as e:\n290:             return {\"success\": False, \"error\": str(e)}\n291: \n292:     def apply_reviews(self, process_id: str) -> dict:\n293:         proc = self.db.get_process(process_id)\n294:         if not proc or not proc.get('output_file') or not os.path.exists(proc['output_file']):\n295:             return {\"success\": False, \"error\": \"ملف النتائج غير موجود\"}\n296:             \n297:         try:\n298:             wb = openpyxl.load_workbook(proc['output_file'])\n299:             if 'يحتاج مراجعة' not in wb.sheetnames:\n300:                 return {\"success\": False, \"error\": \"شيت المراجعة غير موجود\"}\n301:                 \n302:             review_ws = wb['يحتاج مراجعة']\n303:             not_found_ws = wb['لم يُعثر عليه'] if 'لم يُعثر عليه' in wb.sheetnames else None\n304:             \n305:             matched_count = 0\n306:             rejected_count = 0\n307:             rows_to_delete = []\n308:             \n309:             # Columns in review sheet: القرار(A), اسم الصنف المطلوب(B), اسم المرشح(C), المخزن(D), السبب(E)\n310:             for row_idx in range(2, review_ws.max_row + 1):\n311:                 decision = review_ws.cell(row=row_idx, column=1).value\n312:                 req_name = review_ws.cell(row=row_idx, column=2).value\n313:                 wh_candidate = review_ws.cell(row=row_idx, column=3).value\n314:                 wh_name = review_ws.cell(row=row_idx, column=4).value\n315:                 \n316:                 if decision == '✅ مطابق':\n317:                     # Find the warehouse sheet and add the item there\n318:                     safe_wh_name = wh_name or \"\"\n319:                     for ch in r\"[]:*?/\\\\\":\n320:                         safe_wh_name = safe_wh_name.replace(ch, \"_\")\n321:                     safe_wh_name = safe_wh_name[:31]\n322:                     \n323:                     if safe_wh_name in wb.sheetnames:\n324:                         ws_target = wb[safe_wh_name]\n325:                         ws_target.append([req_name, wh_candidate, \"تأكيد يدوي (مراجعة)\"])\n326:                     \n327:                     matched_count += 1\n328:                     rows_to_delete.append(row_idx)\n329:                     \n330:                 elif decision == '❌ غير مطابق':\n331:                     # Move to \"لم يُعثر عليه\"\n332:                     if not_found_ws:\n333:                         not_found_ws.append([req_name, \"مرفوض يدوياً\"])\n334:                     \n335:                     rejected_count += 1\n336:                     rows_to_delete.append(row_idx)\n337:                     \n338:                 # Empty decision = leave as is (user hasn't decided yet)\n339:                     \n340:             # Delete processed rows from bottom to top\n341:             for row_idx in sorted(rows_to_delete, reverse=True):\n342:                 review_ws.delete_rows(row_idx)\n343:                 \n344:             wb.save(proc['output_file'])\n345:             \n346:             remaining = review_ws.max_row - 1 if 