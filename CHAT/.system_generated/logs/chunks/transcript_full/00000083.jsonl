eview_reqs]\nprint(f\"Total unmatched shortages: {len(unmatched_shortages)}\")\n\n# 3. Read all warehouse items\nwh_dir = Path(\"data/input/warehouses\")\nwh_files = list(wh_dir.glob(\"*.xlsx\"))\n\nwarehouses_data = {}\nfor wh_file in wh_files:\n    rows = read_excel(wh_file)\n    extracted = extract_item_names(rows)\n    items = [x[\"item_name_raw\"].strip() for x in extracted if x[\"item_name_raw\"]]\n    warehouses_data[wh_file.stem] = items\n\n# 4. Check unmatched shortages against all warehouse items\npotential_misses = []\n\nfor s in unmatched_shortages:\n    s_brands = extract_brand_tokens(s).split()\n    s_form = extract_form_group(s)\n    s_st = extract_strength(s)\n    \n    if not s_brands:\n        continue\n    first_s_brand = s_brands[0]\n    if len(first_s_brand) < 3:\n        continue\n    \n    for wh_name, wh_items in warehouses_data.items():\n        for w in wh_items:\n            w_brands = extract_brand_tokens(w).split()\n            if not w_brands:\n                continue\n            first_w_brand = w_brands[0]\n            if len(first_w_brand) < 3:\n                continue\n            \n            # Check brand match\n            brand_sim = fuzz.ratio(first_s_brand, first_w_brand)\n            if brand_sim >= 82 or first_s_brand in w_brands:\n                w_form = extract_form_group(w)\n                w_st = extract_strength(w)\n                \n                # Check form conflict\n                form_conflict = False\n                if s_form and w_form and s_form != w_form:\n                    form_conflict = True\n                \n                # Check strength conflict\n                strength_conflict = False\n                if s_st and w_st and not (s_st & w_st):\n                    strength_conflict = True\n                \n                token_sort = fuzz.token_sort_ratio(s, w)\n                ratio = fuzz.ratio(s, w)\n                \n                if token_sort >= 60:\n                    potential_misses.append({\n                        \"shortage\": s,\n                        \"warehouse\": wh_name,\n                        \"wh_item\": w,\n                        \"ratio\": ratio,\n                        \"token_sort\": token_sort,\n                        \"brand_sim\": brand_sim,\n                        \"form_conflict\": form_conflict,\n                        \"strength_conflict\": strength_conflict,\n                        \"s_form\": s_form,\n                        \"w_form\": w_form,\n                        \"s_st\": list(s_st),\n                        \"w_st\": list(w_st)\n                    })\n\nclean_misses = [m for m in potential_misses if not m[\"form_conflict\"] and not m[\"strength_conflict\"]]\nclean_misses.sort(key=lambda x: x[\"token_sort\"], reverse=True)\n\nprint(f\"\\nPotential candidate matches found: {len(potential_misses)}\")\nprint(f\"Clean candidates (no form or strength conflict): {len(clean_misses)}\")\n\nprint(\"\\n--- TOP CLEAN CANDIDATES (Could any of these be real false negatives?) ---\")\nseen_pairs = set()\ncount = 0\nfor m in clean_misses:\n    pair_key = (m['shortage'], m['wh_item'])\n    if pair_key in seen_pairs:\n        continue\n    seen_pairs.add(pair_key)\n    print(f\"[{m['warehouse']}] Shortage: '{m['shortage']}' <==> Wh: '{m['wh_item']}' | token_sort: {m['token_sort']} | st: {m['s_st']} vs {m['w_st']}\")\n    count += 1\n    if count >= 50:\n        break\n","Description":"Script to find any potential false negatives with robust strength and form checking","Overwrite":true,"TargetFile":"d:\\AI_Engineer\\Pharmacy-agy\\scratch\\find_false_negatives.py","toolAction":"Write script","toolSummary":"Write false negative check script"}}]}
