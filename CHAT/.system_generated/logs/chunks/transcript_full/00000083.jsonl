{"step_index":3961,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-22T22:11:43Z","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"import openpyxl\nimport re\nfrom pathlib import Path\nfrom rapidfuzz import fuzz\nfrom src.extract.excel_reader import read_excel, extract_item_names\nfrom src.fast_match.search import extract_brand_token, extract_dosage_strength, extract_form_group\n\nresults_path = Path(\"data/processes/PROC-001/results_PROC-001.xlsx\")\nwb = openpyxl.load_workbook(results_path, data_only=True)\n\n# 1. Collect all matched and review items\nmatched_reqs = set()\nreview_reqs = set()\n\nfor sheetname in wb.sheetnames:\n    if \"مطابقة\" in sheetname and \"ملخص\" not in sheetname:\n        ws = wb[sheetname]\n        for row in list(ws.iter_rows(values_only=True))[1:]:\n            if row and row[0]:\n                matched_reqs.add(str(row[0]).strip())\n    elif \"مراجعة\" in sheetname:\n        ws = wb[sheetname]\n        for row in list(ws.iter_rows(values_only=True))[1:]:\n            if row and row[0]:\n                review_reqs.add(str(row[0]).strip())\n\nprint(f\"Total matched requested items across sheets: {len(matched_reqs)}\")\nprint(f\"Total review requested items across sheets: {len(review_reqs)}\")\n\n# 2. Read all shortages from original file\nshortages_file = Path(\"data/input/shortages/0913.xlsx\")\nshortage_rows = read_excel(shortages_file)\nshortage_items = extract_item_names(shortage_rows, name_column=\"أسم الصنف\")\nall_shortage_names = list({item[\"item_name_raw\"].strip() for item in shortage_items if item[\"item_name_raw\"]})\nprint(f\"Total unique shortages in 0913.xlsx: {len(all_shortage_names)}\")\n\n# Unmatched items\nunmatched_shortages = [s for s in all_shortage_names if s not in matched_reqs and s not in review_reqs]\nprint(f\"Total unmatched shortages: {len(unmatched_shortages)}\")\n\n# 3. Read all warehouse items\nwh_dir = Path(\"data/input/warehouses\")\nwh_files = list(wh_dir.glob(\"*.xlsx\"))\n\nwarehouses_data = {}\nfor wh_file in wh_files:\n    rows = read_excel(wh_file)\n    extracted = extract_item_names(rows)\n    items = [x[\"item_name_raw\"].strip() for x in extracted if x[\"item_name_raw\"]]\n    warehouses_data[wh_file.stem] = items\n    print(f\"Warehouse {wh_file.stem}: {len(items)} items\")\n\n# 4. Check unmatched shortages against all warehouse items\n# Look for strong candidate matches that might have been missed (brand token match + form match + high token sort ratio)\npotential_misses = []\n\nfor s in unmatched_shortages:\n    s_brand = extract_brand_token(s)\n    s_forms = extract_form_group(s)\n    s_st = extract_dosage_strength(s)\n    \n    for wh_name, wh_items in warehouses_data.items():\n        for w in wh_items:\n            w_brand = extract_brand_token(w)\n            # Must share brand token or have very high ratio\n            ratio = fuzz.ratio(s, w)\n            token_sort = fuzz.token_sort_ratio(s, w)\n            \n            # Check if brand tokens match and length > 3\n            brand_match = (s_brand and w_brand and (s_brand == w_brand or fuzz.ratio(s_brand, w_brand) >= 85))\n            \n            if brand_match and (ratio >= 65 or token_sort >= 70):\n                w_forms = extract_form_group(w)\n                w_st = extract_dosage_strength(w)\n                \n                # Check form conflict (e.g. cream vs ointment, tab vs syr)\n                form_conflict = False\n                if s_forms and w_forms and not (s_forms & w_forms):\n                    form_conflict = True\n                \n                # Check strength conflict\n                strength_conflict = False\n                if s_st and w_st and s_st != w_st:\n                    strength_conflict = True\n                \n                potential_misses.append({\n                    \"shortage\": s,\n                    \"warehouse\": wh_name,\n                    \"wh_item\": w,\n                    \"ratio\": ratio,\n                    \"token_sort\": token_sort,\n                    \"brand_match\": brand_match,\n                    \"form_conflict\": form_conflict,\n                    \"strength_conflict\": strength_conflict,\n                    \"s_forms\": list(s_forms),\n                    \"w_forms\": list(w_forms),\n                    \"s_st\": s_st,\n                    \"w_st\": w_st\n                })\n\nprint(f\"\\nPotential matches found for unmatched shortages: {len(potential_misses)}\")\n\n# Filter to real candidates (no form conflict, no strength conflict)\nclean_misses = [m for m in potential_misses if not m[\"form_conflict\"] and not m[\"strength_conflict\"]]\nprint(f\"Clean candidates (no form/strength conflict): {len(clean_misses)}\")\n\nfor m in clean_misses[:30]:\n    print(f\"- Shortage: '{m['shortage']}' vs [{m['warehouse']}] '{m['wh_item']}' (ratio: {m['ratio']}, token_sort: {m['token_sort']}, forms: {m['s_forms']} vs {m['w_forms']}, st: {m['s_st']})\")\n","Description":"Scan for potential false negatives where an item in shortages existed in warehouses but was not matched","Overwrite":true,"TargetFile":"d:\\AI_Engineer\\Pharmacy-agy\\scratch\\find_false_negatives.py","toolAction":"Create script","toolSummary":"Script to find false negatives"}}]}
