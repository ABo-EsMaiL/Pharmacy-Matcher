{"step_index":1770,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-22T10:41:28Z","content":"Created At: 2026-09-22T13:41:28+03:00\nCompleted At: 2026-09-22T13:41:28+03:00\nFile Path: `file:///d:/AI_Engineer/Pharmacy-agy/desktop_app/templates/index.html`\nTotal Lines: 1812\nTotal Bytes: 65269\nShowing lines 1100 to 1400\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1100:     <!-- The original screen-home is removed. We use screen-new as the home page. \n1101:          To keep app.js happy if it references screen-home, we add a dummy hidden div -->\n1102:     <div id=\"screen-home\" style=\"display:none;\"></div>\n1103: \n1104:     <script>\n1105: let currentProcessId = null;\n1106: let selectedWarehouseFiles = [];\n1107: let selectedShortageFiles = [];\n1108: let serverStatusInterval = null;\n1109: let isServerRunning = false;\n1110: \n1111: // Ensure Pywebview API is ready\n1112: window.addEventListener('pywebviewready', function() {\n1113:     loadSettings();\n1114:     loadLogs();\n1115:     updateServerStatus();\n1116:     serverStatusInterval = setInterval(updateServerStatus, 5000);\n1117:     setupDragAndDrop();\n1118: });\n1119: \n1120: // Logs Logic\n1121: window.addEventListener('new_log', function(e) {\n1122:     // 1. Update the main system logs textarea (in Settings)\n1123:     const logArea = document.getElementById('system-logs');\n1124:     if (logArea) {\n1125:         logArea.value += e.detail + '\\n';\n1126:         logArea.scrollTop = logArea.scrollHeight;\n1127:     }\n1128:     \n1129:     // 2. Update the pipeline terminal textarea (in Terminal screen)\n1130:     const termEl = document.getElementById('pipeline-log-terminal');\n1131:     if (termEl) {\n1132:         termEl.value += e.detail + '\\n';\n1133:         termEl.scrollTop = termEl.scrollHeight;\n1134:     }\n1135: });\n1136: \n1137: async function loadLogs() {\n1138:     try {\n1139:         const logsStr = await window.pywebview.api.get_logs();\n1140:         const logs = JSON.parse(logsStr);\n1141:         const logArea = document.getElementById('system-logs');\n1142:         if (logArea) {\n1143:             logArea.value = logs.join('\\n') + (logs.length ? '\\n' : '');\n1144:             logArea.scrollTop = logArea.scrollHeight;\n1145:         }\n1146:     } catch (e) {\n1147:         console.error(e);\n1148:     }\n1149: }\n1150: \n1151: // Toast Notifications\n1152: function showToast(message, type = 'success') {\n1153:     const container = document.getElementById('toast-container');\n1154:     const toast = document.createElement('div');\n1155:     toast.className = `toast ${type}`;\n1156:     \n1157:     const icon = type === 'success' ? 'ph-check-circle' : 'ph-warning-circle';\n1158:     toast.innerHTML = `<i class=\"ph-fill ${icon}\"></i> <span>${message}</span>`;\n1159:     \n1160:     container.appendChild(toast);\n1161:     \n1162:     setTimeout(() => {\n1163:         toast.style.animation = 'fadeOut 0.3s ease forwards';\n1164:         setTimeout(() => toast.remove(), 300);\n1165:     }, 3000);\n1166: }\n1167: \n1168: // Exit App\n1169: async function exitApp() {\n1170:     try {\n1171:         let isRunning = false;\n1172:         if (window.pywebview && window.pywebview.api) {\n1173:             const historyStr = await window.pywebview.api.get_history();\n1174:             const history = JSON.parse(historyStr);\n1175:             isRunning = history.some(item => item.status === 'processing');\n1176:         }\n1177:         \n1178:         if (isRunning) {\n1179:             showCustomConfirm('تأكيد الإغلاق', 'توجد عمليات مطابقة قيد التشغيل في الخلفية. هل أنت متأكد من الإغلاق؟', async () => {\n1180:                 await window.pywebview.api.exit_app();\n1181:             });\n1182:         } else {\n1183:             if (window.pywebview && window.pywebview.api) {\n1184:                 await window.pywebview.api.exit_app();\n1185:             }\n1186:         }\n1187:     } catch (e) {\n1188:         console.error(e);\n1189:         // Fallback\n1190:         if (window.pywebview && window.pywebview.api) {\n1191:             window.pywebview.api.exit_app();\n1192:         }\n1193:     }\n1194: }\n1195: \n1196: // Delete Process\n1197: function deleteProcess(processId) {\n1198:     showCustomConfirm('تأكيد الحذف', 'هل أنت متأكد من حذف هذه العملية نهائياً من السجل؟', async () => {\n1199:         try {\n1200:             const res = await window.pywebview.api.delete_process(processId);\n1201:             if (res.success) {\n1202:                 showToast('تم الحذف بنجاح', 'success');\n1203:                 loadHistory();\n1204:             } else {\n1205:                 showToast('خطأ: ' + res.error, 'error');\n1206:             }\n1207:         } catch (error) {\n1208:             showToast('خطأ في الحذف', 'error');\n1209:         }\n1210:     });\n1211: }\n1212: \n1213: // --- Drag & Drop Logic ---\n1214: function processSelectedFiles(files, targetZone) {\n1215:     const validShortageExts = ['.pdf', '.xlsx', '.xls', '.csv'];\n1216:     const validWarehouseExts = ['.pdf', '.xlsx', '.xls', '.csv', '.json'];\n1217:     \n1218:     const validExts = targetZone === 'warehouse' ? validWarehouseExts : validShortageExts;\n1219:     const validFiles = [];\n1220:     const invalidFiles = [];\n1221:     \n1222:     files.forEach(f => {\n1223:         const ext = f.substring(f.lastIndexOf('.')).toLowerCase();\n1224:         if (validExts.includes(ext) || !f.includes('.')) {\n1225:             validFiles.push(f);\n1226:         } else {\n1227:             invalidFiles.push(f);\n1228:         }\n1229:     });\n1230:     \n1231:     if (invalidFiles.length > 0) {\n1232:         showToast(`تم تجاهل ${invalidFiles.length} ملفات غير مدعومة. المسموح: ${validExts.join(', ')}`, 'error');\n1233:     }\n1234:     \n1235:     if (validFiles.length > 0) {\n1236:         if (targetZone === 'warehouse') {\n1237:             selectedWarehouseFiles = [...selectedWarehouseFiles, ...validFiles];\n1238:             updateFileList('warehouse', selectedWarehouseFiles);\n1239:         } else {\n1240:             selectedShortageFiles = [...selectedShortageFiles, ...validFiles];\n1241:             updateFileList('shortage', selectedShortageFiles);\n1242:         }\n1243:         checkSubmitState();\n1244:     }\n1245: }\n1246: \n1247: function setupDragAndDrop() {\n1248:     const zones = [\n1249:         { id: 'zone-shortage', type: 'shortage' },\n1250:         { id: 'zone-warehouse', type: 'warehouse' }\n1251:     ];\n1252: \n1253:     zones.forEach(({id, type}) => {\n1254:         const zone = document.getElementById(id);\n1255:         if (!zone) return;\n1256: \n1257:         zone.addEventListener('dragenter', () => { window.activeDragZone = type; });\n1258:         zone.addEventListener('dragover', (e) => {\n1259:             e.preventDefault();\n1260:             window.activeDragZone = type;\n1261:             zone.style.borderColor = 'var(--primary)';\n1262:             zone.style.background = '#f0f9ff';\n1263:         });\n1264: \n1265:         zone.addEventListener('dragleave', (e) => {\n1266:             e.preventDefault();\n1267:             zone.style.borderColor = '';\n1268:             zone.style.background = '';\n1269:         });\n1270: \n1271:         zone.addEventListener('drop', async (e) => {\n1272:             e.preventDefault();\n1273:             zone.style.borderColor = '';\n1274:             zone.style.background = '';\n1275:             \n1276:             if (e.dataTransfer && e.dataTransfer.files) {\n1277:                 const files = Array.from(e.dataTransfer.files);\n1278:                 const savedPaths = [];\n1279:                 \n1280:                 // Show a mini loading toast if dropping many files\n1281:                 if (files.length > 2) {\n1282:                     showToast('جاري معالجة الملفات المسحوبة...', 'success');\n1283:                 }\n1284:                 \n1285:                 for (let file of files) {\n1286:                     // if it happens to have a path, use it directly (e.g. Mac/Linux or specific pywebview configs)\n1287:                     if (file.path && (file.path.includes('\\\\') || file.path.includes('/'))) {\n1288:                         savedPaths.push(file.path);\n1289:                     } else {\n1290:                         // Otherwise fallback to Base64 (Perfect for Edge WebView2)\n1291:                         await new Promise((resolve) => {\n1292:                             const reader = new FileReader();\n1293:                             reader.onload = async (event) => {\n1294:                                 const base64 = event.target.result.split(',')[1];\n1295:                                 const tempPath = await window.pywebview.api.save_dropped_file(file.name, base64);\n1296:                                 if (tempPath) {\n1297:                                     savedPaths.push(tempPath);\n1298:                                 }\n1299:                                 resolve();\n1300:                             };\n1301:                             reader.readAsDataURL(file);\n1302:                         });\n1303:                     }\n1304:                 }\n1305:                 \n1306:                 if (savedPaths.length > 0) {\n1307:                     processSelectedFiles(savedPaths, type);\n1308:                 }\n1309:             }\n1310:             window.activeDragZone = null;\n1311:         });\n1312:     });\n1313: }\n1314: \n1315: // --- New Process Logic ---\n1316: function resetNewProcessForm() {\n1317:     selectedWarehouseFiles = [];\n1318:     selectedShortageFiles = [];\n1319:     updateFileList('warehouse', selectedWarehouseFiles);\n1320:     updateFileList('shortage', selectedShortageFiles);\n1321:     document.getElementById('progress-area').classList.add('hidden');\n1322:     document.getElementById('btn-submit').removeAttribute('disabled');\n1323:     checkSubmitState();\n1324: }\n1325: \n1326: async function selectFiles(type) {\n1327:     try {\n1328:         const filePaths = await window.pywebview.api.select_files(type);\n1329:         if (filePaths && filePaths.length > 0) {\n1330:             const pathList = JSON.parse(filePaths);\n1331:             processSelectedFiles(pathList, type);\n1332:         }\n1333:     } catch (error) {\n1334:         showToast('حدث خطأ أثناء اختيار الملفات', 'error');\n1335:         console.error(error);\n1336:     }\n1337: }\n1338: \n1339: function updateFileList(type, files) {\n1340:     const listEl = document.getElementById(`list-${type}`);\n1341:     listEl.innerHTML = '';\n1342:     files.forEach((path, index) => {\n1343:         let fileName = path.split('\\\\').pop().split('/').pop();\n1344:         if (fileName.includes('?')) {\n1345:             fileName = fileName.split('?')[0];\n1346:         }\n1347:         \n1348:         let iconClass = 'ph-file';\n1349:         const ext = fileName.split('.').pop().toLowerCase();\n1350:         if (ext === 'pdf') iconClass = 'ph-file-pdf text-danger';\n1351:         else if (ext === 'xlsx' || ext === 'xls' || ext === 'csv') iconClass = 'ph-file-xls text-success';\n1352:         else if (ext === 'json') iconClass = 'ph-file-code text-warning';\n1353: \n1354:         const li = document.createElement('li');\n1355:         li.className = 'file-item';\n1356:         li.innerHTML = `\n1357:             <div class=\"file-item-name\" title=\"${path}\">\n1358:                 <i class=\"ph-fill ${iconClass}\"></i>\n1359:                 <span>${fileName}</span>\n1360:             </div>\n1361:             <button class=\"file-item-delete\" onclick=\"removeFile('${type}', ${index})\" title=\"إزالة الملف\">\n1362:                 <i class=\"ph-fill ph-trash\"></i>\n1363:             </button>\n1364:         `;\n1365:         listEl.appendChild(li);\n1366:     });\n1367: }\n1368: \n1369: function removeFile(type, index) {\n1370:     if (type === 'warehouse') {\n1371:         selectedWarehouseFiles.splice(index, 1);\n1372:         updateFileList('warehouse', selectedWarehouseFiles);\n1373:     } else {\n1374:         selectedShortageFiles.splice(index, 1);\n1375:         updateFileList('shortage', selectedShortageFiles);\n1376:     }\n1377:     checkSubmitState();\n1378: }\n1379: \n1380: function checkSubmitState() {\n1381:     const btn = document.getElementById('btn-submit');\n1382:     if (selectedWarehouseFiles.length > 0 && selectedShortageFiles.length > 0) {\n1383:         btn.removeAttribute('disabled');\n1384:     } else {\n1385:         btn.setAttribute('disabled', 'true');\n1386:     }\n1387: }\n1388: \n1389: async function submitProcess() {\n1390:     if (selectedShortageFiles.length === 0 || selectedWarehouseFiles.length === 0) {\n1391:         showToast('يرجى اختيار ملف نواقص وملف مخزن واحد على الأقل', 'error');\n1392:         return;\n1393:     }\n1394:     \n1395:     const btn = document.getElementById('btn-submit');\n1396:     const progressModal = document.getElementById('progress-modal');\n1397:     \n1398:     // UI Loading state\n1399:     btn.classList.add('hidden');\n1400:     progressModal.style.display = 'flex';\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
