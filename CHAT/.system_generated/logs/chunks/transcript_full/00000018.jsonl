d-color: var(--bg-sidebar);\n    border-left: 1px solid var(--border); /* RTL */\n    display: flex;\n    flex-direction: column;\n    box-shadow: var(--shadow-md);\n    z-index: 10;\n}\n\n.brand {\n    padding: 30px 24px;\n    display: flex;\n    align-items: center;\n    gap: 16px;\n    border-bottom: 1px solid var(--border);\n    color: var(--primary);\n}\n\n.brand i {\n    font-size: 42px;\n    filter: drop-shadow(0 4px 6px rgba(14, 165, 233, 0.3));\n}\n\n.brand-text h1 {\n    font-size: 24px;\n    font-weight: 800;\n    line-height: 1.2;\n    color: var(--text-main);\n}\n\n.brand-text span {\n    font-size: 13px;\n    color: var(--text-muted);\n    font-weight: 600;\n    letter-spacing: 0.5px;\n}\n\n.nav-menu {\n    padding: 24px 16px;\n    display: flex;\n    flex-direction: column;\n    gap: 12px;\n    flex: 1;\n}\n\n.nav-item {\n    display: flex;\n    align-items: center;\n    gap: 16px;\n    width: 100%;\n    padding: 16px 20px;\n    background: transparent;\n    border: none;\n    border-radius: var(--radius-md);\n    color: var(--text-muted);\n    font-size: 16px;\n    font-weight: 700;\n    text-align: right;\n    cursor: pointer;\n    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n}\n\n.nav-item i {\n    font-size: 22px;\n    transition: transform 0.3s ease;\n}\n\n.nav-item:hover {\n    background-color: var(--bg-main);\n    color: var(--primary);\n    transform: translateX(-4px);\n}\n.nav-item:hover i {\n    transform: scale(1.1);\n}\n\n.nav-item.active {\n    background-color: var(--primary);\n    color: white;\n    box-shadow: 0 8px 16px rgba(14, 165, 233, 0.25);\n}\n\n.sidebar-footer {\n    padding: 20px 16px;\n    border-top: 1px solid var(--border);\n}\n\n.text-danger {\n    color: var(--danger) !important;\n}\n.text-danger:hover {\n    background-color: #fef2f2 !important;\n}\n\n.server-status-card {\n    background-color: var(--bg-main);\n    border: 1px solid var(--border);\n    border-radius: var(--radius-md);\n    padding: 16px;\n    ma