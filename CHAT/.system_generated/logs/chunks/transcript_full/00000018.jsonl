hed_count = 0\n272:             rejected_count = 0\n273:             rows_to_delete = []\n274:             \n275:             # Columns in review sheet: القرار(A), اسم الصنف المطلوب(B), اسم المرشح(C), المخزن(D), السبب(E)\n276:             for row_idx in range(2, review_ws.max_row + 1):\n277:                 decision = review_ws.cell(row=row_idx, column=1).value\n278:                 req_name = review_ws.cell(row=row_idx, column=2).value\n279:                 wh_candidate = review_ws.cell(row=row_idx, column=3).value\n280:                 wh_name = review_ws.cell(row=row_idx, column=4).value\n281:                 \n282:                 if decision == '✅ مطابق':\n283:                     # Find the warehouse sheet and add the item there\n284:                     safe_wh_name = wh_name or \"\"\n285:                     for ch in r\"[]:*?/\\\\\":\n286:                         safe_wh_name = safe_wh_name.replace(ch, \"_\")\n287:                     safe_wh_name = safe_wh_name[:31]\n288:                     \n289:                     if safe_wh_name in wb.sheetnames:\n290:                         ws_target = wb[safe_wh_name]\n291:                         ws_target.append([req_name, wh_candidate, \"تأكيد يدوي (مراجعة)\"])\n292:                     \n293:                     matched_count += 1\n294:                     rows_to_delete.append(row_idx)\n295:                     \n296:                 elif decision == '❌ غير مطابق':\n297:                     # Move to \"لم يُعثر عليه\"\n298:                     if not_found_ws:\n299:                         not_found_ws.append([req_name, \"مرفوض يدوياً\"])\n300:                     \n301:                     rejected_count += 1\n302:                     rows_to_delete.append(row_idx)\n303:                     \n304:                 # Empty decision = leave as is (user hasn't decided yet)\n305:                     \n306:             # Delete processed rows from bottom to top\n307:             for row_idx in sorted(rows_to_delete