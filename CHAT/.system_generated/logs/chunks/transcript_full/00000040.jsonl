essId);\n1534:         showToast(`تم تنفيذ التعديلات! نجاح: ${result.success}, فشل: ${result.failed}`, 'success');\n1535:         \n1536:         if (result.new_stats) {\n1537:             loadResults(result.new_stats);\n1538:         }\n1539:     } catch (error) {\n1540:         showToast('حدث خطأ أثناء تنفيذ التعديلات', 'error');\n1541:     }\n1542: }\n1543: \n1544: // --- History Logic ---\n1545: async function loadHistory() {\n1546:     const listEl = document.getElementById('history-list');\n1547:     listEl.innerHTML = '<div class=\"spinner\"></div>';\n1548:     \n1549:     try {\n1550:         const historyStr = await window.pywebview.api.get_history();\n1551:         const history = JSON.parse(historyStr);\n1552:         \n1553:         if (!history || history.length === 0) {\n1554:             listEl.innerHTML = '<div class=\"empty-state\"><i class=\"ph-fill ph-empty\"></i><p>لا توجد عمليات سابقة مسجلة.</p></div>';\n1555:             return;\n1556:         }\n1557:         \n1558:         listEl.innerHTML = '';\n1559:         history.forEach(item => {\n1560:             const date = new Date(item.created_at).toLocaleString('ar-EG');\n1561:             const statusClass = item.status === 'completed' ? 'badge-completed' : (item.status === 'processing' ? 'badge-processing' : 'badge-reviewing');\n1562:             let statusText = item.status === 'completed' ? 'مكتمل' : 'قيد المراجعة';\n1563:             if (item.status === 'processing') statusText = 'قيد التشغيل...';\n1564:             else if (item.status === 'error') statusText = 'فشل';\n1565:             \n1566:             const card = document.createElement('div');\n1567:             card.className = 'history-card';\n1568:             card.onclick = () => { if(item.status !== 'processing') viewProcess(item.id); };\n1569:             \n1570:             card.innerHTML = `\n1571:                 <div class=\"history-info\">\n1572:                     <div class=\"history-header\">\n1573:                         <h4>العملية ${item.id.substring(0,8)}...</h4>\n1574:                         <span class=\"badge-status ${statusClass}\">${statusText}</span>\n1575:                     </div>\n1576:                     <div class=\"history-date\"><i class=\"ph ph-calendar\"></i> ${date}</div>\n1577:                     <div class=\"history-files\">\n1578:                         <span><i class=\"ph-fill ph-files\"></i> ${JSON.parse(item.shortage_files || '[]').length} نواقص</span>\n1579:                         <span><i class=\"ph-fill ph-folders\"></i> ${JSON.parse(item.warehouse_files || '[]').length} مخازن</span>\n1580:                     </div>\n1581:                 </div>\n1582:                 <div class=\"history-actions\">\n1583:                     ${item.status === 'processing' \n1584:                         ? `<button class=\"btn btn-primary\" style=\"opacity:0.7; cursor:not-allowed;\" disabled><i class=\"ph-fill ph-spinner-gap spinner\"></i> جاري التشغيل...</button>`\n1585:                         : (item.status === 'error'\n1586:                             ? `<button class=\"btn btn-warning\" onclick=\"restartProcess('${item.id}')\"><i class=\"ph-fill ph-arrow-counter-clockwise\"></i> إعادة تشغيل</button>\n1587:                                <button class=\"btn btn-danger btn-icon\" onclick=\"event.stopPropagation(); deleteProcess('${item.id}')\"><i class=\"ph ph-trash\"></i></button>`\n1588:                             : `<button class=\"btn btn-primary\" onclick=\"viewProcess('${item.id}')\"><i class=\"ph-fill ph-eye\"></i> عرض النتائج</button>\n1589:                                <button class=\"btn btn-danger btn-icon\" onclick=\"event.stopPropagation(); deleteProcess('${item.id}')\"><i class=\"ph ph-trash\"></i></button>`\n1590:                         )\n1591:                     }\n1592:                 </div>\n1593:             `;\n1594:             listEl.appendChild(card);\n1595:         });\n1596:     } catch (e) {\n1597:         console.error(e);