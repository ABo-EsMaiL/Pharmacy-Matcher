f.vectorizer.fit_transform(self.corpus)\n102: \n103:     def search(self, query: str, top_k: int = 6) -> list[dict]:\n104:         \"\"\"Returns the top_k most similar items from the warehouse with pharmaceutical validation.\"\"\"\n105:         if not self.corpus:\n106:             return []\n107:             \n108:         q_norm = normalize_for_search(query)\n109:         if not q_norm:\n110:             return []\n111:             \n112:         q_vec = self.vectorizer.transform([q_norm])\n113:         sims = cosine_similarity(q_vec, self.matrix).flatten()\n114:         \n115:         # Look at top candidates\n116:         top_indices = np.argsort(sims)[-top_k * 3:][::-1]\n117:         \n118:         req_brand = extract_brand_tokens(query)\n119:         req_form = extract_form_group(query)\n120:         \n121:         results = []\n122:         for idx in top_indices:\n123:             score = float(sims[idx])\n124:             cand_name = self.original_names[idx]\n125:             cand_brand = extract_brand_tokens(cand_name)\n126:             cand_form = extract_form_group(cand_name)\n127:             \n128:             # Rule 1: Zero tolerance for conflicting dosage forms (Tablets vs Syrup, Cream vs Suppository, etc.)\n129:             if req_form and cand_form and req_form != cand_form:\n130:                 continue\n131:                 \n132:             # Rule 2: Brand similarity check (Levenshtein / Token sort)\n133:             words_req = req_brand.split()\n134:             words_cand = cand_brand.split()\n135:             if len(words_req) > 1 or len(words_cand) > 1:\n136:                 brand_sim = fuzz.token_sort_ratio(req_brand, cand_brand)\n137:             else:\n138:                 brand_sim = fuzz.ratio(req_brand, cand_brand)\n139:                 \n140:             # Check prefix match for brand names\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task