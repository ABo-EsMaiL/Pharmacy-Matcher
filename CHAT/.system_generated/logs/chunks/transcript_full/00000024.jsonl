}\")\n46: \n47:     url = f\"{base_url.rstrip('/')}/api/v2/parse\"\n48:     headers = {\"unstructured-api-key\": api_key}\n49: \n50:     # رفع الملف مع إعدادات الاستخراج\n51:     with open(filepath, \"rb\") as f:\n52:         files = {\n53:             \"input\": (filepath.name, f, \"application/pdf\"),\n54:         }\n55:         data = {\n56:             \"profile\": \"best\",\n57:             \"output\": \"elements\",\n58:         }\n59: \n60:         response = requests.post(url, headers=headers, files=files, data=data)\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
