{"step_index":669,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-22T00:22:20Z","content":"Created At: 2026-09-22T03:22:20+03:00\nCompleted At: 2026-09-22T03:22:20+03:00\nFile Path: `file:///d:/AI_Engineer/Pharmacy-agy/src/extract/pdf_reader.py`\nTotal Lines: 363\nTotal Bytes: 12958\nShowing lines 50 to 100\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n50:     # رفع الملف مع إعدادات الاستخراج\n51:     with open(filepath, \"rb\") as f:\n52:         files = {\n53:             \"input\": (filepath.name, f, \"application/pdf\"),\n54:         }\n55:         data = {\n56:             \"profile\": \"best\",\n57:             \"output\": \"elements\",\n58:         }\n59: \n60:         response = requests.post(url, headers=headers, files=files, data=data)\n61: \n62:     # معالجة الاستجابة\n63:     if response.status_code == 200:\n64:         # استجابة فورية - النتائج جاهزة\n65:         print(\"  ✅ تم استخراج البيانات فوراً\")\n66:         result = response.json()\n67: \n68:     elif response.status_code == 202:\n69:         # مهمة غير متزامنة - يجب الانتظار\n70:         poll_url = response.headers.get(\"Location\")\n71:         if not poll_url:\n72:             raise RuntimeError(\n73:                 \"❌ استجابة 202 بدون رابط Location للاستعلام عن حالة المهمة\"\n74:             )\n75: \n76:         print(f\"  ⏳ المهمة غير متزامنة، جارٍ الانتظار...\")\n77:         result = _poll_for_result(poll_url, headers)\n78: \n79:     else:\n80:         raise RuntimeError(\n81:             f\"❌ فشل الاتصال بـ Unstructured API\\n\"\n82:             f\"  الحالة: {response.status_code}\\n\"\n83:             f\"  الرد: {response.text[:500]}\"\n84:         )\n85: \n86:     # حفظ الاستجابة الخام كملف JSON بجانب ملف PDF\n87:     json_path = filepath.with_suffix(\".json\")\n88: