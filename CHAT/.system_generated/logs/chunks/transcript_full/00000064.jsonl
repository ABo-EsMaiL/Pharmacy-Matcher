ard.className = 'history-card';\n2245:             card.onclick = () => { if(item.status !== 'processing') viewProcess(item.id); };\n2246:             \n2247:             card.innerHTML = `\n2248:                 <div class=\"history-info\">\n2249:                     <div class=\"history-header\">\n2250:                         <h4>${t.process_label} ${item.id.substring(0,8)}...</h4>\n2251:                         <span class=\"badge-status ${statusClass}\">${statusText}</span>\n2252:                     </div>\n2253:                     <div class=\"history-date\"><i class=\"ph ph-calendar\"></i> ${date}</div>\n2254:                     <div class=\"history-files\">\n2255:                         <span><i class=\"ph-fill ph-files\"></i> ${JSON.parse(item.shortage_files || '[]').length} ${t.badge_shortages}</span>\n2256:                         <span><i class=\"ph-fill ph-folders\"></i> ${JSON.parse(item.warehouse_files || '[]').length} ${t.badge_warehouses}</span>\n2257:                     </div>\n2258:                 </div>\n2259:                 <div class=\"history-actions\">\n2260:                     ${item.status === 'processing' \n2261:                         ? `<button class=\"btn btn-primary\" style=\"opacity:0.7; cursor:not-allowed;\" disabled><i class=\"ph-fill ph-spinner-gap spinner\"></i> ${t.status_processing}</button>`\n2262:                         : (item.status === 'error'\n2263:                             ? `<button class=\"btn btn-warning\" onclick=\"restartProcess('${item.id}')\"><i class=\"ph-fill ph-arrow-counter-clockwise\"></i> ${t.btn_restart}</button>\n2264:                                <button class=\"btn btn-danger btn-icon\" onclick=\"event.stopPropagation(); deleteProcess('${item.id}')\"><i class=\"ph ph-trash\"></i></button>`\n2265:                             : `<button class=\"btn btn-primary\" onclick=\"viewProcess('${item.id}')\"><i class=\"ph-fill ph-eye\"></i> ${t.btn_view_results}</button>\n2266:                        