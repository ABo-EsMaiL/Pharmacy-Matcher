iv>\n                        <div class=\"drop-zone\" id=\"zone-shortage\">\n                            <i class=\"ph ph-upload-simple drop-icon\"></i>\n                            <h4>اضغط لاختيار الملفات</h4>\n                            <p>(يدعم PDF / Excel)</p>\n                            <button class=\"btn btn-outline\" onclick=\"selectFiles('shortage')\">تصفح الملفات</button>\n                        </div>\n                        <ul id=\"list-shortage\" class=\"file-list\"></ul>\n                    </div>\n\n                    <!-- Warehouses -->\n                    <div class=\"upload-card\">\n                        <div class=\"card-header secondary\">\n                            <i class=\"ph-fill ph-buildings\"></i>\n                            <h3>2. قوائم المخازن</h3>\n                        </div>\n                        <div class=\"drop-zone\" id=\"zone-warehouse\">\n                            <i class=\"ph ph-upload-simple drop-icon\"></i>\n                            <h4>اضغط لاختيار الملفات</h4>\n                            <p>(يدعم PDF / Excel / JSON)</p>\n                            <button class=\"btn btn-outline\" onclick=\"selectFiles('warehouse')\">تصفح الملفات</button>\n                        </div>\n                        <ul id=\"list-warehouse\" class=\"file-list\"></ul>\n                    </div>\n                </div>\n\n                <div class=\"action-bar-bottom\">\n                    <button id=\"btn-submit\" class=\"btn btn-primary btn-massive\" onclick=\"submitProcess()\" disabled>\n                        <i class=\"ph-fill ph-play-circle\"></i> بدء عملية المطابقة\n                    </button>\n                </div>\n\n                <!-- PROGRESS WIDGET -->\n                <div id=\"progress-modal\" style=\"display: none;\">\n                    <div class=\"progress-box\">\n                        <div style=\"display: flex; align-items: center; gap: 10px; margin-bottom: 10px;\">\n                      