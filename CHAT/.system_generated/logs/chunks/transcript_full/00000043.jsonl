processing') viewProcess(item.id); };\n1626:             \n1627:             card.innerHTML = `\n1628:                 <div class=\"history-info\">\n1629:                     <div class=\"history-header\">\n1630:                         <h4>العملية ${item.id.substring(0,8)}...</h4>\n1631:                         <span class=\"badge-status ${statusClass}\">${statusText}</span>\n1632:                     </div>\n1633:                     <div class=\"history-date\"><i class=\"ph ph-calendar\"></i> ${date}</div>\n1634:                     <div class=\"history-files\">\n1635:                         <span><i class=\"ph-fill ph-files\"></i> ${JSON.parse(item.shortage_files || '[]').length} نواقص</span>\n1636:                         <span><i class=\"ph-fill ph-folders\"></i> ${JSON.parse(item.warehouse_files || '[]').length} مخازن</span>\n1637:                     </div>\n1638:                 </div>\n1639:                 <div class=\"history-actions\">\n1640:                     ${item.status === 'processing' \n1641:                         ? `<button class=\"btn btn-primary\" style=\"opacity:0.7; cursor:not-allowed;\" disabled><i class=\"ph-fill ph-spinner-gap spinner\"></i> جاري التشغيل...</button>`\n1642:                         : (item.status === 'error'\n1643:                             ? `<button class=\"btn btn-warning\" onclick=\"restartProcess('${item.id}')\"><i class=\"ph-fill ph-arrow-counter-clockwise\"></i> إعادة تشغيل</button>\n1644:                                <button class=\"btn btn-danger btn-icon\" onclick=\"event.stopPropagation(); deleteProcess('${item.id}')\"><i class=\"ph ph-trash\"></i></button>`\n1645:                             : `<button class=\"btn btn-primary\" onclick=\"viewProcess('${item.id}')\"><i class=\"ph-fill ph-eye\"></i> عرض النتائج</button>\n1646:                                <button class=\"btn btn-danger btn-icon\" onclick=\"event.stopPropagation(); deleteProcess('${item.id}')\"><i class=\"ph ph-trash\"></i></button>`\n1647:                         )\n1648:                     }\n1649:                 </div>\n1650:             `;\n1651:             listEl.appendChild(card);\n1652:         });\n1653:     } catch (e) {\n1654:         console.error(e);\n1655:         listEl.innerHTML = '<div class=\"empty-state text-danger\"><i class=\"ph-fill ph-warning\"></i><p>خطأ في جلب السجل</p></div>';\n1656:     }\n1657: }\n1658: \n1659: async function restartProcess(processId) {\n1660:     try {\n1661:         const res = await window.pywebview.api.restart_process(processId);\n1662:         if (res.success) {\n1663:             currentProcessId = res.process_id;\n1664:             switchScreen('screen-new');\n1665:             \n1666:             const btn = document.getElementById('btn-submit');\n1667:             const progressModal = document.getElementById('progress-modal');\n1668:             \n1669:             btn.classList.add('hidden');\n1670:             progressModal.style.display = 'flex';\n1671:             document.getElementById('progress-text').innerText = 'جاري تهيئة العملية...';\n1672:             document.getElementById('progress-bar-fill').style.width = '5%';\n1673:             \n1674:             const termEl = document.getElementById('pipeline-log-terminal');\n1675:             if (termEl) termEl.innerHTML = `[System] Restarted process ${processId}...\\n`;\n1676:             \n1677:             showToast('تم بدء العملية من جديد', 'success');\n1678:         } else {\n1679:             showToast(res.error || 'حدث خطأ أثناء إعادة التشغيل', 'error');\n1680:         }\n1681:     } catch (e) {\n1682:         showToast('خطأ في الاتصال بالبرنامج', 'error');\n1683:         console.error(e);\n1684:     }\n1685: }\n1686: \n1687: async function viewProcess(processId) {\n1688:     try {\n1689:         const dataStr = await window.pywebview.api.get_process_details(processId);\n1690:         const data = JSON.parse(dataStr);\n1691:         if (!data || !data.id) throw new Error(\"لم يتم 