 primary\">\n                            <i class=\"ph-fill ph-clipboard-text\"></i>\n                            <h3 data-i18n=\"shortages_title\">1. ملفات النواقص</h3>\n                        </div>\n                        <div class=\"drop-zone\" id=\"zone-shortage\">\n                            <i class=\"ph ph-upload-simple drop-icon\"></i>\n                            <h4 data-i18n=\"shortages_drop_title\">اضغط لاختيار الملفات</h4>\n                            <p data-i18n=\"shortages_drop_sub\">(يدعم PDF / Excel)</p>\n                            <button class=\"btn btn-outline\" onclick=\"selectFiles('shortage')\" data-i18n=\"browse_files\">تصفح الملفات</button>\n                        </div>\n                        <ul id=\"list-shortage\" class=\"file-list\"></ul>\n                    </div>\n\n                    <!-- Warehouses -->\n                    <div class=\"upload-card\">\n                        <div class=\"card-header secondary\">\n                            <i class=\"ph-fill ph-buildings\"></i>\n                            <h3 data-i18n=\"warehouses_title\">2. قوائم المخازن</h3>\n                        </div>\n                        <div class=\"drop-zone\" id=\"zone-warehouse\">\n                            <i class=\"ph ph-upload-simple drop-icon\"></i>\n                            <h4 data-i18n=\"warehouses_drop_title\">اضغط لاختيار الملفات</h4>\n                            <p data-i18n=\"warehouses_drop_sub\">(يدعم PDF / Excel / JSON)</p>\n                            <button class=\"btn btn-outline\" onclick=\"selectFiles('warehouse')\" data-i18n=\"browse_files\">تصفح الملفات</button>\n                        </div>\n                        <ul id=\"list-warehouse\" class=\"file-list\"></ul>\n                    </div>\n                </div>\n\n                <div class=\"action-bar-bottom\">\n                    <button id=\"btn-submit\" class=\"btn btn-primary btn-massive\" onclick=\"submitProcess()\" disabled>\n                        <i class=\"ph-fill ph-play-circle\"></i> <span data-i18n=\"btn_start_matching\">بدء عملية المطابقة</span>\n                    </button>\n                </div>\n\n                <!-- PROGRESS WIDGET -->\n                <div id=\"progress-modal\" style=\"display: none;\">\n                    <div class=\"progress-box\">\n                        <div style=\"display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;\">\n                            <div style=\"display: flex; align-items: center; gap: 10px;\">\n                                <div class=\"spinner\" style=\"width: 22px; height: 22px; border-width: 2px;\"></div>\n                                <h3 id=\"progress-text\" style=\"margin: 0; font-size: 15px; font-weight: bold;\" data-i18n=\"progress_init\">جاري تهيئة العملية...</h3>\n                            </div>\n                            <span id=\"progress-timer\" style=\"font-family: monospace; font-size: 14px; font-weight: 700; color: var(--primary); background: #e0f2fe; padding: 3px 8px; border-radius: 6px;\">⏱️ 00:00</span>\n                        </div>\n                        <div style=\"width: 100%; height: 6px; background: #e2e8f0; border-radius: 3px; margin: 12px 0; overflow: hidden;\">\n                            <div id=\"progress-bar-fill\" style=\"width: 10%; height: 100%; background: var(--primary); transition: width 0.5s ease;\"></div>\n                        </div>\n                        \n                        <p id=\"progress-subtext\" style=\"color: var(--text-muted); font-size: 11px; margin-top: 10px; text-align: center;\" data-i18n=\"progress_sub\">العملية تعمل في الخلفية. يمكنك متابعة السجلات من تبويب \"سجل النظام\".</p>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Screen 2: Results -->\n            <div id=\"screen-results\" class=\"screen\">\n                <header class=\"page-header\">\n                    <h2><i class=\"ph-fill ph-check-circle\"></i> <span data-i18n=\"results_title\">تقرير نتائج المطابقة</span></h2>\n                    <p data-i18n=\"results_desc\">تم الانتهاء من فحص الملفات وإنشاء تقرير الإكسيل بنجاح.</p>\n                </header>\n                \n                <div class=\"stats-grid\">\n                    <div class=\"stat-card\">\n                        <div class=\"stat-icon\"><i class=\"ph-fill ph-list-numbers\"></i></div>\n                        <div class=\"stat-info\">\n                            <span class=\"stat-title\" data-i18n=\"stat_total_title\">إجمالي الأصناف المطلوبة</span>\n                            <strong id=\"stat-total\" class=\"stat-value\">0</strong>\n                        </div>\n                    </div>\n                    <div class=\"stat-card stat-success\">\n                        <div class=\"stat-icon\"><i class=\"ph-fill ph-check-fat\"></i></div>\n                        <div class=\"stat-info\">\n                            <span class=\"stat-title\" data-i18n=\"stat_matched_title\">تمت المطابقة بنجاح</span>\n                            <div class=\"stat-flex\">\n                                <strong id=\"stat-matched\" class=\"stat-value\">0</strong>\n                                <span id=\"stat-matched-pct\" class=\"stat-badge\">0%</span>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"stat-card stat-warning\">\n                        <div class=\"stat-icon\"><i class=\"ph-fill ph-warning\"></i></div>\n                        <div class=\"stat-info\">\n                            <span class=\"stat-title\" data-i18n=\"stat_review_title\">يحتاج مراجعة (غير مؤكد)</span>\n                            <div class=\"stat-flex\">\n                                <strong id=\"stat-review\" class=\"stat-value\">0</strong>\n                                <span id=\"stat-review-pct\" class=\"stat-badge\">0%</span>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"stat-card stat-danger\">\n                        <div class=\"stat-icon\"><i class=\"ph-fill ph-x-circle\"></i></div>\n                        <div class=\"stat-info\">\n                            <span class=\"stat-title\" data-i18n=\"stat_notfound_title\">غير متوفر في المخازن</span>\n                            <div class=\"stat-flex\">\n                                <strong id=\"stat-notfound\" class=\"stat-value\">0</strong>\n                                <span id=\"stat-notfound-pct\" class=\"stat-badge\">0%</span>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"results-workflow\">\n                    <h3 data-i18n=\"workflow_title\">خطوات المراجعة النهائية:</h3>\n                    <div class=\"workflow-steps\">\n                        <div class=\"step-box\">\n                            <div class=\"step-num\">1</div>\n                            <h4 data-i18n=\"step1_title\">افتح ملف الإكسيل</h4>\n                            <p data-i18n=\"step1_desc\">اضغط على الزر لفتح الملف، ثم اذهب لشيت \"يحتاج مراجعة\".</p>\n                            <button class=\"btn btn-outline\" onclick=\"openExcel()\"><i class=\"ph-fill ph-microsoft-excel-logo\"></i> <span data-i18n=\"btn_open_excel\">فتح الإكسيل</span></button>\n                        </div>\n                        <div class=\"step-box\">\n                            <div class=\"step-num\">2</div>\n                            <h4 data-i18n=\"step2_title\">راجع واتخذ القرار</h4>\n                            <p data-i18n=\"step2_desc\">اختر (✅ مطابق) أو (❌ غير مطابق) لكل صنف، ثم احفظ الملف وأغلقه.</p>\n                        </div>\n                        <div class=\"step-box\">\n                            <div class=\"step-num\">3</div>\n                            <h4 data-i18n=\"step3_title\">طبق التعديلات</h4>\n                            <p data-i18n=\"step3_desc\">اضغط هنا لنقل الأصناف لشيتات المخازن وتنظيف القائمة.</p>\n                            <button class=\"btn btn-primary\" onclick=\"applyReviews()\"><i class=\"ph-fill ph-magic-wand\"></i> <span data-i18n=\"btn_apply_reviews\">تنفيذ التعديلات</span></button>\n                        </div>\n                    </div>\n                    <div class=\"folder-action\">\n                        <button class=\"btn btn-text\" onclick=\"openFolder()\"><i class=\"ph-fill ph-folder-open\"></i> <span data-i18n=\"btn_open_folder\">فتح مجلد حفظ النتائج (Folder)</span></button>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Screen 3: History -->\n            <div id=\"screen-history\" class=\"screen\">\n                <header class=\"page-header\">\n                    <h2><i class=\"ph-fill ph-clock-counter-clockwise\"></i> <span data-i18n=\"history_title\">سجل العمليات السابقة</span></h2>\n                    <p data-i18n=\"history_desc\">هنا تجد جميع عمليات المطابقة التي قمت بها سابقاً، يمكنك العودة إليها في أي وقت.</p>\n                </header>\n                \n                <div id=\"history-list\" class=\"history-grid\">\n                    <!-- History items will be injected here -->\n                    <div class=\"empty-state\">\n                        <i class=\"ph-fill ph-empty\"></i>\n                        <p data-i18n=\"history_empty\">لا توجد عمليات سابقة مسجلة.</p>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Screen 4: Settings -->\n            <div id=\"screen-settings\" class=\"screen\">\n                <header class=\"page-header\">\n                    <h2><i class=\"ph-fill ph-gear\"></i> <span data-i18n=\"settings_title\">إعدادات النظام</span></h2>\n                    <p data-i18n=\"settings_desc\">قم بضبط إعدادات الربط مع سيرفر الذكاء الاصطناعي (MSEMAX) و Unstructured API وجودة الاستخراج.</p>\n                </header>\n\n                <div class=\"settings-grid\">\n                    <!-- General API Settings -->\n                    <div class=\"settings-card\">\n                        <div class=\"card-header dark\">\n                            <i class=\"ph-fill ph-key\"></i>\n                            <h3 data-i18n=\"api_keys_header\">مفاتيح الربط وخيارات المعالجة</h3>\n                        </div>\n                        <div class=\"card-body form-grid\">\n                            <div class=\"form-group\">\n                                <label data-i18n=\"lbl_unstructured_profile\">وضع معالجة PDF (Parse Profile)</label>\n                                <select id=\"setting-unstructured-profile\" class=\"form-control\">\n                                    <option value=\"best\">جودة فائقة (Best - دقة عالية جداً للأسماء الطبية)</option>\n                                    <option value=\"balanced\">متوازن (Balanced - أسرع)</option>\n                                </select>\n                                <small style=\"color: var(--text-muted); font-size: 11px;\" data-i18n=\"profile_note\">Best يضمن دقة قراءة الأسماء الطبية العربية المعقدة ويمنع أخطاء الحروف.</small>\n                            </div>\n                            <div class=\"form-group mt-2\">\n                                <label data-i18n=\"lbl_unstructured_key\">Unstructured API Key</label>\n                                <input type=\"password\" id=\"setting-unstructured-key\" class=\"form-control\" placeholder=\"Enter Unstructured.io Key...\">\n                            </div>\n                            <div class=\"form-group mt-2\">\n                                <label data-i18n=\"lbl_local_url\">Local AI URL (MSEMAX / vLLM)</label>\n                                <input type=\"text\" id=\"setting-local-url\" class=\"form-control\" placeholder=\"http://127.0.0.1:8000/v1/chat/completions\">\n                            </div>\n                            <div class=\"form-group\">\n                                <label data-i18n=\"lbl_local_key\">Local AI Key (إن وجد)</label>\n                                <input type=\"password\" id=\"setting-local-key\" class=\"form-control\" placeholder=\"Optional API Key\">\n                            </div>\n                            <div class=\"form-group\">\n                                <label data-i18n=\"lbl_model_name\">اسم الموديل (Model Name)</label>\n                                <input type=\"text\" id=\"setting-model-name\" class=\"form-control\" placeholder=\"gpt-4o-mini, llama3, etc...\">\n                            </div>\n                        </div>\n                    </div>\n\n                    <!-- Server Settings -->\n                    <div class=\"settings-card\">\n                        <div class=\"card-header dark\">\n                            <i class=\"ph-fill ph-hard-drives\"></i>\n                            <h3 data-i18n=\"server_header\">إعدادات سيرفر (MSEMAX)</h3>\n                        </div>\n                        <div class=\"card-body form-grid\">\n                            <div class=\"form-group mb-4\">\n                                <label data-i18n=\"lbl_msemax_dir\">مسار مجلد MSEMAX</label>\n                                <div class=\"input-group\">\n                                    <input type=\"text\" id=\"setting-msemax-dir\" class=\"form-control\" readonly>\n                                    <button class=\"btn btn-outline-secondary\" onclick=\"selectMsemaxDir()\" data-i18n=\"btn_select_dir\">تحديد المجلد</button>\n                                </div>\n                            </div>\n\n                            <div class=\"btn-group-vertical\">\n                                <button class=\"btn btn-outline\" onclick=\"setupRequirements()\">\n                                    <i class=\"ph ph-download-simple\"></i>\n                                    <span data-i18n=\"btn_install_reqs\">تثبيت متطلبات الجهاز الأساسية</span>\n                                    <span id=\"req-status\" style=\"margin-right:auto\"></span>\n                                </button>\n                                <button class=\"btn btn-outline\" onclick=\"getSession()\">\n                                    <i class=\"ph ph-browser\"></i>\n                                    <span data-i18n=\"btn_renew_session\">تجديد الجلسة (Get Session)</span>\n                                    <span id=\"session-status\" style=\"margin-right:auto\"></span>\n                                </button>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"action-bar-bottom mt-3\">\n                    <button class=\"btn btn-primary btn-massive\" onclick=\"saveSettings()\">\n                        <i class=\"ph-fill ph-floppy-disk\"></i> <span data-i18n=\"btn_save_settings\">حفظ الإعدادات</span>\n                    </button>\n                </div>\n                \n                <!-- System Logs Viewer -->\n                <div class=\"settings-card\" style=\"margin-top: 32px; border-color: var(--border);\">\n                    <div class=\"card-header\" style=\"background: var(--text-main); color: white;\">\n                        <i class=\"ph-fill ph-terminal-window\"></i>\n                        <h3 data-i18n=\"system_logs_title\">سجل النظام (System Logs)</h3>\n                    </div>\n                    <div style=\"background: #1e1e1e; padding: 12px;\">\n                        <textarea id=\"system-logs\" readonly style=\"width: 100%; height: 250px; background: #1e1e1e; color: #00ff00; border: none; font-family: monospace; font-size: 13px; outline: none; resize: vertical; direction: ltr; text-align: left;\"></textarea>\n                    </div>\n                </div>\n            </div>\n\n            <!-- سجل النظام (Terminal) -->