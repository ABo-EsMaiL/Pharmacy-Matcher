essage.includes('Matching')) pct = 60;\n1518:             if (data.message.includes('حفظ') || data.message.includes('Saving')) pct = 90;\n1519:             pb.style.width = pct + '%';\n1520:         }\n1521:     }\n1522: });\n1523: \n1524: window.addEventListener('process_complete', (e) => {\n1525:     const data = e.detail;\n1526:     \n1527:     if (data.process_id === currentProcessId) {\n1528:         const btn = document.getElementById('btn-submit');\n1529:         const progressModal = document.getElementById('progress-modal');\n1530:         \n1531:         btn.classList.remove('hidden');\n1532:         progressModal.style.display = 'none';\n1533:         \n1534:         if (data.success) {\n1535:             showToast('تمت المطابقة بنجاح!', 'success');\n1536:             if (data.stats) {\n1537:                 loadResults(data.stats);\n1538:             }\n1539:             window.showScreen('screen-results');\n1540:         } else {\n1541:             showToast('فشلت عملية المطابقة: ' + data.error, 'error');\n1542:         }\n1543:     }\n1544: });\n1545: \n1546: // --- Results Logic ---\n1547: function loadResults(stats) {\n1548:     const total = stats.total || 0;\n1549:     const matched = stats.matched || 0;\n1550:     const notfound = stats.not_found || 0;\n1551:     const review = stats.review || 0;\n1552:     \n1553:     document.getElementById('stat-total').innerText = total;\n1554:     document.getElementById('stat-matched').innerText = matched;\n1555:     document.getElementById('stat-notfound').innerText = notfound;\n1556:     document.getElementById('stat-review').innerText = review;\n1557:     \n1558:     if (total > 0) {\n1559:         document.getElementById('stat-matched-pct').innerText = Math.round((matched/total)*100) + '%';\n1560:         document.getElementById('stat-notfound-pct').innerText = Math.round((notfound/total)*100) + '%';\n1561:         document.getElementById('stat-review-pct').innerText = Math.round((review/total)*100) + '%