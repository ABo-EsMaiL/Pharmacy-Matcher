ير موجودة لإعادة التشغيل\"}\n239:             \n240:             # get process details\n241:             cursor = self._db.conn.cursor()\n242:             cursor.execute('SELECT shortage_files, warehouse_files FROM processes WHERE id = ?', (process_id,))\n243:             row = cursor.fetchone()\n244:             if not row:\n245:                 return {\"success\": False, \"error\": \"العملية غير موجودة\"}\n246:                 \n247:             shortage_filenames = json.loads(row['shortage_files'])\n248:             warehouse_filenames = json.loads(row['warehouse_files'])\n249:             \n250:             shortage_paths = [str(workspace / name) for name in shortage_filenames]\n251:             warehouse_paths = [str(workspace / name) for name in warehouse_filenames]\n252:             \n253:             # Reset status\n254:             self._db.update_process_status(process_id, 'processing')\n255:             \n256:             thread = threading.Thread(target=self._process_worker, args=(process_id, shortage_paths, warehouse_paths, True))\n257:             thread.daemon = True\n258:             thread.start()\n259:             \n260:             return {\"success\": True, \"process_id\": process_id}\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
