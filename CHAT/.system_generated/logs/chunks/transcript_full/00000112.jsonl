{"step_index":5433,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-23T16:30:12Z","content":"Created At: 2026-09-23T19:30:12+03:00\nCompleted At: 2026-09-23T19:30:12+03:00\nFile Path: `file:///C:/Users/kakak/.gemini/antigravity/brain/916274de-7f92-49fc-a0a8-d291664b474a/scratch/test_safe_auto.py`\nTotal Lines: 119\nTotal Bytes: 4618\nShowing lines 1 to 119\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: import sys\n2: sys.path.insert(0, \".\")\n3: import json\n4: import re\n5: from pathlib import Path\n6: from rapidfuzz import fuzz\n7: \n8: from src.extract.excel_reader import read_excel, extract_item_names\n9: from src.extract.file_handler import read_input_files\n10: from src.fast_match.search import (\n11:     FastCandidateFinder,\n12:     extract_brand_tokens,\n13:     extract_form_group,\n14:     normalize_text,\n15:     FORM_GROUPS\n16: )\n17: from src.config import load_config\n18: \n19: # Helper to normalize arabic numbers\n20: def norm_num(s: str) -> str:\n21:     s = str(s)\n22:     for e, w in zip('٠١٢٣٤٥٦٧٨٩', '0123456789'):\n23:         s = s.replace(e, w)\n24:     return s\n25: \n26: def get_strength_pattern(text: str) -> str | None:\n27:     text = norm_num(text.lower())\n28:     m = re.search(r'(\\d+(?:\\.\\d+)?)\\s*(?:مجم|مج|جم|جرام|gm|mg|mcg|مكجم)', text)\n29:     if m:\n30:         return m.group(1)\n31:     if 'ربع' in text or '25.' in text:\n32:         return '0.25'\n33:     if 'نص' in text or 'نصف' in text or '.5' in text or '0.5' in text:\n34:         return '0.5'\n35:     return None\n36: \n37: def has_co(text: str) -> bool:\n38:     t = text.lower()\n39:     return bool(re.search(r'(?:^|[^\\w])(كو|بلس|بلاس|كومب|co|plus|comp)(?:[^\\w]|$)|كواقراص|كوأقراص|بلساقراص|بلسكبسول', t))\n40: \n41: def are_forms_compatible(form1: str | None, form2: str | None) -> bool:\n42:     if not form1 or not form2:\n43:         return True\n44:     if form1 == form2:\n45:         return True\n46:     compat = {\n47:         ('tablet', 'capsule'), ('capsule', 'tablet'),\n48:         ('cream', 'ointment'), ('ointment', 'cream'),\n49:         ('cream', 'gel'), ('gel', 'cream'),\n50:         ('injection', 'ampoule'), ('ampoule', 'injection'),\n51:     }\n52:     return (form1, form2) in compat\n53: \n54: # Brand Family Stopwords that need secondary tokens to match\n55: BRAND_FAMILIES = {'بيتادين', 'هيرو', 'انسولين', 'ليمتلس', 'سيتال', 'لبن'}\n56: \n57: def is_safe_auto_match(req: str, cand: str) -> tuple[bool, str]:\n58:     brand_r = extract_brand_tokens(req)\n59:     brand_c = extract_brand_tokens(cand)\n60:     if not brand_r or not brand_c:\n61:         return False, \"no_brand\"\n62:         \n63:     words_r = brand_r.split()\n64:     words_c = brand_c.split()\n65:     \n66:     # If brand belongs to a wide family, brand must match beyond the first word\n67:     first_r = words_r[0]\n68:     first_c = words_c[0]\n69:     if first_r in BRAND_FAMILIES or first_c in BRAND_FAMILIES:\n70:         # Full brand string must match well\n71:         if fuzz.ratio(brand_r, brand_c) < 85:\n72:             return False, \"brand_family_ambiguity\"\n73:             \n74:     b_sim = fuzz.ratio(brand_r, brand_c)\n75:     if words_r and words_c and (words_r[0] == words_c[0] or fuzz.ratio(words_r[0], words_c[0]) >= 85):\n76:         if len(words_r) == 1 and len(words_c) == 1:\n77:             b_sim = max(b_sim, 90)\n78:             \n79:     if b_sim < 85:\n80:         return False, \"low_brand_sim\"\n81:         \n82:     form_r = extract_form_group(req)\n83:     form_c = extract_form_group(cand)\n84:     if not are_forms_compatible(form_r, form_c):\n85:         return False, \"form_conflict\"\n86:         \n87:     is_req_syrup = bool(re.search(r'\\b(شراب|شرب|معلق)\\b', req))\n88:     is_cand_syrup = bool(re.search(r'\\b(شراب|شرب|معلق)\\b', cand))\n89:     norm_c = norm_num(cand)\n90:     norm_r = norm_num(req)\n91:     has_c_solid_mg = bool(re.search(r'\\b(100|125|200|250|300|400|500|600|800|1000)\\s*(?:مجم|مج|mg)\\b', norm_c)) and not re.search(r'\\b(مل|ملل|ml|/5|5مل)\\b', norm_c)\n92:     has_r_solid_mg = bool(re.search(r'\\b(100|125|200|250|300|400|500|600|800|1000)\\s*(?:مجم|مج|mg)\\b', norm_r)) and not re.search(r'\\b(مل|ملل|ml|/5|5مل)\\b', norm_r)\n93:     if (is_req_syrup and not is_cand_syrup and has_c_solid_mg) or (is_cand_syrup and not is_req_syrup and has_r_solid_mg):\n94:         return False, \"syrup_solid_conflict\"\n95:         \n96:     if has_co(req) != has_co(cand):\n97:         return False, \"co_mismatch\"\n98:         \n99:     str_r = get_strength_pattern(req)\n100:     str_c = get_strength_pattern(cand)\n101:     if str_r and str_c:\n102:         try:\n103:             if float(str_r) != float(str_c):\n104:                 return False, f\"strength_mismatch_{str_r}_vs_{str_c}\"\n105:         except:\n106:             if str_r != str_c:\n107:                 return False, f\"strength_mismatch_{str_r}_vs_{str_c}\"\n108:                 \n109:     slash_r = re.search(r'(?:^|[^\\d/])(\\d+(?:\\.\\d+)?\\/\\d+(?:\\.\\d+)?)(?:[^\\d/]|$)', req)\n110:     slash_c = re.search(r'(?:^|[^\\d/])(\\d+(?:\\.\\d+)?\\/\\d+(?:\\.\\d+)?)(?:[^\\d/]|$)', cand)\n111:     if (slash_r and not slash_c) or (slash_c and not slash_r):\n112:         return False, \"slash_strength_mismatch\"\n113:     if slash_r and slash_c and slash_r.group(1) != slash_c.group(1):\n114:         return False, \"slash_strength_mismatch\"\n115:         \n116:     return True, \"auto_matched\"\n117: \n118: print(\"Safety Auto-Match function defined successfully.\")\n119: \nThe above content shows the entire, complete file contents of the requested file.\n"}
