if currently static\n1562:     updateServerStatusTextOnly();\n1563: }\n1564: \n1565: function toggleLanguage() {\n1566:     setLanguage(currentLang === 'ar' ? 'en' : 'ar');\n1567: }\n1568: \n1569: function updateServerStatusTextOnly() {\n1570:     const text = document.getElementById('server-status-text');\n1571:     const btn = document.getElementById('btn-toggle-server');\n1572:     const t = I18N[currentLang] || I18N.ar;\n1573:     if (isServerRunning) {\n1574:         if (text) text.textContent = t.server_running;\n1575:         if (btn) btn.innerHTML = `<i class=\"ph ph-stop\"></i> ${t.btn_stop_server}`;\n1576:     } else {\n1577:         if (text) text.textContent = t.server_stopped;\n1578:         if (btn) btn.innerHTML = `<i class=\"ph ph-play\"></i> ${t.btn_start_server}`;\n1579:     }\n1580: }\n1581: \n1582: function startProgressTimer() {\n1583:     progressStartTime = Date.now();\n1584:     const timerEl = document.getElementById('progress-timer');\n1585:     if (timerEl) timerEl.textContent = '⏱️ 00:00';\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
