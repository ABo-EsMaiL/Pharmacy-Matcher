    max_length = max(max_length, cell_len)\n67:         # حد أدنى 12، حد أقصى 60\n68:         adjusted_width = min(max(max_length + 4, 12), 60)\n69:         ws.column_dimensions[col_letter].width = adjusted_width\n70: \n71: \n72: def _add_data_rows(ws, rows: list[list], start_row: int = 2) -> None:\n73:     \"\"\"إضافة صفوف البيانات مع التنسيق.\"\"\"\n74:     for row_idx, row_data in enumerate(rows, start=start_row):\n75:         for col_idx, value in enumerate(row_data, start=1):\n76:             cell = ws.cell(row=row_idx, column=col_idx, value=value)\n77:             cell.font = _CELL_FONT\n78:             cell.alignment = _CELL_ALIGNMENT\n79:             cell.border = _THIN_BORDER\n80: \n81: \n82: def _truncate_sheet_name(name: str, max_len: int = 31) -> str:\n83:     \"\"\"\n84:     اقتطاع اسم الورقة ليتوافق مع حد Excel (31 حرفاً).\n85:     يزيل أيضاً الأحرف غير المسموح بها في أسماء الأوراق.\n86:     \"\"\"\n87:     # إزالة الأحرف غير المسموح بها في أسماء أوراق Excel\n88:     invalid_chars = r\"[]:*?/\\\\\"\n89:     for ch in invalid_chars:\n90:         name = name.replace(ch, \"_\")\n91:     return name[:max_len]\n92: \n93: \n94: def _format_confidence(conf_raw: str) -> str:\n95:     \"\"\"تحويل قيم درجة التطابق الإنجليزية والتقنية إلى مصطلحات عربية واضحة.\"\"\"\n96:     if not conf_raw:\n97:         return \"\"\n98:     conf_str = str(conf_raw).strip()\n99:     conf_lower = conf_str.lower()\n100:     if conf_lower == \"exact\":\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
