{"step_index":2204,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-22T11:08:15Z","content":"Created At: 2026-09-22T14:08:15+03:00\nCompleted At: 2026-09-22T14:08:15+03:00\nFile Path: `file:///d:/AI_Engineer/Pharmacy-agy/desktop_app/backend.py`\nTotal Lines: 544\nTotal Bytes: 23458\nShowing lines 220 to 380\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n220:             \n221:             shortage_filenames = [Path(p).name for p in shortage_paths]\n222:             warehouse_filenames = [Path(p).name for p in warehouse_paths]\n223:             \n224:             process_id = self.db.create_process(shortage_filenames, warehouse_filenames)\n225:             \n226:             thread = threading.Thread(target=self._process_worker, args=(process_id, shortage_paths, warehouse_paths))\n227:             thread.start()\n228:             \n229:             return {\"success\": True, \"process_id\": process_id}\n230:             \n231:         except Exception as e:\n232:             return {\"success\": False, \"error\": str(e)}\n233: \n234:     def restart_process(self, process_id: str) -> dict:\n235:         try:\n236:             workspace = PROJECT_ROOT / 'data' / 'inputs' / process_id\n237:             if not workspace.exists():\n238:                 return {\"success\": False, \"error\": \"ملفات العملية غير موجودة لإعادة التشغيل\"}\n239:             \n240:             # get process details\n241:             cursor = self.db.conn.cursor()\n242:             cursor.execute('SELECT shortage_files, warehouse_files FROM processes WHERE id = ?', (process_id,))\n243:             row = cursor.fetchone()\n244:             if not row:\n245:                 return {\"success\": False, \"error\": \"العملية غير موجودة\"}\n246:                 \n247:             shortage_filenames = json.loads(row['shortage_files'])\n248:             warehouse_filenames = json.loads(row['warehouse_files'])\n249:             \n250:             shortage_paths = [str(workspace / name) for name in shortage_filenames]\n251:             warehouse_paths = [str(workspace / name) for name in warehouse_filenames]\n252:             \n253:             # Reset status\n254:             self.db.update_process_status(process_id, 'processing')\n255:             \n256:             thread = threading.Thread(target=self._process_worker, args=(process_id, shortage_paths, warehouse_paths, True))\n257:             thread.daemon = True\n258:             thread.start()\n259:             \n260:             return {\"success\": True, \"process_id\": process_id}\n261:         except Exception as e:\n262:             return {\"success\": False, \"error\": str(e)}\n263: \n264:     def _process_worker(self, process_id: str, shortage_paths: list, warehouse_paths: list, is_restart: bool = False):\n265:         try:\n266:             self.add_log(f\"--- Starting new process [{process_id}] ---\")\n267:             proc_dir = self.db.get_process_dir(process_id)\n268:             \n269:             # Create subdirs\n270:             shortages_dir = proc_dir / 'input_shortages'\n271:             shortages_dir.mkdir(parents=True, exist_ok=True)\n272:             warehouses_dir = proc_dir / 'input_warehouses'\n273:             warehouses_dir.mkdir(parents=True, exist_ok=True)\n274:             \n275:             # Copy files to workspace if not restarting\n276:             copied_shortages = []\n277:             for p in shortage_paths:\n278:                 dest = shortages_dir / Path(p).name\n279:                 if not is_restart or not dest.exists():\n280:                     try:\n281:                         shutil.copy2(p, dest)\n282:                     except shutil.SameFileError:\n283:                         pass\n284:                 copied_shortages.append(dest)\n285:                 \n286:             copied_warehouses = []\n287:             for p in warehouse_paths:\n288:                 dest = warehouses_dir / Path(p).name\n289:                 if not is_restart or not dest.exists():\n290:                     try:\n291:                         shutil.copy2(p, dest)\n292:                     except shutil.SameFileError:\n293:                         pass\n294:                 copied_warehouses.append(dest)\n295:                 \n296:             if self.window:\n297:                 self.window.evaluate_js(f\"window.dispatchEvent(new CustomEvent('process_update', {{detail: {{process_id: '{process_id}', status: 'processing', message: 'Reading files...'}}}}));\")\n298:                 \n299:             # Import actual project modules\n300:             from src.config import load_config\n301:             from src.extract.file_handler import read_input_files\n302:             from src.fast_match.coordinator import FastCoordinator\n303:             from src.output.excel_writer import write_results_excel\n304:             \n305:             # Load and update config with current settings\n306:             settings = self.get_settings()\n307:             config = load_config()\n308:             config.unstructured_api_key = settings.get('unstructured_api_key', '') or config.unstructured_api_key\n309:             config.local_api_url = settings.get('local_api_url', '') or config.local_api_url\n310:             config.local_api_key = settings.get('local_api_key', '') or config.local_api_key\n311:             config.local_model = settings.get('local_model', '') or config.local_model\n312:             \n313:             self.add_log(\"[PROCESS] Config loaded.\")\n314:             if self.window:\n315:                 self.window.evaluate_js(f\"window.dispatchEvent(new CustomEvent('process_update', {{detail: {{process_id: '{process_id}', status: 'processing', message: 'Extracting data from files...'}}}}));\")\n316:             \n317:             # Read input files (this handles PDF→Unstructured API automatically)\n318:             api_key = settings.get('unstructured_api_key', '') or config.unstructured_api_key\n319:             gemini_key = settings.get('gemini_api_key', '') or config.gemini_api_key\n320:             profile = settings.get('unstructured_profile', 'balanced')\n321:             \n322:             self.add_log(f\"[PROCESS] Reading Shortages files (Profile: {profile.upper()})...\")\n323:             shortage_data = read_input_files(copied_shortages, role=\"shortages\", api_key=api_key, gemini_api_key=gemini_key, profile=profile)\n324:             self.add_log(f\"[PROCESS] Read {len(shortage_data)} shortage files.\")\n325:             \n326:             self.add_log(f\"[PROCESS] Reading Warehouse files (Profile: {profile.upper()})...\")\n327:             warehouse_data = read_input_files(copied_warehouses, role=\"warehouse\", api_key=api_key, gemini_api_key=gemini_key, profile=profile)\n328:             self.add_log(f\"[PROCESS] Read {len(warehouse_data)} warehouse files.\")\n329:             \n330:             # Flatten shortages\n331:             all_shortages = []\n332:             for file_items in shortage_data.values():\n333:                 all_shortages.extend(file_items)\n334:             \n335:             self.add_log(f\"[PROCESS] Extracted total {len(all_shortages)} shortage items. Starting coordinator...\")\n336:             \n337:             if self.window:\n338:                 self.window.evaluate_js(f\"window.dispatchEvent(new CustomEvent('process_update', {{detail: {{process_id: '{process_id}', status: 'processing', message: 'Matching {len(all_shortages)} items...'}}}}));\")\n339:             \n340:             # Run matching\n341:             coordinator = FastCoordinator(config)\n342:             results = coordinator.process(all_shortages, warehouse_data)\n343:             \n344:             self.add_log(f\"[PROCESS] Matching completed.\")\n345:             if self.wi