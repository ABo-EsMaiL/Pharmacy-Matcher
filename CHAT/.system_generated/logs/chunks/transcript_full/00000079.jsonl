{"step_index":3764,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-22T21:04:02Z","thinking":"The similarity score of 53.3% between 'سيرازيت' and 'ديوراسيف' stems from a 53% match calculated using either `token_set_ratio` or `fuzz.ratio` algorithms. Similarly, the match between 'سيفيكسيم' and 'زوفيراكس' is at 50%. The next step is to examine how `fuzz.ratio` compares to `fuzz.token`.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"ArtifactMetadata":{"RequestFeedback":false,"Summary":"Test stricter brand ratio and threshold","UserFacing":false},"CodeContent":"import sys\nfrom pathlib import Path\nsys.path.insert(0, str(Path(r'd:\\AI_Engineer\\Pharmacy-agy')))\n\nfrom scratch.test_enhanced_search import (\n    shortage_names, wh_input, finder, true_matches,\n    extract_brand_tokens, extract_form_group\n)\nfrom rapidfuzz import fuzz\n\nprint(\"Testing different brand thresholds using fuzz.ratio:\")\n\nfor brand_thresh in [50, 55, 60, 65, 70]:\n    candidates = {}\n    missed = []\n    \n    for req in shortage_names:\n        raw_cands = finder.search(req, top_k=8)\n        req_brand = extract_brand_tokens(req)\n        req_form = extract_form_group(req)\n        \n        valid = []\n        for c in raw_cands:\n            cand_name = c[\"name\"]\n            cand_brand = extract_brand_tokens(cand_name)\n            cand_form = extract_form_group(cand_name)\n            \n            # Form check\n            if req_form and cand_form and req_form != cand_form:\n                continue\n                \n            # If multi-word brand, check token_sort_ratio; if single word, check ratio\n            words_req = req_brand.split()\n            words_cand = cand_brand.split()\n            \n            if len(words_req) > 1 or len(words_cand) > 1:\n                # e.g. \"نيتروماك ريتارد\" or \"برايم روز بلاس\"\n                sim = fuzz.token_sort_ratio(req_brand, cand_brand)\n            else:\n                sim = fuzz.ratio(req_brand, cand_brand)\n                \n            # Check if one is prefix of other (e.g. \"ماريفان\" vs \"ماريفان 3\")\n            if req_brand and cand_brand:\n                if req_brand.startswith(cand_brand) or cand_brand.startswith(req_brand):\n                    sim = max(sim, 80)\n            \n            # Acceptance condition:\n            if sim >= brand_thresh or c[\"score\"] >= 0.50:\n                valid.append((cand_name, sim, c[\"score\"]))\n                \n        if valid:\n            candidates[req] = valid\n            \n        if req in true_matches:\n            expected = true_matches[req]\n            if not any(v[0] == expected for v in valid):\n                missed.append((req, expected, [v[0] for v in valid]))\n                \n    print(f\"Threshold {brand_thresh}%: Shortages sent to LLM = {len(candidates):3d} | Missed true matches = {len(missed)}\")\n    if missed:\n        for m in missed:\n            print(f\"   Missed at {brand_thresh}%: {m[0]} -> {m[1]}\")\n","Description":"Test stricter brand ratio and threshold","Overwrite":true,"TargetFile":"C:\\Users\\kakak\\.gemini\\antigravity\\brain\\916274de-7f92-49fc-a0a8-d291664b474a\\scratch\\test_strict_brand.py","toolAction":"Writing script","toolSummary":"Write test strict brand script"}}]}
