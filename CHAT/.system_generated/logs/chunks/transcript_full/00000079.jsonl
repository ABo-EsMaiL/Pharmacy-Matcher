{"step_index":3785,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-22T21:05:38Z","content":"Created At: 2026-09-23T00:05:38+03:00\nCompleted At: 2026-09-23T00:05:38+03:00\nFile Path: `file:///d:/AI_Engineer/Pharmacy-agy/src/fast_match/search.py`\nTotal Lines: 67\nTotal Bytes: 2465\nShowing lines 1 to 67\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: import numpy as np\n2: from sklearn.feature_extraction.text import TfidfVectorizer\n3: from sklearn.metrics.pairwise import cosine_similarity\n4: import re\n5: \n6: def normalize_for_search(text: str) -> str:\n7:     \"\"\"Enhanced normalization for Arabic pharmaceutical search.\"\"\"\n8:     if not text:\n9:         return \"\"\n10:     text = str(text).lower()\n11:     text = re.sub(r'[\\u064B-\\u065F\\u0670\\u0640]', '', text)  # Remove Arabic diacritics and tatweel\n12:     text = re.sub(r'[أإآ]', 'ا', text)\n13:     text = re.sub(r'ة', 'ه', text)\n14:     text = re.sub(r'ى', 'ي', text)\n15:     # Eastern Arabic to Western digits\n16:     for e, w in zip('٠١٢٣٤٥٦٧٨٩', '0123456789'):\n17:         text = text.replace(e, w)\n18:     text = re.sub(r'[^\\w\\s]', ' ', text)  # Replace punctuation with spaces\n19:     text = re.sub(r'\\s+', ' ', text).strip()\n20:     return text\n21: \n22: class FastCandidateFinder:\n23:     def __init__(self):\n24:         # Use Character N-Grams (2 to 4 chars) to catch slight misspellings automatically\n25:         self.vectorizer = TfidfVectorizer(analyzer='char_wb', ngram_range=(2, 4))\n26:         self.corpus = []\n27:         self.original_names = []\n28:         self.ids = []\n29:         self.matrix = None\n30: \n31:     def fit(self, warehouse_items: list[dict]):\n32:         \"\"\"\n33:         warehouse_items: list of dicts with 'id' and 'name'\n34:         \"\"\"\n35:         self.ids = [item[\"id\"] for item in warehouse_items]\n36:         self.original_names = [item[\"name\"] for item in warehouse_items]\n37:         self.corpus = [normalize_for_search(name) for name in self.original_names]\n38:         \n39:         if self.corpus:\n40:             self.matrix = self.vectorizer.fit_transform(self.corpus)\n41: \n42:     def search(self, query: str, top_k: int = 5) -> list[dict]:\n43:         \"\"\"Returns the top_k most similar items from the warehouse.\"\"\"\n44:         if not self.corpus:\n45:             return []\n46:             \n47:         q_norm = normalize_for_search(query)\n48:         if not q_norm:\n49:             return []\n50:             \n51:         q_vec = self.vectorizer.transform([q_norm])\n52:         sims = cosine_similarity(q_vec, self.matrix).flatten()\n53:         \n54:         # Get top K indices\n55:         top_indices = np.argsort(sims)[-top_k:][::-1]\n56:         \n57:         results = []\n58:         for idx in top_indices:\n59:             score = float(sims[idx])\n60:             if score > 0.1:  # Ignore completely unrelated items\n61:                 results.append({\n62:                     \"id\": self.ids[idx],\n63:                     \"name\": self.original_names[idx],\n64:                     \"score\": score\n65:                 })\n66:         return results\n67: \nThe above content shows the entire, complete file contents of the requested file.\n"}
