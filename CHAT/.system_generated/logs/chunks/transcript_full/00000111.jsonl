nment = _HEADER_ALIGNMENT\n39:         cell.border = _THIN_BORDER\n40: \n41: \n42: def _format_sheet(ws, num_cols: int) -> None:\n43:     \"\"\"تنسيق الورقة: تجميد الصف الأول، فلتر تلقائي، RTL، عرض الأعمدة.\"\"\"\n44:     # تجميد الصف الأول\n45:     ws.freeze_panes = \"A2\"\n46: \n47:     # فلتر تلقائي\n48:     if ws.max_row > 0 and num_cols > 0:\n49:         last_col_letter = get_column_letter(num_cols)\n50:         ws.auto_filter.ref = f\"A1:{last_col_letter}{ws.max_row}\"\n51: \n52:     # اتجاه الورقة من اليمين لليسار\n53:     ws.sheet_view.rightToLeft = True\n54: \n55:     # عرض الأعمدة التلقائي (تقدير بسيط)\n56:     for col_idx in range(1, num_cols + 1):\n57:         max_length = 0\n58:         col_letter = get_column_letter(col_idx)\n59:         for row in ws.iter_rows(\n60:             min_col=col_idx, max_col=col_idx, min_row=1, max_row=ws.max_row\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
