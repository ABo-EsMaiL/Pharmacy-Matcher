m.content or \"\"\n706:         if isinstance(content, list):\n707:             content = \" \".join([p.get(\"text\", \"\") for p in content if isinstance(p, dict) and \"text\" in p])\n708:         content = str(content).strip()\n709: \n710:         if m.role == \"system\":\n711:             system_lines.append(content)\n712:         elif m.role == \"user\":\n713:             dialogue_lines.append(f\"User: {content}\")\n714:         elif m.role == \"assistant\":\n715:             dialogue_lines.append(f\"Assistant: {content}\")\n716: \n717:     if len(dialogue_lines) == 1 and not system_lines:\n718:         return dialogue_lines[0].replace(\"User: \", \"\", 1)\n719: \n720:     parts = []\n721:     if system_lines:\n722:         parts.append(\"[System Instructions]\\n\" + \"\\n\".join(system_lines))\n723:     if dialogue_lines:\n724:         parts.append(\"\\n\".join(dialogue_lines))\n725: \n726:     return \"\\n\\n\".join(parts)\n727: \n728: # ------------------------------------------------------------------------------\n729: # Endpoints\n730: # ------------------------------------------------------------------------------\n731: @app.post(\"/v1/chat/completions\", dependencies=[Depends(verify_api_key)])\n732: @limiter.limit(RATE_LIMIT)\n733: async def chat_completions(request: Request, chat_request: ChatRequest):\n734:     \"\"\"OpenAI-compatible chat completions endpoint driven by Google AI Studio Web.\"\"\"\n735:     sem = _get_semaphore()\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
