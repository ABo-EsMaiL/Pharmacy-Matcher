    document.getElementById('stat-notfound-pct').innerText = '0%';\n2129:         document.getElementById('stat-review-pct').innerText = '0%';\n2130:     }\n2131: }\n2132: \n2133: async function openExcel() {\n2134:     if (!currentProcessId) return;\n2135:     try {\n2136:         await window.pywebview.api.open_excel(currentProcessId);\n2137:     } catch (error) {\n2138:         showToast('تعذر فتح الملف: ' + error, 'error');\n2139:     }\n2140: }\n2141: \n2142: async function openFolder() {\n2143:     if (!currentProcessId) return;\n2144:     try {\n2145:         await window.pywebview.api.open_folder(currentProcessId);\n2146:     } catch (error) {\n2147:         showToast('تعذر فتح المجلد: ' + error, 'error');\n2148:     }\n2149: }\n2150: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
