   body = await response.text()\n117:                             logger.error(f\"[Google Backend Error {response.status}] URL: {url[:80]} | Response Body: {body[:600]}\")\n118:                         except Exception:\n119:                             logger.error(f\"[Google Backend Error {response.status}] URL: {url[:80]}\")\n120:                     elif \"generatecontent\" in url.lower() or \"runprompt\" in url.lower():\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
