ng.basicConfig(\n42:     level=logging.INFO,\n43:     format=\"%(asctime)s - %(name)s - %(levelname)s - %(message)s\"\n44: )\n45: logger = logging.getLogger(\"msemax.webhook\")\n46: \n47: # ------------------------------------------------------------------------------\n48: # Configuration\n49: # ------------------------------------------------------------------------------\n50: API_KEY = os.getenv(\"MSE_MAX_KEY\", \"\").strip()\n51: CHROME_PROFILE_DIR = os.getenv(\"CHROME_PROFILE_DIR\", \"./chrome_profile\")\n52: BASE_DIR = os.path.dirname(os.path.abspath(__file__))\n53: if not os.path.isabs(CHROME_PROFILE_DIR):\n54:     CHROME_PROFILE_DIR = os.path.normpath(os.path.join(BASE_DIR, CHROME_PROFILE_DIR))\n55: HEADLESS = os.getenv(\"HEADLESS\", \"true\").lower() in (\"true\", \"1\", \"yes\")\n56: DEFAULT_MODEL = os.getenv(\"DEFAULT_MODEL\", \"gemini-3.8-flash\").strip()\n57: THINKING_MODE = os.getenv(\"THINKING_MODE\", \"high\").strip().lower()\n58: ENABLE_SEARCH_GROUNDING = os.getenv(\"ENABLE_SEARCH_GROUNDING\", \"true\").lower() in (\"true\", \"1\", \"yes\")\n59: CLEAR_CHAT_ON_REQUEST = os.getenv(\"CLEAR_CHAT_ON_REQUEST\", \"false\").lower() in (\"true\", \"1\", \"yes\")\n60: REQUEST_TIMEOUT = float(os.getenv(\"MSE_REQUEST_TIMEOUT\", \"180\"))\n61: RATE_LIMIT = os.getenv(\"MSE_RATE_LIMIT\", \"30/minute\").strip()\n62: MAX_CONCURRENT = int(os.getenv(\"MSE_MAX_CONCURRENT\", \"1\"))\n63: PORT = int(os.getenv(\"PORT\", \"8001\"))\n64: TARGET_URL = \"https://aistudio.google.com/prompts/new_chat\"\n65: \n66: # ------------------------------------------------------------------------------\n67: # Browser Automation Manager (Playwright Persistent Context)\n68: # ------------------------------------------------------------------------------\n69: class WebHookBrowserManager:\n70:     def __init__(self):\n71:         self.playwright = None\n72:         self.context: Optional[BrowserContext] = None\n73:         self.page: Optional[Page] = None\n74:         self.lock = asyncio.Lock