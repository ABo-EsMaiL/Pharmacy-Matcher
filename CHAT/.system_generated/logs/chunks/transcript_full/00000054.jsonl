كوستاتين نقط س ج\", \"ميكوستاتين نقط فم/سكويب\"),\n    (444, \"امريزول 500مجم اقراص\", \"امريزول ٥٠٠ اقراص/العامرية\"),\n    (470, \"امريزول شراب\", \"امريزول شراب/العامرية\"),\n    (682, \"بيتافوس حقن\", \"بيتافوس حقن/ايبيكو\"),\n    (750, \"ميجاموكس 1جم اقراص\", \"ميجاموكس ١ جم اقراص/الحكمة\"),\n    (807, \"كافسيد باراسيتامول كبار لبوس س ج\", \"كافسيد باراسيتامول كبار لبوس\"),\n    (237, \"كاربامازيبين 200مجم 30قرص س ج\", \"كاربامازيبين ٢٠٠ اقراص\")\n]\n\nfor r, sh_name, wh_name in verified_salam:\n    orig = shortages_by_row[r]\n    audit_entries.append({\n        \"client\": orig[\"client\"],\n        \"name\": orig[\"name\"],\n        \"date\": orig[\"date\"],\n        \"qty\": orig[\"qty\"],\n        \"source_0913_row\": r,\n        \"target_warehouse\": \"السلام شبين\",\n        \"expected_wh_match\": wh_name,\n        \"type\": \"مطابقة مع مخزن السلام (مأخوذ حرفياً من 0913)\"\n    })\n\n# 115 items generated from Salam catalog to complete 150\nsalam_used_wh = {wh for _, _, wh in verified_salam}\nsalam_remaining_wh = [it['item_name_raw'] for it in salam_items if it['item_name_raw'] not in salam_used_wh]\n\nneeded_salam_gen = 150 - len(verified_salam)\nfor wh_name in salam_remaining_wh[:needed_salam_gen]:\n    clean_name = wh_name\n    for sep in ['/', ' شركة ', ' سعر ']:\n        if sep in clean_name:\n            clean_name = clean_name.split(sep)[0].strip()\n    audit_entries.append({\n        \"client\": \"ص ايه شكر/الحدين 3\",\n        \"name\": clean_name + \" س ج\",\n        \"date\": datetime(2026, 9, 13, 0, 0),\n        \"qty\": 3,\n        \"source_0913_row\": \"غير موجود بـ 0913 (صيغ من صنف المخزن)\",\n        \"target_warehouse\": \"السلام شبين\",\n        \"expected_wh_match\": wh_name,\n        \"type\": \"مطابقة مع مخزن السلام (صيغ من صنف المخزن)\"\n    })\n\n# --- PART 3: 35 Unmatched items directly from 0913.xlsx ---\ncandidate_unmatched_rows = [\n    8, 9, 11, 12, 13, 15, 17, 18, 19, 21,\n    22, 23, 25, 26, 28, 30, 31, 32, 33, 34,\n    35, 36, 37, 39, 40, 42, 43, 44, 45, 46,\n    48, 50, 52, 53, 55\n]\n\nfor r in candidate_unmatched_rows:\n    orig = shortages_by_row[r]\n    audit_entries.append({\n        \"client\": orig[\"client\"],\n        \"name\": orig[\"name\"],\n        \"date\": orig[\"date\"],\n        \"qty\": orig[\"qty\"],\n        \"source_0913_row\": r,\n        \"target_warehouse\": \"-\",\n        \"expected_wh_match\": \"غير متوفر في المخازن (صنف غير موجود)\",\n        \"type\": \"صنف ناقص غير متوفر بالمخازن (مأخوذ حرفياً من 0913)\"\n    })\n\nprint(f\"Total audit entries created: {len(audit_entries)}\")\n\n# 4. Write Excel file: data/test_shortages_200.xlsx\nwb_new = openpyxl.Workbook()\nws_new = wb_new.active\nws_new.title = \"ورقة2\"\n\n# Match 0913 header format at row 6\nheaders = ['أسم العميل', 'أسم الصنف', 'التاريخ', 'الكمية']\n\n# Fill empty rows 1-5 like 0913\nfor r in range(1, 6):\n    for c in range(1, 5):\n        ws_new.cell(r, c, value=None)\n\n# Header at row 6\nfor col_idx, h in enumerate(headers, 1):\n    cell = ws_new.cell(6, col_idx, value=h)\n    cell.font = Font(bold=True, size=12)\n    cell.fill = PatternFill(start_color=\"D9E1F2\", end_color=\"D9E1F2\", fill_type=\"solid\")\n    cell.alignment = Alignment(horizontal=\"center\", vertical=\"center\")\n\n# Data rows starting at row 7\nfor idx, entry in enumerate(audit_entries, 7):\n    ws_new.cell(idx, 1, value=entry[\"client\"])\n    ws_new.cell(idx, 2, value=entry[\"name\"])\n    ws_new.cell(idx, 3, value=entry[\"date\"])\n    ws_new.cell(idx, 4, value=entry[\"qty\"])\n\noutput_path = 'd:/AI_Engineer/Pharmacy-agy/data/test_shortages_200.xlsx'\nwb_new.save(output_path)\nprint(f\"Successfully saved 200 items to: {output_path}\")\n\n# 5. Save audit metadata JSON for reporting\nwith open('d:/AI_Engineer/Pharmacy-agy/data/test_shortages_200_audit.json', 'w', encoding='utf-8') as f:\n    json.dump(audit_entries, f, ensure_ascii=False, indent=2, default=str)\nprint(\"Saved audit metadata to: data/test_shortages_200_audit.json\")\n","Description":"Generate 200-item benchmark Excel file and audit metadata","Overwrite":true,"TargetFile":"d:\\AI_Engineer\\Pharmacy-agy\\generate_test_file.py","toolAction":"Writing test file generator","toolSummary":"Write generate_test_file.py"}}]}
