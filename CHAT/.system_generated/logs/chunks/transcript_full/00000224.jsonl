onfig = config\n43:         self.openrouter_api_key = getattr(config, 'openrouter_api_key', None)\n44: \n45:     def process(\n46:         self,\n47:         shortage_items: list[dict],\n48:         warehouse_data: dict[str, list[dict]],\n49:     ) -> dict:\n50:         \n51:         unique_shortages = {}\n52:         for item in shortage_items:\n53:             name = item.get(\"item_name_raw\", \"\")\n54:             if name and name not in unique_shortages:\n55:                 unique_shortages[name] = item\n56:                 \n57:         deduped_shortages = list(unique_shortages.values())\n58: \n59:         print(f\"\\n{'='*60}\")\n60:         print(f\"[*] Starting Match: {len(shortage_items)} raw -> {len(deduped_shortages)} UNIQUE shortages x {len(warehouse_data)} warehouses\")\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
