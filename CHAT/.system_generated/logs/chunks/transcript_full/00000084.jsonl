ortage_item\": shortage_name,\n178:                         \"warehouse_item\": best_name,\n179:                         \"confidence\": f\"high ({best_score:.2f})\",\n180:                         \"method\": \"fast_tfidf\"\n181:                     })\n182:                     tfidf_match_count += 1\n183:                 \n184:                 # Rule 2: Plausible candidate -> Ask LLM to evaluate with clinical rules\n185:                 else:\n186:                     candidates_for_llm = [{\"id\": c[\"id\"], \"name\": c[\"name\"]} for c in top_candidates[:3]]\n187:                     llm_cases.append({\n188:                         \"case_id\": f\"Q{idx:05}\",\n189:                         \"requested_name\": shortage_name,\n190:                         \"candidates\": candidates_for_llm\n191:                     })\n192: \n193:         print(f\"  -> Exact Matches: {exact_count}\")\n194:         print(f\"  -> TF-IDF Auto-Matches (>88%): {tfidf_match_count}\")\n195:         \n196:         # 3. Process via LLM in large optimal chunks (75 items per message)\n197:         if llm_cases and hasattr(self.config, 'local_api_url'):\n198:             batch_size = 75\n199:             batches = [llm_cases[i:i + batch_size] for i in range(0, len(llm_cases), batch_size)]\n200:             print(f\"  -> Sending {len(llm_cases)} ambiguous items to Local API (MSEMAX) in {len(batches)} large batch(es) (Max ~75 items/msg)...\")\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
