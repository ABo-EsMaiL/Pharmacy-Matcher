{"step_index":4010,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-22T22:13:37Z","content":"Created At: 2026-09-23T01:13:37+03:00\nCompleted At: 2026-09-23T01:13:37+03:00\nFile Path: `file:///d:/AI_Engineer/Pharmacy-agy/src/extract/pdf_reader.py`\nTotal Lines: 352\nTotal Bytes: 16213\nShowing lines 50 to 100\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n50:     # 1. Local Cache Check\n51:     file_hash = _get_file_hash(filepath)\n52:     cache_dir = filepath.parent.parent.parent / 'data' / '.unstructured_cache'\n53:     cache_dir.mkdir(parents=True, exist_ok=True)\n54:     cache_file = cache_dir / f\"{file_hash}_extract.json\"\n55:     \n56:     if cache_file.exists():\n57:         try:\n58:             with open(cache_file, \"r\", encoding=\"utf-8\") as f:\n59:                 result_data = json.load(f)\n60:             cached_items = parse_structured_result(result_data, filepath.name)\n61:             if len(cached_items) > 0:\n62:                 print(f\"[+] Loaded {len(cached_items)} items from local cache: {filepath.name}\")\n63:                 return cached_items\n64:             else:\n65:                 print(f\"[*] Local cache has 0 items for {filepath.name}. Checking server...\")\n66:         except Exception:\n67:             print(f\"[*] Local cache invalid for {filepath.name}. Checking server...\")\n68: \n69:     try:\n70:         from unstructured_transform_client import TransformClient\n71:     except ImportError:\n72:         print(\"⚠️ unstructured-transform-client not found. Please install it:\")\n73:         print(\"pip install unstructured-transform-client\")\n74:         raise RuntimeError(\"unstructured-transform-client is required to process PDFs\")\n75: \n76:     client = TransformClient(\n77:         api_key=api_key,\n78:         server_url=base_url,\n79:     )\n80: \n81:     schema = {\n82:         \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n83:         \"title\": \"Supplier Product Names\",\n84:         \"description\": \"Extract product entries from all pages as source data only. Return one entry per source product row, preserving duplicates and different strengths. Include products even when price or quantity is blank or zero. Copy names faithfully without spelling repair or inferred digits. Do not infer stock, requested quantities or shortage matches.\",\n85:         \"type\": \"object\",\n86:         \"properties\": {\n87:             \"items\": {\n88:                 \"type\": \"array\",\n89:                 \"description\": \"Every product entry from every page, in document order. Keep repeated entries. Exclude document headers, footers, contact details, column labels and totals.\",\n90:                 \"items\": {\n91:                     \"type\": \"object\",\n92:                     \"properties\": {\n93:                         \"item_name_raw\": {\n94:                             \"type\": \"string\",\n95:                             \"description\": \"Copy the complete product name/description exactly as present in the source, preserving Arabic, English, mixed text, spelling, strengths, units, dosage form, pack numbers, punctuation and manufacturer text. Do not correct, translate or complete it. Exclude values belonging to separate price, discount or quantity columns, but retain numbers written inside the name itself.\",\n96:                         },\n97:                         \"source_page\": {\n98:                             \"type\": [\n99:                                 \"integer\",\n100:                                 \"null\",\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
{"step_index":4011,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-22T22:13:38Z","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"import sys\nsys.path.insert(0, '.')\nimport openpyxl\nimport json\nimport re\nfrom pathlib import Path\nfrom rapidfuzz import fuzz\nfrom src.extract.excel_reader import read_excel, extract_item_names\nfrom src.extract.pdf_reader import parse_structured_result\nfrom src.fast_match.search import extract_brand_tokens, extract_form_group\n\nresults_path = Path(\"data/processes/PROC-001/results_PROC-001.xlsx\")\nwb = openpyxl.load_workbook(results_path, data_only=True)\n\n# 1. Collect all matched and review items\nmatched_reqs = set()\nreview_reqs = set()\n\nfor sheetname in wb.sheetnames:\n    ws = wb[sheetname]\n    if \"ملخص\" in sheetname:\n        continue\n    if \"يحتاج مراجعة\" in sheetname:\n        for row in list(ws.iter_rows(values_only=True))[1:]:\n            if row and len(row) > 1 and row[1]:\n                review_reqs.add(str(row[1]).strip())\n    elif \"لم يُعثر عليه\" in sheetname:\n        continue\n    else:\n        # Warehouse match sheet\n        for row in list(ws.iter_rows(values_only=True))[1:]:\n            if row and row[0]:\n                matched_reqs.add(str(row[0]).strip())\n\nprint(f\"Total matched requested items in results: {len(matched_reqs)}\")\nprint(f\"Total review requested items in results: {len(review_reqs)}\")\n\n# 2. Read all shortages from original file\nshortages_file = Path(\"data/processes/PROC-001/input_shortages/0913.xlsx\")\nshortage_rows = read_excel(shortages_file)\nshortage_items = extract_item_names(shortage_rows, name_column=\"أسم الصنف\")\nall_shortage_names = list({item[\"item_name_raw\"].strip() for item in shortage_items if item[\"item_name_raw\"]})\nprint(f\"Total unique shortages in 0913.xlsx: {len(all_shortage_names)}\")\n\n# Unmatched items\nunmatched_shortages = [s for s in all_shortage_names if s not in matched_reqs and s not in review_reqs]\nprint(f\"Total unmatched shortages: {len(unmatched_shortages)}\")\n\n# 3. Load all warehouse items from cache\nwh_dir = Path(\"data/processes/PROC-001/input_warehouses\")\ncache_dir = Path(\"data/processes/data/.unstructured_cache\")\n\nwarehouses_data = {}\n\nfor pdf_file in wh_dir.glob(\"*.pdf\"):\n    # Check alongside json\n    alongside = pdf_file.with_suffix('.json')\n    items = []\n    if alongside.exists():\n        with open(alongside, 'r', encoding='utf-8') as f:\n            data = json.load(f)\n        items = parse_structured_result(data, pdf_file.name)\n    else:\n        # Try finding in cache\n        import hashlib\n        hasher = hashlib.md5()\n        with open(pdf_file, 'rb') as f:\n            buf = f.read(65536)\n            while len(buf) > 0:\n                hasher.update(buf)\n                buf = f.read(65536)\n        h = hasher.hexdigest()\n        cache_file = cache_dir / f\"{h}_extract.json\"\n        if cache_file.exists():\n            with open(cache_file, 'r', encoding='utf-8') as f:\n                data = json.load(f)\n            items = parse_structured_result(data, pdf_file.name)\n            \n    wh_names = [it[\"item_name_raw\"].strip() for it in items if it.get(\"item_name_raw\")]\n    warehouses_data[pdf_file.stem] = wh_names\n    print(f\"Loaded Warehouse: {pdf_file.stem} ({len(wh_names)} items)\")\n\n# 4. Thorough False Negative Audit\n# For every unmatched shortage, search across all warehouse items for potential false negatives\ndef extract_strength(text: str):\n    matches = re.findall(r'(\\d+(?:\\.\\d+)?)\\s*(?:مجم|جم|جرام|مل|مج|mg|gm|g|ml|%)', str(text).lower())\n    return set(matches)\n\npotential_false_negatives = []\n\nfor s in unmatched_shortages:\n    s_brands = extract_brand_tokens(s).split()\n    if not s_brands:\n        continue\n    first_s_brand = s_brands[0]\n    if len(first_s_brand) < 3:\n        continue\n        \n    s_form = extract_form_group(s)\n    s_st = extract_strength(s)\n    \n    for wh_name, items in warehouses_data.items():\n        for w in items:\n            w_brands = extract_brand_tokens(w).split()\n            if not w_brands:\n                continue\n            first_w_brand = w_brands[0]\n            if len(first_w_brand) < 3:\n                continue\n                \n            brand_sim = fuzz.ratio(first_s_brand, first_w_brand)\n            if brand_sim >= 80 or first_s_brand in w_brands or first_w_brand in s_brands:\n                w_form = extract_form_group(w)\n                w_st = extract_strength(w)\n                \n                # Check form conflict\n                form_conflict = False\n                if s_form and w_form and s_form != w_form:\n                    form_conflict = True\n                    \n                # Check strength conflict\n                strength_conflict = False\n                if s_st and w_st and not (s_st & w_st):\n                    strength_conflict = True\n                    \n                token_sort = fuzz.token_sort_ratio(s, w)\n                \n                # If high similarity or same brand\n                if token_sort >= 55 and not form_conflict and not strength_conflict:\n                    potential_false_negatives.append({\n                        \"shortage\": s,\n                        \"warehouse\": wh_name,\n                        \"wh_item\": w,\n                        \"token_sort\": token_sort,\n                        \"brand_sim\": brand_sim,\n                        \"s_form\": s_form,\n                        \"w_form\": w_form,\n                        \"s_st\": list(s_st),\n                        \"w_st\": list(w_st)\n                    })\n\nprint(f\"\\nTotal potential false negatives found: {len(potential_false_negatives)}\")\npotential_false_negatives.sort(key=lambda x: x[\"token_sort\"], reverse=True)\n\nseen = set()\ntop_clean = []\nfor p in potential_false_negatives:\n    key = (p[\"shortage\"], p[\"wh_item\"])\n    if key not in seen:\n        seen.add(key)\n        top_clean.append(p)\n\nprint(f\"Unique candidate pairs: {len(top_clean)}\")\nprint(\"\\n--- TOP 35 CANDIDATES ---\")\nfor p in top_clean[:35]:\n    print(f\"[{p['warehouse']}]\")\n    print(f\"  Shortage : '{p['shortage']}'\")\n    print(f\"  Warehouse: '{p['wh_item']}'\")\n    print(f\"  Score    : token_sort={p['token_sort']} | Form: {p['s_form']} vs {p['w_form']} | St: {p['s_st']} vs {p['w_st']}\\n\")\n","Description":"Audit potential false negatives across all warehouses","Overwrite":true,"TargetFile":"d:\\AI_Engineer\\Pharmacy-agy\\scratch\\find_false_negatives.py","toolAction":"Write script","toolSummary":"Audit potential false negatives"}}]}
