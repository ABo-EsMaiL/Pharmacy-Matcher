{"step_index":678,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-22T00:23:00Z","tool_calls":[{"name":"replace_file_content","args":{"AllowMultiple":false,"Description":"Update JS references to progress-area to progress-modal","EndLine":1330,"Instruction":"Replace progress-area references with progress-modal and use style.display = 'flex'/'none'","ReplacementContent":"async function submitProcess() {\n    if (selectedShortageFiles.length === 0 || selectedWarehouseFiles.length === 0) {\n        showToast('يرجى اختيار ملف نواقص وملف مخزن واحد على الأقل', 'error');\n        return;\n    }\n    \n    const btn = document.getElementById('btn-submit');\n    const progressModal = document.getElementById('progress-modal');\n    \n    // UI Loading state\n    btn.classList.add('hidden');\n    progressModal.style.display = 'flex';\n    document.getElementById('progress-text').innerText = 'جاري تهيئة العملية...';\n    document.getElementById('progress-bar-fill').style.width = '5%';\n    \n    try {\n        const res = await window.pywebview.api.start_process(selectedShortageFiles, selectedWarehouseFiles);\n        if (res.success) {\n            currentProcessId = res.process_id;\n            \n            // If the backend detected an identical exact match that was already completed!\n            if (res.existing) {\n                showToast('هذه العملية مسجلة بالفعل، جاري عرض النتائج...', 'info');\n                // Simulate process_complete event\n                setTimeout(() => {\n                    window.dispatchEvent(new CustomEvent('process_complete', {\n                        detail: {\n                            process_id: res.process_id,\n                            success: true,\n                            stats: res.stats\n                        }\n                    }));\n                }, 500);\n            } else {\n                // Background process started\n                showToast('بدأت العملية بنجاح في الخلفية', 'success');\n            }\n        } else {\n            showToast('خطأ: ' + res.error, 'error');\n            btn.classList.remove('hidden');\n            progressModal.style.display = 'none';\n        }\n    } catch (error) {\n        showToast('حدث خطأ أثناء الاتصال', 'error');\n        btn.classList.remove('hidden');\n        progressModal.style.display = 'none';\n    }\n}\n\n// --- Process Events ---\nwindow.addEventListener('process_update', (e) => {\n    const data = e.detail;\n    const progressModal = document.getElementById('progress-modal');\n    if (progressModal && progressModal.style.display === 'flex' && data.process_id === currentProcessId) {\n        const msgEl = document.getElementById('progress-text');\n        if (msgEl && data.message) msgEl.innerText = data.message;\n        \n        const pb = document.getElementById('progress-bar-fill');\n        if (pb) {\n            // Very simple heuristic to advance progress bar based on text\n            let pct = 10;\n            if (data.message.includes('استخراج') || data.message.includes('Extracting')) pct = 30;\n            if (data.message.includes('مطابقة') || data.message.includes('Matching')) pct = 60;\n            if (data.message.includes('حفظ') || data.message.includes('Saving')) pct = 90;\n            pb.style.width = pct + '%';\n        }\n    }\n});\n\nwindow.addEventListener('process_complete', (e) => {\n    const data = e.detail;\n    \n    if (data.process_id === currentProcessId) {\n        const btn = document.getElementById('btn-submit');\n        const progressModal = document.getElementById('progress-modal');\n        \n        btn.classList.remove('hidden');\n        progressModal.style.display = 'none';\n        \n        if (data.success) {\n            showToast('تمت المطابقة بنجاح!', 'success');\n            if (data.stats) {\n                loadResults(data.stats);\n            }\n            window.showScreen('screen-results');\n        } else {\n            showToast('فشلت عملية المطابقة: ' + data.error, 'error');\n        }\n    }\n});","StartLine":1255,"TargetContent":"async function submitProcess() {\n    if (selectedShortageFiles.length === 0 || selectedWarehouseFiles.length === 0) {\n        showToast('يرجى اختيار ملف نواقص وملف مخزن واحد على الأقل', 'error');\n        return;\n    }\n    \n    const btn = document.getElementById('btn-submit');\n    const progressArea = document.getElementById('progress-area');\n    \n    // UI Loading state\n    btn.classList.add('hidden');\n    progressArea.classList.remove('hidden');\n    document.getElementById('progress-text').innerText = 'جاري تهيئة العملية...';\n    document.getElementById('progress-bar-fill').style.width = '5%';\n    \n    try {\n        const res = await window.pywebview.api.start_process(selectedShortageFiles, selectedWarehouseFiles);\n        if (res.success) {\n            currentProcessId = res.process_id;\n            window.activeProcesses = (window.activeProcesses || 0) + 1;\n            \n            // If the backend detected an identical exact match that was already completed!\n            if (res.existing) {\n                showToast('هذه العملية مسجلة بالفعل، جاري عرض النتائج...', 'info');\n                // Simulate process_complete event\n                setTimeout(() => {\n                    window.dispatchEvent(new CustomEvent('process_complete', {\n                        detail: {\n                            process_id: res.process_id,\n                            success: true,\n                            stats: res.stats\n                        }\n                    }));\n                }, 500);\n            } else {\n                // Background process started\n                showToast('بدأت العملية بنجاح في الخلفية', 'success');\n            }\n        } else {\n            showToast('خطأ: ' + res.error, 'error');\n            btn.classList.remove('hidden');\n            progressArea.classList.add('hidden');\n        }\n    } catch (error) {\n        showToast('حدث خطأ أثناء الاتصال', 'error');\n        btn.classList.remove('hidden');\n        progressArea.classList.add('hidden');\n    }\n}\n\n// --- Process Events ---\nwindow.addEventListener('process_update', (e) => {\n    const data = e.detail;\n    const progressArea = document.getElementById('progress-area');\n    if (progressArea && !progressArea.classList.contains('hidden') && data.process_id === currentProcessId) {\n        const msgEl = document.getElementById('progress-text');\n        if (msgEl && data.message) msgEl.innerText = data.message;\n        \n        const pb = document.getElementById('progress-bar-fill');\n        if (pb) {\n            // Very simple heuristic to advance progress bar based on text\n            let pct = 10;\n            if (data.message.includes('استخراج') || data.message.includes('Extracting')) pct = 30;\n            if (data.message.includes('مطابقة') || data.message.includes('Matching')) pct = 60;\n            if (data.message.includes('حفظ') || data.message.includes('Saving')) pct = 90;\n            pb.style.width = pct + '%';\n        }\n    }\n});\n\nwindow.addEventListener('process_complete', (e) => {\n    const data = e.detail;\n    window.activeProcesses = Math.max(0, (window.activeProcesses || 1) - 1);\n    \n    if (data.process_id === currentProcessId) {\n        const btn = document.getElementById('btn-submit');\n        const progressArea = document.getElementById('progress-area');\n        \n        btn.classList.remove('hidden');\n        progressArea.classList.add('hidden');\n        \n        if (data.success) {\n            showToast('تمت المطابقة بنجاح!', 'success');\n            if (data.stats) {\n                loadResults(data.stats);\n            }\n            window.showScreen('screen-results');\n        } else {\n            showToast('فشلت عملية المطابقة: ' + data.error, 'error');\n        }\n    }\n});","TargetFile":"d:\\AI_Engineer\\Pharmacy-agy\\desktop_app\\templates\\index.html","toolAction":"Update JS progress visibility","toolSummary":"Fix progress logic"}}]}
