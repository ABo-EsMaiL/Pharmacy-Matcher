1714: let selectedWarehouseFiles = [];\n1715: let selectedShortageFiles = [];\n1716: let serverStatusInterval = null;\n1717: let isServerRunning = false;\n1718: \n1719: // Ensure Pywebview API is ready\n1720: window.addEventListener('pywebviewready', function() {\n1721:     setLanguage(currentLang);\n1722:     loadSettings();\n1723:     loadLogs();\n1724:     updateServerStatus();\n1725:     serverStatusInterval = setInterval(updateServerStatus, 5000);\n1726:     setupDragAndDrop();\n1727: });\n1728: \n1729: // Logs Logic\n1730: window.addEventListener('new_log', function(e) {\n1731:     // 1. Update the main system logs textarea (in Settings)\n1732:     const logArea = document.getElementById('system-logs');\n1733:     if (logArea) {\n1734:         logArea.value += e.detail + '\\n';\n1735:         logArea.scrollTop = logArea.scrollHeight;\n1736:     }\n1737:     \n1738:     // 2. Update the pipeline terminal textarea (in Terminal screen)\n1739:     const termEl = document.getElementById('pipeline-log-terminal');\n1740:     if (termEl) {\n1741:         termEl.value += e.detail + '\\n';\n1742:         termEl.scrollTop = termEl.scrollHeight;\n1743:     }\n1744: });\n1745: \n1746: async function loadLogs() {\n1747:     try {\n1748:         const logsStr = await window.pywebview.api.get_logs();\n1749:         const logs = JSON.parse(logsStr);\n1750:         const text = logs.join('\\n') + (logs.length ? '\\n' : '');\n1751:         \n1752:         const logArea = document.getElementById('system-logs');\n1753:         if (logArea) {\n1754:             logArea.value = text;\n1755:             logArea.scrollTop = logArea.scrollHeight;\n1756:         }\n1757:         \n1758:         const termEl = document.getElementById('pipeline-log-terminal');\n1759:         if (termEl) {\n1760:             termEl.value = text;\n1761:             termEl.scrollTop = termEl.scrollHeight;\n1762:         }\n1763:     } catch (e) {\n1764:         console.error(e);\n1765:     }\n1766: }\n1767: \n1768: // Toast Notifications\n1769: function showToast(message, type = 'success') {\n1770:     const container = document.getElementById('toast-container');\n1771:     const toast = document.createElement('div');\n1772:     toast.className = `toast ${type}`;\n1773:     \n1774:     const icon = type === 'success' ? 'ph-check-circle' : 'ph-warning-circle';\n1775:     toast.innerHTML = `<i class=\"ph-fill ${icon}\"></i> <span>${message}</span>`;\n1776:     \n1777:     container.appendChild(toast);\n1778:     \n1779:     setTimeout(() => {\n1780:         toast.style.animation = 'fadeOut 0.3s ease forwards';\n1781:         setTimeout(() => toast.remove(), 300);\n1782:     }, 3000);\n1783: }\n1784: \n1785: // Exit App\n1786: async function exitApp() {\n1787:     const t = I18N[currentLang] || I18N.ar;\n1788:     try {\n1789:         let isRunning = false;\n1790:         if (window.pywebview && window.pywebview.api) {\n1791:             const historyStr = await window.pywebview.api.get_history();\n1792:             const history = JSON.parse(historyStr);\n1793:             isRunning = history.some(item => item.status === 'processing');\n1794:         }\n1795:         \n1796:         if (isRunning) {\n1797:             showCustomConfirm(t.confirm_exit_title, t.confirm_exit_msg, async () => {\n1798:                 await window.pywebview.api.exit_app();\n1799:             });\n1800:         } else {\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
