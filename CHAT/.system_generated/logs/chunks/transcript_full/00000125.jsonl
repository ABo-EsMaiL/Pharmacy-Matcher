lsx', '.xls', '.csv', '.json'];\n1836:     \n1837:     const validExts = targetZone === 'warehouse' ? validWarehouseExts : validShortageExts;\n1838:     const validFiles = [];\n1839:     const invalidFiles = [];\n1840:     \n1841:     files.forEach(f => {\n1842:         const ext = f.substring(f.lastIndexOf('.')).toLowerCase();\n1843:         if (validExts.includes(ext) || !f.includes('.')) {\n1844:             validFiles.push(f);\n1845:         } else {\n1846:             invalidFiles.push(f);\n1847:         }\n1848:     });\n1849:     \n1850:     if (invalidFiles.length > 0) {\n1851:         showToast(`تم تجاهل ${invalidFiles.length} ملفات غير مدعومة. المسموح: ${validExts.join(', ')}`, 'error');\n1852:     }\n1853:     \n1854:     if (validFiles.length > 0) {\n1855:         if (targetZone === 'warehouse') {\n1856:             selectedWarehouseFiles = [...selectedWarehouseFiles, ...validFiles];\n1857:             updateFileList('warehouse', selectedWarehouseFiles);\n1858:         } else {\n1859:             selectedShortageFiles = [...selectedShortageFiles, ...validFiles];\n1860:             updateFileList('shortage', selectedShortageFiles);\n1861:         }\n1862:         checkSubmitState();\n1863:     }\n1864: }\n1865: \n1866: function setupDragAndDrop() {\n1867:     const zones = [\n1868:         { id: 'zone-shortage', type: 'shortage' },\n1869:         { id: 'zone-warehouse', type: 'warehouse' }\n1870:     ];\n1871: \n1872:     zones.forEach(({id, type}) => {\n1873:         const zone = document.getElementById(id);\n1874:         if (!zone) return;\n1875: \n1876:         zone.addEventListener('dragenter', () => { window.activeDragZone = type; });\n1877:         zone.addEventListener('dragover', (e) => {\n1878:             e.preventDefault();\n1879:             window.activeDragZone = type;\n1880:             zone.style.borderColor = 'var(--primary)';\n1881:             zone.style.background = '#f0f9ff';\n1882:         });\n1883: \n1884:         zone.addEventListener('dragleave', (e) => {\n1885:             e.preventDefault();\n1886:             zone.style.borderColor = '';\n1887:             zone.style.background = '';\n1888:         });\n1889: \n1890:         zone.addEventListener('drop', async (e) => {\n1891:             e.preventDefault();\n1892:             zone.style.borderColor = '';\n1893:             zone.style.background = '';\n1894:             \n1895:             if (e.dataTransfer && e.dataTransfer.files) {\n1896:                 const files = Array.from(e.dataTransfer.files);\n1897:                 const savedPaths = [];\n1898:                 \n1899:                 // Show a mini loading toast if dropping many files\n1900:                 if (files.length > 2) {\n1901:                     showToast('جاري معالجة الملفات المسحوبة...', 'success');\n1902:                 }\n1903:                 \n1904:                 for (let file of files) {\n1905:                     // if it happens to have a path, use it directly (e.g. Mac/Linux or specific pywebview configs)\n1906:                     if (file.path && (file.path.includes('\\\\') || file.path.includes('/'))) {\n1907:                         savedPaths.push(file.path);\n1908:                     } else {\n1909:                         // Otherwise fallback to Base64 (Perfect for Edge WebView2)\n1910:                         await new Promise((resolve) => {\n1911:                             const reader = new FileReader();\n1912:                             reader.onload = async (event) => {\n1913:                                 const base64 = event.target.result.split(',')[1];\n1914:                                 const tempPath = await window.pywebview.api.save_dropped_file(file.name, base64);\n1915:                                 if (tempPath) {\n1916:                                     savedPaths.push(tempPath);\n1917:                                 }\n1918:                                 resolve();\n1919:                             };\n1920:                             reader.readAsDataURL(file);\n1921:                         });\n1922:                     }\n1923:                 }\n1924:                 \n1925:                 if (savedPaths.length > 0) {\n1926:                     processSelectedFiles(savedPaths, type);\n1927:                 }\n1928:             }\n1929:             window.activeDragZone = null;\n1930:         });\n1931:     });\n1932: }\n1933: \n1934: // --- New Process Logic ---\n1935: function resetNewProcessForm() {\n1936:     selectedWarehouseFiles = [];\n1937:     selectedShortageFiles = [];\n1938:     updateFileList('warehouse', selectedWarehouseFiles);\n1939:     updateFileList('shortage', selectedShortageFiles);\n1940:     document.getElementById('progress-area').classList.add('hidden');\n1941:     document.getElementById('btn-submit').removeAttribute('disabled');\n1942:     checkSubmitState();\n1943: }\n1944: \n1945: async function selectFiles(type) {\n1946:     try {\n1947:         const filePaths = await window.pywebview.api.select_files(type);\n1948:         if (filePaths && filePaths.length > 0) {\n1949:             const pathList = JSON.parse(filePaths);\n1950:             processSelectedFiles(pathList, type);\n1951:         }\n1952:     } catch (error) {\n1953:         showToast('حدث خطأ أثناء اختيار الملفات', 'error');\n1954:         console.error(error);\n1955:     }\n1956: }\n1957: \n1958: function updateFileList(type, files) {\n1959:     const listEl = document.getElementById(`list-${type}`);\n1960:     listEl.innerHTML = '';\n1961:     files.forEach((path, index) => {\n1962:         let fileName = path.split('\\\\').pop().split('/').pop();\n1963:         if (fileName.includes('?')) {\n1964:             fileName = fileName.split('?')[0];\n1965:         }\n1966:         \n1967:         let iconClass = 'ph-file';\n1968:         const ext = fileName.split('.').pop().toLowerCase();\n1969:         if (ext === 'pdf') iconClass = 'ph-file-pdf text-danger';\n1970:         else if (ext === 'xlsx' || ext === 'xls' || ext === 'csv') iconClass = 'ph-file-xls text-success';\n1971:         else if (ext === 'json') iconClass = 'ph-file-code text-warning';\n1972: \n1973:         const li = document.createElement('li');\n1974:         li.className = 'file-item';\n1975:         li.innerHTML = `\n1976:             <div class=\"file-item-name\" title=\"${path}\">\n1977:                 <i class=\"ph-fill ${iconClass}\"></i>\n1978:                 <span>${fileName}</span>\n1979:             </div>\n1980:             <button class=\"file-item-delete\" onclick=\"removeFile('${type}', ${index})\" title=\"إزالة الملف\">\n1981:                 <i class=\"ph-fill ph-trash\"></i>\n1982:             </button>\n1983:         `;\n1984:         listEl.appendChild(li);\n1985:     });\n1986: }\n1987: \n1988: function removeFile(type, index) {\n1989:     if (type === 'warehouse') {\n1990:         selectedWarehouseFiles.splice(index, 1);\n1991:         updateFileList('warehouse', selectedWarehouseFiles);\n1992:     } else {\n1993:         selectedShortageFiles.splice(index, 1);\n1994:         updateFileList('shortage', selectedShortageFiles);\n1995:     }\n1996:     checkSubmitState();\n1997: }\n1998: \n1999: function checkSubmitState() {\n2000:     const btn = document.getElementById('btn-submit');\n2001:     if (selectedWarehouseFiles.length > 0 && selectedShortageFiles.length > 0) {\n2002:         btn.removeAttribute('disabled');\n2003:     } else {\n2004:         btn.setAttribute('disabled', 'true');\n2005:     }\n2006: }\n2007: \n2008: async function submitProcess() {\n2009:     const t = I18N[currentLang] || I18N.ar;\n2010:     if (isProcessRunning) {\n2011:         showToast(currentLang === 'en' ? 'A matching process is currently running. Please wait.' : 'توجد عملية مطابقة قيد التشغيل حالياً، يرجى الانتظار حتى تنتهي', 'warning');\n2012:         return;\n2013:     }\n2014:     if (selectedShortageFiles.length === 0 || selectedWarehouseFiles.length === 0) {\n2015:         showToast(t.select_at_least_one, 'error');\n2016:         return;\n2017:     }\n2018:     \n2019:     const btn = document.getElementById('btn-submit');\n2020:     const progressModal = document.getElementById('progress-modal');\n2021:     \n2022:     // UI Loading state\n2023:     isProcessRunning = true;\n2024:     if (btn) {\n2025:         btn.classList.add('hidden');\n2026:         btn.style.display = 'none';\n2027:     }\n2028:     if (progressModal) {\n2029:         progressModal.style.display = 'flex';\n2030:     }\n2031:     document.getElementById('progress-text').innerText = t.progress_init;\n2032:     document.getElementById('progress-bar-fill').style.width = '5%';\n2033:     startProgressTimer();\n2034:     \n2035:     const termEl = document.getElementById('pipeline-log-terminal');\n2036:     if (termEl) termEl.innerHTML = '[System] Started pipeline...\\n';\n2037:     \n2038:     try {\n2039:         const res = await window.pywebview.api.start_process(\n2040:             JSON.stringify(selectedShortageFiles), \n2041:             JSON.stringify(selectedWarehouseFiles)\n2042:         );\n2043:         if (res.success) {\n2044:             currentProcessId = res.process_id;\n2045:             \n2046:             if (res.queued) {\n2047:                 isProcessRunning = false;\n2048:                 if (btn) {\n2049:                     btn.classList.remove('hidden');\n2050:                     btn.style.display = '';\n2051:                 }\n2052:                 if (progressModal) {\n2053:                     progressModal.style.display = 'none';\n2054:                 }\n2055:                 stopProgressTimer();\n2056:                 \n2057:                 selectedShortageFiles = [];\n2058:                 selectedWarehouseFiles = [];\n2059:                 renderFileList('shortages-list', selectedShortageFiles, 'shortages');\n2060:                 renderFileList('warehouses-list', selectedWarehouseFiles, 'warehouses');\n2061:   