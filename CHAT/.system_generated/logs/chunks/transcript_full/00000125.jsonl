-muted);\n}\n.server-badges-row {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    flex-wrap: wrap;\n}\n.badge-pill {\n    padding: 4px 10px;\n    border-radius: 20px;\n    font-size: 12px;\n    font-weight: 700;\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n}\n.badge-pill.status-online {\n    background: #ecfdf5;\n    color: #065f46;\n    border: 1px solid #a7f3d0;\n}\n.badge-pill.status-offline {\n    background: #fef2f2;\n    color: #991b1b;\n    border: 1px solid #fecaca;\n}\n.badge-pill.active-server-badge {\n    background: #eff6ff;\n    color: #1d4ed8;\n    border: 1px solid #bfdbfe;\n}\n.server-details-list {\n    background: #f8fafc;\n    border: 1px solid var(--border);\n    border-radius: var(--radius-md);\n    padding: 12px 16px;\n    display: flex;\n    flex-direction: column;\n    gap: 8px;\n    font-size: 13px;\n}\n.server-detail-row {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    gap: 12px;\n}\n.server-detail-label {\n    color: var(--text-muted);\n    font-weight: 600;\n}\n.server-detail-value {\n    color: var(--text-main);\n    font-weight: 700;\n    font-family: monospace;\n    direction: ltr;\n}\n.server-actions-grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 10px;\n    margin-top: auto;\n}\n.active-banner {\n    background: linear-gradient(135deg, #0ea5e9, #38bdf8);\n    color: white;\n    padding: 16px 20px;\n    border-radius: var(--radius-lg);\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 16px;\n    margin-bottom: 24px;\n    box-shadow: 0 4px 12px rgba(14, 165, 233, 0.25);\n}\n.active-banner-content {\n    display: flex;\n    align-items: center;\n    gap: 14px;\n}\n.active-banner-icon {\n    font-size: 32px;\n}\n.active-banner-text h4 {\n    margin: 0;\n    font-size: 16px;\n    font-weight: 800;\n}\n.active-banner-text p {\n    margin: 2px 0 0;\n    font-size: 13px;\n    opacity: 0.9;\n}\n.server-test-box {\n    background: #1e1e1e;\n    border-radius: var(--radius-md);\n    padding: 14px;\n    color: #4ade80;\n    font-family: 'Consolas', 'Courier New', monospace;\n    font-size: 13px;\n    line-height: 1.5;\n    min-height: 120px;\n    max-height: 250px;\n    overflow-y: auto;\n    direction: ltr;\n    text-align: left;\n    white-space: pre-wrap;\n    word-break: break-all;\n}\n    </style>","StartLine":972,"TargetContent":"@keyframes fadeOut {\n    from { opacity: 1; }\n    to { opacity: 0; }\n}\n    </style>","TargetFile":"d:/AI_Engineer/Pharmacy-agy/desktop_app/templates/index.html","toolAction":"Adding CSS styles","toolSummary":"Add CSS for servers screen"}}]}
