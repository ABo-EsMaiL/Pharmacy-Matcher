{"step_index":108,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-21T15:40:28Z","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"\"\"\"Pharmacy Drug Matching Pipeline\n\nمشروع مطابقة أدوية النواقص مع قوائم المخازن.\nيقرأ ملفات النواقص وملفات المخازن (PDF أو Excel)، يطابق الأسماء\nباستخدام Gemini، ويُخرج ملف Excel بالنتائج.\n\nUsage:\n    python main.py --shortages <file> --warehouses <file1> <file2> ... --output <output.xlsx>\n    python main.py --shortages 0913.xlsx --warehouses w1.pdf w2.pdf --output results.xlsx\n\"\"\"\n\nimport argparse\nimport sys\nfrom pathlib import Path\n\n# إضافة مجلد المشروع إلى مسار Python\nsys.path.insert(0, str(Path(__file__).resolve().parent))\n\nfrom src.config import load_config\nfrom src.extract.file_handler import read_input_files\nfrom src.match.coordinator import Coordinator\nfrom src.output.excel_writer import write_results_excel\n\n\ndef main():\n    if hasattr(sys.stdout, \"reconfigure\"):\n        sys.stdout.reconfigure(encoding=\"utf-8\", errors=\"replace\")\n\n    parser = argparse.ArgumentParser(\n        description=\"مطابقة أدوية النواقص مع قوائم المخازن\",\n        formatter_class=argparse.RawDescriptionHelpFormatter,\n        epilog=__doc__,\n    )\n    parser.add_argument(\n        \"--shortages\", \"-s\",\n        nargs=\"+\",\n        type=Path,\n        required=True,\n        help=\"ملف أو ملفات النواقص (Excel أو PDF)\",\n    )\n    parser.add_argument(\n        \"--warehouses\", \"-w\",\n        nargs=\"+\",\n        type=Path,\n        required=True,\n        help=\"ملفات المخازن (PDF أو Excel) — كل ملف يمثل مخزن واحد\",\n    )\n    parser.add_argument(\n        \"--output\", \"-o\",\n        type=Path,\n        default=Path(\"output/results.xlsx\"),\n        help=\"مسار ملف Excel الناتج (افتراضي: output/results.xlsx)\",\n    )\n\n    args = parser.parse_args()\n\n    # ─── التحقق من وجود الملفات ───\n    for f in args.shortages + args.warehouses:\n        if not f.exists():\n            parser.error(f\"الملف غير موجود: {f}\")\n\n    # ─── تحميل الإعدادات ───\n    try:\n        config = load_config()\n    except ValueError as e:\n        print(f\"⚠️ {e}\")\n        print(\"يرجى نسخ .env.example إلى .env وتعبئة المفاتيح.\")\n        return 1\n\n    print(f\"\\n🔧 الإعدادات:\")\n    print(f\"   النموذج: {config.gemini_model}\")\n    print(f\"   Unstructured API: {'✅ متوفر' if config.unstructured_api_key else '❌ مفقود'}\")\n    print(f\"   Gemini API: {'✅ متوفر' if config.gemini_api_key else '❌ مفقود'}\")\n\n    # ─── قراءة ملفات النواقص ───\n    shortage_data = read_input_files(\n        args.shortages, role=\"shortages\", api_key=config.unstructured_api_key,\n    )\n\n    # تجميع كل النواقص في قائمة واحدة\n    all_shortages = []\n    for filename, items in shortage_data.items():\n        all_shortages.extend(items)\n\n    if not all_shortages:\n        print(\"❌ لم يتم العثور على أي أصناف في ملفات النواقص!\")\n        return 1\n\n    print(f\"\\n📋 إجمالي أصناف النواقص: {len(all_shortages)}\")\n\n    # ─── قراءة ملفات المخازن ───\n    warehouse_data = read_input_files(\n        args.warehouses, role=\"warehouse\", api_key=config.unstructured_api_key,\n    )\n\n    if not warehouse_data:\n        print(\"❌ لم يتم العثور على أي أصناف في ملفات المخازن!\")\n        return 1\n\n    # ─── تشغيل المطابقة ───\n    coordinator = Coordinator(config)\n    results = coordinator.process(all_shortages, warehouse_data)\n\n    # ─── كتابة النتائج ───\n    write_results_excel(results, args.output)\n\n    print(f\"\\n🎉 تم الانتهاء!\")\n    print(f\"   📄 النتائج: {args.output.resolve()}\")\n\n    summary = results.get(\"summary\", {})\n    if summary.get(\"not_found_count\", 0) > 0:\n        print(f\"   ⚠️ {summary['not_found_count']} صنف لم يُعثر عليه في أي مخزن\")\n    if summary.get(\"review_count\", 0) > 0:\n        print(f\"   👁️ {summary['review_count']} حالة تحتاج مراجعة يدوية\")\n\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n","Description":"Main entry point for CLI — parses args, loads config, reads files, runs matching, writes Excel output","Overwrite":false,"TargetFile":"d:\\AI_Engineer\\Pharmacy-agy\\main.py","toolAction":"Creating main entry point","toolSummary":"Main pipeline script"}}]}
