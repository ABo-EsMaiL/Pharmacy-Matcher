{"step_index":97,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-21T15:38:39Z","content":"Created At: 2026-09-21T18:38:39+03:00\nCompleted At: 2026-09-21T18:38:40+03:00\nFile Path: `file:///d:/AI_Engineer/Pharmacy-agy/src/output/excel_writer.py`\nTotal Lines: 237\nTotal Bytes: 9939\nShowing lines 1 to 237\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"\"\"\n2: وحدة كتابة نتائج المطابقة إلى ملف Excel.\n3: Write the final Excel output with per-warehouse sheets and summary.\n4: \"\"\"\n5: \n6: from pathlib import Path\n7: \n8: from openpyxl import Workbook\n9: from openpyxl.styles import Alignment, Font, PatternFill, Border, Side\n10: from openpyxl.utils import get_column_letter\n11: \n12: \n13: # ──────────────────────────────────────────────\n14: # أنماط التنسيق\n15: # ──────────────────────────────────────────────\n16: _HEADER_FILL = PatternFill(start_color=\"00695C\", end_color=\"00695C\", fill_type=\"solid\")\n17: _HEADER_FONT = Font(name=\"Arial\", bold=True, color=\"FFFFFF\", size=11)\n18: _HEADER_ALIGNMENT = Alignment(\n19:     horizontal=\"center\", vertical=\"center\", wrap_text=True\n20: )\n21: _CELL_FONT = Font(name=\"Arial\", size=10)\n22: _CELL_ALIGNMENT = Alignment(horizontal=\"right\", vertical=\"center\", wrap_text=True)\n23: _THIN_BORDER = Border(\n24:     left=Side(style=\"thin\"),\n25:     right=Side(style=\"thin\"),\n26:     top=Side(style=\"thin\"),\n27:     bottom=Side(style=\"thin\"),\n28: )\n29: \n30: \n31: def _apply_header_style(ws, num_cols: int) -> None:\n32:     \"\"\"تطبيق تنسيق الرأس على الصف الأول.\"\"\"\n33:     for col_idx in range(1, num_cols + 1):\n34:         cell = ws.cell(row=1, column=col_idx)\n35:         cell.fill = _HEADER_FILL\n36:         cell.font = _HEADER_FONT\n37:         cell.alignment = _HEADER_ALIGNMENT\n38:         cell.border = _THIN_BORDER\n39: \n40: \n41: def _format_sheet(ws, num_cols: int) -> None:\n42:     \"\"\"تنسيق الورقة: تجميد الصف الأول، فلتر تلقائي، RTL، عرض الأعمدة.\"\"\"\n43:     # تجميد الصف الأول\n44:     ws.freeze_panes = \"A2\"\n45: \n46:     # فلتر تلقائي\n47:     if ws.max_row > 0 and num_cols > 0:\n48:         last_col_letter = get_column_letter(num_cols)\n49:         ws.auto_filter.ref = f\"A1:{last_col_letter}{ws.max_row}\"\n50: \n51:     # اتجاه الورقة من اليمين لليسار\n52:     ws.sheet_view.rightToLeft = True\n53: \n54:     # عرض الأعمدة التلقائي (تقدير بسيط)\n55:     for col_idx in range(1, num_cols + 1):\n56:         max_length = 0\n57:         col_letter = get_column_letter(col_idx)\n58:         for row in ws.iter_rows(\n59:             min_col=col_idx, max_col=col_idx, min_row=1, max_row=ws.max_row\n60:         ):\n61:             for cell in row:\n62:                 if cell.value:\n63:                     # حساب العرض التقريبي (الحروف العربية أعرض)\n64:                     cell_len = len(str(cell.value))\n65:                     max_length = max(max_length, cell_len)\n66:         # حد أدنى 12، حد أقصى 60\n67:         adjusted_width = min(max(max_length + 4, 12), 60)\n68:         ws.column_dimensions[col_letter].width = adjusted_width\n69: \n70: \n71: def _add_data_rows(ws, rows: list[list], start_row: int = 2) -> None:\n72:     \"\"\"إضافة صفوف البيانات مع التنسيق.\"\"\"\n73:     for row_idx, row_data in enumerate(rows, start=start_row):\n74:         for col_idx, value in enumerate(row_data, start=1):\n75:             cell = ws.cell(row=row_idx, column=col_idx, value=value)\n76:             cell.font = _CELL_FONT\n77:             cell.alignment = _CELL_ALIGNMENT\n78:             cell.border = _THIN_BORDER\n79: \n80: \n81: def _truncate_sheet_name(name: str, max_len: int = 31) -> str:\n82:     \"\"\"\n83:     اقتطاع اسم الورقة ليتوافق مع حد Excel (31 حرفاً).\n84:     يزيل أيضاً الأحرف غير المسموح بها في أسماء الأوراق.\n85:     \"\"\"\n86:     # إزالة الأحرف غير المسموح بها في أسماء أوراق Excel\n87:     invalid_chars = r\"[]:*?/\\\\\"\n88:     for ch in invalid_chars:\n89:         name = name.replace(ch, \"_\")\n90:     return name[:max_len]\n91: \n92: \n93: def write_results_excel(results: dict, output_path: Path) -> None:\n94:     \"\"\"\n95:     كتابة نتائج المطابقة إلى ملف Excel منسّق.\n96: \n97:     Args:\n98:         results: قاموس النتائج من المنسِّق (Coordinator) يحتوي على:\n99:             - warehouse_results: نتائج كل مخزن\n100:             - not_found: الأصناف غير الموجودة\n101:             - summary: ملخص إحصائي\n102:         output_path: مسار ملف Excel الناتج.\n103:     \"\"\"\n104:     wb = Workbook()\n105: \n106:     # ────────────────────────────────────────\n107:     # ورقة الملخص\n108:     # ────────────────────────────────────────\n109:     ws_summary = wb.active\n110:     ws_summary.title = \"ملخص\"\n111: \n112:     summary = results.get(\"summary\", {})\n113:     warehouse_results = results.get(\"warehouse_results\", {})\n114: \n115:     summary_headers = [\"البند\", \"العدد\", \"النسبة\"]\n116:     ws_summary.append(summary_headers)\n117:     _apply_header_style(ws_summary, len(summary_headers))\n118: \n119:     total = summary.get(\"total_shortages\", 0)\n120:     matched = summary.get(\"matched_count\", 0)\n121:     not_found = summary.get(\"not_found_count\", 0)\n122:     review = summary.get(\"review_count\", 0)\n123: \n124:     summary_data = [\n125:         [\"إجمالي الأصناف المطلوبة\", total, \"\"],\n126:         [\n127:             \"تم مطابقتها\",\n128:             matched,\n129:             f\"{matched / total * 100:.1f}%\" if total > 0 else \"0%\",\n130:         ],\n131:         [\n132:             \"لم يُعثر عليها\",\n133:             not_found,\n134:             f\"{not_found / total * 100:.1f}%\" if total > 0 else \"0%\",\n135:         ],\n136:         [\n137:             \"تحتاج مراجعة\",\n138:             review,\n139:             f\"{review / total * 100:.1f}%\" if total > 0 else \"0%\",\n140:         ],\n141:         [],  # صف فارغ\n142:         [\"─── تفاصيل المخازن ───\", \"\", \"\"],\n143:     ]\n144:     _add_data_rows(ws_summary, summary_data)\n145: \n146:     # تفاصيل كل مخزن\n147:     detail_row = len(summary_data) + 3\n148:     for wh_name, wh_data in warehouse_results.items():\n149:         wh_matched = len(wh_data.get(\"matched\", []))\n150:         wh_review = len(wh_data.get(\"needs_review\", []))\n151:         ws_summary.cell(row=detail_row, column=1, value=wh_name).font = _CELL_FONT\n152:         ws_summary.cell(\n153:             row=detail_row, column=2, value=f\"مطابق: {wh_matched}\"\n154:         ).font = _CELL_FONT\n155:         ws_summary.cell(\n156:             row=detail_row, column=3, value=f\"مراجعة: {wh_review}\"\n157:         ).font = _CELL_FONT\n158:         detail_row += 1\n159: \n160:     _format_sheet(ws_summary, len(summary_headers))\n161: \n162:     # ────────────────────────────────────────\n163:     # ورقة لكل مخزن (المطابقات المؤكدة فقط)\n164:     # ────────────────────────────────────────\n165:     for wh_name, wh_data in warehouse_results.items():\n166:         sheet_name = _truncate_sheet_name(wh_name)\n167:         ws_wh = wb.create_sheet(title=sheet_name)\n168: \n169:         headers = [\"اسم الصنف المطلوب\", \"اسم الصنف في المخزن\", \"درجة التطابق\"]\n170:         ws_wh.append(headers)\n171:         _apply_header_style(ws_wh, len(headers))\n172: \n173:         matched_items = wh_data.get(\"matched\", [])\n174:         rows = []\n175:         for match in matched_items:\n176:             shortage_name = match.get(\"shortage_item\", \"\")\n177:             warehouse_item = match.get(\"warehouse_item\", \"\")\n178:             confidence = match.get(\"confidence\", \"\")\n179:             rows.append([shortage_name, warehouse_item, confidence])\n180: \n181:         _add_data_rows(ws_wh, rows)\n182:         _format_sheet(ws_wh, len(headers))\n183: \n184:     # ────────────────────────────────────────\n185:     # ورقة \"لم يُعثر عليه\"\n186:     # ────────────────────────────────────────\n187:     ws_not_found = wb.create_sheet(title=\"لم يُعثر عليه\")\n188:     nf_headers = [\"اسم الصنف\", \"الملف المصدر\"]\n189:     ws_not_found.append(nf_headers)\n190:     _apply_header_style(ws_not_found, len(nf_headers))\n191: \n192:     not_found_items = results.get(\"not_found\", [])\n193:     nf_rows = []\n194:     for item in not_found_items:\n195:         name = item.get(\"name\", \"\") if isinstance(item, dict) else str(item)\n196:         source = item.get(\"source\", \"\") if isinstance(item, dict) else \"\"\n197:         nf_rows.append([name, source])\n198: \n199:     _add_data_rows(ws_not_found, nf_rows)\n200:     _format_sheet(ws_not_found, len(nf_headers))\n201: \n202:     # ────────────────────────────────────────\n203:     # ورقة \"يحتاج مراجعة\"\n204:     # ────────────────────────────────────────\n205:     ws_review = wb.create_sheet(title=\"يحتاج مراجعة\")\n206:     review_headers = [\n207:         \"اسم الصنف المطلوب\",\n208:         \"اسم المرشح في المخزن\",\n209:         \"المخزن\",\n210:         \"السبب\",\n211:     ]\n212:     ws_review.append(review_headers)\n213:     _apply_header_style(ws_review, len(review_headers))\n214: \n215:     review_rows = []\n216:     for wh_name, wh_data in warehouse_results.items():\n217:         for item in wh_data.get(\"needs_review\", []):\n218:             review_rows.append(\n219:                 [\n220:                     item.get(\"shortage_item\", \"\"),\n221:                     item.get(\"warehouse_item\", \"\"),\n222:                     wh_name,\n223:                     item.get(\"reason\", \"\"),\n224:                 ]\n225:             )\n226: \n227:     _add_data_rows(ws_review, review_rows)\n228:     _format_sheet(ws_review, len(review_headers))\n229: \n230:     # ────────────────────────────────────────\n231:     # حفظ الملف\n232:     # ────────────────────────────────────────\n233:     output_path = Path(output_path)\n234:     output_path.parent.mkdir(parents=True, exist_ok=True)\n235:     wb.save(str(output_path))\n236:     print(f\"✅ تم حفظ النتائج في: {output_path}\")\n237: \nThe above content shows the entire, complete file contents of the requested file.\n"}
