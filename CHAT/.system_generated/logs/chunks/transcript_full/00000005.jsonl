{"step_index":99,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-21T15:38:50Z","content":"Created At: 2026-09-21T18:38:50+03:00\nCompleted At: 2026-09-21T18:38:50+03:00\nFile Path: `file:///d:/AI_Engineer/Pharmacy-agy/src/extract/file_handler.py`\nTotal Lines: 98\nTotal Bytes: 3599\nShowing lines 1 to 98\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"\"\"\n2: وحدة معالجة الملفات - كشف نوع الملف وتوجيهه للقارئ المناسب.\n3: File handler module - detects file type and routes to appropriate reader.\n4: \"\"\"\n5: \n6: from pathlib import Path\n7: \n8: from .excel_reader import read_excel, extract_item_names\n9: from .pdf_reader import extract_items_from_pdf\n10: \n11: \n12: # الامتدادات المدعومة\n13: _EXCEL_EXTENSIONS = {\".xlsx\", \".xls\", \".xlsm\"}\n14: _PDF_EXTENSIONS = {\".pdf\"}\n15: \n16: \n17: def read_input_files(\n18:     filepaths: list[Path],\n19:     role: str,\n20:     api_key: str | None = None,\n21:     base_url: str = \"https://transform.unstructured.io\",\n22: ) -> dict[str, list[dict]]:\n23:     \"\"\"\n24:     قراءة مجموعة ملفات إدخال (PDF أو Excel) واستخراج أسماء الأصناف.\n25: \n26:     يكتشف نوع كل ملف بناءً على امتداده ويوجهه للقارئ المناسب.\n27: \n28:     Args:\n29:         filepaths: قائمة مسارات الملفات المطلوب قراءتها.\n30:         role: دور الملفات - 'shortages' (قائمة النقص) أو 'warehouse' (قائمة المستودع).\n31:         api_key: مفتاح Unstructured API (مطلوب لملفات PDF).\n32:         base_url: عنوان خادم Unstructured API.\n33: \n34:     Returns:\n35:         قاموس يربط اسم الملف بقائمة العناصر المستخرجة.\n36:         كل عنصر يحتوي على: item_name_raw, source_file, source_page/source_row.\n37: \n38:     Raises:\n39:         ValueError: إذا كان امتداد الملف غير مدعوم.\n40:         ValueError: إذا كان مفتاح API مفقوداً لملفات PDF.\n41:     \"\"\"\n42:     role_label = \"قائمة النقص\" if role == \"shortages\" else \"قائمة المستودع\"\n43:     print(f\"\\n{'='*60}\")\n44:     print(f\"📂 جارٍ معالجة ملفات {role_label} ({len(filepaths)} ملف)\")\n45:     print(f\"{'='*60}\")\n46: \n47:     results: dict[str, list[dict]] = {}\n48: \n49:     for filepath in filepaths:\n50:         filepath = Path(filepath)\n51:         ext = filepath.suffix.lower()\n52: \n53:         print(f\"\\n📎 الملف: {filepath.name} (النوع: {ext})\")\n54: \n55:         if ext in _EXCEL_EXTENSIONS:\n56:             items = _process_excel_file(filepath)\n57:         elif ext in _PDF_EXTENSIONS:\n58:             items = _process_pdf_file(filepath, api_key, base_url)\n59:         else:\n60:             raise ValueError(\n61:                 f\"❌ امتداد الملف غير مدعوم: {ext}\\n\"\n62:                 f\"  الامتدادات المدعومة: \"\n63:                 f\"{', '.join(sorted(_EXCEL_EXTENSIONS | _PDF_EXTENSIONS))}\"\n64:             )\n65: \n66:         results[filepath.name] = items\n67:         print(f\"  📊 إجمالي العناصر المستخرجة: {len(items)}\")\n68: \n69:     total = sum(len(items) for items in results.values())\n70:     print(f\"\\n{'='*60}\")\n71:     print(f\"✅ اكتملت معالجة {role_label}: {total} عنصر من {len(filepaths)} ملف\")\n72:     print(f\"{'='*60}\\n\")\n73: \n74:     return results\n75: \n76: \n77: def _process_excel_file(filepath: Path) -> list[dict]:\n78:     \"\"\"معالجة ملف Excel واستخراج أسماء الأصناف.\"\"\"\n79:     rows = read_excel(filepath)\n80:     items = extract_item_names(rows, source_file=filepath.name)\n81:     return items\n82: \n83: \n84: def _process_pdf_file(\n85:     filepath: Path,\n86:     api_key: str | None,\n87:     base_url: str,\n88: ) -> list[dict]:\n89:     \"\"\"معالجة ملف PDF واستخراج أسماء الأصناف.\"\"\"\n90:     if not api_key:\n91:         raise ValueError(\n92:             f\"❌ مفتاح Unstructured API مطلوب لمعالجة ملفات PDF.\\n\"\n93:             f\"  يرجى تعيين UNSTRUCTURED_API_KEY في ملف .env\"\n94:         )\n95: \n96:     items = extract_items_from_pdf(filepath, api_key, base_url)\n97:     return items\n98: \nThe above content shows the entire, complete file contents of the requested file.\n"}
