or entry in extracted[key]:\n236:                         if isinstance(entry, dict):\n237:                             name = (\n238:                                 entry.get(\"name\")\n239:                                 or entry.get(\"item_name\")\n240:                                 or entry.get(\"text\", \"\")\n241:                             )\n242:                         else:\n243:                             name = str(entry)\n244:                         name = str(name).strip()\n245:                         if name:\n246:                             page = elem.get(\"metadata\", {}).get(\"page_number\")\n247:                             items.append({\"item_name_raw\": name, \"source_page\": page})\n248: \n249:     return items\n250: \n251: \n252: def _try_html_tables(elements: list[dict]) -> list[dict]:\n253:     \"\"\"\n254:     محاولة استخراج الأصناف من جداول HTML في عناصر Table.\n255: \n256:     يبحث عن العمود الذي يحتوي على أسماء الأدوية (نص عربي أو أطول النصوص).\n257:     \"\"\"\n258:     items: list[dict] = []\n259:     arabic_pattern = re.compile(r\"[\\u0600-\\u06FF]\")\n260: \n261:     for elem in elements:\n262:         if elem.get(\"type\") != \"Table\":\n263:             continue\n264: \n265:         html = elem.get(\"metadata\", {}).get(\"text_as_html\", \"\")\n266:         if not html:\n267:             continue\n268: \n269:         page = elem.get(\"metadata\", {}).get(\"page_number\")\n270:         table_items = _parse_html_table(html, arabic_pattern)\n271: \n272:         for name in table_items:\n273:             items.append({\"item_name_raw\": name, \"source_page\": page})\n274: \n275:     return items\n276: \n277: \n278: def _parse_html_table(html: str, arabic_pattern: re.Pattern) -> list[str]:\n279:     \"\"\"\n280:     تحليل جدول HTML بسيط واستخراج أسماء الأدوية.\n281: \n282:     يبحث عن العمود الذي يحتوي على نصوص عربية أو أطول النصوص.\n283:     \"\"\"\n284:     # استخراج الصفوف: كل <tr>...</tr>\n285:     row_pattern = re.compile(r\"<tr[^>]*>(.*?)</tr>\", re.DOTALL | re.IGNORECASE)\n286:     cell_pattern = re.compile(r\"<t[dh][^>]*>(.*?)</t[dh]>\", re.DOTALL | re.IGNORECASE)\n287:     tag_stripper = re.compile(r\"<[^>]+>\")\n288: \n289:     rows_html = row_pattern.findall(html)\n290:     if not rows_html:\n291:         return []\n292: \n293:     # تحليل جميع الصفوف إلى قائمة من قوائم الخلايا\n294:     parsed_rows: list[list[str]] = []\n295:     for row_html in rows_html:\n296:         cells = cell_pattern.findall(row_html)\n297:         cleaned = [tag_stripper.sub(\"\", c).strip() for c in cells]\n298:         parsed_rows.append(cleaned)\n299: \n300:     if len(parsed_rows) < 2:\n301:         return []\n302: \n303:     # تحديد عدد الأعمدة\n304:     num_cols = max(len(row) for row in parsed_rows)\n305:     if num_cols == 0:\n306:         return []\n307: \n308:     # البحث عن عمود أسماء الأدوية\n309:     # تخطي الصف الأول (عناوين) وفحص بقية الصفوف\n310:     data_rows = parsed_rows[1:]\n311:     best_col = 0\n312:     best_score = -1\n313: \n314:     for col_idx in range(num_cols):\n315:         score = 0\n316:         for row in data_rows:\n317:             if col_idx >= len(row):\n318:                 continue\n319:             cell_text = row[col_idx]\n320:             arabic_count = len(arabic_pattern.findall(cell_text))\n321:             if arabic_count > 0:\n322:                 score += len(cell_text) * (arabic_count / max(len(cell_text), 1))\n323: \n324:         if score > best_score:\n325:             best_score = score\n326:             best_col = col_idx\n327: \n328:     # إذا لم يُعثر على نص عربي، اختيار العمود الأطول\n329:     if best_score <= 0:\n330:         col_lengths = [0] * num_cols\n331:         for row in data_rows:\n332:             for col_idx, cell in enumerate(row):\n333:                 col_lengths[col_idx] += len(cell)\n334:         best_col = col_lengths.index(max(col_lengths)) if col_lengths else 0\n335: \n336:     # استخراج القيم من العمود المحدد\n337:     names: list[str] = []\n338:     for row in data_rows:\n339:         if best_col < len(row):\n340:             name = row[best_col].strip()\n341:             if name:\n342:                 names.append(name)\n343: \n344:     return names\n345: \n346: \n347: def _try_text_content(elements: list[dict]) -> list[dict]:\n348:     \"\"\"\n349:     محاولة استخراج الأصناف من المحتوى النصي.\n350: \n351:     يجمع النصوص من عناصر NarrativeText وTitle ويفصلها بالأسطر.\n352:     \"\"\"\n353:     items: list[dict] = []\n354:     arabic_pattern = re.compile(r\"[\\u0600-\\u06FF]\")\n355: \n356:     for elem in elements:\n357:         elem_type = elem.get(\"type\", \"\")\n358:         if elem_type not in (\"NarrativeText\", \"Title\", \"ListItem\", \"UncategorizedText\"):\n359:             continue\n360: \n361:         text = elem.get(\"text\", \"\").strip()\n362:         if not text:\n363:             continue\n364: \n365:         page = elem.get(\"metadata\", {}).get(\"page_number\")\n366: \n367:         # تقسيم النص إلى أسطر وفحص كل سطر\n368:         for line in text.split(\"\\n\"):\n369:             line = line.strip()\n370:             if not line or len(line) < 3:\n371:                 continue\n372: \n373:             # قبول الأسطر التي تحتوي على نص عربي أو أسماء أدوية (حروف لاتينية + أرقام)\n374:             has_arabic = bool(arabic_pattern.search(line))\n375:             has_drug_chars = bool(re.search(r\"[a-zA-Z]{3,}\", line))\n376: \n377:             if has_arabic or has_drug_chars:\n378:                 items.append({\"item_name_raw\": line, \"source_page\": page})\n379: \n380:     return items\n381: \nThe above content shows the entire, complete file contents of the requested file.\n"}
