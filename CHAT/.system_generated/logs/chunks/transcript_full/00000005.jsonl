{"step_index":95,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-21T15:38:31Z","content":"Created At: 2026-09-21T18:38:31+03:00\nCompleted At: 2026-09-21T18:38:32+03:00\nFile Path: `file:///d:/AI_Engineer/Pharmacy-agy/src/match/text_match.py`\nTotal Lines: 148\nTotal Bytes: 5191\nShowing lines 1 to 148\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"\"\"\n2: وحدة تنظيف النصوص والمطابقة الضبابية لأسماء الأدوية العربية.\n3: Text cleaning and fuzzy matching for Arabic drug names.\n4: \"\"\"\n5: \n6: import re\n7: import unicodedata\n8: from rapidfuzz import fuzz\n9: \n10: \n11: # ──────────────────────────────────────────────\n12: # خريطة الأرقام العربية-الهندية إلى الأرقام الغربية\n13: # ──────────────────────────────────────────────\n14: _ARABIC_INDIC_MAP = str.maketrans(\n15:     \"٠١٢٣٤٥٦٧٨٩\",\n16:     \"0123456789\",\n17: )\n18: \n19: # أحرف الألف المختلفة → ا\n20: _ALEF_VARIANTS = re.compile(r\"[أإآٱ]\")\n21: \n22: # التشكيل (الفتحة، الضمة، الكسرة، السكون، الشدة، التنوين)\n23: _TASHKEEL = re.compile(\n24:     r\"[\\u0610-\\u061A\\u064B-\\u065F\\u0670\\u06D6-\\u06DC\"\n25:     r\"\\u06DF-\\u06E4\\u06E7\\u06E8\\u06EA-\\u06ED]\"\n26: )\n27: \n28: # التطويل / الكشيدة\n29: _TATWEEL = \"\\u0640\"\n30: \n31: \n32: def normalize_text(text: str) -> str:\n33:     \"\"\"\n34:     تنظيف وتوحيد نص اسم الدواء العربي للمقارنة.\n35: \n36:     الخطوات:\n37:       1. تحويل الأرقام العربية-الهندية (٠-٩) إلى غربية (0-9)\n38:       2. إزالة التطويل/الكشيدة (ـ)\n39:       3. إزالة التشكيل (الحركات)\n40:       4. توحيد أشكال الألف (أ، إ، آ → ا)\n41:       5. تحويل التاء المربوطة (ة → ه) لأغراض البحث\n42:       6. توحيد المسافات (مسافات متعددة → مسافة واحدة)\n43:       7. حذف المسافات من البداية والنهاية\n44: \n45:     ملاحظة: لا يتم حذف أي كلمات أو اختصارات أو أرقام.\n46: \n47:     Args:\n48:         text: النص الأصلي لاسم الدواء.\n49: \n50:     Returns:\n51:         النص بعد التنظيف والتوحيد.\n52:     \"\"\"\n53:     if not text:\n54:         return \"\"\n55: \n56:     # 1. تحويل الأرقام العربية-الهندية إلى غربية\n57:     result = text.translate(_ARABIC_INDIC_MAP)\n58: \n59:     # 2. إزالة التطويل/الكشيدة\n60:     result = result.replace(_TATWEEL, \"\")\n61: \n62:     # 3. إزالة التشكيل\n63:     result = _TASHKEEL.sub(\"\", result)\n64: \n65:     # 4. توحيد أشكال الألف\n66:     result = _ALEF_VARIANTS.sub(\"ا\", result)\n67: \n68:     # 5. تحويل التاء المربوطة إلى هاء\n69:     result = result.replace(\"ة\", \"ه\")\n70: \n71:     # 6. توحيد المسافات\n72:     result = re.sub(r\"\\s+\", \" \", result)\n73: \n74:     # 7. حذف المسافات من البداية والنهاية\n75:     result = result.strip()\n76: \n77:     return result\n78: \n79: \n80: def find_candidates(\n81:     query: str,\n82:     items: list[str],\n83:     threshold: float = 0.60,\n84:     max_results: int = 5,\n85: ) -> list[tuple[str, float]]:\n86:     \"\"\"\n87:     البحث عن أقرب المرشحين لاسم دواء باستخدام المطابقة الضبابية.\n88: \n89:     يستخدم كلاً من token_sort_ratio و partial_ratio من مكتبة rapidfuzz\n90:     ويأخذ الأعلى بينهما لكل عنصر.\n91: \n92:     Args:\n93:         query: اسم الدواء المطلوب البحث عنه.\n94:         items: قائمة أسماء الأدوية المتاحة في المخزن.\n95:         threshold: الحد الأدنى لدرجة التشابه (0.0 إلى 1.0).\n96:         max_results: الحد الأقصى لعدد النتائج المُرجَعة.\n97: \n98:     Returns:\n99:         قائمة من (اسم_الدواء_الأصلي, درجة_التشابه) مرتبة تنازلياً.\n100:         الدرجة من 0.0 إلى 1.0.\n101:     \"\"\"\n102:     if not query or not items:\n103:         return []\n104: \n105:     normalized_query = normalize_text(query)\n106:     scored: list[tuple[str, float]] = []\n107: \n108:     for original_item in items:\n109:         normalized_item = normalize_text(original_item)\n110: \n111:         # حساب درجة التشابه بطريقتين واختيار الأعلى\n112:         score_token = fuzz.token_sort_ratio(normalized_query, normalized_item)\n113:         score_partial = fuzz.partial_ratio(normalized_query, normalized_item)\n114:         best_score = max(score_token, score_partial)\n115: \n116:         # تحويل الدرجة من 0-100 إلى 0-1\n117:         normalized_score = best_score / 100.0\n118: \n119:         if normalized_score >= threshold:\n120:             scored.append((original_item, normalized_score))\n121: \n122:     # ترتيب تنازلي حسب الدرجة وأخذ أعلى النتائج\n123:     scored.sort(key=lambda x: x[1], reverse=True)\n124:     return scored[:max_results]\n125: \n126: \n127: def quick_match(query: str, item: str) -> float:\n128:     \"\"\"\n129:     حساب سريع لدرجة التشابه بين اسمي دواء.\n130: \n131:     Args:\n132:         query: اسم الدواء الأول.\n133:         item: اسم الدواء الثاني.\n134: \n135:     Returns:\n136:         درجة التشابه من 0.0 إلى 1.0.\n137:     \"\"\"\n138:     if not query or not item:\n139:         return 0.0\n140: \n141:     normalized_query = normalize_text(query)\n142:     normalized_item = normalize_text(item)\n143: \n144:     score_token = fuzz.token_sort_ratio(normalized_query, normalized_item)\n145:     score_partial = fuzz.partial_ratio(normalized_query, normalized_item)\n146: \n147:     return max(score_token, score_partial) / 100.0\n148: \nThe above content shows the entire, complete file contents of the requested file.\n"}
