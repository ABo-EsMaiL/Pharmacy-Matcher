ni_api_key=gemini_api_key,\n94:             profile=profile\n95:         )\n96:         results[fname] = items\n97: \n98:     total = sum(len(items) for items in results.values())\n99:     print(f\"\\n{'='*60}\")\n100:     print(f\"[+] Completed {role_label}: {total} items from {len(results)} file(s)\")\n101:     print(f\"{'='*60}\\n\")\n102: \n103:     return results\n104: \n105: \n106: def _process_excel_file(filepath: Path) -> list[dict]:\n107:     rows = read_excel(filepath)\n108:     items = extract_item_names(rows, source_file=filepath.name)\n109:     return items\n110: \n111: \n112: def _process_markdown_file(filepath: Path) -> list[dict]:\n113:     return read_markdown_file(filepath)\n114: \n115: \n116: def _process_pdf_file(\n117:     filepath: Path,\n118:     vision_api_url: str = \"http://127.0.0.1:8001/v1/chat/completions\",\n119:     vision_api_key: str = \"[REDACTED_CREDENTIAL]\",\n120:     vision_model: str = \"gemini-3.8-flash\",\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
