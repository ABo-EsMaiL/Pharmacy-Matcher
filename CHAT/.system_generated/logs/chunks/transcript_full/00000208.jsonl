{"step_index":10098,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-25T14:09:35Z","thinking":"The state variable `isProcessRunning` must be updated to reflect whether a process is active. When a process starts, the visual badge indicating activity needs to become visible; conversely, upon process completion or error, the badge must be hidden. This ensures real-time visual feedback on process status.\n\n\n","tool_calls":[{"name":"replace_file_content","args":{"AllowMultiple":false,"Description":"Update top-bar-process-badge in submitProcess and process events","EndLine":2765,"Instruction":"Sync top-bar-process-badge visibility and text with process lifecycle","ReplacementContent":"    // UI Loading state\n    isProcessRunning = true;\n    const topBarBadge = document.getElementById('top-bar-process-badge');\n    if (topBarBadge) topBarBadge.style.display = 'inline-flex';\n\n    if (btn) {\n        btn.classList.add('hidden');\n        btn.style.display = 'none';\n    }\n    if (progressModal) {\n        progressModal.style.display = 'flex';\n    }\n    document.getElementById('progress-text').innerText = t.progress_init;\n    document.getElementById('progress-bar-fill').style.width = '5%';\n    startProgressTimer();\n    \n    const termEl = document.getElementById('pipeline-log-terminal');\n    if (termEl) termEl.innerHTML = '[System] Started pipeline...\\n';\n    \n    try {\n        const res = await window.pywebview.api.start_process(\n            JSON.stringify(selectedShortageFiles), \n            JSON.stringify(selectedWarehouseFiles)\n        );\n        if (res.success) {\n            currentProcessId = res.process_id;\n            \n            if (res.queued) {\n                isProcessRunning = false;\n                if (topBarBadge) topBarBadge.style.display = 'none';\n                if (btn) {\n                    btn.classList.remove('hidden');\n                    btn.style.display = '';\n                }\n                if (progressModal) {\n                    progressModal.style.display = 'none';\n                }\n                stopProgressTimer();\n                \n                selectedShortageFiles = [];\n                selectedWarehouseFiles = [];\n                renderFileList('shortages-list', selectedShortageFiles, 'shortages');\n                renderFileList('warehouses-list', selectedWarehouseFiles, 'warehouses');\n                updateSubmitButton();\n                \n                const queueMsg = currentLang === 'en'\n                    ? `Process added to queue (Position #${res.position || 1}). It will start automatically once the current process completes.`\n                    : `تمت إضافة العملية إلى قائمة الانتظار (الترتيب #${res.position || 1})، وستبدأ تلقائياً فور انتهاء العملية الحالية.`;\n                showToast(queueMsg, 'info');\n                loadHistory();\n                return;\n            }\n\n            // If the backend detected an identical exact match that was already completed!\n            if (res.existing) {\n                showToast(t.process_existing, 'info');\n                // Simulate process_complete event\n                setTimeout(() => {\n                    window.dispatchEvent(new CustomEvent('process_complete', {\n                        detail: {\n                            process_id: res.process_id,\n                            success: true,\n                            stats: res.stats\n                        }\n                    }));\n                }, 500);\n            } else {\n                // Background process started\n                showToast(t.toast_started, 'success');\n            }\n        } else {\n            isProcessRunning = false;\n            if (topBarBadge) topBarBadge.style.display = 'none';\n            showToast((currentLang === 'en' ? 'Error: ' : 'خطأ: ') + res.error, 'error');\n            if (btn) {\n                btn.classList.remove('hidden');\n                btn.style.display = '';\n            }\n            if (progressModal) {\n                progressModal.style.display = 'none';\n            }\n            stopProgressTimer();\n        }\n    } catch (error) {\n        isProcessRunning = false;\n        if (topBarBadge) topBarBadge.style.display = 'none';\n        showToast(currentLang === 'en' ? 'Connection error' : 'حدث خطأ أثناء الاتصال', 'error');\n        if (btn) {\n            btn.classList.remove('hidden');\n            btn.style.display = '';\n        }\n        if (progressModal) {\n            progressModal.style.display = 'none';\n        }\n        stopProgressTimer();\n    }\n}\n\n// --- Process Events ---\nwindow.addEventListener('process_update', (e) => {\n    const data = e.detail;\n    const progressModal = document.getElementById('progress-modal');\n    const topBarMsg = document.getElementById('top-bar-process-text');\n    if (topBarMsg && data.message) {\n        topBarMsg.innerText = data.message;\n    }\n\n    if (progressModal && progressModal.style.display === 'flex' && data.process_id === currentProcessId) {\n        const msgEl = document.getElementById('progress-text');\n        \n        if (msgEl && data.message) {\n            msgEl.innerText = data.message;\n        }\n        \n        const pb = document.getElementById('progress-bar-fill');\n        if (pb && data.message) {\n            // Very simple heuristic to advance progress bar based on text\n            let pct = 10;\n            if (data.message.includes('استخراج') || data.message.includes('Extracting')) pct = 30;\n            if (data.message.includes('مطابقة') || data.message.includes('Matching')) pct = 60;\n            if (data.message.includes('حفظ') || data.message.includes('Saving')) pct = 90;\n            pb.style.width = pct + '%';\n        }\n    }\n});\n\nwindow.addEventListener('process_complete', (e) => {\n    const data = e.detail;\n    isProcessRunning = false;\n    const topBarBadge = document.getElementById('top-bar-process-badge');\n    if (topBarBadge) topBarBadge.style.display = 'none';\n\n    if (typeof loadHistory === 'function') {\n        loadHistory();\n    }","StartLine":2650,"TargetContent":"    // UI Loading state\n    isProcessRunning = true;\n    if (btn) {\n        btn.classList.add('hidden');\n        btn.style.display = 'none';\n    }\n    if (progressModal) {\n        progressModal.style.display = 'flex';\n    }\n    document.getElementById('progress-text').innerText = t.progress_init;\n    document.getElementById('progress-bar-fill').style.width = '5%';\n    startProgressTimer();\n    \n    const termEl = document.getElementById('pipeline-log-terminal');\n    if (termEl) termEl.innerHTML = '[System] Started pipeline...\\n';\n    \n    try {\n        const res = await window.pywebview.api.start_process(\n            JSON.stringify(selectedShortageFiles), \n            JSON.stringify(selectedWarehouseFiles)\n        );\n        if (res.success) {\n            currentProcessId = res.process_id;\n            \n            if (res.queued) {\n                isProcessRunning = false;\n                if (btn) {\n                    btn.classList.remove('hidden');\n                    btn.style.display = '';\n                }\n                if (progressModal) {\n                    progressModal.style.display = 'none';\n                }\n                stopProgressTimer();\n                \n                selectedShortageFiles = [];\n                selectedWarehouseFiles = [];\n                renderFileList('shortages-list', selectedShortageFiles, 'shortages');\n                renderFileList('warehouses-list', selectedWarehouseFiles, 'warehouses');\n                updateSubmitButton();\n                \n                const queueMsg = currentLang === 'en'\n                    ? `Process added to queue (Position #${res.position || 1}). It will start automatically once the current process completes.`\n                    : `تمت إضافة العملية إلى قائمة الانتظار (الترتيب #${res.position || 1})، وستبدأ تلقائياً فور انتهاء العملية الحالية.`;\n                showToast(queueMsg, 'info');\n                loadHistory();\n                return;\n            }\n\n            // If the backend detected an identical exact match that was already completed!\n            if (res.existing) {\n                showToast(t.process_existing, 'info');\n                // Simulate process_complete event\n                setTimeout(() => {\n                    window.dispatchEvent(new CustomEvent('process_complete', {\n                        detail: {\n                            process_id: res.process_id,\n                            success: true,\n                            stats: res.stats\n                        }\n                    }));\n                }, 500);\n            } else {\n                // Background process started\n                showToast(t.toast_started, 'success');\n            }\n        } else {\n            isProcessRunning = false;\n            showToast((currentLang === 'en' ? 'Error: ' : 'خطأ: ') + res.error, 'error');\n            if (btn) {\n                btn.classList.remove('hidden');\n                btn.style.display = '';\n            }\n            if (progressModal) {\n                progressModal.style.display = 'none';\n            }\n            stopProgressTimer();\n        }\n    } catch (error) {\n        isProcessRunning = false;\n        showToast(currentLang === 'en' ? 'Connection error' : 'حدث خطأ أثناء الاتصال', 'error');\n        if (btn) {\n            btn.classList.remove('hidden');\n            btn.style.display = '';\n        }\n        if (progressModal) {\n            progressModal.style.display = 'none';\n        }\n        stopProgressTimer();\n    }\n}\n\n// --- Process Events ---\nwindow.addEventListener('process_update', (e) => {\n    const data = e.detail;\n    const progressModal = document.getElementById('progress-modal');\n    if (progressModal && progressModal.style.display === 'flex' && data.process_id === currentProcessId) {\n        const msgEl = document.getElementById('progress-text');\n        \n        if (msgEl && data.message) {\n            msgEl.innerText = data.message;\n        }\n        \n        const pb = document.getElementById('progress-bar-fill');\n        if (pb && data.message) {\n            // Very simple heuristic to advance progress bar based on text\n            let pct = 10;\n            if (data.message.includes('استخراج') || data.message.includes('Extracting')) pct = 30;\n            if (data.message.includes('مطابقة') || data.message.includes('Matching')) pct = 60;\n            if (data.message.includes('حفظ') || data.message.includes('Saving')) pct = 90;\n            pb.style.width = pct + '%';\n        }\n    }\n});\n\nwindow.addEventListener('process_complete', (e) => {\n    const data = e.detail;\n    isProcessRunning = false;\n    if (typeof loadHistory === 'function') {\n        loadHistory();\n    }","TargetFile":"d:\\AI_Engineer\\Pharmacy-agy-vision\\desktop_app\\templates\\index.html","toolAction":"Updating submitProcess and events","toolSummary":"Sync process badge with process lifecycle"}}]}
