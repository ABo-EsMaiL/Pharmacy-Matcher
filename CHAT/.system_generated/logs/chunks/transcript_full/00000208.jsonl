if ext in _MARKDOWN_EXTENSIONS:\n39:             items = _process_markdown_file(filepath)\n40:         elif ext in _PDF_EXTENSIONS:\n41:             items = _process_pdf_file(\n42:                 filepath,\n43:                 vision_api_url=vision_api_url,\n44:                 vision_api_key=vision_api_key,\n45:                 vision_model=vision_model,\n46:                 legacy_api_key=api_key,\n47:                 legacy_base_url=base_url\n48:             )\n49:         elif ext in _JSON_EXTENSIONS:\n50:             items = _process_json_file(filepath)\n51:         else:\n52:             print(f\"[!] Unsupported extension: {ext} for {filepath.name}\")\n53:             return filepath.name, []\n54: \n55:         print(f\"  -> [DONE] {filepath.name}: {len(items)} items extracted.\")\n56:         return filepath.name, items\n57:     except Exception as e:\n58:         print(f\"[!] Exception processing {filepath.name}: {e}\")\n59:         return filepath.name, []\n60: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
