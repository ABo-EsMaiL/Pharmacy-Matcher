                     job_res = client.jobs.get(job_id)\n180:                         if hasattr(job_res, 'model_dump'):\n181:                             job_data = job_res.model_dump()\n182:                         elif hasattr(job_res, '__dict__'):\n183:                             job_data = job_res.__dict__\n184:                         else:\n185:                             job_data = dict(job_res)\n186:                     except Exception as poll_err:\n187:                         print(f\"[*] Polling note ({filepath.name}): {poll_err}\")\n188:                         continue\n189: \n190:                     cur_status = str(job_data.get(\"status\", \"\")).lower()\n191:                     if \"completed\" in cur_status:\n192:                         result_data = job_data\n193:                         break\n194:                     elif \"failed\" in cur_status or \"error\" in cur_status:\n195:                         err_text = str(job_data.get(\"error\", \"\"))\n196:                         print(f\"[!] Server job failed for {filepath.name}: {err_text}\")\n197:                         return []\n198: \n199:                     if attempts % 3 == 0:\n200:                         print(f\"[*] {filepath.name} status: {job_data.get('status')} ... ({attempts * 8}s)\")\n201: \n202:                 if attempts >= 180:\n203:                     print(f\"[!] Timeout reached (24 minutes) for {filepath.name}. Continuing with remaining files...\")\n204:                     return []\n205: \n206:         items = parse_structured_result(result_data, filepath.name)\n207: \n208:         # Cache only if items extracted\n209:         if len(items) > 0:\n210:             with open(cache_file, \"w\", encoding=\"utf-8\") as f:\n211:                 json.dump(result_data, f, ensure_ascii=False, indent=2, default=str)\n212:             print(f\"[+] Saved valid local cache for: {filepath.name} ({len(items)} items)\")\n213: \n214:         # Save local json copy\n215:         json_path = filepath.with_suffix(\".json\")\n216:         try:\n217:             with open(json_path, \"w\", encoding=\"utf-8\") as f:\n218:                 json.dump(result_data, f, ensure_ascii=False, indent=2, default=str)\n219:         except Exception:\n220:             pass\n221: \n222:         print(f\"[+] Successfully extracted {len(items)} items from {filepath.name}\")\n223:         return items\n224: \n225:     except Exception as e:\n226:         print(f\"[!] Extraction error for {filepath.name}: {e}\")\n227:         return []\n228: \n229: def parse_structured_result(result_data: dict, filename: str) -> list[dict]:\n230:     \"\"\"\n231:     Parse structured items from extraction response.\n232:     Supports:\n233:     1. Direct extracted_data / job.result.extracted_data (JSON schema output)\n234:     2. Markdown HTML tables in result_data[\"markdown\"] (Fallback table output)\n235:     \"\"\"\n236:     import re\n237:     items = []\n238:     if not isinstance(result_data, dict):\n239:         return items\n240: \n241:     # If wrapped in job result (e.g. from client.jobs.get)\n242:     if \"result\" in result_data and isinstance(result_data[\"result\"], dict):\n243:         result_data = result_data[\"result\"]\n244: \n245:     # 1. Try extracted_data (schema output)\n246:     extracted_data = result_data.get(\"extracted_data\", [])\n247:     if isinstance(extracted_data, list) and len(extracted_data) > 0:\n248:         for block in extracted_data:\n249:             data = block.get(\"data\", {}) if isinstance(block, dict) else getattr(block, \"data\", {})\n250:             if isinstance(data, dict) and \"items\" in data:\n251:                 for item in data.get(\"items\", []):\n252:                     if not isinstance(item, dict):\n253:                         continue\n254:                     name = item.get(\"item_name_raw\")\n255:                     if name:\n256:                         items.append({\n257:                             \"item_name_raw\": str(name).strip(),\n258:                             \"source_page\": item.get(\"source_page\"),\n259:                             \"source_file\": filename\n260:                         })\n261: \n262:     # 2. Try markdown HTML tables if no items extracted yet\n263:     if not items and \"markdown\" in result_data and result_data[\"markdown\"]:\n264:         md = str(result_data[\"markdown\"])\n265:         rows = re.findall(r\"<tr>(.*?)</tr>\", md, re.DOTALL | re.IGNORECASE)\n266:         if rows:\n267:             name_col_idx = 1\n268:             header_cells = [re.sub(r\"<.*?>\", \"\", c).strip() for c in re.findall(r\"<t[dh].*?>(.*?)</t[dh]>\", rows[0], re.DOTALL | re.IGNORECASE)]\n269:             for idx, col in enumerate(header_cells):\n270:                 col_lower = col.lower()\n271:                 if any(k in col_lower for k in [\"اسم الصنف\", \"اسم الدواء\", \"item name\", \"product name\", \"description\", \"اسم\"]):\n272:                     if not any(nk in col_lower for nk in [\"رقم\", \"كود\", \"code\", \"id\", \"number\"]):\n273:                         name_col_idx = idx\n274:                         break\n275: \n276:             for r in rows[1:]:\n277:                 cells = [re.sub(r\"<.*?>\", \"\", c).strip() for c in re.findall(r\"<t[dh].*?>(.*?)</t[dh]>\", r, re.DOTALL | re.IGNORECASE)]\n278:                 if len(cells) > name_col_idx:\n279:                     val = cells[name_col_idx]\n280:                     if val and not val.isdigit() and len(val) >= 2 and val not in header_cells:\n281:                         items.append({\n282:                             \"item_name_raw\": val,\n283:                             \"source_page\": None,\n284:                             \"source_file\": filename\n285:                         })\n286: \n287:     return items\n288: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this