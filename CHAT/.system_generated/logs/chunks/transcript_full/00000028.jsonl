{"step_index":911,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-22T00:56:57Z","tool_calls":[{"name":"replace_file_content","args":{"AllowMultiple":false,"Description":"Add Gemini fallback in parse_items_from_response","EndLine":349,"Instruction":"Add gemini fallback into parse_items_from_response","ReplacementContent":"def parse_items_from_response(response: dict | list, gemini_api_key: str = None) -> list[dict]:\n    elements = _normalize_response(response)\n\n    items = _try_extracted_data(elements)\n    if items:\n        print(f\"     -> Extracted {len(items)} items from structured data\")\n        return items\n\n    items = _try_html_tables(elements)\n    if items and len(items) > 5:\n        print(f\"     -> Extracted {len(items)} items from HTML tables\")\n        return items\n\n    # Fallback to Gemini if normal extraction fails or extracts very few items\n    if gemini_api_key:\n        print(f\"     -> Basic extraction yielded {len(items)} items. Attempting Gemini AI extraction...\")\n        gemini_items = _extract_with_gemini(elements, gemini_api_key)\n        if gemini_items:\n            print(f\"     -> Extracted {len(gemini_items)} items using Gemini AI\")\n            return gemini_items\n\n    items = _try_text_content(elements)\n    print(f\"     -> Extracted {len(items)} items from raw text content\")\n    return items\n\ndef _extract_with_gemini(elements: list[dict], api_key: str) -> list[dict]:\n    try:\n        from google import genai\n        client = genai.Client(api_key=api_key)\n        \n        # Collect all raw text from the elements\n        full_text = \"\\n\".join([elem.get(\"text\", \"\").strip() for elem in elements if elem.get(\"text\")])\n        if not full_text.strip():\n            return []\n            \n        prompt = f\"\"\"\n        أنت مساعد ذكي متخصص في قراءة فواتير ونواقص الأدوية والصيدليات.\n        مرفق لك النص الخام المستخرج من ملف PDF.\n        قم باستخراج جميع أسماء الأدوية والأصناف الموجودة في هذا النص.\n        أرجع النتيجة **فقط** على شكل مصفوفة JSON تحتوي على أسماء الأدوية كنصوص (Strings).\n        لا تقم بإضافة أي نصوص أخرى، أو markdown tags مثل ```json، فقط المصفوفة.\n        \n        النص:\n        {full_text[:35000]}\n        \"\"\"\n        \n        response = client.models.generate_content(\n            model='gemini-2.5-flash',\n            contents=prompt,\n        )\n        text = response.text.strip()\n        \n        # Clean markdown\n        if text.startswith('```json'): text = text[7:-3]\n        elif text.startswith('```'): text = text[3:-3]\n        \n        import json\n        extracted = json.loads(text.strip())\n        \n        items = []\n        for name in extracted:\n            if isinstance(name, str) and name.strip():\n                items.append({\"item_name_raw\": name.strip(), \"source_page\": 1})\n        return items\n    except Exception as e:\n        print(f\"     -> Gemini extraction failed: {e}\")\n        return []\n\ndef extract_items_from_pdf(\n    filepath: Path,\n    api_key: str,\n    base_url: str = \"https://transform.unstructured.io\",\n    gemini_api_key: str = None,\n) -> list[dict]:","StartLine":327,"TargetContent":"def parse_items_from_response(response: dict | list) -> list[dict]:\n    elements = _normalize_response(response)\n\n    items = _try_extracted_data(elements)\n    if items:\n        print(f\"     -> Extracted {len(items)} items from structured data\")\n        return items\n\n    items = _try_html_tables(elements)\n    if items:\n        print(f\"     -> Extracted {len(items)} items from HTML tables\")\n        return items\n\n    items = _try_text_content(elements)\n    print(f\"     -> Extracted {len(items)} items from raw text content\")\n    return items\n\n\ndef extract_items_from_pdf(\n    filepath: Path,\n    api_key: str,\n    base_url: str = \"https://transform.unstructured.io\",\n) -> list[dict]:","TargetFile":"d:\\AI_Engineer\\Pharmacy-agy\\src\\ext