{"step_index":918,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-22T00:57:48Z","content":"Created At: 2026-09-22T03:57:48+03:00\nCompleted At: 2026-09-22T03:57:48+03:00\nFile Path: `file:///C:/Users/kakak/.gemini/antigravity/brain/916274de-7f92-49fc-a0a8-d291664b474a/.system_generated/tasks/task-916.log`\nTotal Lines: 234\nTotal Bytes: 8753\nShowing lines 1 to 234\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \r\n2:     Returns:\r\n3:         قائمة من القواميس بالشكل:\r\n4:         {\"item_name_raw\": str, \"source_page\": int|None, \"source_file\": str}\r\n5:     \"\"\"\r\n6:     filepath = Path(filepath)\r\n7: \r\n8:     # استخراج البيانات من PDF\r\n9:     result = extract_from_pdf(filepath, api_key, base_url)\r\n10: \r\n11:     # تحليل الاستجابة\r\n12:     items = parse_items_from_response(result, gemini_api_key)\r\n13: \r\n14:     # إضافة اسم الملف المصدر لكل عنصر\r\n15:     for item in items:\r\n16:         item[\"source_file\"] = filepath.name\r\n17: \r\n18:     return items\r\n19: \r\n20: \r\n21: # ──────────────────────── دوال مساعدة داخلية ────────────────────────\r\n22: \r\n23: \r\n24: def _poll_for_result(poll_url: str, headers: dict) -> dict:\r\n25:     \"\"\"\r\n26:     الاستعلام المتكرر عن حالة مهمة غير متزامنة حتى اكتمالها.\r\n27:     \"\"\"\r\n28:     for attempt in range(1, _MAX_POLL_ATTEMPTS + 1):\r\n29:         time.sleep(_POLL_INTERVAL_SECONDS)\r\n30:         resp = requests.get(poll_url, headers=headers)\r\n31: \r\n32:         if resp.status_code != 200:\r\n33:             print(f\"  ⚠️ خطأ في الاستعلام (محاولة {attempt}): {resp.status_code}\")\r\n34:             continue\r\n35: \r\n36:         data = resp.json()\r\n37:         status = data.get(\"status\", \"\")\r\n38: \r\n39:         if status == \"completed\":\r\n40:             print(f\"  ✅ اكتملت المهمة (بعد {attempt * _POLL_INTERVAL_SECONDS} ثانية)\")\r\n41:             # النتائج قد تكون في data[\"elements\"] أو data نفسه\r\n42:             return data.get(\"elements\", data)\r\n43: \r\n44:         if status in (\"failed\", \"error\"):\r\n45:             raise RuntimeError(\r\n46:                 f\"❌ فشلت مهمة Unstructured API: {data.get('error', 'خطأ غير معروف')}\"\r\n47:             )\r\n48: \r\n49:         print(\r\n50:             f\"  ⏳ الحالة: {status} (محاولة {attempt}/{_MAX_POLL_ATTEMPTS})\"\r\n51:         )\r\n52: \r\n53:     raise RuntimeError(\r\n54:         f\"❌ انتهت مهلة الانتظار ({_MAX_POLL_ATTEMPTS * _POLL_INTERVAL_SECONDS} ثانية) \"\r\n55:         f\"للمهمة غير المتزامنة\"\r\n56:     )\r\n57: \r\n58: \r\n59: def _normalize_response(response: dict | list) -> list[dict]:\r\n60:     \"\"\"تحويل الاستجابة إلى قائمة عناصر موحدة.\"\"\"\r\n61:     if isinstance(response, list):\r\n62:         return response\r\n63:     if isinstance(response, dict):\r\n64:         # قد تكون العناصر في مفتاح 'elements' أو الاستجابة نفسها عنصر واحد\r\n65:         if \"elements\" in response:\r\n66:             return response[\"elements\"]\r\n67:         return [response]\r\n68:     return []\r\n69: \r\n70: \r\n71: def _try_extracted_data(elements: list[dict]) -> list[dict]:\r\n72:     \"\"\"محاولة استخراج الأصناف من حقل extracted_data.\"\"\"\r\n73:     items: list[dict] = []\r\n74:     for elem in elements:\r\n75:         extracted = elem.get(\"extracted_data\")\r\n76:         if not extracted:\r\n77:             continue\r\n78: \r\n79:         # extracted_data قد يكون قائمة أو قاموس\r\n80:         if isinstance(extracted, list):\r\n81:             for entry in extracted:\r\n82:                 name = entry.get(\"name\") or entry.get(\"item_name\") or entry.get(\"text\", \"\")\r\n83:                 name = str(name).strip()\r\n84:                 if name:\r\n85:                     page = elem.get(\"metadata\", {}).get(\"page_number\")\r\n86:                     items.append({\"item_name_raw\": name, \"source_page\": page})\r\n87:         elif isinstance(extracted, dict):\r\n88:             # قد يحتوي على items أو rows\r\n89:             for key in (\"items\", \"rows\", \"data\"):\r\n90:                 if key in extracted and isinstance(extracted[key], list):\r\n91:                     for entry in extracted[key]:\r\n92:                         if isinstance(entry, dict):\r\n93:                             name = (\r\n94:                                 entry.get(\"name\")\r\n95:                                 or entry.get(\"item_name\")\r\n96:                                 or entry.get(\"text\", \"\")\r\n97:                             )\r\n98:                         else:\r\n99:                             name = str(entry)\r\n100:                         name = str(name).strip()\r\n101:                         if name:\r\n102:                             page = elem.get(\"metadata\", {}).get(\"page_number\")\r\n103:                             items.append({\"item_name_raw\": name, \"source_page\": page})\r\n104: \r\n105:     return items\r\n106: \r\n107: \r\n108: def _try_html_tables(elements: list[dict]) -> list[dict]:\r\n109:     \"\"\"\r\n110:     محاولة استخراج الأصناف من جداول HTML في عناصر Table.\r\n111: \r\n112:     يبحث عن العمود الذي يحتوي على أسماء الأدوية (نص عربي أو أطول النصوص).\r\n113:     \"\"\"\r\n114:     items: list[dict] = []\r\n115:     arabic_pattern = re.compile(r\"[\\u0600-\\u06FF]\")\r\n116: \r\n117:     for elem in elements:\r\n118:         if elem.get(\"type\") != \"Table\":\r\n119:             continue\r\n120: \r\n121:         html = elem.get(\"metadata\", {}).get(\"text_as_html\", \"\")\r\n122:         if not html:\r\n123:             continue\r\n124: \r\n125:         page = elem.get(\"metadata\", {}).get(\"page_number\")\r\n126:         table_items = _parse_html_table(html, arabic_pattern)\r\n127: \r\n128:         for name in table_items:\r\n129:             items.append({\"item_name_raw\": name, \"source_page\": page})\r\n130: \r\n131:     return items\r\n132: \r\n133: \r\n134: def _parse_html_table(html: str, arabic_pattern: re.Pattern) -> list[str]:\r\n135:     \"\"\"\r\n136:     تحليل جدول HTML بسيط واستخراج أسماء الأدوية.\r\n137: \r\n138:     يبحث عن العمود الذي يحتوي على نصوص عربية أو أطول النصوص.\r\n139:     \"\"\"\r\n140:     # استخراج الصفوف: كل <tr>...</tr>\r\n141:     row_pattern = re.compile(r\"<tr[^>]*>(.*?)</tr>\", re.DOTALL | re.IGNORECASE)\r\n142:     cell_pattern = re.compile(r\"<t[dh][^>]*>(.*?)</t[dh]>\", re.DOTALL | re.IGNORECASE)\r\n143:     tag_stripper = re.compile(r\"<[^>]+>\")\r\n144: \r\n145:     rows_html = row_pattern.findall(html)\r\n146:     if not rows_html:\r\n147:         return []\r\n148: \r\n149:     # تحليل جميع الصفوف إلى قائمة من قوائم الخلايا\r\n150:     parsed_rows: list[list[str]] = []\r\n151:     for row_html in rows_html:\r\n152:         cells = cell_pattern.findall(row_html)\r\n153:         cleaned = [tag_stripper.sub(\"\", c).strip() for c in cells]\r\n154:         parsed_rows.append(cleaned)\r\n155: \r\n156:     if len(parsed_rows) < 2:\r\n157:         return []\r\n158: \r\n159:     # تحديد عدد الأعمدة\r\n160:     num_cols = max(len(row) for row in parsed_rows)\r\n161:     if num_cols == 0:\r\n162:         return []\r\n163: \r\n164:     # البحث عن عمود أسماء الأدوية\r\n165:     # تخطي الصف الأول (عناوين) وفحص بقية الصفوف\r\n166:     data_rows = parsed_rows[1:]\r\n167:     best_col = 0\r\n168:     best_score = -1\r\n169: \r\n170:     for col_idx in range(num_cols):\r\n171:         score = 0\r\n172:         for row in data_rows:\r\n173:             if col_idx >= len(row):\r\n174:                 continue\r\n175:             cell_text = row[col_idx]\r\n176:             arabic_count = len(arabic_pattern.findall(cell_text))\r\n177:             if arabic_count > 0:\r\n178:                 score += len(cell_text) * (arabic_count / max(len(cell_text), 1))\r\n179: \r\n180:         if score > best_score:\r\n181:             best_score = score\r\n182:             best_col = col_idx\r\n183: \r\n184:     # إذا لم يُعثر على نص عربي، اختيار العمود الأطول\r\n185:     if best_score <= 0:\r\n186:         col_lengths = [0] * num_cols\r\n187:         for row in data_rows:\r\n188:             for col_idx, cell in enumerate(row):\r\n189:                 col_lengths[col_idx] += len(cell)\r\n190:         best_col = col_lengths.index(max(col_lengths)) if col_lengths else 0\r\n191: \r\n192:     # استخراج القيم من العمود المحدد\r\n193:     names: list[str] = []\r\n194:     for row in data_rows:\r\n195:         if best_col < len(row):\r\n196:             name = row[best_col].strip()\r\n197:             if name:\r\n198:                 names.append(name)\r\n199: \r\n200:     return names\r\n201: \r\n202: \r\n203: def _try_text_content(elements: list[dict]) -> list[dict]:\r\n204:     \"\"\"\r\n205:     محاولة استخراج الأصناف من المحتوى النصي.\r\n206: \r\n207:     يجمع النصوص من عناصر NarrativeText وTitle ويفصلها بالأسطر.\r\n208:     \"\"\"\r\n209:     items: list[dict] = []\r\n210:     arabic_pattern = re.compile(r\"[\\u0600-\\u06FF]\")\r\n211: \r\n212:     for elem in elements:\r\n213:         text = elem.get(\"text\", \"\").strip()\r\n214:         if not text:\r\n215:             continue\r\n216: \r\n217:         page = elem.get(\"metadata\", {}).get(\"page_number\")\r\n218: \r\n219:         # تقسيم النص إلى أسطر وفحص كل سطر\r\n220:         for line in text.split(\"\\n\"):\r\n221:             line = line.strip()\r\n222:             if not line or len(line) < 3:\r\n223:                 continue\r\n224: \r\n225:             # قبول الأسطر التي تحتوي على نص عربي أو أسماء أدوية (حروف لاتينية + أرقام)\r\n226:             has_arabic = bool(arabic_pattern.search(line))\r\n227:             has_drug_chars = bool(re.search(r\"[a-zA-Z]{3,}\", line))\r\n228: \r\n229:             if has_arabic or has_drug_chars:\r\n230:                 items.append({\"item_name_raw\": line, \"source_page\": page})\r\n231: \r\n232:     return items\r\n233: \r\n234: \nThe above content shows the entire, complete file contents of the requested file.\n"}
{"step_index":919,"source":"SYSTEM","type":"SYSTEM_MESSAGE","status":"DONE","created_at":"2026-09-22T00:57:48Z","content":"The following is a <SYSTEM_MESSAGE> not actually sent by the user. It is provided by the system as important information to pay attention to.\n\n<SYSTEM_MESSAGE>\n[Message] timestamp=2026-09-22T00:57:44Z sender=916274de-7f92-49fc-a0a8-d291664b474a/task-916 priority=MESSAGE_PRIORITY_HIGH content=Task id \"916274de-7f92-49fc-a0a8-d291664b474a/task-916\" finished with result:\n\nThe command exited with code 0.\nOutput:\n<truncated 21 lines>\n\r\n\r\ndef _poll_for_result(poll_url: str, headers: dict) -> dict:\r\n    \"\"\"\r\n    الاستعلام المتكرر عن حالة مهمة غير متزامنة حتى اكتمالها.\r\n    \"\"\"\r\n    for attempt in range(1, _MAX_POLL_ATTEMPTS + 1):\r\n        time.sleep(_POLL_INTERVAL_SECONDS)\r\n        resp = requests.get(poll_url, headers=headers)\r\n\r\n        if resp.status_code != 200:\r\n            print(f\"  ⚠️ خطأ في الاستعلام (محاولة {attempt}): {resp.status_code}\")\r\n            continue\r\n\r\n        data = resp.json()\r\n        status = data.get(\"status\", \"\")\r\n\r\n        if status == \"completed\":\r\n            print(f\"  ✅ اكتملت المهمة (بعد {attempt * _POLL_INTERVAL_SECONDS} ثانية)\")\r\n            # النتائج قد تكون في data[\"elements\"] أو data نفسه\r\n            return data.get(\"elements\", data)\r\n\r\n        if status in (\"failed\", \"error\"):\r\n            raise RuntimeError(\r\n                f\"❌ فشلت مهمة Unstructured API: {data.get('error', 'خطأ غير معروف')}\"\r\n            )\r\n\r\n        print(\r\n            f\"  ⏳ الحالة: {status} (محاولة {attempt}/{_MAX_POLL_ATTEMPTS})\"\r\n        )\r\n\r\n    raise RuntimeError(\r\n        f\"❌ انتهت مهلة الانتظار ({_MAX_POLL_ATTEMPTS * _POLL_INTERVAL_SECONDS} ثانية) \"\r\n        f\"للمهمة غير المتزامنة\"\r\n    )\r\n\r\n\r\ndef _normalize_response(response: dict | list) -> list[dict]:\r\n    \"\"\"تحويل الاستجابة إلى قائمة عناصر موحدة.\"\"\"\r\n    if isinstance(response, list):\r\n        return response\r\n    if isinstance(response, dict):\r\n        # قد تكون العناصر في مفتاح 'elements' أو الاستجابة نفسها عنصر واحد\r\n        if \"elements\" in response:\r\n            return response[\"elements\"]\r\n        return [response]\r\n    return []\r\n\r\n\r\ndef _try_extracted_data(elements: list[dict]) -> list[dict]:\r\n    \"\"\"محاولة استخراج الأصناف من حقل extracted_data.\"\"\"\r\n    items: list[dict] = []\r\n    for elem in elements:\r\n        extracted = elem.get(\"extracted_data\")\r\n        if not extracted:\r\n            continue\r\n\r\n        # extracted_data قد يكون قائمة أو قاموس\r\n        if isinstance(extracted, list):\r\n            for entry in extracted:\r\n                name = entry.get(\"name\") or entry.get(\"item_name\") or entry.get(\"text\", \"\")\r\n                name = str(name).strip()\r\n                if name:\r\n                    page = elem.get(\"metadata\", {}).get(\"page_number\")\r\n                    items.append({\"item_name_raw\": name, \"source_page\": page})\r\n        elif isinstance(extracted, dict):\r\n            # قد يحتوي على items أو rows\r\n            for key in (\"items\", \"rows\", \"data\"):\r\n                if key in extracted and isinstance(extracted[key], list):\r\n                    for entry in extracted[key]:\r\n                        if isinstance(entry, dict):\r\n                            name = (\r\n                                entry.get(\"name\")\r\n                                or entry.get(\"item_name\")\r\n                                or entry.get(\"text\", \"\")\r\n                            )\r\n                        else:\r\n                            name = str(entry)\r\n                        name = str(name).strip()\r\n                        if name:\r\n                            page = elem.get(\"metadata\", {}).get(\"page_number\")\r\n                            items.append({\"item_name_raw\": name, \"source_page\": page})\r\n\r\n    return items\r\n\r\n\r\ndef _try_html_tables(elements: list[dict]) -> list[dict]:\r\n    \"\"\"\r\n    محاولة استخراج الأصناف من جداول HTML في عناصر Table.\r\n\r\n    يبحث عن العمود الذي يحتوي على أسماء الأدوية (نص عربي أو أطول النصوص).\r\n    \"\"\"\r\n    items: list[dict] = []\r\n    arabic_pattern = re.compile(r\"[\\u0600-\\u06FF]\")\r\n\r\n    for elem in elements:\r\n        if elem.get(\"type\") != \"Table\":\r\n            continue\r\n\r\n        html = elem.get(\"metadata\", {}).get(\"text_as_html\", \"\")\r\n        if not html:\r\n            continue\r\n\r\n        page = elem.get(\"metadata\", {}).get(\"page_number\")\r\n        table_items = _parse_html_table(html, arabic_pattern)\r\n\r\n        for name in table_items:\r\n            items.append({\"item_name_raw\": name, \"source_page\": page})\r\n\r\n    return items\r\n\r\n\r\ndef _parse_html_table(html: str, arabic_pattern: re.Pattern) -> list[str]:\r\n    \"\"\"\r\n    تحليل جدول HTML بسيط واستخراج أسماء الأدوية.\r\n\r\n    يبحث عن العمود الذي يحتوي على نصوص عربية أو أطول النصوص.\r\n    \"\"\"\r\n    # استخراج الصفوف: كل <tr>...</tr>\r\n    row_pattern = re.compile(r\"<tr[^>]*>(.*?)</tr>\", re.DOTALL | re.IGNORECASE)\r\n    cell_pattern = re.compile(r\"<t[dh][^>]*>(.*?)</t[dh]>\", re.DOTALL | re.IGNORECASE)\r\n    tag_stripper = re.compile(r\"<[^>]+>\")\r\n\r\n    rows_html = row_pattern.findall(html)\r\n    if not rows_html:\r\n        return []\r\n\r\n    # تحليل جميع الصفوف إلى قائمة من قوائم الخلايا\r\n    parsed_rows: list[list[str]] = []\r\n    for row_html in rows_html:\r\n        cells = cell_pattern.findall(row_html)\r\n        cleaned = [tag_stripper.sub(\"\", c).strip() for c in cells]\r\n        parsed_rows.append(cleaned)\r\n\r\n    if len(parsed_rows) < 2:\r\n        return []\r\n\r\n    # تحديد عدد الأعمدة\r\n    num_cols = max(len(row) for row in parsed_rows)\r\n    if num_cols == 0:\r\n        return []\r\n\r\n    # البحث عن عمود أسماء الأدوية\r\n    # تخطي الصف الأول (عناوين) وفحص بقية الصفوف\r\n    data_rows = parsed_rows[1:]\r\n    best_col = 0\r\n    best_score = -1\r\n\r\n    for col_idx in range(num_cols):\r\n        score = 0\r\n        for row in data_rows:\r\n            if col_idx >= len(row):\r\n                continue\r\n            cell_text = row[col_idx]\r\n            arabic_count = len(arabic_pattern.findall(cell_text))\r\n            if arabic_count > 0:\r\n                score += len(cell_text) * (arabic_count / max(len(cell_text), 1))\r\n\r\n        if score > best_score:\r\n            best_score = score\r\n            best_col = col_idx\r\n\r\n    # إذا لم يُعثر على نص عربي، اختيار العمود الأطول\r\n    if best_score <= 0:\r\n        col_lengths = [0] * num_cols\r\n        for row in data_rows:\r\n            for col_idx, cell in enumerate(row):\r\n                col_lengths[col_idx] += len(cell)\r\n        best_col = col_lengths.index(max(col_lengths)) if col_lengths else 0\r\n\r\n    # استخراج القيم من العمود المحدد\r\n    names: list[str] = []\r\n    for row in data_rows:\r\n        if best_col < len(row):\r\n            name = row[best_col].strip()\r\n            if name:\r\n                names.append(name)\r\n\r\n    return names\r\n\r\n\r\ndef _try_text_content(elements: list[dict]) -> list[dict]:\r\n    \"\"\"\r\n    محاولة استخراج الأصناف من المحتوى النصي.\r\n\r\n    يجمع النصوص من عناصر NarrativeText وTitle ويفصلها بالأسطر.\r\n    \"\"\"\r\n    items: list[dict] = []\r\n    arabic_pattern = re.compile(r\"[\\u0600-\\u06FF]\")\r\n\r\n    for elem in elements:\r\n        text = elem.get(\"text\", \"\").strip()\r\n        if not text:\r\n            continue\r\n\r\n        page = elem.get(\"metadata\", {}).get(\"page_number\")\r\n\r\n        # تقسيم النص إلى أسطر وفحص كل سطر\r\n        for line in text.split(\"\\n\"):\r\n            line = line.strip()\r\n            if not line or len(line) < 3:\r\n                continue\r\n\r\n            # قبول الأسطر التي تحتوي على نص عربي أو أسماء أدوية (حروف لاتينية + أرقام)\r\n            has_arabic = bool(arabic_pattern.search(line))\r\n            has_drug_chars = bool(re.search(r\"[a-zA-Z]{3,}\", line))\r\n\r\n            if has_arabic or has_drug_chars:\r\n                items.append({\"item_name_raw\": line, \"source_page\": page})\r\n\r\n    return items\r\n\r\n\n\n</SYSTEM_MESSAGE>"}
