].replace(\"User: \", \"\", 1)\n1129:         if system_lines:\n1130:             return f\"[System Instructions]\\n\" + \"\\n\\n\".join(system_lines) + \"\\n\\n\" + last_user\n1131:         return last_user\n1132: \n1133:     parts = []\n1134:     if system_lines:\n1135:         parts.append(\"[System Instructions]\\n\" + \"\\n\\n\".join(system_lines))\n1136: \n1137:     if len(dialogue_lines) == 1:\n1138:         # Clean single user prompt without \"User:\" prefix\n1139:         parts.append(dialogue_lines[0].replace(\"User: \", \"\", 1))\n1140:     elif dialogue_lines:\n1141:         parts.append(\"\\n\\n\".join(dialogue_lines))\n1142: \n1143:     return \"\\n\\n\".join(parts)\n1144: \n1145: # ------------------------------------------------------------------------------\n1146: # Endpoints\n1147: # ------------------------------------------------------------------------------\n1148: @app.post(\"/v1/chat/completions\", dependencies=[Depends(verify_api_key)])\n1149: @limiter.limit(RATE_LIMIT)\n1150: async def chat_completions(request: Request, chat_request: ChatRequest):\n1151:     \"\"\"OpenAI-compatible chat completions endpoint driven by Google AI Studio Web.\"\"\"\n1152:     sem = _get_semaphore()\n1153:     if sem.locked():\n1154:         raise HTTPException(\n1155:             status_code=429,\n1156:             detail={\"error\": \"Server busy — browser tab currently processing another request.\", \"type\": \"concurrency_limit\"}\n1157:         )\n1158: \n1159:     prompt = format_messages_to_prompt(chat_request.messages)\n1160:     chunk_id = f\"chatcmpl-{uuid.uuid4().hex[:12]}\"\n1161:     now = int(time.time())\n1162:     model_name = chat_request.model or DEFAULT_MODEL\n1163:     batch_size_header = request.headers.get(\"x-batch-size\")\n1164:     batch_size = int(batch_size_header) if (batch_size_header and batch_size_header.isdigit()) else None\n1165:     logger.info(f\"Incoming /v1/chat/completions prompt ({len(prompt)} chars, batch_size={batch_size}): {repr(prompt[:80])}\")\n1166: \n1167:     async def sse_generator():\n1168:         async with sem:\n1169:             async with browser_manager.lock:\n1170:                 first_chunk = {\n1171:                     \"id\": chunk_id,\n1172:                     \"object\": \"chat.completion.chunk\",\n1173:                     \"created\": now,\n1174:                     \"model\": model_name,\n1175:                     \"choices\": [{\"index\": 0, \"delta\": {\"role\": \"assistant\", \"content\": \"\"}, \"finish_reason\": None}]\n1176:                 }\n1177:                 yield f\"data: {json.dumps(first_chunk, ensure_ascii=False)}\\n\\n\"\n1178: \n1179:                 async for chunk_data in browser_manager.send_prompt_and_stream(prompt, model_name=model_name, batch_size=batch_size):\n1180:                     if isinstance(chunk_data, dict):\n1181:                         delta = chunk_data[\"delta\"]\n1182:                     else:\n1183:                         delta = chunk_data\n1184:                         \n1185:                     if delta:\n1186:                         chunk = {\n1187:                             \"id\": chunk_id,\n1188:                             \"object\": \"chat.completion.chunk\",\n1189:                             \"created\": now,\n1190:                             \"model\": model_name,\n1191:                             \"choices\": [{\"index\": 0, \"delta\": {\"content\": delta}, \"finish_reason\": None}]\n1192:                         }\n1193:                         yield f\"data: {json.dumps(chunk, ensure_ascii=False)}\\n\\n\"\n1194: \n1195:                 done_chunk = {\n1196:                     \"id\": chunk_id,\n1197:                     \"object\": \"chat.completion.chunk\",\n1198:                     \"created\": now,\n1199:                     \"model\": model_name,\n1200:                     \"choices\": [{\"index\": 0, \"delta\": {}, \"finish_reason\": \"stop\"}]\n1201:                 }\n1202:                 yield f\"data: {json.dumps(done_chunk, ensure_ascii=False)}\\n\\n\"\n1203:                 yield \"data: [DONE]\\n\\n\"\n1204: \n1205:     if chat_request.stream:\n1206:         return StreamingResponse(\n1207:             sse_generator(),\n1208:             media_type=\"text/event-stream\",\n1209:             headers={\n1210:                 \"Cache-Control\": \"no-cache\",\n1211:                 \"Connection\": \"keep-alive\",\n1212:                 \"X-Accel-Buffering\": \"no\"\n1213:             }\n1214:         )\n1215:     else:\n1216:         full_text = \"\"\n1217:         async with sem:\n1218:             async with browser_manager.lock:\n1219:                 async for chunk_data in browser_manager.send_prompt_and_stream(prompt, model_name=model_name, batch_size=batch_size):\n1220:                     if isinstance(chunk_data, dict):\n1221:                         full_text = chunk_data[\"text\"]\n1222:                     else:\n1223:                         full_text += chunk_data\n1224: \n1225:         timings = getattr(browser_manager, \"last_timings\", {})\n1226:         headers = {\n1227:             \"X-Timing-PreExec\": f\"{timings.get('pre_exec', 0.0):.2f}s\",\n1228:             \"X-Timing-Generation\": f\"{timings.get('generation', 0.0):.2f}s\",\n1229:             \"X-Timing-Total\": f\"{timings.get('total', 0.0):.2f}s\"\n1230:         }\n1231:         return JSONResponse({\n1232:             \"id\": chunk_id,\n1233:             \"object\": \"chat.completion\",\n1234:             \"created\": now,\n1235:             \"model\": model_name,\n1236:             \"choices\": [{\n1237:                 \"index\": 0,\n1238:                 \"message\": {\n1239:                     \"role\": \"assistant\",\n1240:                     \"content\": full_text\n1241:                 },\n1242:                 \"finish_reason\": \"stop\"\n1243:             }]\n1244:         }, headers=headers)\n1245: \n1246: @app.post(\"/v1/responses\", dependencies=[Dep