{"step_index":8270,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-24T19:35:41Z","thinking":"The prompt formatting function needs a strict cleanup, retaining only system instructions and the current user case data while discarding assistant messages. Historical reasoning markers must be removed to create a concise prompt. This adjustment aims to provide a more streamlined and focused prompt for the model.\n\n\n","tool_calls":[{"name":"replace_file_content","args":{"AllowMultiple":false,"Description":"Update format_messages_to_prompt and chat_completions with clean prompt and search control","EndLine":1245,"Instruction":"Clean prompt formatting, add search control and headers to chat_completions","ReplacementContent":"def format_messages_to_prompt(messages: List[ChatMessage]) -> str:\n    \"\"\"Combines user/system messages into a pristine, clean prompt string, completely omitting any historical reasoning.\"\"\"\n    system_lines = []\n    user_lines = []\n\n    for m in messages:\n        content = m.content or \"\"\n        if isinstance(content, list):\n            content = \" \".join([p.get(\"text\", \"\") for p in content if isinstance(p, dict) and \"text\" in p])\n        content = str(content).strip()\n        if not content:\n            continue\n\n        if m.role == \"system\":\n            system_lines.append(content)\n        elif m.role == \"user\":\n            user_lines.append(content)\n        # Assistant messages and previous reasoning are intentionally IGNORED in matching to keep the prompt 100% clean\n\n    # Sanitize user content: remove any leaked thoughts or historical reasoning markers\n    clean_user_lines = []\n    for u in user_lines:\n        u_clean = re.sub(r'<\\s*thought\\b[^>]*>.*?<\\s*/\\s*thought\\s*>', '', u, flags=re.DOTALL | re.IGNORECASE)\n        u_clean = re.sub(r'\\*\\*(?:Defining the Problem|Refining the Matching Criteria|Analyzing Match Results|Thinking Process)\\*\\*.*?(?=\\n\\n|$)', '', u_clean, flags=re.DOTALL)\n        u_clean = re.sub(r'(?:Defining the Problem|Refining the Matching Criteria|Analyzing Match Results|I\\'ve just\\b).*?(?=\\n\\n|$)', '', u_clean, flags=re.DOTALL)\n        u_clean = u_clean.strip()\n        if u_clean:\n            clean_user_lines.append(u_clean)\n\n    parts = []\n    if system_lines:\n        parts.append(\"[System Instructions]\\n\" + \"\\n\\n\".join(system_lines))\n\n    if clean_user_lines:\n        parts.append(\"\\n\\n\".join(clean_user_lines))\n\n    return \"\\n\\n\".join(parts)\n\n# ------------------------------------------------------------------------------\n# Endpoints\n# ------------------------------------------------------------------------------\n@app.post(\"/v1/chat/completions\", dependencies=[Depends(verify_api_key)])\n@limiter.limit(RATE_LIMIT)\nasync def chat_completions(request: Request, chat_request: ChatRequest):\n    \"\"\"OpenAI-compatible chat completions endpoint driven by Google AI Studio Web.\"\"\"\n    sem = _get_semaphore()\n    if sem.locked():\n        raise HTTPException(\n            status_code=429,\n            detail={\"error\": \"Server busy — browser tab currently processing another request.\", \"type\": \"concurrency_limit\"}\n        )\n\n    prompt = format_messages_to_prompt(chat_request.messages)\n    chunk_id = f\"chatcmpl-{uuid.uuid4().hex[:12]}\"\n    now = int(time.time())\n    model_name = chat_request.model or DEFAULT_MODEL\n    batch_size_header = request.headers.get(\"x-batch-size\")\n    batch_size = int(batch_size_header) if (batch_size_header and batch_size_header.isdigit()) else None\n\n    # Check search toggle header\n    search_hdr = request.headers.get(\"x-google-search-enabled\") or request.headers.get(\"x-enable-search\")\n    enable_search = None\n    if search_hdr is not None:\n        enable_search = search_hdr.lower() in (\"true\", \"1\", \"yes\")\n    else:\n        enable_search = ENABLE_SEARCH_GROUNDING\n\n    logger.info(\n        f\"Incoming /v1/chat/completions prompt ({len(prompt)} chars, batch_size={batch_size}, \"\n        f\"google_search={'ENABLED' if enable_search else 'DISABLED'}): {repr(prompt[:80])}\"\n    )\n\n    async def sse_generator():\n        async with sem:\n            async with browser_manager.lock:\n                first_chunk = {\n                    \"id\": chunk_id,\n                    \"object\": \"chat.completion.chunk\",\n                    \"created\": now,\n                    \"model\": model_name,\n                    \"choices\": [{\"index\": 0, \"delta\": {\"role\": \"assistant\", \"content\": \"\"}, \"finish_reason\": None}]\n                }\n                yield f\"data: {json.dumps(first_chunk, ensure_ascii=False)}\\n\\n\"\n\n                async for chunk_data in browser_manager.send_prompt_and_stream(prompt, model_name=model_name, batch_size=batch_size, enable_search=enable_search):\n                    if isinstance(chunk_data, dict):\n                        delta = chunk_data[\"delta\"]\n                    else:\n                        delta = chunk_data\n                        \n                    if delta:\n                        chunk = {\n                            \"id\": chunk_id,\n                            \"object\": \"chat.completion.chunk\",\n                            \"created\": now,\n                            \"model\": model_name,\n                            \"choices\": [{\"index\": 0, \"delta\": {\"content\": delta}, \"finish_reason\": None}]\n                        }\n                        yield f\"data: {json.dumps(chunk, ensure_ascii=False)}\\n\\n\"\n\n                done_chunk = {\n                    \"id\": chunk_id,\n                    \"object\": \"chat.completion.chunk\",\n                    \"created\": now,\n                    \"model\": model_name,\n                    \"choices\": [{\"index\": 0, \"delta\": {}, \"finish_reason\": \"stop\"}]\n                }\n                yield f\"data: {json.dumps(done_chunk, ensure_ascii=False)}\\n\\n\"\n                yield \"data: [DONE]\\n\\n\"\n\n    if chat_request.stream:\n        return StreamingResponse(\n            sse_generator(),\n            media_type=\"text/event-stream\",\n            headers={\n                \"Cache-Control\": \"no-cache\",\n                \"Connection\": \"keep-alive\",\n                \"X-Accel-Buffering\": \"no\"\n            }\n        )\n    else:\n        full_text = \"\"\n        async with sem:\n            async with browser_manager.lock:\n                async for chunk_data in browser_manager.send_prompt_and_stream(prompt, model_name=model_name, batch_size=batch_size, enable_search=enable_search):\n                    if isinstance(chunk_data, dict):\n                        full_text = chunk_data[\"text\"]\n                    else:\n                        full_text += chunk_data\n\n        timings = getattr(browser_manager, \"last_timings\", {})\n        headers = {\n            \"X-Timing-PreExec\": f\"{timings.get('pre_exec', 0.0):.2f}s\",\n            \"X-Timing-Generation\": f\"{timings.get('generation', 0.0):.2f}s\",\n            \"X-Timing-Total\": f\"{timings.get('total', 0.0):.2f}s\",\n            \"X-Batch-Size\": str(batch_size or 0),\n            \"X-Google-Search-Enabled\": str(browser_manager.google_search_enabled).lower(),\n            \"X-Tool-Calls-Count\": str(browser_manager.last_tool_calls_count),\n            \"X-Thinking-Mode\": str(browser_manager.active_thinking),\n            \"X-Final-Status\": str(timings.get('state', 'UNKNOWN')),\n        }\n        return JSONResponse({\n            \"id\": chunk_id,\n            \"object\": \"chat.completion\",\n            \"created\": now,\n            \"model\": model_name,\n            \"choices\": [{\n                \"index\": 0,\n                \"message\": {\n                    \"role\": \"assistant\",\n                    \"content\": full_text\n                },\n                \"finish_reason\": \"stop\"\n            }]\n        }, headers=headers)","StartLine":1104,"TargetContent":"def format_messages_to_prompt(messages: List[ChatMessage]) -> str:\n    \"\"\"Combines user/system/assistant messages into a clean prompt string.\"\"\"\n    system_lines = []\n    dialogue_lines = []\n\n    for m in messages:\n        content = m.content or \"\"\n        if isinstance(content, list):\n            content = \" \".join([p.get(\"text\", \"\") for p in content if isinstance(p, dict) and \"text\" in p])\n        content = str(content).strip()\n        if not content:\n            continue\n\n        if m.role == \"system\":\n            system_lines.append(content)\n        elif m.role == \"user\":\n            dialogue_lines.append(f\"User: {content}\")\n        elif m.role == \"assistant\":\n            dialogue_lines.append(f\"Assistant: {content}\")\n\n    # In continuous chat mode where CLEAR_CHAT_ON_REQUEST is False,\n    # previous assistant/user turns already live in the browser session.\n    # But system instructions must ALWAYS be preserved if provided.\n    if not CLEAR_CHAT_ON_REQUEST and dialogue_lines:\n        last_user = dialogue_lines[-1].replace(\"User: \", \"\", 1)\n        if system_lines:\n            return f\"[System Instructions]\\n\" + \"\\n\\n\".join(system_lines) + \"\\n\\n\" + last_user\n        return last_user\n\n    parts = []\n    if system_lines:\n        parts.append(\"[System Instructions]\\n\" + \"\\n\\n\".join(system_lines))\n\n    if len(dialogue_lines) == 1:\n        # Clean single user prompt without \"User:\" prefix\n        parts.append(dialogue_lines[0].replace(\"User: \", \"\", 1))\n    elif dialogue_lines:\n        parts.append(\"\\n\\n\".join(dialogue_lines))\n\n    return \"\\n\\n\".join(parts)\n\n# ------------------------------------------------------------------------------\n# Endpoints\n# ------------------------------------------------------------------------------\n@app.post(\"/v1/chat/completions\", dependencies=[Depends(verify_api_key)])\n@limiter.limit(RATE_LIMIT)\nasync def chat_completions(request: Request, chat_request: ChatRequest):\n    \"\"\"OpenAI-compatible chat completions endpoint driven by Google AI Studio Web.\"\"\"\n    sem = _get_semaphore()\n    if sem.locked():\n        raise HTTPException(\n            status_code=429,\n            detail={\"error\": \"Server busy — browser tab currently processing another request.\", \"type\": \"concurrency_limit\"}\n        )\n\n    prompt = format_messages_to_prompt(chat_request.messages)\n    chunk_id = f\"chatcmpl-{uuid.uuid4().hex[:12]}\"\n    now = int(time.time())\n    model_name = chat_request.model or DEFAULT_MODEL\n    batch_size_header = request.headers.get(\"x-batch-size\")\n    batch_size = int(batch_size_header) if (batch_size_header and batch_size_header.isdigit()) else None\n    logger.info(f\"Incoming /v1/chat/completions prompt ({len(prompt)} chars, batch_size={batch_size}): {repr(prompt[:80])}\")\n\n    async def sse_generator():\n        async with sem:\n            async with browser_manager.lock:\n                first_chunk = {\n                    \"id\": chunk_id,\n                    \"object\": \"chat.completion.chunk\",\n                    \"created\": now,\n                    \"model\": model_name,\n                    \"choices\": [{\"index\": 0, \"delta\": {\"role\": \"assistant\", \"content\": \"\"}, \"finish_reason\": None}]\n                }\n                yield f\"data: {json.dumps(first_chunk, ensure_ascii=False)}\\n\\n\"\n\n                async for chunk_data in browser_manager.send_prompt_and_stream(prompt, model_name=model_name, batch_size=batch_size):\n                    if isinstance(chunk_data, dict):\n       