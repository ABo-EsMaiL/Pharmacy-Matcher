{"step_index":1208,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-22T01:23:55Z","content":"Created At: 2026-09-22T04:23:55+03:00\nCompleted At: 2026-09-22T04:23:55+03:00\nFile Path: `file:///d:/AI_Engineer/Pharmacy-agy/src/extract/pdf_reader.py`\nTotal Lines: 428\nTotal Bytes: 15882\nShowing lines 1 to 428\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"\"\"\n2: وحدة قراءة ملفات PDF - استخراج أسماء الأدوية باستخدام Unstructured API.\n3: PDF reader module - extracts drug names using the Unstructured API.\n4: \"\"\"\n5: \n6: from pathlib import Path\n7: import json\n8: import re\n9: import time\n10: import requests\n11: \n12: \n13: # الحد الأقصى لعدد محاولات الاستعلام عن حالة المهمة غير المتزامنة\n14: _MAX_POLL_ATTEMPTS = 60\n15: # الفاصل الزمني بين محاولات الاستعلام (بالثواني)\n16: _POLL_INTERVAL_SECONDS = 5\n17: \n18: \n19: import hashlib\n20: \n21: def _get_file_hash(filepath: Path) -> str:\n22:     hasher = hashlib.md5()\n23:     with open(filepath, 'rb') as f:\n24:         buf = f.read(65536)\n25:         while len(buf) > 0:\n26:             hasher.update(buf)\n27:             buf = f.read(65536)\n28:     return hasher.hexdigest()\n29: \n30: def extract_from_pdf(\n31:     filepath: Path,\n32:     api_key: str,\n33:     base_url: str = \"https://transform.unstructured.io\",\n34: ) -> dict:\n35:     \"\"\"\n36:     رفع ملف PDF إلى Unstructured API واستخراج العناصر المهيكلة.\n37:     \"\"\"\n38:     filepath = Path(filepath)\n39:     if not filepath.exists():\n40:         raise FileNotFoundError(f\"❌ ملف PDF غير موجود: {filepath}\")\n41: \n42:     # Check global cache first\n43:     file_hash = _get_file_hash(filepath)\n44:     cache_dir = filepath.parent.parent.parent / 'data' / '.unstructured_cache'\n45:     cache_dir.mkdir(parents=True, exist_ok=True)\n46:     cache_file = cache_dir / f\"{file_hash}.json\"\n47:     \n48:     if cache_file.exists():\n49:         print(f\"📄 تم العثور على الملف في الذاكرة المؤقتة (Cache). جاري تحميل البيانات المستخرجة مباشرة: {filepath.name}\")\n50:         with open(cache_file, \"r\", encoding=\"utf-8\") as f:\n51:             result = json.load(f)\n52:         # Also copy to local process directory\n53:         json_path = filepath.with_suffix(\".json\")\n54:         with open(json_path, \"w\", encoding=\"utf-8\") as jf:\n55:             json.dump(result, jf, ensure_ascii=False, indent=2)\n56:         return result\n57: \n58:     print(f\"📄 جارٍ رفع ملف PDF إلى Unstructured API: {filepath.name}\")\n59: \n60:     url = f\"{base_url.rstrip('/')}/api/v2/parse\"\n61:     headers = {\"unstructured-api-key\": api_key, \"accept\": \"application/json\"}\n62: \n63:     # رفع الملف مع إعدادات الاستخراج\n64:     with open(filepath, \"rb\") as f:\n65:         files = {\n66:             \"input\": (filepath.name, f, \"application/pdf\"),\n67:         }\n68:         data = {\n69:             \"profile\": \"best\",\n70:             \"output\": \"elements\",\n71:         }\n72: \n73:         response = requests.post(url, headers=headers, files=files, data=data)\n74: \n75:     # معالجة الاستجابة\n76:     if response.status_code == 200:\n77:         # استجابة فورية - النتائج جاهزة\n78:         print(\"  ✅ تم استخراج البيانات فوراً\")\n79:         result = response.json()\n80: \n81:     elif response.status_code == 202:\n82:         # مهمة غير متزامنة - يجب الانتظار\n83:         poll_url = response.headers.get(\"Location\")\n84:         if not poll_url:\n85:             raise RuntimeError(\n86:                 \"❌ استجابة 202 بدون رابط Location للاستعلام عن حالة المهمة\"\n87:             )\n88: \n89:         print(f\"  ⏳ المهمة غير متزامنة، جارٍ الانتظار...\")\n90:         result = _poll_for_result(poll_url, headers)\n91: \n92:     else:\n93:         raise RuntimeError(\n94:             f\"❌ فشل الاتصال بـ Unstructured API\\n\"\n95:             f\"  الحالة: {response.status_code}\\n\"\n96:             f\"  الرد: {response.text[:500]}\"\n97:         )\n98: \n99:     # حفظ الاستجابة الخام كملف JSON بجانب ملف PDF\n100:     json_path = filepath.with_suffix(\".json\")\n101:     with open(json_path, \"w\", encoding=\"utf-8\") as jf:\n102:         json.dump(result, jf, ensure_ascii=False, indent=2)\n103:         \n104:     # حفظ في الذاكرة المؤقتة العامة للمرات القادمة\n105:     with open(cache_file, \"w\", encoding=\"utf-8\") as cf:\n106:         json.dump(result, cf, ensure_ascii=False, indent=2)\n107:         \n108:     print(f\"  💾 تم حفظ الاستجابة الخام: {json_path.name}\")\n109: \n110:     return result\n111: \n112: \n113: def parse_items_from_response(response: dict | list, gemini_api_key: str = None) -> list[dict]:\n114:     elements = _normalize_response(response)\n115: \n116:     items = _try_extracted_data(elements)\n117:     if items:\n118:         print(f\"     -> Extracted {len(items)} items from structured data\")\n119:         return items\n120: \n121:     items = _try_html_tables(elements)\n122:     if items and len(items) > 5:\n123:         print(f\"     -> Extracted {len(items)} items from HTML tables\")\n124:         return items\n125: \n126:     # Fallback to Gemini if normal extraction fails or extracts very few items\n127:     if gemini_api_key:\n128:         print(f\"     -> Basic extraction yielded {len(items)} items. Attempting Gemini AI extraction...\")\n129:         gemini_items = _extract_with_gemini(elements, gemini_api_key)\n130:         if gemini_items:\n131:             print(f\"     -> Extracted {len(gemini_items)} items using Gemini AI\")\n132:             return gemini_items\n133: \n134:     items = _try_text_content(elements)\n135:     print(f\"     -> Extracted {len(items)} items from raw text content\")\n136:     return items\n137: \n138: def _extract_with_gemini(elements: list[dict], api_key: str) -> list[dict]:\n139:     try:\n140:         from google import genai\n141:         client = genai.Client(api_key=api_key)\n142:         \n143:         # Collect all raw text from the elements\n144:         full_text = \"\\n\".join([elem.get(\"text\", \"\").strip() for elem in elements if elem.get(\"text\")])\n145:         if not full_text.strip():\n146:             return []\n147:             \n148:         prompt = f\"\"\"\n149:         أنت مساعد ذكي متخصص في قراءة فواتير ونواقص الأدوية والصيدليات.\n150:         مرفق لك النص الخام المستخرج من ملف PDF.\n151:         قم باستخراج جميع أسماء الأدوية والأصناف الموجودة في هذا النص.\n152:         أرجع النتيجة **فقط** على شكل مصفوفة JSON تحتوي على أسماء الأدوية كنصوص (Strings).\n153:         لا تقم بإضافة أي نصوص أخرى، أو markdown tags مثل ```json، فقط المصفوفة.\n154:         \n155:         النص:\n156:         {full_text[:35000]}\n157:         \"\"\"\n158:         \n159:         response = client.models.generate_content(\n160:             model='gemini-2.5-flash',\n161:             contents=prompt,\n162:         )\n163:         text = response.text.strip()\n164:         \n165:         # Clean markdown\n166:         if text.startswith('```json'): text = text[7:-3]\n167:         elif text.startswith('```'): text = text[3:-3]\n168:         \n169:         import json\n170:         extracted = json.loads(text.strip())\n171:         \n172:         items = []\n173:         for name in extracted:\n174:             if isinstance(name, str) and name.strip():\n175:                 items.append({\"item_name_raw\": name.strip(), \"source_page\": 1})\n176:         return items\n177:     except Exception as e:\n178:         print(f\"     -> Gemini extraction failed: {e}\")\n179:         return []\n180: \n181: def extract_items_from_pdf(\n182:     filepath: Path,\n183:     api_key: str,\n184:     base_url: str = \"https://transform.unstructured.io\",\n185:     gemini_api_key: str = None,\n186: ) -> list[dict]:\n187:     \"\"\"\n188:     استخراج أسماء الأصناف من ملف PDF (الدالة الرئيسية).\n189: \n190:     تجمع بين رفع الملف وتحليل الاستجابة.\n191: \n192:     Args:\n193:         filepath: مسار ملف PDF.\n194:         api_key: مفتاح Unstructured API.\n195:         base_url: عنوان خادم Unstructured API.\n196: \n197:     Returns:\n198:         قائمة من القواميس بالشكل:\n199:         {\"item_name_raw\": str, \"source_page\": int|None, \"source_file\": str}\n200:     \"\"\"\n201:     filepath = Path(filepath)\n202: \n203:     # استخراج البيانات من PDF\n204:     result = extract_from_pdf(filepath, api_key, base_url)\n205: \n206:     # تحليل الاستجابة\n207:     items = parse_items_from_response(result, gemini_api_key)\n208: \n209:     # إضافة اسم الملف المصدر لكل عنصر\n210:     for item in items:\n211:         item[\"source_file\"] = filepath.name\n212: \n213:     return items\n214: \n215: \n216: # ──────────────────────── دوال مساعدة داخلية ────────────────────────\n217: \n218: \n219: def _poll_for_result(poll_url: str, headers: dict) -> dict:\n220:     \"\"\"\n221:     الاستعلام المتكرر عن حالة مهمة غير متزامنة حتى اكتمالها.\n222:     \"\"\"\n223:     for attempt in range(1, _MAX_POLL_ATTEMPTS + 1):\n224:         time.sleep(_POLL_INTERVAL_SECONDS)\n225:         resp = requests.get(poll_url, headers=headers)\n226: \n227:         if resp.status_code != 200:\n228:             print(f\"  ⚠️ خطأ في الاستعلام (محاولة {attempt}): {resp.status_code}\")\n229:             continue\n230: \n231:         data = resp.json()\n232:         status = data.get(\"status\", \"\")\n233: \n234:         if status == \"completed\":\n235:             print(f\"  ✅ اكتملت المهمة (بعد {attempt * _POLL_INTERVAL_SECONDS} ثانية)\")\n236:             # النتائج قد تكون في data[\"elements\"] أو data نفسه\n237:             return data.get(\"elements\", data)\n238: \n239:         if status in (\"failed\", \"error\"):\n240:             raise RuntimeError(\n241:                 f\"❌ فشلت مهمة Unstructured API: {data.get('error', 'خطأ غير معروف')}\"\n242:             )\n243: \n244:         print(\n245:             f\"  ⏳ الحالة: {status} (محاولة {attempt}/{_MAX_POLL_ATTEMPTS})\"\n246:         )\n247: \n248:     raise RuntimeError(\n249:         f\"❌ انتهت مهلة الانتظار ({_MAX_POLL_ATTEMPTS * _POLL_INTERVAL_SECONDS} ثانية) \"\n250:         f\"للمهمة غير المتزامنة\"\n251:     )\n252: \n253: \n254: def _normalize_response(response: dict | list) -> list[dict]:\n255:     \"\"\"تحويل الاستجابة إلى قائمة عناصر موحدة.\"\"\"\n256:     if isinstance(response, list):\n257:         return response\n258:     if isinstance(response, dict):\n259:         # قد تكون العناصر في مفتاح 'elements' أو الاستجابة نفسها عنصر واحد\n260:         if \"elements\" in response:\n261:             return response[\"elements\"]\n262:         return [response]\n263:     return []\n264: \n265: \n266: def _try_extracted_data(elements: list[dict]) -> list[dict]:\n267:     \"\"\"محاولة استخراج الأصناف من حقل extracted_data.\"\"\"\n268:     items: list[dict] = []\n269:     for elem in elements:\n270:         extracted = elem.get(\"extracted_data\")\n271:         if not extracted:\n272:             continue\n273: \n274:         # extracted_data قد يكون قائمة أو قاموس\n275:         if isinstance(extracted, list):\n276:             for entry in extracted:\n277:                 name = entry.get(\"name\") or entry.get(\"item_name\") or entry.get(\"text\", \"\")\n278:                 name = str(name).strip()\n279:                 if name:\n280:                     page = elem.get(\"metadata\", {}).get(\"page_number\")\n281:                     items.append({\"item_name_raw\": name, \"source_page\": page})\n282:         elif isinstance(extracted, dict):\n283:             # قد يحتوي على items أو rows\n284:             for key in (\"items\", \"rows\", \"data\"):\n285:                 if key in extracted and isinstance(extracted[key], list):\n286:                     for entry in extracted[key]:\n287:                         if isinstance(entry, dict):\n288:                             name = (\n289:                                 entry.get(\"name\")\n290:                                 or entry.get(\"item_name\")\n291:                                 or entry.get(\"text\", \"\")\n292:                             )\n293:                         else:\n294:                             name = str(entry)\n295:                         name = str(name).strip()\n296:                         if name:\n297:                             page = elem.get(\"metadata\", {}).get(\"page_number\")\n298:                             items.append({\"item_name_raw\": name, \"source_page\": page})\n299: \n300:     return items\n301: \n302: \n303: def _try_html_tables(elements: list[dict]) -> list[dict]:\n304:     \"\"\"\n305:     محاولة استخراج الأصناف من جداول HTML في عناصر Table.\n306: \n307:     يبحث عن العمود الذي يحتوي على أسماء الأدوية (نص عربي أو أطول النصوص).\n308:     \"\"\"\n309:     items: list[dict] = []\n310:     arabic_pattern = re.compile(r\"[\\u0600-\\u06FF]\")\n311: \n312:     for elem in elements:\n313:         if elem.get(\"type\") != \"Table\":\n314:             continue\n315: \n316:         html = elem.get(\"metadata\", {}).get(\"text_as_html\", \"\")\n317:         if not html:\n318:             continue\n319: \n320:         page = elem.get(\"metadata\", {}).get(\"page_number\")\n321:         table_items = _parse_html_table(html, arabic_pattern)\n322: \n323:         for name in table_items:\n324:             items.append({\"item_name_raw\": name, \"source_page\": page})\n325: \n326:     return items\n327: \n328: \n329: def _parse_html_table(html: str, arabic_pattern: re.Pattern) -> list[str]:\n330:     \"\"\"\n331:     تحليل جدول HTML بسيط واستخراج أسماء الأدوية.\n332: \n333:     يبحث عن العمود الذي يحتوي على نصوص عربية أو أطول النصوص.\n334:     \"\"\"\n335:     # استخراج الصفوف: كل <tr>...</tr>\n336:     row_pattern = re.compile(r\"<tr[^>]*>(.*?)</tr>\", re.DOTALL | re.IGNORECASE)\n337:     cell_pattern = re.compile(r\"<t[dh][^>]*>(.*?)</t[dh]>\", re.DOTALL | re.IGNORECASE)\n338:     tag_stripper = re.compile(r\"<[^>]+>\")\n339: \n340:     rows_html = row_pattern.findall(html)\n341:     if not rows_html:\n342:         return []\n343: \n344:     # تحليل جميع الصفوف إلى قائمة من قوائم الخلايا\n345:     parsed_rows: list[list[str]] = []\n346:     for row_html in rows_html:\n347:         cells = cell_pattern.findall(row_html)\n348:         cleaned = [tag_stripper.sub(\"\", c).strip() for c in cells]\n349:         parsed_rows.append(cleaned)\n350: \n351:     if len(parsed_rows) < 2:\n352:         return []\n353: \n354:     # تحديد عدد الأعمدة\n355:     num_cols = max(len(row) for row in parsed_rows)\n356:     if num_cols == 0:\n357:         return []\n358: \n359:     # البحث عن عمود أسماء الأدوية\n360:     # تخطي الصف الأول (عناوين) وفحص بقية الصفوف\n361:     data_rows = parsed_rows[1:]\n362:     best_col = 0\n363:     best_score = -1\n364: \n365:     for col_idx in range(num_cols):\n366:         score = 0\n367:         for row in data_rows:\n368:             if col_idx >= len(row):\n369:                 continue\n370:             cell_text = row[col_idx]\n371:             arabic_count = len(arabic_pattern.findall(cell_text))\n372:             if arabic_count > 0:\n373:                 score += len(cell_text) * (arabic_count / max(len(cell_text), 1))\n374: \n375:         if score > best_score:\n376:             best_score = score\n377:             best_col = col_idx\n378: \n379:     # إذا لم يُعثر على نص عربي، اختيار العمود الأطول\n380:     if best_score <= 0:\n381:         col_lengths = [0] * num_cols\n382:         for row in data_rows:\n383:             for col_idx, cell in enumerate(row):\n384:                 col_lengths[col_idx] += len(cell)\n385:         best_col = col_lengths.index(max(col_lengths)) if col_lengths else 0\n386: \n387:     # استخراج القيم من العمود المحدد\n388:     names: list[str] = []\n389:     for row in data_rows:\n390:         if best_col < len(row):\n391:             name = row[best_col].strip()\n392:             if name:\n393:                 names.append(name)\n394: \n395:     return names\n396: \n397: \n398: def _try_text_content(elements: list[dict]) -> list[dict]:\n399:     \"\"\"\n400:     محاولة استخراج الأصناف من المحتوى النصي.\n401: \n402:     يجمع النصوص من عناصر NarrativeText وTitle ويفصلها بالأسطر.\n403:     \"\"\"\n404:     items: list[dict] = []\n405:     arabic_pattern = re.compile(r\"[\\u0600-\\u06FF]\")\n406: \n407:     for elem in elements:\n408:         text = elem.get(\"text\", \"\").strip()\n409:         if not text:\n410:             continue\n411: \n412:         page = elem.get(\"metadata\", {}).get(\"page_number\")\n413: \n414:         # تقسيم النص إلى أسطر وفحص كل سطر\n415:         for line in text.split(\"\\n\"):\n416:             line = line.strip()\n417:             if not line or len(line) < 3:\n418:                 continue\n419: \n420:             # قبول الأسطر التي تحتوي على نص عربي أو أسماء أدوية (حروف لاتينية + أرقام)\n421:             has_arabic = bool(arabic_pattern.search(line))\n422:             has_drug_chars = bool(re.search(r\"[a-zA-Z]{3,}\", line))\n423: \n424:             if has_arabic or has_drug_chars:\n425:                 items.append({\"item_name_raw\": line, \"source_page\": page})\n426: \n427:     return items\n428: \nThe above content shows the entire, complete file contents of the requested file.\n"}
