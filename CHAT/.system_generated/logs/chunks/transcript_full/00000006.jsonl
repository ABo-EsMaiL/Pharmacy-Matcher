{"step_index":150,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-21T15:59:36Z","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"\"\"\"\nFile handler module - detects file type and routes to appropriate reader.\n\"\"\"\n\nimport json\nfrom pathlib import Path\n\nfrom .excel_reader import read_excel, extract_item_names\nfrom .pdf_reader import extract_items_from_pdf, parse_items_from_response\n\n_EXCEL_EXTENSIONS = {\".xlsx\", \".xls\", \".xlsm\"}\n_PDF_EXTENSIONS = {\".pdf\"}\n_JSON_EXTENSIONS = {\".json\"}\n\n\ndef read_input_files(\n    filepaths: list[Path],\n    role: str,\n    api_key: str | None = None,\n    base_url: str = \"https://transform.unstructured.io\",\n) -> dict[str, list[dict]]:\n    role_label = \"Shortages\" if role == \"shortages\" else \"Warehouse\"\n    print(f\"\\n{'='*60}\")\n    print(f\"[*] Processing {role_label} files ({len(filepaths)} file(s))\")\n    print(f\"{'='*60}\")\n\n    results: dict[str, list[dict]] = {}\n\n    for filepath in filepaths:\n        filepath = Path(filepath)\n        ext = filepath.suffix.lower()\n\n        print(f\"\\n  -> File: {filepath.name} (Type: {ext})\")\n\n        if ext in _EXCEL_EXTENSIONS:\n            items = _process_excel_file(filepath)\n        elif ext in _PDF_EXTENSIONS:\n            items = _process_pdf_file(filepath, api_key, base_url)\n        elif ext in _JSON_EXTENSIONS:\n            items = _process_json_file(filepath)\n        else:\n            raise ValueError(\n                f\"[!] Unsupported extension: {ext}\\n\"\n                f\"    Supported: {', '.join(sorted(_EXCEL_EXTENSIONS | _PDF_EXTENSIONS | _JSON_EXTENSIONS))}\"\n            )\n\n        results[filepath.name] = items\n        print(f\"     Extracted items: {len(items)}\")\n\n    total = sum(len(items) for items in results.values())\n    print(f\"\\n{'='*60}\")\n    print(f\"[+] Completed {role_label}: {total} items from {len(filepaths)} file(s)\")\n    print(f\"{'='*60}\\n\")\n\n    return results\n\n\ndef _process_excel_file(filepath: Path) -> list[dict]:\n    rows = read_excel(filepath)\n    items = extract_item_names(rows, source_file=filepath.name)\n    return items\n\n\ndef _process_pdf_file(\n    filepath: Path,\n    api_key: str | None,\n    base_url: str,\n) -> list[dict]:\n    if not api_key:\n        raise ValueError(\n            f\"[!] Unstructured API Key required for PDF files.\\n\"\n            f\"    Please set UNSTRUCTURED_API_KEY in .env\"\n        )\n\n    items = extract_items_from_pdf(filepath, api_key, base_url)\n    return items\n\n\ndef _process_json_file(filepath: Path) -> list[dict]:\n    \"\"\"Process cached Unstructured JSON to save API limits.\"\"\"\n    with open(filepath, \"r\", encoding=\"utf-8-sig\") as f:\n        data = json.load(f)\n    \n    items = parse_items_from_response(data)\n    \n    doc_name = filepath.name\n    if isinstance(data, dict):\n        doc_name = (data.get(\"source\") or {}).get(\"filename\") or doc_name\n    elif isinstance(data, list) and data:\n        doc_name = (data[0].get(\"metadata\") or {}).get(\"filename\") or doc_name\n\n    for item in items:\n        item[\"source_file\"] = doc_name\n        \n    return items\n","Description":"Translated prints in file_handler to English to fix Powershell display issues","Overwrite":true,"TargetFile":"d:\\AI_Engineer\\Pharmacy-agy\\src\\extract\\file_handler.py","toolAction":"Translating file handler","toolSummary":"File_handler.py translation"}}]}
