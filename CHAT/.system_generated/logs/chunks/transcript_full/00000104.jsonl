at-matched').innerText = matched;\n156:     document.getElementById('stat-notfound').innerText = notfound;\n157:     document.getElementById('stat-review').innerText = review;\n158:     \n159:     if (total > 0) {\n160:         document.getElementById('stat-matched-pct').innerText = Math.round((matched/total)*100) + '%';\n161:         document.getElementById('stat-notfound-pct').innerText = Math.round((notfound/total)*100) + '%';\n162:         document.getElementById('stat-review-pct').innerText = Math.round((review/total)*100) + '%';\n163:     } else {\n164:         document.getElementById('stat-matched-pct').innerText = '0%';\n165:         document.getElementById('stat-notfound-pct').innerText = '0%';\n166:         document.getElementById('stat-review-pct').innerText = '0%';\n167:     }\n168: }\n169: \n170: async function openExcel() {\n171:     if (!currentProcessId) return;\n172:     try {\n173:         await window.pywebview.api.open_excel(currentProcessId);\n174:     } catch (error) {\n175:         showToast('تعذر فتح الملف: ' + error, 'error');\n176:     }\n177: }\n178: \n179: async function openFolder() {\n180:     if (!currentProcessId) return;\n181:     try {\n182:         await window.pywebview.api.open_folder(currentProcessId);\n183:     } catch (error) {\n184:         showToast('تعذر فتح المجلد: ' + error, 'error');\n185:     }\n186: }\n187: \n188: async function applyReviews() {\n189:     if (!currentProcessId) return;\n190:     try {\n191:         const result = await window.pywebview.api.apply_reviews(currentProcessId);\n192:         showToast(`تم تنفيذ التعديلات! نجاح: ${result.success}, فشل: ${result.failed}`, 'success');\n193:         \n194:         // Reload stats if backend provides them\n195:         if (result.new_stats) {\n196:             loadResults(result.new_stats);\n197:         }\n198:     } catch (error) {\n199:         showToast('حدث خطأ أثناء تنفيذ التعديلات', 'error');\n200:     }\n201: }\n202: \n203: // --- History Logic ---\n204: 