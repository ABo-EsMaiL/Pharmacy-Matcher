{"step_index":6702,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-24T14:34:04Z","content":"Created At: 2026-09-24T17:34:04+03:00\nCompleted At: 2026-09-24T17:34:04+03:00\nFile Path: `file:///d:/AI_Engineer/MSEMAX-GAIStudio/app.py`\nTotal Lines: 971\nTotal Bytes: 41919\nShowing lines 1 to 150\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"\"\"\n2: MSEMAX — Google AI Studio Web Hook Gateway (FastAPI Server)\n3: \n4: A 100% free, OpenAI-compatible API gateway that drives the Google AI Studio\n5: Web Interface (https://aistudio.google.com) using a persistent Chromium\n6: browser profile (./chrome_profile).\n7: \n8: No official API key is required. Uses real-time DOM stream capture to\n9: provide instant Server-Sent Events (SSE) responses compatible with any\n10: OpenAI client, LangChain, n8n, etc.\n11: \n12: Default Model: gemini-3.8-flash (Thinking: High)\n13: \n14: Author: Mohamed (MSEMAX) & Antigravity\n15: License: MIT\n16: \"\"\"\n17: \n18: import os\n19: import time\n20: import json\n21: import uuid\n22: import asyncio\n23: import logging\n24: from typing import AsyncGenerator, Optional, Any, List, Dict\n25: from contextlib import asynccontextmanager\n26: \n27: from fastapi import FastAPI, Request, HTTPException, Depends, Header\n28: from fastapi.responses import StreamingResponse, JSONResponse\n29: from fastapi.middleware.cors import CORSMiddleware\n30: from pydantic import BaseModel\n31: from slowapi import Limiter, _rate_limit_exceeded_handler\n32: from slowapi.util import get_remote_address\n33: from slowapi.errors import RateLimitExceeded\n34: from dotenv import load_dotenv\n35: from playwright.async_api import async_playwright, BrowserContext, Page\n36: \n37: # Load environment\n38: load_dotenv()\n39: \n40: logging.basicConfig(\n41:     level=logging.INFO,\n42:     format=\"%(asctime)s - %(name)s - %(levelname)s - %(message)s\"\n43: )\n44: logger = logging.getLogger(\"msemax.webhook\")\n45: \n46: # ------------------------------------------------------------------------------\n47: # Configuration\n48: # ------------------------------------------------------------------------------\n49: API_KEY = os.getenv(\"MSE_MAX_KEY\", \"\").strip()\n50: CHROME_PROFILE_DIR = os.getenv(\"CHROME_PROFILE_DIR\", \"./chrome_profile\")\n51: HEADLESS = os.getenv(\"HEADLESS\", \"true\").lower() in (\"true\", \"1\", \"yes\")\n52: DEFAULT_MODEL = os.getenv(\"DEFAULT_MODEL\", \"gemini-3.8-flash\").strip()\n53: THINKING_MODE = os.getenv(\"THINKING_MODE\", \"high\").strip().lower()\n54: ENABLE_SEARCH_GROUNDING = os.getenv(\"ENABLE_SEARCH_GROUNDING\", \"true\").lower() in (\"true\", \"1\", \"yes\")\n55: CLEAR_CHAT_ON_REQUEST = os.getenv(\"CLEAR_CHAT_ON_REQUEST\", \"false\").lower() in (\"true\", \"1\", \"yes\")\n56: REQUEST_TIMEOUT = float(os.getenv(\"MSE_REQUEST_TIMEOUT\", \"180\"))\n57: RATE_LIMIT = os.getenv(\"MSE_RATE_LIMIT\", \"30/minute\").strip()\n58: MAX_CONCURRENT = int(os.getenv(\"MSE_MAX_CONCURRENT\", \"1\"))\n59: PORT = int(os.getenv(\"PORT\", \"8001\"))\n60: TARGET_URL = \"https://aistudio.google.com/prompts/new_chat\"\n61: \n62: # ------------------------------------------------------------------------------\n63: # Browser Automation Manager (Playwright Persistent Context)\n64: # ------------------------------------------------------------------------------\n65: class WebHookBrowserManager:\n66:     def __init__(self):\n67:         self.playwright = None\n68:         self.context: Optional[BrowserContext] = None\n69:         self.page: Optional[Page] = None\n70:         self.lock = asyncio.Lock()\n71:         self.is_ready = False\n72:         self.is_shutting_down = False\n73: \n74:     async def start(self):\n75:         logger.info(f\"Launching persistent Chromium context from: {CHROME_PROFILE_DIR} (headless={HEADLESS}, start-maximized)\")\n76:         self.playwright = await async_playwright().start()\n77: \n78:         args = [\n79:             \"--disable-blink-features=AutomationControlled\",\n80:             \"--start-maximized\"\n81:         ]\n82: \n83:         try:\n84:             self.context = await self.playwright.chromium.launch_persistent_context(\n85:                 user_data_dir=CHROME_PROFILE_DIR,\n86:                 headless=HEADLESS,\n87:                 no_viewport=True,\n88:                 args=args\n89:             )\n90:         except Exception as e:\n91:             logger.error(f\"Failed to launch browser: {e}\")\n92:             logger.error(\"Please ensure no other Chromium process is currently using ./chrome_profile.\")\n93:             raise e\n94: \n95:         self.page = self.context.pages[0] if self.context.pages else await self.context.new_page()\n96: \n97:         # Removed stealth.min.js injection. \n98:         # Relying entirely on native Playwright events and default browser state to pass BotGuard.\n99: \n100:         # Attach network response listener to capture any Google backend errors\n101:         async def handle_response(response):\n102:             try:\n103:                 url = response.url\n104:                 if any(k in url.lower() for k in [\"alkali\", \"generatecontent\", \"runprompt\", \"clients6.google.com\", \"streamgeneratecontent\"]):\n105:                     if response.status >= 400:\n106:                         try:\n107:                             body = await response.text()\n108:                             logger.error(f\"[Google Backend Error {response.status}] URL: {url[:80]} | Response Body: {body[:600]}\")\n109:                         except Exception:\n110:                             logger.error(f\"[Google Backend Error {response.status}] URL: {url[:80]}\")\n111:                     elif \"generatecontent\" in url.lower() or \"runprompt\" in url.lower():\n112:                         logger.info(f\"[Google Backend Status {response.status}] URL: {url[:80]}\")\n113:             except Exception:\n114:                 pass\n115: \n116:         self.page.on(\"response\", handle_response)\n117:         self.page.on(\"pageerror\", lambda err: logger.warning(f\"[Browser Page Error]: {err}\"))\n118: \n119:         logger.info(f\"Navigating to {TARGET_URL} to ensure clean environment...\")\n120:         try:\n121:             await self.page.goto(TARGET_URL, timeout=60000, wait_until=\"domcontentloaded\")\n122:             await asyncio.sleep(2)\n123:         except Exception as e:\n124:             logger.warning(f\"Initial page navigation warning: {e}. Page will be ready on demand.\")\n125: \n126:         self.is_ready = True\n127:         logger.info(\"Google AI Studio web page ready!\")\n128:         \n129:         await self.ensure_thinking_mode()\n130: \n131:     async def ensure_thinking_mode(self):\n132:         \"\"\"Ensures the Thinking Mode is set correctly on the current page.\"\"\"\n133:         if not THINKING_MODE or not self.page or self.page.is_closed():\n134:             return\n135:             \n136:         try:\n137:             thinking_select = self.page.locator('mat-select[aria-label=\"Thinking Level\"]')\n138:             \n139:             # Wait a bit for the UI to load it (up to 10 seconds)\n140:             try:\n141:                 await thinking_select.wait_for(state=\"visible\", timeout=10000)\n142:             except Exception:\n143:                 logger.debug(\"Thinking Level selector not found or not visible yet.\")\n144:                 return\n145: \n146:             if await thinking_select.count() > 0:\n147:                 current_thinking = await thinking_select.inner_text()\n148:                 if THINKING_MODE.lower() not in current_thinking.lower():\n149:                     logger.info(f\"Changing Thinking Level from '{current_thinking.strip()}' to '{THINKING_MODE}'...\")\n150:                     await thi