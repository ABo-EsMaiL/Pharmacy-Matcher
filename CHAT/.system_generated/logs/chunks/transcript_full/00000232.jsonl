ct\"\r\n155:             \r\n156:     # 2. Combination check (كو / بلس)\r\n157:     if has_co(req) != has_co(cand):\r\n158:         return \"reject\", \"combination_mismatch\"\r\n159:         \r\n160:     # 3. Strength check (التركيز خط أحمر - zero tolerance)\r\n161:     str_r = get_strength_pattern(req)\r\n162:     str_c = get_strength_pattern(cand)\r\n163:     if str_r and str_c:\r\n164:         try:\r\n165:             if float(str_r) != float(str_c):\r\n166:                 return \"reject\", f\"strength_conflict_{str_r}_vs_{str_c}\"\r\n167:         except:\r\n168:             if str_r != str_c:\r\n169:                 return \"reject\", f\"strength_conflict_{str_r}_vs_{str_c}\"\r\n170:                 \r\n171:     slash_r = re.search(r'(?:^|[^\\d/])(\\d+(?:\\.\\d+)?\\/\\d+(?:\\.\\d+)?)(?:[^\\d/]|$)', norm_num(req))\r\n172:     slash_c = re.search(r'(?:^|[^\\d/])(\\d+(?:\\.\\d+)?\\/\\d+(?:\\.\\d+)?)(?:[^\\d/]|$)', norm_num(cand))\r\n173:     if slash_r and slash_c and slash_r.group(1) != slash_c.group(1):\r\n174:         return \"reject\", \"slash_strength_conflict\"\r\n175:     if (slash_r and not slash_c) or (slash_c and not slash_r):\r\n176:         return \"reject\", \"slash_missing_conflict\"\r\n177: \r\n178:     # 4. Brand Similarity & Identity\r\n179:     b_sim = fuzz.ratio(brand_r, brand_c)\r\n180:     is_exact_brand = (brand_r == brand_c)\r\n181:     \r\n182:     if not is_exact_brand:\r\n183:         # Check if difference is strictly the Arabic definite article 'ال'\r\n184:         if (brand_r.startswith('ال') and brand_r[2:] == brand_c) or \\\r\n185:            (brand_c.startswith('ال') and brand_c[2:] == brand_r):\r\n186:             is_exact_brand = True\r\n187:             \r\n188:     if not is_exact_brand:\r\n189:         if b_sim >= 60:\r\n190:             return \"ambiguous\", f\"ocr_check_needed_{b_sim:.1f}%\"\r\n191:         else:\r\n192:             return \"reject\", f\"low_brand_sim_{b_sim:.1f}%\"\r\n193: \r\n194:     # 5. Form check for confirmed brand:\r\n195:     form_r = extract_form_group(req)\r\n196:     form_c = extract_form_group(cand)\r\n197:     \r\n198:     is_r_drops = 'نقط' in req or 'قطره' in req or 'قطرة' in req\r\n199:     is_c_drops = 'نقط' in cand or 'قطره' in cand or 'قطرة' in cand\r\n200:     is_drops_conflict = (is_r_drops != is_c_drops)\r\n201:     \r\n202:     is_req_syrup = bool(re.search(r'\\b(شراب|شرب|معلق)\\b', req))\r\n203:     is_cand_syrup = bool(re.search(r'\\b(شراب|شرب|معلق)\\b', cand))\r\n204:     is_syrup_conflict = (is_req_syrup != is_cand_syrup)\r\n205:     \r\n206:     if are_forms_identical(form_r, form_c) and not is_drops_conflict and not is_syrup_conflict:\r\n207:         return \"match\", \"exact_brand_and_form\"\r\n208:     else:\r\n209:         return \"review\", f\"different_form_{form_r}_vs_{form_c}\"\r\n210: \r\n211: def is_safe_auto_match(req: str, cand: str) -> tuple[bool, str]:\r\n212:     status, reason = classify_pair(req, cand)\r\n213:     return (status == \"match\", reason)\r\n214: \r\n215: class FastCoordinator:\r\n216:     def __init__(self, config: Config):\r\n217:         self.config = config\r\n218: \r\n219:     def process(self, shortage_items: list[dict], warehouse_data: dict[str, list[dict]]) -> dict:\r\n220:         unique_shortages = {}\r\n221:         for item in shortage_items:\r\n222:             name = item.get(\"item_name_raw\", \"\")\r\n223:             if name and name not in unique_shortages:\r\n224:                 unique_shortages[name] = item\r\n225:                 \r\n226:         deduped_shortages = list(unique_shortages.values())\r\n227: \r\n228:         print(f\"\\n{'='*60}\")\r\n229:         print(f\"[FAST ENGINE] Starting Match: {len(shortage_items)} raw -> {len(deduped_shortages)} UNIQUE shortages x {len(warehouse_data)} warehouses\")\r\n230:         print(f\"{'='*60}\\n\")\r\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, 