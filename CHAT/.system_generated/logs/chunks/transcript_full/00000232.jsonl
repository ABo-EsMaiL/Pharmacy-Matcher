كجم)', text)\r\n75:     if m:\r\n76:         val = m.group(1)\r\n77:         unit = m.group(2)\r\n78:         if unit in ['جم', 'جرام', 'gm']:\r\n79:             # Pharmacological rule: tablets/capsules/pills never come in multi-gram dosages (>=5g).\r\n80:             # In Egyptian warehouse price lists, '10 جم اقراص' is a common shorthand for 10 mg (not 10,000 mg!).\r\n81:             is_oral_solid = bool(re.search(r'\\b(اقراص|قرص|كبسول|كبسوله|حبوب|تابلت|اقراض)\\b', text))\r\n82:             try:\r\n83:                 num_val = float(val)\r\n84:                 if is_oral_solid and num_val >= 5:\r\n85:                     pass  # Keep as is (mg)\r\n86:                 else:\r\n87:                     val = str(num_val * 1000)\r\n88:             except:\r\n89:                 pass\r\n90:         return val\r\n91:     m2 = re.search(r'\\b(1000|875|625|500|400|300|250|200|150|125|100|80|75|50|40|25|20|15|10|5|2.5|1)\\b', text)\r\n92:     if m2:\r\n93:         return m2.group(1)\r\n94:     if 'ربع' in text or '25.' in text:\r\n95:         return '0.25'\r\n96:     if 'نص' in text or 'نصف' in text or '.5' in text or '0.5' in text:\r\n97:         return '0.5'\r\n98:     return None\r\n99: \r\n100: def has_co(text: str) -> bool:\r\n101:     t = text.lower()\r\n102:     return bool(re.search(r'(?:^|[^\\w])(كو|بلس|بلاس|كومب|co|plus|comp)(?:[^\\w]|$)|كواقراص|كوأقراص|بلساقراص|بلسكبسول', t))\r\n103: \r\n104: def are_forms_identical(form1: str | None, form2: str | None) -> bool:\r\n105:     if not form1 or not form2:\r\n106:         return True\r\n107:     if form1 == form2:\r\n108:         return True\r\n109:     if (form1, form2) in {('tablet', 'capsule'), ('capsule', 'tablet')}:\r\n110:         return True\r\n111:     return False\r\n112: \r\n113: def are_forms_compatible(form1: str | None, form2: str | None) -> bool:\r\n114:     if not form1 and not form2:\r\n115:         return True\r\n116:     if form1 == form2:\r\n117:         return True\r\n118:     compat = {\r\n119:  