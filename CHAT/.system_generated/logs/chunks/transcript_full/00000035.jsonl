 process_id = self.db.create_process(shortage_filenames, warehouse_filenames)\n235:             \n236:             thread = threading.Thread(target=self._process_worker, args=(process_id, shortage_paths, warehouse_paths))\n237:             thread.start()\n238:             \n239:             return {\"success\": True, \"process_id\": process_id}\n240:             \n241:         except Exception as e:\n242:             return {\"success\": False, \"error\": str(e)}\n243: \n244:     def restart_process(self, process_id: str) -> dict:\n245:         try:\n246:             workspace = PROJECT_ROOT / 'data' / 'inputs' / process_id\n247:             if not workspace.exists():\n248:                 return {\"success\": False, \"error\": \"ملفات العملية غير موجودة لإعادة التشغيل\"}\n249:             \n250:             # get process details\n251:             cursor = self.db.conn.cursor()\n252:             cursor.execute('SELECT shortage_files, warehouse_files FROM processes WHERE id = ?', (process_id,))\n253:             row = cursor.fetchone()\n254:             if not row:\n255:                 return {\"success\": False, \"error\": \"العملية غير موجودة\"}\n256:                 \n257:             shortage_filenames = json.loads(row['shortage_files'])\n258:             warehouse_filenames = json.loads(row['warehouse_files'])\n259:             \n260:             shortage_paths = [str(workspace / name) for name in shortage_filenames]\n261:             warehouse_paths = [str(workspace / name) for name in warehouse_filenames]\n262:             \n263:             # Reset status\n264:             self.db.update_process_status(process_id, 'processing')\n265:             \n266:             thread = threading.Thread(target=self._process_worker, args=(process_id, shortage_paths, warehouse_paths, True))\n267:             thread.daemon = True\n268:             thread.start()\n269:             \n270:             return {\"success\": True, \"process_id\": process_id}\n271:         except E