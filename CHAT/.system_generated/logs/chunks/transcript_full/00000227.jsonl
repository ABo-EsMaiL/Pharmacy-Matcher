\n                    text === 'stop' || text.includes('stop run') || text.includes('stop generat') || text === 'cancel run' || \n                    tooltip.includes('stop')\n                );\n                \n                const isEnabled = !b.disabled && b.getAttribute('aria-disabled') !== 'true' && !b.classList.contains('mat-button-disabled');\n                return isCancel && isEnabled;\n            });\n\n            // Active spinners indicating model thinking or DOM streaming\n            const hasSpinner = document.querySelector(\n                'mat-progress-spinner, .typing-indicator, ms-spinner, .thought-activity-host[aria-expanded=\"true\"], [data-test-id*=\"spinner\" i]'\n            ) !== null;\n\n            // Check if Run button is present and currently disabled (indicates turn finished / prompt textarea empty)\n            const runBtn = document.querySelector('button.ctrl-enter, button[mattooltipclass=\"run-button-tooltip\"]') ||\n                           allButtons.find(b => {\n                               const a = (b.getAttribute('aria-label') || '').toLowerCase();\n                               const t = (b.innerText || '').trim().toLowerCase();\n                               return t === 'run' || a === 'run';\n                           });\n            \n            const isRunDisabled = runBtn ? (runBtn.disabled || runBtn.getAttribute('aria-disabled') === 'true' || runBtn.classList.contains('mat-button-disabled')) : false;\n\n            const isRunning = Boolean(cancelBtn) || hasSpinner;\n\n            // Check for internal errors and tool call errors\n            let hasError = false;\n            let errorText = \"\";\n            const alertEl = document.querySelector('mat-snack-bar-container, .toast, [role=\"alert\"]');\n            if (alertEl) {\n                const atxt = (alertEl.innerText || alertEl.textContent || '').toLowerCase();\n                if (atxt.includes('permission denied') || atxt.includes('internal