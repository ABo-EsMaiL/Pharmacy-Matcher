t generating within {t_cfg['initial_start_timeout']:.0f}s]\"}\n                        break\n\n            # ------------------------------------------------------------------\n            # 2. State: RESPONSE_IN_PROGRESS\n            # ------------------------------------------------------------------\n            if current_state == self.STATE_RESPONSE_IN_PROGRESS:\n                # Milestone: First token/character detected\n                if len(current_text) > 0 and t_first_token is None:\n                    t_first_token = now\n                    logger.info(f\"[{case_count} cases] First token/character detected at {t_first_token - t_submit:.2f}s (len: {len(current_text)})\")\n\n                # Character growth detection\n                if len(current_text) > len(prev_text):\n                    delta = current_text[len(prev_text):]\n                    prev_text = current_text\n                    t_last_growth = now\n                    stability_start_time = None  # Reset stability timer when text actively grows\n                    yield {\"delta\": delta, \"text\": current_text}\n                else:\n                    # No character growth on this tick\n                    if len(current_text) == 0:\n                        # Model is still thinking / waiting to emit first token\n                        if (now - t_submit) > t_cfg[\"first_token_timeout\"]:\n                            if not is_running:\n                                logger.error(f\"[{case_count} cases] Model stopped without producing tokens after {now - t_submit:.1f}s.\")\n                                yield {\"delta\": \"\", \"text\": f\"[Error: FIRST_TOKEN_TIMEOUT - Model finished without producing any text after {now - t_submit:.1f}s]\"}\n                            else:\n                                logger.error(f\"[{case_count} cases] Model thinking exceeded first_token_timeout ({t_cfg['first_token_timeout']:.0f}s).\")\n                                yield {\"delta\": \"\", \"text\": f\"[Error: FIRST_TOKEN_TIMEOUT - Model stayed in thinking for >{t_cfg['first_token_timeout']:.0f}s without generating tokens]\"}\n                            break\n                    else:\n                        # Text has been emitted (len > 0), but did not grow on this tick\n                        if not is_running:\n                            # Generation has stopped running: check stability duration\n                            if stability_start_time is None:\n                                stability_start_time = now\n                            elif (now - stability_start_time) >= t_cfg[\"stability_duration\"]:\n                                # Stable for required duration!\n                                current_state = self.STATE_RESPONSE_COMPLETED\n                                logger.info(\n                                    f\"[{case_count} cases] State -> RESPONSE_COMPLETED via stability \"\n                                    f\"({t_cfg['stability_duration']:.1f}s stable at {len(current_text)} chars)\"\n                                )\n                                yield {\"delta\": \"\", \"text\": current_text}\n                                break\n                        else:\n                            # is_running is True: NEVER timeout while running, EXCEPT stagnation guardrail\n                            stability_start_time = None\n                            if (now - t_last_growth) > t_cfg[\"stagnation_timeout\"]:\n                                logger.error(f\"[{case_count} cases] Stagnation: no character growth for {t_cfg['stagnation_timeout']:.0f}s while running.\")\n                                yield {\"delta\": \"\", \"text\": f\"[Error: STAGNATION_TIMEOUT - Text generation stalled for {t_cfg['stagnation_timeout']:.0f}s]\"}\n                                break\n\n                    # Always yield the current state so non-streaming callers can access text\n                    yield {\"delta\