�د المسارات والملف\r\n9: PDF_PATH = Path(r\"D:\\AI_Engineer\\Pharmacy-agy\\data\\processes\\PROC-015\\input_warehouses\\المكرومي المنصورة.pdf\")\r\n10: ENDPOINT_URL = \"http://127.0.0.1:8001/v1/chat/completions\"\r\n11: API_KEY = \"[REDACTED_CREDENTIAL]\"\r\n12: \r\n13: print(f\"[*] جاري قراءة ملف: {PDF_PATH.name}\")\r\n14: pdf = pdfium.PdfDocument(PDF_PATH)\r\n15: page_1 = pdf[0]\r\n16: \r\n17: # 2. تحويل الصفحة 1 إلى صورة عالية الجودة وصغيرة الحجم (WebP)\r\n18: print(\"[*] تحويل الصفحة الأولى إلى صورة WebP عالية الدقة...\")\r\n19: image = page_1.render(scale=2.5).to_pil()\r\n20: temp_img_path = Path(\"temp_page1_test.webp\")\r\n21: image.save(temp_img_path, format=\"WEBP\", quality=85)\r\n22: print(f\"[+] تم إنشاء الصورة: {temp_img_path.name} (الحجم: {temp_img_path.stat().st_size / 1024:.1f} KB)\")\r\n23: \r\n24: # 3. تحويل الصورة إلى Base64\r\n25: with open(temp_img_path, \"rb\") as f:\r\n26:     img_b64 = base64.b64encode(f.read()).decode(\"utf-8\")\r\n27: \r\n28: # 4. الـ Prompt الصارم للاستخراج\r\n29: prompt_text = (\r\n30:     \"أنت خبير صيدلي متخصص في استخراج بيانات فواتير وقوائم الأدوية.\\n\"\r\n31:     \"قم باستخراج جميع أسماء الأدوية والمنتجات الطبية الموجودة في هذه الصورة بدقة كاملة.\\n\"\r\n32:     \"القواعد:\\n\"\r\n33:     \"1. انقل اسم الصنف كاملاً في (item_name_raw) متضمناً الاسم والتركيز والهيئة والشركة، وتجاهل الأسعار والكميات.\\n\"\r\n34:     \"2. الحروف باللغة العربية السليمة فقط (كاف وباء عربية).\\n\"\r\n35:     \"3. الرد بصيغة JSON فقط: {\\\"items\\\": [{\\\"item_name_raw\\\": \\\"...\\\", \\\"source_page\\\": 1}]}\"\r\n36: )\r\n37: \r\n38: # 5. تجهيز الـ Payload\r\n39: payload = {\r\n40:     \"model\": \"gemini-3.8-flash\",\r\n41:     \"messages\": [\r\n42:         {\r\n43:             \"role\": \"user\",\r\n44:             \"content\": [\r\n45:                 {\"type\": \"text\", \"text\": prompt_text},\r\n46:                 {\r\n47:                     \"type\": \"image_url\",\r\n48:                     \"image_url\": {\r\n49:                         \"url\": f\"data:image/webp;base64,{img_b64}\"\r\n50:                     }\r\n51:                 }\r\n52:             ]\r\n53:         }\r\n54:     ],\r\n55:     \"stream\": False\r\n56: }\r\n57: \r\n58: headers = {\r\n59:     \"Authorization\": f\"Bearer {API_KEY}\",\r\n60:     \"Content-Type\": \"application/json\"\r\n61: }\r\n62: \r\n63: print(f\"[*] إرسال الطلب إلى الـ Endpoint ({ENDPOINT_URL})...\")\r\n64: print(\"    راقب الآن نافذة المتصفح المفتوحة أمامك لترى هل استلم الصورة والبرومبت!\")\r\n65: \r\n66: t0 = time.time()\r\n67: try:\r\n68:     resp = requests.post(ENDPOINT_URL, json=payload, headers=headers, timeout=180)\r\n69:     print(f\"[+] Response Status: {resp.status_code} (استغرق {time.time() - t0:.1f} ثانية)\")\r\n70:     \r\n71:     if resp.status_code == 200:\r\n72:         data = resp.json()\r\n73:         content = data[\"choices\"][0][\"message\"][\"content\"]\r\n74:         print(\"\\n=== الرد المستلم من الـ Endpoint ===\")\r\n75:         print(content[:500] + \"...\\n(باقي الرد تم استلامه بنجاح)\")\r\n76:     else:\r\n77:         print(f\"[!] خطأ من الـ Gateway: {resp.status_code}\")\r\n78:         print(resp.text)\r\n79: except Exception as e:\r\n80:     print(f\"[!] فشل الاتصال بالـ Endpoint: {e}\")\nThe above content shows the entire, complete file contents of the requested file.\n"}
