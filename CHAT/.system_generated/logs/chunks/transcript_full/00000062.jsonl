مطابقة: ') + data.error, 'error');\n2100:         }\n2101:     }\n2102: });\n2103: \n2104: // --- Results Logic ---\n2105: function loadResults(stats) {\n2106:     if (!stats) return;\n2107:     const total = stats.total ?? stats.total_shortages ?? 0;\n2108:     const matched = stats.matched ?? stats.matched_count ?? 0;\n2109:     const notfound = stats.not_found ?? stats.not_found_count ?? 0;\n2110:     const review = stats.review ?? stats.review_count ?? 0;\n2111:     \n2112:     document.getElementById('stat-total').innerText = total;\n2113:     document.getElementById('stat-matched').innerText = matched;\n2114:     document.getElementById('stat-notfound').innerText = notfound;\n2115:     document.getElementById('stat-review').innerText = review;\n2116:     \n2117:     if (total > 0) {\n2118:         document.getElementById('stat-matched-pct').innerText = Math.round((matched/total)*100) + '%';\n2119:         document.getElementById('stat-notfound-pct').innerText = Math.round((notfound/total)*100) + '%';\n2120:         document.getElementById('stat-review-pct').innerText = Math.round((review/total)*100) + '%';\n2121:     } else {\n2122:         document.getElementById('stat-matched-pct').innerText = '0%';\n2123:         document.getElementById('stat-notfound-pct').innerText = '0%';\n2124:         document.getElementById('stat-review-pct').innerText = '0%';\n2125:     }\n2126: }\n2127: \n2128: async function openExcel() {\n2129:     if (!currentProcessId) return;\n2130:     try {\n2131:         await window.pywebview.api.open_excel(currentProcessId);\n2132:     } catch (error) {\n2133:         showToast('تعذر فتح الملف: ' + error, 'error');\n2134:     }\n2135: }\n2136: \n2137: async function openFolder() {\n2138:     if (!currentProcessId) return;\n2139:     try {\n2140:         await window.pywebview.api.open_folder(currentProcessId);\n2141:     } catch (error) {\n2142:         showToast('تعذر فتح المجلد: ' + error, 'error');\n2143:     }\n2144: }\n2145: \n2146: async function rerunMatching() {\n2147:     if (!currentProcessId) {\n2148:         showToast(currentLang === 'en' ? 'No active process to re-run' : 'لا توجد عملية نشطة لإعادة تشغيلها', 'warning');\n2149:         return;\n2150:     }\n2151:     \n2152:     showCustomConfirm(\n2153:         currentLang === 'en' ? 'Re-run Matching' : 'إعادة المطابقة',\n2154:         currentLang === 'en' ? 'Do you want to re-run the matching process using the current files?' : 'هل ترغب في إعادة تشغيل عملية المطابقة لنفس الملفات الحالية؟',\n2155:         async () => {\n2156:             const progressModal = document.getElementById('progress-modal');\n2157:             const progressText = document.getElementById('progress-text');\n2158:             const pb = document.getElementById('progress-bar-fill');\n2159:             \n2160:             pb.style.width = '10%';\n2161:             progressText.innerText = currentLang === 'en' ? 'Re-running matching...' : 'جاري إعادة المطابقة...';\n2162:             progressModal.style.display = 'flex';\n2163:             startProgressTimer();\n2164:             \n2165:             try {\n2166:                 const res = await window.pywebview.api.rerun_process(currentProcessId);\n2167:                 if (!res.success) {\n2168:                     throw new Error(res.error || 'Failed to start re-run');\n2169:                 }\n2170:             } catch (err) {\n2171:                 stopProgressTimer();\n2172:                 progressModal.style.display = 'none';\n2173:                 showToast((currentLang === 'en' ? 'Re-run failed: ' : 'فشلت إعادة المطابقة: ') + err, 'error');\n2174:             }\n2175:         }\n2176:     );\n2177: }\n2178: \n2179: async function applyReviews() {\n2180:     if (!currentProcessId) return;\n2181:     try {\n2182:         const result = await window.pywebview.api.apply_reviews(currentProcessId);\n2183:         showToast(`تم تنفيذ التعديلات! نجاح: ${result.success}, فشل: ${result.failed}`, 'success');\n2184:         \n2185:         if (result.new_stats) {\n2186:             loadResults(result.new_stats);\n2187:         }\n2188:     } catch (error) {\n2189:         showToast(currentLang === 'en' ? 'Error applying changes' : 'حدث خطأ أثناء تنفيذ التعديلات', 'error');\n2190:     }\n2191: }\n2192: \n2193: // --- History Logic ---\n2194: async function loadHistory() {\n2195:     const listEl = document.getElementById('history-list');\n2196:     listEl.innerHTML = '<div class=\"spinner\"></div>';\n2197:     const t = I18N[currentLang] || I18N.ar;\n2198:     \n2199:     try {\n2200:         const historyStr = await window.pywebview.api.get_history();\n2201:         const history = JSON.parse(historyStr);\n2202:         \n2203:         if (!history || history.length === 0) {\n2204:             listEl.innerHTML = `<div class=\"empty-state\"><i class=\"ph-fill ph-empty\"></i><p>${t.history_empty}</p></div>`;\n2205:             return;\n2206:         }\n2207:         \n2208:         listEl.innerHTML = '';\n2209:         history.forEach(item => {\n2210:             const date = new Date(item.created_at).toLocaleString(currentLang === 'ar' ? 'ar-EG' : 'en-US');\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
{"step_index":2793,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-22T12:54:37Z","thinking":"A global flag, initialized to false, controls process execution. Both submit and restart functions check this flag before starting, preventing concurrent executions. The flag is set to true at the start of each function and reset to false upon completion, whether successful or erroneous.\n\n\nThe system now employs a process-running flag to prevent concurrent executions of the matching function; a toast message indicates an active process. The `applyReviews` function retrieves and displays review application results, handling success and failure states including appropriate error messages. Upon successful application, it updates relevant data displays based on returned statistics and refreshes the history.\n\n\n","tool_calls":[{"name":"replace_file_content","args":{"AllowMultiple":false,"Description":"Update rerunMatching and applyReviews in index.html","EndLine":2195,"Instruction":"Update rerunMatching to set isProcessRunning and applyReviews to format clear toast and load new_stats","ReplacementContent":"let isProcessRunning = false;\n\nasync function rerunMatching() {\n    if (!currentProcessId) {\n        showToast(currentLang === 'en' ? 'No active process to re-run' : 'لا توجد عملية نشطة لإعادة تشغيلها', 'warning');\n        return;\n    }\n    if (isProcessRunning) {\n        showToast(currentLang === 'en' ? 'A matching process is currently running. Please wait.' : 'توجد عملية مطابقة قيد التشغيل حالياً، يرجى الانتظار حتى تنتهي', 'warning');\n        return;\n    }\n    \n    showCustomConfirm(\n        currentLang === 'en' ? 'Re-run Matching' : 'إعادة المطابقة',\n        currentLang === 'en' ? 'Do you want to re-run the matching process using the current files?' : 'هل ترغب في إعادة تشغيل عملية المطابقة لنفس الملفات الحالية؟',\n        async () => {\n            const progressModal = document.getElementById('progress-modal');\n            const progressText = document.getElementById('progress-text');\n            const pb = document.getElementById('progress-bar-fill');\n            \n            isProcessRunning = true;\n            pb.style.width = '10%';\n            progressText.innerText = currentLang === 'en' ? 'Re-running matching...' : 'جاري إعادة المطابقة...';\n            progressModal.style.display = 'flex';\n            startProgressTimer();\n            \n            const termEl = document.getElementById('pipeline-log-terminal');\n            if (termEl) termEl.innerHTML += `\\n[System] Re-running matching for process ${currentProcessId}...\\n`;\n            \n            try {\n                const res = await window.pywebview.api.rerun_process(currentProcessId);\n                if (!res.success) {\n                    throw new Error(res.error || 'Failed to start re-run');\n                }\n                showToast(currentLang === 'en' ? 'Re-run started in background' : 'تم بدء إعادة المطابقة', 'success');\n            } catch (err) {\n                isProcessRunning = false;\n                stopProgressTimer();\n                progressModal.style.display = 'none';\n                showToast((currentLang === 'en' ? 'Re-run failed: ' : 'فشلت إعادة المطابقة: ') + err, 'error');\n            }\n        }\n    );\n}\n\nasync function applyReviews() {\n    if (!currentProcessId) return;\n    try {\n        const result = await window.pywebview.api.apply_reviews(currentProcessId);\n        if (result.success) {\n            const msg = currentLang === 'en'\n                ? `Changes applied! Confirmed: ${result.matched}, Rejected: ${result.rejected}, Remaining: ${result.remaining}`\n                : `تم تنفيذ التعديلات! تم اعتماد: ${result.matched} مطابق، ${result.rejected} غير متوفر، والمتبقي للمراجعة: ${result.remaining}`;\n            showToast(msg, 'success');\n            \n            if (result.new_stats) {\n                loadResults(result.new_stats);\n            }\n            if (typeof loadHistory === 'function') {\n                loadHistory();\n            }\n        } else {\n            showToast((currentLang === 'en' ? 'Failed: ' : 'فشل تنفيذ التعديل: ') + (result.error || ''), 'error');\n        }\n    } catch (error) {\n        showToast((currentLang === 'en' ? 'Error applying changes: ' : 'حدث خطأ أثناء تنفيذ التعديلات: ') + error, 'error');\n    }\n}","StartLine":2145,"TargetContent":"async function rerunMatching() {\n    if (!currentProcessId) {\n        showToast(currentLang === 'en' ? 'No active process to re-run' : 'لا توجد عملية نشطة لإعادة تشغيلها', 'warning');\n        return;\n    }\n    \n    showCustomConfirm(\n        currentLang === 'en' ? 'Re-run Matching' : 'إعادة المطابقة',\n        currentLang === 'en' ? 'Do you want to re-run the matching process using the current files?' : 'هل ترغب في إعادة تشغيل عملية المطابقة لنفس الملفات الحالية؟',\n        async () => {\n            const progressModal = document.getElementById('progress-modal');\n            const progressText = document.getElementById('progress-text');\n            const pb = document.getElementById('progress-bar-fill');\n            \n            pb.style.width = '10%';\n            progressText.innerText = currentLang === 'en' ? 'Re-running matching...' : 'جاري إعادة المطابقة...';\n            progressModal.style.display = 'flex';\n            startProgressTimer();\n            \n            try {\n                const res = await window.pywebview.api.rerun_process(currentProcessId);\n                if (!res.success) {\n                    throw new Error(res.error || 'Failed to start re-run');\n                }\n            } catch (err) {\n                stopProgressTimer();\n                progressModal.style.display = 'none';\n                showToast((currentLang === 'en' ? 'Re-run failed: ' : 'فشلت إعادة المطابقة: ') + err, 'error');\n            }\n        }\n    );\n}\n\nasync function applyReviews() {\n    if (!currentProcessId) return;\n    try {\n        const result = await window.pywebview.api.apply_reviews(currentProcessId);\n        showToast(`تم تنفيذ التعديلات! نجاح: ${result.success}, فشل: ${result.failed}`, 'success');\n        \n        if (result.new_stats) {\n            loadResults(result.new_stats);\n        }\n    } catch (error) {\n        showToast(currentLang === 'en' ? 'Error applying changes' : 'حدث خطأ أثناء تنفيذ التعديلات', 'error');\n    }\n}","TargetFile":"d:/AI_Engineer/Pharmacy-agy/desktop_app/templates/index.html","toolAction":"Updating rerunMatching and applyReviews","toolSummary":"Update rerunMatching and applyReviews in index.html"}}]}
