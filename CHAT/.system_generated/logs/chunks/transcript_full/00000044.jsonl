gArea = document.getElementById('system-logs');\n1199:         if (logArea) {\n1200:             logArea.value = logs.join('\\n') + (logs.length ? '\\n' : '');\n1201:             logArea.scrollTop = logArea.scrollHeight;\n1202:         }\n1203:     } catch (e) {\n1204:         console.error(e);\n1205:     }\n1206: }\n1207: \n1208: // Toast Notifications\n1209: function showToast(message, type = 'success') {\n1210:     const container = document.getElementById('toast-container');\n1211:     const toast = document.createElement('div');\n1212:     toast.className = `toast ${type}`;\n1213:     \n1214:     const icon = type === 'success' ? 'ph-check-circle' : 'ph-warning-circle';\n1215:     toast.innerHTML = `<i class=\"ph-fill ${icon}\"></i> <span>${message}</span>`;\n1216:     \n1217:     container.appendChild(toast);\n1218:     \n1219:     setTimeout(() => {\n1220:         toast.style.animation = 'fadeOut 0.3s ease forwards';\n1221:         setTimeout(() => toast.remove(), 300);\n1222:     }, 3000);\n1223: }\n1224: \n1225: // Exit App\n1226: async function exitApp() {\n1227:     try {\n1228:         let isRunning = false;\n1229:         if (window.pywebview && window.pywebview.api) {\n1230:             const historyStr = await window.pywebview.api.get_history();\n1231:             const history = JSON.parse(historyStr);\n1232:             isRunning = history.some(item => item.status === 'processing');\n1233:         }\n1234:         \n1235:         if (isRunning) {\n1236:             showCustomConfirm('تأكيد الإغلاق', 'توجد عمليات مطابقة قيد التشغيل في الخلفية. هل أنت متأكد من الإغلاق؟', async () => {\n1237:                 await window.pywebview.api.exit_app();\n1238:             });\n1239:         } else {\n1240:             if (window.pywebview && window.pywebview.api) {\n1241:                 await window.pywebview.api.exit_app();\n1242:             }\n1243:         }\n1244:     } catch (e) {\n1245:         console.error(e);\n1246:         // Fallback\n1247:         if (window.pywebview && window.pywebview.api) {\n1248:             window.pywebview.api.exit_app();\n1249:         }\n1250:     }\n1251: }\n1252: \n1253: // Delete Process\n1254: function deleteProcess(processId) {\n1255:     showCustomConfirm('تأكيد الحذف', 'هل أنت متأكد من حذف هذه العملية نهائياً من السجل؟', async () => {\n1256:         try {\n1257:             const res = await window.pywebview.api.delete_process(processId);\n1258:             if (res.success) {\n1259:                 showToast('تم الحذف بنجاح', 'success');\n1260:                 loadHistory();\n1261:             } else {\n1262:                 showToast('خطأ: ' + res.error, 'error');\n1263:             }\n1264:         } catch (error) {\n1265:             showToast('خطأ في الحذف', 'error');\n1266:         }\n1267:     });\n1268: }\n1269: \n1270: // --- Drag & Drop Logic ---\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
