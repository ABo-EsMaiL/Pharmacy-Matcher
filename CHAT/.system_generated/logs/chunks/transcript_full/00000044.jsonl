     // Very simple heuristic to advance progress bar based on text\n1791:             let pct = 10;\n1792:             if (data.message.includes('استخراج') || data.message.includes('Extracting')) pct = 30;\n1793:             if (data.message.includes('مطابقة') || data.message.includes('Matching')) pct = 60;\n1794:             if (data.message.includes('حفظ') || data.message.includes('Saving')) pct = 90;\n1795:             pb.style.width = pct + '%';\n1796:         }\n1797:     }\n1798: });\n1799: \n1800: window.addEventListener('process_complete', (e) => {\n1801:     const data = e.detail;\n1802:     \n1803:     if (data.process_id === currentProcessId) {\n1804:         const btn = document.getElementById('btn-submit');\n1805:         const progressModal = document.getElementById('progress-modal');\n1806:         \n1807:         btn.classList.remove('hidden');\n1808:         progressModal.style.display = 'none';\n1809:         \n1810:         if (data.success) {\n1811:             showToast('تمت المطابقة بنجاح!', 'success');\n1812:             if (data.stats) {\n1813:                 loadResults(data.stats);\n1814:             }\n1815:             window.showScreen('screen-results');\n1816:         } else {\n1817:             showToast('فشلت عملية المطابقة: ' + data.error, 'error');\n1818:         }\n1819:     }\n1820: });\n1821: \n1822: // --- Results Logic ---\n1823: function loadResults(stats) {\n1824:     const total = stats.total || 0;\n1825:     const matched = stats.matched || 0;\n1826:     const notfound = stats.not_found || 0;\n1827:     const review = stats.review || 0;\n1828:     \n1829:     document.getElementById('stat-total').innerText = total;\n1830:     document.getElementById('stat-matched').innerText = matched;\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
