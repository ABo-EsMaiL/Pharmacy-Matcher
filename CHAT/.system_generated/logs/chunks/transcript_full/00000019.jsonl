arted\"}\n        except Exception as e:\n            return {\"success\": False, \"message\": str(e)}\n\n    def stop(self) -> dict:\n        if not self.is_running():\n            return {\"success\": True, \"message\": \"not running\"}\n            \n        try:\n            if os.name == 'nt':\n                subprocess.run(['taskkill', '/F', '/T', '/PID', str(self.process.pid)], capture_output=True)\n            else:\n                os.killpg(os.getpgid(self.process.pid), signal.SIGTERM)\n                \n            self.process = None\n            return {\"success\": True, \"message\": \"stopped\"}\n        except Exception as e:\n            return {\"success\": False, \"message\": str(e)}\n\n    def install_requirements(self) -> dict:\n        try:\n            result = subprocess.run(\n                [sys.executable, \"-m\", \"pip\", \"install\", \"-r\", \"requirements.txt\"],\n                cwd=self.msemax_dir,\n                capture_output=True,\n                text=True\n            )\n            return {\"success\": result.returncode == 0, \"output\": result.stdout + \"\\n\" + result.stderr}\n        except Exception as e:\n            return {\"success\": False, \"output\": str(e)}\n\n    def run_get_session(self) -> dict:\n        try:\n            creationflags = 0\n            if os.name == 'nt':\n                creationflags = subprocess.CREATE_NEW_CONSOLE\n                \n            subprocess.Popen(\n                [sys.executable, \"get_session.py\"],\n                cwd=self.msemax_dir,\n                creationflags=creationflags\n            )\n            return {\"success\": True, \"output\": \"Browser session started. Please complete login.\"}\n        except Exception as e:\n            return {\"success\": False, \"output\": str(e)}\n\n    def install_playwright(self) -> dict:\n        try:\n            result = subprocess.run(\n                [sys.executable, \"-m\", \"playwright\", \"install\", \"chromium\"],\n                cwd=self.msemax_dir,\n                capture_output=True,\n                text=True\n            )\n            return {\"success\": result.returncode == 0, \"output\": result.stdout + \"\\n\" + result.stderr}\n        except Exception as e:\n            return {\"success\": False, \"output\": str(e)}\n\n    def get_status(self) -> dict:\n        return {\n            \"running\": self.is_running(),\n            \"pid\": self.process.pid if self.is_running() else None\n        }\n\n    def cleanup(self):\n        self.stop()","TargetFile":"d:\\AI_Engineer\\Pharmacy-agy\\desktop_app\\server_manager.py","toolAction":"Updating server manager to capture and pipe output to a logger","toolSummary":"Update server_manager.py"}}]}
