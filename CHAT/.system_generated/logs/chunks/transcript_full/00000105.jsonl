47:                                 # 1. Dosage form conflict\r\n248:                                 req_form = extract_form_group(shortage_name)\r\n249:                                 wh_form = extract_form_group(warehouse_item)\r\n250:                                 if req_form and wh_form and req_form != wh_form:\r\n251:                                     status = \"no_match\"\r\n252:                                     \r\n253:                                 # 2. Multi-strength slash mismatch (e.g. 4/30 vs 4)\r\n254:                                 slash_req = re.search(r'(?:^|[^\\d/])(\\d+(?:\\.\\d+)?\\/\\d+(?:\\.\\d+)?)(?:[^\\d/]|$)', shortage_name)\r\n255:                                 slash_wh = re.search(r'(?:^|[^\\d/])(\\d+(?:\\.\\d+)?\\/\\d+(?:\\.\\d+)?)(?:[^\\d/]|$)', warehouse_item)\r\n256:                                 if slash_req and not slash_wh:\r\n257:                                     status = \"no_match\"\r\n258:                                 elif slash_wh and not slash_req:\r\n259:                                     status = \"no_match\"\r\n260:                                 elif slash_req and slash_wh and slash_req.group(1) != slash_wh.group(1):\r\n261:                                     status = \"no_match\"\r\n262:                                     \r\n263:                                 # 3. Combination suffix mismatch (كو / بلس / co / plus)\r\n264:                                 is_req_co = bool(re.search(r'\\b(كو|بلس|بلاس|كومب|co|plus|comp)\\b', shortage_name.lower()))\r\n265:                                 is_wh_co = bool(re.search(r'\\b(كو|بلس|بلاس|كومب|co|plus|comp)\\b', warehouse_item.lower()))\r\n266:                                 if is_req_co != is_wh_co:\r\n267:                                     status = \"no_match\"\r\n268:                                     \r\n269:                                 # 4. Commercial prefix mismatch (نيو / new)\r\n270:                                 is_req_new = bool(re.search(r'\\b(نيو|new)\\b', shortage_name.lower()))\r\n271:                                 is_wh_new = bool(re.search(r'\\b(نيو|new)\\b', warehouse_item.lower()))\r\n272:                                 if is_req_new != is_wh_new:\r\n273:                                     status = \"no_match\"\r\n274:                                     \r\n275:                                 # 5. Deterministic Safety Check: Brand similarity\r\n276:                                 req_b = extract_brand_tokens(shortage_name)\r\n277:                                 wh_b = extract_brand_tokens(warehouse_item)\r\n278:                                 if req_b and wh_b:\r\n279:                                     words_r = req_b.split()\r\n280:                                     words_w = wh_b.split()\r\n281:                                     first_r = words_r[0] if words_r else \"\"\r\n282:                                     first_w = words_w[0] if words_w else \"\"\r\n283:                                     b_sim = max(\r\n284:                                         fuzz.ratio(req_b, wh_b),\r\n285:                                         fuzz.token_sort_ratio(req_b, wh_b),\r\n286:                                         fuzz.ratio(req_b.replace(' ', ''), wh_b.replace(' ', ''))\r\n287:                                     )\r\n288:                                     if first_r and first_w and (first_r == first_w or fuzz.ratio(first_r, first_w) >= 80):\r\n289:                                         b_sim = max(b_sim, 80)\r\n290:                                     elif req_b.startswith(wh_b) or wh_b.startswith(req_b):\r\n291:                                         b_sim = max(b_sim, 80)\r\n292:                                     if b_sim < 65:\r\n293:                                         status = \"no_match\"\r\n294:                                         \r\n295:                                     \r\nThe above content does NOT show the entire file contents. If you need to