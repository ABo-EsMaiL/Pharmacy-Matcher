t 50.\n\n\n","tool_calls":[{"name":"run_command","args":{"CommandLine":"D:\\miniconda3\\envs\\venv\\python.exe -c \"\nfrom rapidfuzz import fuzz\n\ndef check_prefix(first_r, first_w):\n    p1 = first_r[:3]\n    p2 = first_w[:3]\n    if len(first_r) >= 5 and len(first_w) >= 5 and fuzz.ratio(p1, p2) < 50:\n        r_strip = first_r[2:] if first_r.startswith('ال') else first_r\n        w_strip = first_w[2:] if first_w.startswith('ال') else first_w\n        if fuzz.ratio(r_strip, w_strip) < 75:\n            return 'BLOCKED'\n    return 'PASSED'\n\ntests = [\n    ('ابيكوتيل', 'البوتيل'),\n    ('فيوسيدل', 'فيوسيدين'),\n    ('جرانتريل', 'جرانتيل'),\n    ('امبوفير', 'اميفير'),\n    ('ميبو', 'ميو'),\n    ('ديباكين', 'ديبيكان'),\n    ('بنادول', 'البنادول'),\n    ('كتافلام', 'الكتفلام')\n]\nfor r, w in tests:\n    print(f'{r} vs {w} -> {check_prefix(r, w)}')\n\"","Cwd":"d:\\AI_Engineer\\Pharmacy-agy","IsDaemon":false,"WaitMsBeforeAsync":5000,"toolAction":"Testing prefix check","toolSummary":"Test check_prefix function"}}]}
