ument.getElementById('pipeline-log-terminal');\n1405:     if (termEl) termEl.innerHTML = '[System] Started pipeline...\\n';\n1406:     \n1407:     try {\n1408:         const res = await window.pywebview.api.start_process(\n1409:             JSON.stringify(selectedShortageFiles), \n1410:             JSON.stringify(selectedWarehouseFiles)\n1411:         );\n1412:         if (res.success) {\n1413:             currentProcessId = res.process_id;\n1414:             \n1415:             // If the backend detected an identical exact match that was already completed!\n1416:             if (res.existing) {\n1417:                 showToast('هذه العملية مسجلة بالفعل، جاري عرض النتائج...', 'info');\n1418:                 // Simulate process_complete event\n1419:                 setTimeout(() => {\n1420:                     window.dispatchEvent(new CustomEvent('process_complete', {\n1421:                         detail: {\n1422:                             process_id: res.process_id,\n1423:                             success: true,\n1424:                             stats: res.stats\n1425:                         }\n1426:                     }));\n1427:                 }, 500);\n1428:             } else {\n1429:                 // Background process started\n1430:                 showToast('بدأت العملية بنجاح في الخلفية', 'success');\n1431:             }\n1432:         } else {\n1433:             showToast('خطأ: ' + res.error, 'error');\n1434:             btn.classList.remove('hidden');\n1435:             progressModal.style.display = 'none';\n1436:         }\n1437:     } catch (error) {\n1438:         showToast('حدث خطأ أثناء الاتصال', 'error');\n1439:         btn.classList.remove('hidden');\n1440:         progressModal.style.display = 'none';\n1441:     }\n1442: }\n1443: \n1444: // --- Process Events ---\n1445: window.addEventListener('process_update', (e) => {\n1446:     const data = e.detail;\n1447:     const progressModal = document.getElementById('progress-modal');\n1448:     if (progressModal && progressModal.style.display === 'flex' && data.process_id === currentProcessId) {\n1449:         const msgEl = document.getElementById('progress-text');\n1450:         \n1451:         if (msgEl && data.message) {\n1452:             msgEl.innerText = data.message;\n1453:         }\n1454:         \n1455:         const pb = document.getElementById('progress-bar-fill');\n1456:         if (pb) {\n1457:             // Very simple heuristic to advance progress bar based on text\n1458:             let pct = 10;\n1459:             if (data.message.includes('استخراج') || data.message.includes('Extracting')) pct = 30;\n1460:             if (data.message.includes('مطابقة') || data.message.includes('Matching')) pct = 60;\n1461:             if (data.message.includes('حفظ') || data.message.includes('Saving')) pct = 90;\n1462:             pb.style.width = pct + '%';\n1463:         }\n1464:     }\n1465: });\n1466: \n1467: window.addEventListener('process_complete', (e) => {\n1468:     const data = e.detail;\n1469:     \n1470:     if (data.process_id === currentProcessId) {\n1471:         const btn = document.getElementById('btn-submit');\n1472:         const progressModal = document.getElementById('progress-modal');\n1473:         \n1474:         btn.classList.remove('hidden');\n1475:         progressModal.style.display = 'none';\n1476:         \n1477:         if (data.success) {\n1478:             showToast('تمت المطابقة بنجاح!', 'success');\n1479:             if (data.stats) {\n1480:                 loadResults(data.stats);\n1481:             }\n1482:             window.showScreen('screen-results');\n1483:         } else {\n1484:             showToast('فشلت عملية المطابقة: ' + data.error, 'error');\n1485:         }\n1486:     }\n1487: });\n1488: \n1489: // --- Results Logic ---\n1490: function loadResults(stats) {\n1491:     const total = stats.total || 0;\n1492:     const matched = stats.matched || 0;\n1493:     const notfound = stats.not_found || 0;\n1494:     const review = stats.review || 0;\n1495:     \n1496:     document.getElementById('stat-total').innerText = total;\n1497:     document.getElementById('stat-matched').innerText = matched;\n1498:     document.getElementById('stat-notfound').innerText = notfound;\n1499:     document.getElementById('stat-review').innerText = review;\n1500:     \n1501:     if (total > 0) {\n1502:         document.getElementById('stat-matched-pct').innerText = Math.round((matched/total)*100) + '%';\n1503:         document.getElementById('stat-notfound-pct').innerText = Math.round((notfound/total)*100) + '%';\n1504:         document.getElementById('stat-review-pct').innerText = Math.round((review/total)*100) + '%';\n1505:     } else {\n1506:         document.getElementById('stat-matched-pct').innerText = '0%';\n1507:         document.getElementById('stat-notfound-pct').innerText = '0%';\n1508:         document.getElementById('stat-review-pct').innerText = '0%';\n1509:     }\n1510: }\n1511: \n1512: async function openExcel() {\n1513:     if (!currentProcessId) return;\n1514:     try {\n1515:         await window.pywebview.api.open_excel(currentProcessId);\n1516:     } catch (error) {\n1517:         showToast('تعذر فتح الملف: ' + error, 'error');\n1518:     }\n1519: }\n1520: \n1521: async function openFolder() {\n1522:     if (!currentProcessId) return;\n1523:     try {\n1524:         await window.pywebview.api.open_folder(currentProcessId);\n1525:     } catch (error) {\n1526:         showToast('تعذر فتح المجلد: ' + error, 'error');\n1527:     }\n1528: }\n1529: \n1530: async function applyReviews() {\n1531:     if (!currentProcessId) return;\n1532:     try {\n1533:         const result = await window.pywebview.api.apply_reviews(currentProcessId);\n1534:         showToast(`تم تنفيذ التعديلات! نجاح: ${result.success}, فشل: ${result.failed}`, 'success');\n1535:         \n1536:         if (result.new_stats) {\n1537:             loadResults(result.new_stats);\n1538:         }\n1539:     } catch (error) {\n1540:         showToast('حدث خطأ أثناء تنفيذ التعديلات', 'error');\n1541:     }\n1542: }\n1543: \n1544: // --- History Logic ---\n1545: async function loadHistory() {\n1546:     const listEl = document.getElementById('history-list');\n1547:     listEl.innerHTML = '<div class=\"spinner\"></div>';\n1548:     \n1549:     try {\n1550:         const historyStr = await window.pywebview.api.get_history();\n1551:         const history = JSON.parse(historyStr);\n1552:         \n1553:         if (!history || history.length === 0) {\n1554:             listEl.innerHTML = '<div class=\"empty-state\"><i class=\"ph-fill ph-empty\"></i><p>لا توجد عمليات سابقة مسجلة.</p></div>';\n1555:             return;\n1556:         }\n1557:         \n1558:         listEl.innerHTML = '';\n1559:         history.forEach(item => {\n1560:             const date = new Date(item.created_at).toLocaleString('ar-EG');\n1561:             const statusClass = item.status === 'completed' ? 'badge-completed' : (item.status === 'processing' ? 'badge-processing' : 'badge-reviewing');\n1562:             let statusText = item.status === 'completed' ? 'مكتمل' : 'قيد المراجعة';\n1563:             if (item.status === 'processing') statusText = 'قيد التشغيل...';\n1564:             else if (item.status === 'error') statusText = 'فشل';\n1565:             \n1566:             const card = document.createElement('div');\n1567:             card.className = 'history-card';\n1568:             card.onclick = () => { if(item.status !== 'processing') viewProcess(item.id); };\n1569:             \n1570:             card.innerHTML = `\n1571:                 <div class=\"history-info\">\n1572:                     <div class=\"history-header\">\n1573:                         <h4>العملية ${item.id.substring(0,8)}...</h4>\n1574:                         <span class=\"badge-status ${statusClass}\">${statusText}</span>\n1575:                     </div>\n1576:                     <div class=\"history-date\"><i class=\"ph ph-calendar\"></i> ${date}</div>\n1577:                     <div class=\"history-files\">\n1578:                         <span><i class=\"ph-fill ph-files\"></i> ${JSON.parse(item.shortage_files || '[]').length} نواقص</span>\n1579:                         <span><i class=\"ph-fill ph-folders\"></i> ${JSON.parse(item.warehouse_files || '[]').length} مخازن</span>\n1580:                     </div>\n1581:                 </div>\n1582:                 <div class=\"history-actions\">\n1583:                     ${item.status === 'processing' \n1584:                         ? `<button class=\"btn btn-primary\" style=\"opacity:0.7; cursor:not-allowed;\" disabled><i class=\"ph-fill ph-spinner-gap spinner\"></i> جاري التشغيل...</button>`\n1585:                         : (item.status === 'error'\n1586:                             ? `<button class=\"btn btn-warning\" onclick=\"restartProcess('${item.id}')\"><i class=\"ph-fill ph-arrow-counter-clockwise\"></i> إعادة تشغيل</button>\n1587:                                <button class=\"btn btn-danger btn-icon\" onclick=\"event.stopPropagation(); deleteProcess('${item.id}')\"><i class=\"ph ph-trash\"></i></button>`\n1588:                             : `<button class=\"btn btn-primary\" onclick=\"viewProcess('${item.id}')\"><i class=\"ph-fill ph-eye\"></i> عرض النتائج</button>\n1589:                                <button class=\"btn btn-danger btn-icon\" onclick=\"event.stopPropagation(); deleteProcess('${item.id}')\"><i class=\"ph ph-trash\"></i></button>`\n1590:                         )\n1591:                     }\n1592:                 </div>\n1593:             `;\n1594:             listEl.appendChild(card);\n1595:         });\n1596:     } catch (e) {\n1597:         console.error(e);\n1598:         listEl.innerHTML = '<div class=\"empty-state text-danger\"><i class=\"ph-fill ph-warning\"></i><p>خطأ في جلب السجل</p></div>';\n1599:     }\n1600: }\n1601: \n1602: async function restartProcess(processId) {\n1603:     try {\n1604:         const res = await window.pywebview.api.restart_process(processId);\n1605:         if (res.success) {\n1606:             currentProcessId = res.process_id;\n1607:             switchScreen('screen-new');\n1608:             \n1609:             const btn = document.getElementById('btn-submit');\n1610:             const progressModal = document.getElementById('progress-modal');\n1611:             \n1612:             btn.classList.add('hidden');\n1613:             progressModal.style.display = 'flex';\n1614:             document.getElementById('progress-text').innerText = 'جاري تهيئة العملية...';\n1615:             document.getElementById('progress-bar-fill').style.width = '5%';\n1616:             \n1617:             const termEl = document.getElementById('pipeline-log-terminal');\n1618:             if (termEl) termEl.innerHTML = `[System] Restarted process ${processId}...\\n`;\n1619:             \n1620:             showToast('تم بدء العملية من جديد', 'success');\n1621:         } else {\n1622:             showToast(res.error || 'حدث خطأ أثناء إعادة التشغيل', 'error');\n1623:         }\n1624:     } catch (e) {\n1625:         showToast('خطأ في الاتصال بالبرنامج', 'error');\n1626:         console.error(e);\n1627:     }\n1628: }\n1629: \n1630: async function viewProcess(processId) {\n1631:     try {\n1632:         const dataStr = await window.pywebview.api.get_process_details(processId);\n1633:         const data = JSON.parse(dataStr);\n1634:         if (!data || !data.id) throw new Error(\"لم يتم العثور على العملية\");\n1635:         \n1636:         currentProcessId = processId;\n1637:         const stats = {\n1638:             total: data.total_shortages || 0,\n1639:             matched: data.matched_count || 0,\n1640:             not_found: data.not_found_count || 0,\n1641:             review: data.review_count || 0\n1642:         };\n1643:         loadResults(stats);\n1644:         window.showScreen('screen-results');\n1645:     } catch (error) {\n1646:         showToast('تعذر تحميل تفاصيل العملية', 'error');\n1647:         console.error(error);\n1648:     }\n1649: }\n1650: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
