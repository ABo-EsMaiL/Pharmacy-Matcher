 showToast('فشل تجديد الجلسة', 'error');\n1728:     }\n1729: }\n1730: \n1731: async function updateServerStatus(statusData) {\n1732:     const indicator = document.getElementById('server-indicator');\n1733:     const text = document.getElementById('server-status-text');\n1734:     const btn = document.getElementById('btn-toggle-server');\n1735:     \n1736:     let isRunning = false;\n1737:     if (statusData !== undefined) {\n1738:         isRunning = typeof statusData === 'object' ? statusData.running : statusData;\n1739:     } else {\n1740:         try {\n1741:             const status = await window.pywebview.api.get_server_status();\n1742:             isRunning = status.running;\n1743:         } catch (error) {\n1744:             console.error('Failed to get server status', error);\n1745:             return;\n1746:         }\n1747:     }\n1748:     \n1749:     if (isRunning) {\n1750:         if (indicator) indicator.className = 'status-indicator running';\n1751:         if (text) text.textContent = 'السيرفر يعمل';\n1752:         if (btn) btn.innerHTML = '<i class=\"ph ph-stop\"></i> إيقاف السيرفر';\n1753:         isServerRunning = true;\n1754:     } else {\n1755:         if (indicator) indicator.className = 'status-indicator stopped';\n1756:         if (text) text.textContent = 'السيرفر متوقف';\n1757:         if (btn) btn.innerHTML = '<i class=\"ph ph-play\"></i> تشغيل السيرفر';\n1758:         isServerRunning = false;\n1759:     }\n1760: }\n1761: \n1762: async function toggleServer() {\n1763:     try {\n1764:         const status = await window.pywebview.api.get_server_status();\n1765:         if (status.running) {\n1766:             await window.pywebview.api.stop_server();\n1767:             showToast('تم إيقاف السيرفر', 'success');\n1768:         } else {\n1769:             await window.pywebview.api.start_server();\n1770:             showToast('تم تشغيل السيرفر', 'success');\n1771:         }\n1772:         updateServerStatus();\n1773:     } catch (error) {\n1774:         showToast('حدث خطأ أثناء تبديل حالة السيرفر', 'error');\n1775:     }\n1776: }\n1777: \n1778: const btnToggle = document.getElementById('btn-toggle-server');\n1779: if (btnToggle) btnToggle.addEventListener('click', toggleServer);\n1780:     </script>\n1781:     <script>\n1782:         // Override showScreen to handle active states on sidebar\n1783:         const originalShowScreen = window.showScreen;\n1784:         window.showScreen = function(screenId, element = null) {\n1785:             // Call original if it exists\n1786:             if (typeof originalShowScreen === 'function') {\n1787:                 originalShowScreen(screenId);\n1788:             } else {\n1789:                 document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));\n1790:                 const target = document.getElementById(screenId);\n1791:                 if (target) target.classList.add('active');\n1792:             }\n1793:             \n1794:             // Update sidebar active class\n1795:             if (element) {\n1796:                 document.querySelectorAll('.nav-item').forEach(btn => btn.classList.remove('active'));\n1797:                 element.classList.add('active');\n1798:             }\n1799: \n1800:             if (screenId === 'screen-new') {\n1801:                 resetNewProcessForm();\n1802:             }\n1803:         };\n1804:         // Auto select first nav item\n1805:         document.addEventListener(\"DOMContentLoaded\", () => {\n1806:             const firstNav = document.querySelector('.nav-item');\n1807:             if (firstNav) firstNav.classList.add('active');\n1808:         });\n1809:     </script>\n1810: </body>\n1811: </html>\n1812: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
