{"step_index":10702,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-25T15:04:04Z","content":"Created At: 2026-09-25T18:04:04+03:00\nCompleted At: 2026-09-25T18:04:04+03:00\nFile Path: `file:///d:/AI_Engineer/Pharmacy-agy-vision/src/output/excel_writer.py`\nTotal Lines: 310\nTotal Bytes: 13675\nShowing lines 1 to 60\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"\"\"\n2: وحدة كتابة نتائج المطابقة إلى ملف Excel.\n3: Write the final Excel output with per-warehouse sheets and summary.\n4: \"\"\"\n5: \n6: from pathlib import Path\n7: import re\n8: \n9: from openpyxl import Workbook\n10: from openpyxl.styles import Alignment, Font, PatternFill, Border, Side\n11: from openpyxl.utils import get_column_letter\n12: \n13: \n14: # ──────────────────────────────────────────────\n15: # أنماط التنسيق\n16: # ──────────────────────────────────────────────\n17: _HEADER_FILL = PatternFill(start_color=\"00695C\", end_color=\"00695C\", fill_type=\"solid\")\n18: _HEADER_FONT = Font(name=\"Arial\", bold=True, color=\"FFFFFF\", size=11)\n19: _HEADER_ALIGNMENT = Alignment(\n20:     horizontal=\"center\", vertical=\"center\", wrap_text=True\n21: )\n22: _CELL_FONT = Font(name=\"Arial\", size=10)\n23: _CELL_ALIGNMENT = Alignment(horizontal=\"right\", vertical=\"center\", wrap_text=True)\n24: _THIN_BORDER = Border(\n25:     left=Side(style=\"thin\"),\n26:     right=Side(style=\"thin\"),\n27:     top=Side(style=\"thin\"),\n28:     bottom=Side(style=\"thin\"),\n29: )\n30: \n31: \n32: def _apply_header_style(ws, num_cols: int) -> None:\n33:     \"\"\"تطبيق تنسيق الرأس على الصف الأول.\"\"\"\n34:     for col_idx in range(1, num_cols + 1):\n35:         cell = ws.cell(row=1, column=col_idx)\n36:         cell.fill = _HEADER_FILL\n37:         cell.font = _HEADER_FONT\n38:         cell.alignment = _HEADER_ALIGNMENT\n39:         cell.border = _THIN_BORDER\n40: \n41: \n42: def _format_sheet(ws, num_cols: int) -> None:\n43:     \"\"\"تنسيق الورقة: تجميد الصف الأول، فلتر تلقائي، RTL، عرض الأعمدة.\"\"\"\n44:     # تجميد الصف الأول\n45:     ws.freeze_panes = \"A2\"\n46: \n47:     # فلتر تلقائي\n48:     if ws.max_row > 0 and num_cols > 0:\n49:         last_col_letter = get_column_letter(num_cols)\n50:         ws.auto_filter.ref = f\"A1:{last_col_letter}{ws.max_row}\"\n51: \n52:     # اتجاه الورقة من اليمين لليسار\n53:     ws.sheet_view.rightToLeft = True\n54: \n55:     # عرض الأعمدة التلقائي (تقدير بسيط)\n56:     for col_idx in range(1, num_cols + 1):\n57:         max_length = 0\n58:         col_letter = get_column_letter(col_idx)\n59:         for row in ws.iter_rows(\n60:             min_col=col_idx, max_col=col_idx, min_row=1, max_row=ws.max_row\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
