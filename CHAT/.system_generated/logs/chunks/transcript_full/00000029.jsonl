{"step_index":963,"source":"SYSTEM","type":"SYSTEM_MESSAGE","status":"DONE","created_at":"2026-09-22T01:00:25Z","content":"The following is a <SYSTEM_MESSAGE> not actually sent by the user. It is provided by the system as important information to pay attention to.\n\n<SYSTEM_MESSAGE>\n[Message] timestamp=2026-09-22T01:00:21Z sender=916274de-7f92-49fc-a0a8-d291664b474a/task-960 priority=MESSAGE_PRIORITY_HIGH content=Task id \"916274de-7f92-49fc-a0a8-d291664b474a/task-960\" finished with result:\n\nThe command exited with code 0.\nOutput:\n}\r\n\r\n\r\n\r\n// --- Process Events ---\r\n\r\nwindow.addEventListener('process_update', (e) => {\r\n\r\n    const data = e.detail;\r\n\r\n    const progressModal = document.getElementById('progress-modal');\r\n\r\n    if (progressModal && progressModal.style.display === 'flex' && data.process_id === currentProcessId) {\r\n\r\n        const msgEl = document.getElementById('progress-text');\r\n\r\n        \r\n\r\n        if (msgEl && data.message) {\r\n\r\n            msgEl.innerText = data.message;\r\n\r\n        }\r\n\r\n        \r\n\r\n        const pb = document.getElementById('progress-bar-fill');\r\n\r\n        if (pb) {\r\n\r\n            // Very simple heuristic to advance progress bar based on text\r\n\r\n            let pct = 10;\r\n\r\n            if (data.message.includes('استخراج') || data.message.includes('Extracting')) pct = 30;\r\n\r\n            if (data.message.includes('مطابقة') || data.message.includes('Matching')) pct = 60;\r\n\r\n            if (data.message.includes('حفظ') || data.message.includes('Saving')) pct = 90;\r\n\r\n            pb.style.width = pct + '%';\r\n\r\n        }\r\n\r\n    }\r\n\r\n});\r\n\r\n\r\n\r\nwindow.addEventListener('process_complete', (e) => {\r\n\r\n    const data = e.detail;\r\n\r\n    \r\n\r\n    if (data.process_id === currentProcessId) {\r\n\r\n        const btn = document.getElementById('btn-submit');\r\n\r\n\n\n</SYSTEM_MESSAGE>"}
