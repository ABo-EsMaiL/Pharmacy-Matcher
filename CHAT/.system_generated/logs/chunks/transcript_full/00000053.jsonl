  s_core = get_core_tokens(s)\n27:     if not s_core:\n28:         continue\n29:     best_candidate = None\n30:     best_score = 0\n31:     \n32:     for r, sh in shortages:\n33:         sh_core = get_core_tokens(sh)\n34:         if not sh_core: continue\n35:         \n36:         # Check if the primary brand token matches\n37:         primary_s = s_core[0]\n38:         # Allow prefix/substring match of primary brand (at least 4 chars)\n39:         brand_match = False\n40:         for sh_t in sh_core:\n41:             if primary_s == sh_t or (len(primary_s) >= 4 and (primary_s in sh_t or sh_t in primary_s)):\n42:                 brand_match = True\n43:                 break\n44:                 \n45:         if brand_match:\n46:             score = fuzz.token_set_ratio(normalize_text(s), normalize_text(sh))\n47:             if score > best_score:\n48:                 best_score = score\n49:                 best_candidate = (r, sh, score)\n50:                 \n51:     if best_candidate and best_score >= 50:\n52:         matched_salam.append((idx, s, best_candidate[0], best_candidate[1], best_score))\n53:     else:\n54:         unmatched_salam.append((idx, s))\n55: \n56: print(f\"Total Salam Items: {len(salam_items)}\")\n57: print(f\"Matched with a shortage having the SAME primary drug brand: {len(matched_salam)}\")\n58: print(f\"Unmatched (Brand NOT present in shortages): {len(unmatched_salam)}\")\n59: \n60: print(\"\\n--- MATCHED EXAMPLES ---\")\n61: for idx, s, r, sh, score in matched_salam[:25]:\n62:     print(f\"[{idx}] Salam: {s} <===> Shortage (Row {r}): {sh} (Score: {score:.1f})\")\n63: \n64: print(\"\\n--- UNMATCHED EXAMPLES (First 20) ---\")\n65: for idx, s in unmatched_salam[:20]:\n66:     print(f\"[{idx}] {s}\")\n67: \nThe above content shows the entire, complete file contents of the requested file.\n"}
