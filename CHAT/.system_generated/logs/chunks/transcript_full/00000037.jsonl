{"step_index":1486,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-22T10:08:00Z","content":"Created At: 2026-09-22T13:08:00+03:00\nCompleted At: 2026-09-22T13:08:00+03:00\nFile Path: `file:///d:/AI_Engineer/Pharmacy-agy/src/extract/pdf_reader.py`\nTotal Lines: 194\nTotal Bytes: 8436\nShowing lines 1 to 189\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"\"\"\n2: وحدة قراءة ملفات PDF - استخراج أسماء الأدوية باستخدام Unstructured API (Extraction Workflow).\n3: \"\"\"\n4: \n5: from pathlib import Path\n6: import json\n7: import hashlib\n8: \n9: def _get_file_hash(filepath: Path) -> str:\n10:     hasher = hashlib.md5()\n11:     with open(filepath, 'rb') as f:\n12:         buf = f.read(65536)\n13:         while len(buf) > 0:\n14:             hasher.update(buf)\n15:             buf = f.read(65536)\n16:     return hasher.hexdigest()\n17: \n18: def extract_items_from_pdf(\n19:     filepath: Path,\n20:     api_key: str,\n21:     base_url: str = \"https://transform.unstructured.io\",\n22:     gemini_api_key: str = None,\n23: ) -> list[dict]:\n24:     \"\"\"\n25:     استخراج أسماء الأصناف من ملف PDF باستخدام خدمة Extraction في Unstructured.\n26:     \"\"\"\n27:     filepath = Path(filepath)\n28:     if not filepath.exists():\n29:         raise FileNotFoundError(f\"PDF file not found: {filepath}\")\n30: \n31:     print(f\"📄 Processing PDF file with Unstructured AI: {filepath.name}\")\n32: \n33:     # Check cache\n34:     file_hash = _get_file_hash(filepath)\n35:     cache_dir = filepath.parent.parent.parent / 'data' / '.unstructured_cache'\n36:     cache_dir.mkdir(parents=True, exist_ok=True)\n37:     cache_file = cache_dir / f\"{file_hash}_extract.json\"\n38:     \n39:     if cache_file.exists():\n40:         try:\n41:             with open(cache_file, \"r\", encoding=\"utf-8\") as f:\n42:                 result_data = json.load(f)\n43:             cached_items = parse_structured_result(result_data, filepath.name)\n44:             if len(cached_items) > 0:\n45:                 print(f\"[+] Loaded {len(cached_items)} items from cache: {filepath.name}\")\n46:                 return cached_items\n47:             else:\n48:                 print(f\"[*] Cache has 0 items for {filepath.name}. Re-processing with API...\")\n49:         except Exception:\n50:             print(f\"[*] Cache invalid for {filepath.name}. Re-processing with API...\")\n51: \n52:     try:\n53:         from unstructured_transform_client import TransformClient\n54:     except ImportError:\n55:         print(\"⚠️ unstructured-transform-client not found. Please install it:\")\n56:         print(\"pip install unstructured-transform-client\")\n57:         raise RuntimeError(\"unstructured-transform-client is required to process PDFs\")\n58: \n59:     client = TransformClient(\n60:         api_key=api_key,\n61:         server_url=base_url,\n62:     )\n63: \n64:     schema = {\n65:         \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n66:         \"title\": \"Supplier Product Names\",\n67:         \"description\": \"Extract product entries from all pages as source data only. Return one entry per source product row, preserving duplicates and different strengths. Include products even when price or quantity is blank or zero. Copy names faithfully without spelling repair or inferred digits. Do not infer stock, requested quantities or shortage matches.\",\n68:         \"type\": \"object\",\n69:         \"properties\": {\n70:             \"items\": {\n71:                 \"type\": \"array\",\n72:                 \"description\": \"Every product entry from every page, in document order. Keep repeated entries. Exclude document headers, footers, contact details, column labels and totals.\",\n73:                 \"items\": {\n74:                     \"type\": \"object\",\n75:                     \"properties\": {\n76:                         \"item_name_raw\": {\n77:                             \"type\": \"string\",\n78:                             \"description\": \"Copy the complete product name/description exactly as present in the source, preserving Arabic, English, mixed text, spelling, strengths, units, dosage form, pack numbers, punctuation and manufacturer text. Do not correct, translate or complete it. Exclude values belonging to separate price, discount or quantity columns, but retain numbers written inside the name itself.\",\n79:                         },\n80:                         \"source_page\": {\n81:                             \"type\": [\n82:                                 \"integer\",\n83:                                 \"null\",\n84:                             ],\n85:                             \"description\": \"The 1-based source page containing this product entry, taken from the source page metadata. Return null when unavailable; do not guess.\",\n86:                         },\n87:                     },\n88:                     \"required\": [\n89:                         \"item_name_raw\",\n90:                         \"source_page\",\n91:                     ],\n92:                     \"additionalProperties\": False,\n93:                 },\n94:             },\n95:         },\n96:         \"required\": [\n97:             \"items\",\n98:         ],\n99:         \"additionalProperties\": False,\n100:     }\n101: \n102:     try:\n103:         print(f\"  ⏳ Uploading and extracting data from {filepath.name} ... This may take some time.\")\n104:         with open(filepath, \"rb\") as f:\n105:             # We wait up to 10 minutes (600 seconds) for the extraction job\n106:             result = client.extract.from_document(\n107:                 input=f,\n108:                 schema=schema,\n109:                 wait_seconds=600 \n110:             )\n111: \n112:         # Convert result to dict\n113:         if hasattr(result, 'model_dump'):\n114:             result_data = result.model_dump()\n115:         elif hasattr(result, '__dict__'):\n116:             result_data = result.__dict__\n117:         else:\n118:             result_data = dict(result)\n119: \n120:         # Check if it returned a job instead of immediate result\n121:         # TransformClient often returns 202 Accepted with a job ID for large files\n122:         if result_data.get(\"status\") in [\"queued\", \"processing\", \"in_progress\"]:\n123:             job_id = result_data.get(\"id\") or result_data.get(\"job_id\")\n124:             if job_id:\n125:                 print(f\"  ⏳ Processing on server (Job ID: {job_id}). Waiting...\")\n126:                 import time\n127:                 attempts = 0\n128:                 while attempts < 120:  # 20 minutes max (120 * 10s)\n129:                     time.sleep(10)\n130:                     attempts += 1\n131:                     job_res = client.jobs.get(job_id)\n132:                     # Convert to dict\n133:                     if hasattr(job_res, 'model_dump'):\n134:                         job_data = job_res.model_dump()\n135:                     elif hasattr(job_res, '__dict__'):\n136:                         job_data = job_res.__dict__\n137:                     else:\n138:                         job_data = dict(job_res)\n139:                         \n140:                     status = job_data.get(\"status\")\n141:                     if status == \"completed\":\n142:                         result_data = job_data\n143:                         break\n144:                     elif status in [\"failed\", \"error\"]:\n145:                         raise RuntimeError(f\"Extraction failed on server: {job_data.get('error', '')}\")\n146:                     \n147:                     if attempts % 3 == 0:\n148:                         print(f\"  ⏳ Current status: {status} ... (Attempt {attempts}/120)\")\n149:                