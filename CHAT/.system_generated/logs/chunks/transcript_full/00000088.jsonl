d_wh_item exists in real_items\n        best_match = None\n        best_score = 0\n        for item in real_items:\n            score = fuzz.ratio(claimed_wh_item, item)\n            if score > best_score:\n                best_score = score\n                best_match = item\n                \n        if best_score < 75:\n            print(f\"❌ [HALLUCINATION / NOT FOUND] #{idx} Req: '{req_name}'\")\n            print(f\"    Gemini claimed: '{claimed_wh_item}'\")\n            print(f\"    Best real item in {target_wh}: '{best_match}' (score: {best_score:.1f})\")\n        elif claimed_wh_item != best_match:\n            print(f\"⚠️ [SLIGHT ALTERATION] #{idx} Req: '{req_name}'\")\n            print(f\"    Gemini claimed: '{claimed_wh_item}'\")\n            print(f\"    Real item is  : '{best_match}' (score: {best_score:.1f})\")\n        else:\n            # Exact match in warehouse\n            pass\n","Description":"Audit Gemini chat against actual warehouse data","Overwrite":true,"TargetFile":"d:\\AI_Engineer\\Pharmacy-agy\\scratch\\audit_gemini_chat.py","toolAction":"Write audit script","toolSummary":"Audit Gemini chat tables"}}]}
