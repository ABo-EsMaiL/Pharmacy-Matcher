h(\"data/processes/PROC-001/input_shortages/0913.xlsx\")\nshortage_rows = read_excel(shortages_file)\nshortage_items = extract_item_names(shortage_rows, name_column=\"أسم الصنف\")\n\n# Cure Pharma\nwh_file = Path(\"data/processes/PROC-001/input_warehouses/كيور فارما خاص.json\")\nwith open(wh_file, \"r\", encoding=\"utf-8\") as f:\n    cure_data = json.load(f)\ncure_items = parse_structured_result(cure_data, \"كيور فارما خاص.pdf\")\nwh_items_list = [{\"id\": f\"WH_{i:05}\", \"name\": item[\"item_name_raw\"]} for i, item in enumerate(cure_items)]\n\nfinder = FastCandidateFinder()\nfinder.fit(wh_items_list)\n\ntest_names = [\n    \"ترايملازما كريم س ج\",\n    \"دولوكسبرين 30مجم 28قرص س ج\",\n    \"ديكلوبرو150مجم 20قرص\",\n    \"لاكسيول بي ملين اقراص\",\n    \"لاكتيز 15 ملل نقط 750مجم\",\n    \"فلوبادكس 8مجم اقراص\",\n    \"نابيبرادين 7.5 مجم 30 قرص س ج\",\n    \"زوكوزيت 20/10مجم اقراص\",\n    \"فايركتا 3 شريط س ج\",\n    \"سيفيتيل 1جم\",\n    \"ميلجا ماكس30قرص\",\n    \"نيفيلوب12.5/5مجم بلاس20قرص\",\n    \"فيتا دي ثري4000ميكروفيلم\"\n]\n\nprint(\"Checking candidate retrieval for items Gemini matched in Cure Pharma:\")\nfor name in test_names:\n    cands = finder.search(name, top_k=3)\n    c_names = [c[\"name\"] for c in cands]\n    print(f\"\\nReq: '{name}'\")\n    print(f\"Cands ({len(cands)}): {c_names}\")\n","Description":"Check candidate search for Cure Pharma items Gemini matched","Overwrite":true,"TargetFile":"d:\\AI_Engineer\\Pharmacy-agy\\scratch\\check_cure_gemini_items.py","toolAction":"Write script","toolSummary":"Check Cure Pharma candidate retrieval"}}]}
