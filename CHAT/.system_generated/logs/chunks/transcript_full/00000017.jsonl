_server();\n+            showToast('تم إيقاف السيرفر', 'success');\n+        } else {\n+            await window.pywebview.api.start_server();\n+            showToast('تم تشغيل السيرفر', 'success');\n+        }\n+        updateServerStatus();\n+    } catch (error) {\n+        showToast('حدث خطأ أثناء تبديل حالة السيرفر', 'error');\n+    }\n+}\n+\n+const btnToggle = document.getElementById('btn-toggle-server');\n+if (btnToggle) btnToggle.addEventListener('click', toggleServer);\n+    </script>\n     <script>\n         // Override showScreen to handle active states on sidebar\n         const originalShowScreen = window.showScreen;\n[diff_block_end]\n\nPlease note that the above snippet only shows the MODIFIED lines from the last change. It shows up to 3 lines of unchanged lines before and after the modified lines. The actual file contents may have many more lines not shown."}
