\n85:     def run_get_session(self) -> dict:\n86:         return self.server_manager.run_get_session()\n87: \n88:     def select_files(self, file_type: str) -> str:\n89:         \"\"\"Opens a native file dialog. Returns JSON list of selected file paths.\"\"\"\n90:         import webview\n91:         if not self.window:\n92:             return \"[]\"\n93:         \n94:         if file_type == 'warehouse':\n95:             file_types = ('Warehouse Files (*.pdf;*.xlsx;*.xls;*.json)', 'All Files (*.*)')\n96:         else:\n97:             file_types = ('Shortage Files (*.pdf;*.xlsx;*.xls)', 'All Files (*.*)')\n98:         \n99:         result = self.window.create_file_dialog(\n100:             webview.OPEN_DIALOG,\n101:             allow_multiple=True,\n102:             file_types=file_types\n103:         )\n104:         \n105:         if result:\n106:             return json.dumps([str(p) for p in result])\n107:         return \"[]\"\n108: \n109:     def select_directory(self) -> str:\n110:         \"\"\"Opens a native directory picker. Returns selected path.\"\"\"\n111:         import webview\n112:         if not self.window:\n113:             return \"\"\n114:         result = self.window.create_file_dialog(webview.FOLDER_DIALOG)\n115:         if result and len(result) > 0:\n116:             return str(result[0])\n117:         return \"\"\n118: \n119:     def start_process(self, shortage_paths_json: str, warehouse_paths_json: str) -> dict:\n120:         try:\n121:             shortage_paths = json.loads(shortage_paths_json)\n122:             warehouse_paths = json.loads(warehouse_paths_json)\n123:             \n124:             shortage_filenames = [Path(p).name for p in shortage_paths]\n125:             warehouse_filenames = [Path(p).name for p in warehouse_paths]\n126:             \n127:             process_id = self.db.create_process(shortage_filenames, warehouse_filenames)\n128:             \n129:             thread = threading.Thread(target=self._process_worker, args=(process_id, shortage_paths, warehouse_paths))\n130:             thread.start()\n131:             \n132:             return {\"success\": True, \"process_id\": process_id}\n133:             \n134:         except Exception as e:\n135:             return {\"success\": False, \"error\": str(e)}\n136: \n137:     def _process_worker(self, process_id, shortage_paths, warehouse_paths):\n138:         try:\n139:             proc_dir = self.db.get_process_dir(process_id)\n140:             \n141:             # Copy files to process directory\n142:             copied_shortages = []\n143:             for p in shortage_paths:\n144:                 dst = proc_dir / 'input_shortages' / Path(p).name\n145:                 shutil.copy2(p, dst)\n146:                 copied_shortages.append(dst)\n147:                 \n148:             copied_warehouses = []\n149:             for p in warehouse_paths:\n150:                 dst = proc_dir / 'input_warehouses' / Path(p).name\n151:                 shutil.copy2(p, dst)\n152:                 copied_warehouses.append(dst)\n153:                 \n154:             if self.window:\n155:                 self.window.evaluate_js(\"window.dispatchEvent(new CustomEvent('process_update', {detail: {process_id: '%s', status: 'processing', message: 'جاري قراءة الملفات...'}}));\" % process_id)\n156:                 \n157:             # Import actual project modules\n158:             from src.config import load_config\n159:             from src.extract.file_handler import read_input_files\n160:             from src.fast_match.coordinator import FastCoordinator\n161:             from src.output.excel_writer import write_results_excel\n162:             \n163:             # Load and update config with current settings\n164:             settings = self.get_settings()\n165:             config = load_config()\n166:             config.unstructured_api_key = settings.get('unstructured_api_key', '') or config.unstructured_api_key\n167:             config.loca