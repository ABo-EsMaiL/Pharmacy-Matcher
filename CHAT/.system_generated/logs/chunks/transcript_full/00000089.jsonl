erwise empty string)\"\n65:     }\n66:   ]\n67: }\n68: \n69: CRITICAL RULES FOR RESPONSE:\n70: - ONLY include cases that are \"match\" or \"review\".\n71: - DO NOT return cases that are \"no_match\" (any omitted case_id is automatically considered no_match).\n72: - DO NOT return markdown blocks (no ```json). Return ONLY the raw JSON starting with { and ending with }.\n73: \"\"\"\n74: \n75: class FastCoordinator:\n76:     def __init__(self, config: Config):\n77:         self.config = config\n78: \n79:     def process(self, shortage_items: list[dict], warehouse_data: dict[str, list[dict]]) -> dict:\n80:         unique_shortages = {}\n81:         for item in shortage_items:\n82:             name = item.get(\"item_name_raw\", \"\")\n83:             if name and name not in unique_shortages:\n84:                 unique_shortages[name] = item\n85:                 \n86:         deduped_shortages = list(unique_shortages.values())\n87: \n88:         print(f\"\\n{'='*60}\")\n89:         print(f\"[FAST ENGINE] Starting Match: {len(shortage_items)} raw -> {len(deduped_shortages)} UNIQUE shortages x {len(warehouse_data)} warehouses\")\n90:         print(f\"{'='*60}\\n\")\n91: \n92:         all_warehouse_results = {}\n93:         found_in = {}\n94: \n95:         for wh_name, wh_items in warehouse_data.items():\n96:             print(f\"\\n{'-'*40}\")\n97:             print(f\"[Warehouse] {wh_name} ({len(wh_items)} items)\")\n98:             print(f\"{'-'*40}\")\n99: \n100:             wh_result = self._match_warehouse(deduped_shortages, wh_items, wh_name)\n101:             all_warehouse_results[wh_name] = wh_result\n102: \n103:             for match in wh_result[\"matched\"]:\n104:                 name = match[\"shortage_item\"]\n105:                 found_in.setdefault(name, []).append(wh_name)\n106: \n107:         all_shortage_names = {item[\"item_name_raw\"] for item in deduped_shortages}\n108:         found_names = set(found_in.keys())\n109:         \n110:         review_only_names = set()\n111:         for wh_result in all_warehouse_results.values():\n112:             for rev in wh_result[\"needs_review\"]:\n113:                 review_only_names.add(rev[\"shortage_item\"])\n114: \n115:         not_found_names = all_shortage_names - found_names - review_only_names\n116:         not_found_items = [\n117:             {\"name\": name, \"source\": next(\n118:                 (item.get(\"source_file\", \"\") for item in deduped_shortages\n119:                  if item.get(\"item_name_raw\") == name), \"\"\n120:             )}\n121:             for name in sorted(not_found_names)\n122:         ]\n123: \n124:         total_wh_matched = sum(len(wh[\"matched\"]) for wh in all_warehouse_results.values())\n125:         total_review_items = sum(len(wh[\"needs_review\"]) for wh in all_warehouse_results.values())\n126:         total_not_found = len(not_found_items)\n127:         summary = {\n128:             \"total_shortages\": len(shortage_items),\n129:             \"unique_shortages\": len(deduped_shortages),\n130:             \"matched_count\": total_wh_matched,\n131:             \"not_found_count\": total_not_found,\n132:             \"review_count\": total_review_items,\n133:         }\n134: \n135:         return {\n136:             \"warehouse_results\": all_warehouse_results,\n137:             \"not_found\": not_found_items,\n138:             \"summary\": summary,\n139:         }\n140: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
