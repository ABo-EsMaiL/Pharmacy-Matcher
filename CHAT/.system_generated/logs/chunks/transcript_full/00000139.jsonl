{"step_index":6639,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-24T12:03:51Z","content":"Created At: 2026-09-24T15:03:51+03:00\nCompleted At: 2026-09-24T15:03:51+03:00\nFile Path: `file:///d:/AI_Engineer/Pharmacy-agy/scripts/package_production.py`\nTotal Lines: 193\nTotal Bytes: 7637\nShowing lines 1 to 60\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"\"\"\n2: Production Packaging Script for Pharmacy Matcher.\n3: Creates a clean, ready-to-deploy distribution folder for the pharmacy client machine.\n4: Excludes all development caches, test databases, scratch scripts, and temporary inputs.\n5: \"\"\"\n6: \n7: import os\n8: import shutil\n9: import sqlite3\n10: from pathlib import Path\n11: \n12: PROJECT_ROOT = Path(__file__).resolve().parent.parent\n13: DIST_DIR = PROJECT_ROOT / \"dist_production\"\n14: \n15: def package():\n16:     print(\"=\" * 60)\n17:     print(\"[*] Packaging Pharmacy Matcher for Production Deployment\")\n18:     print(\"=\" * 60)\n19: \n20:     if DIST_DIR.exists():\n21:         print(f\"[-] Removing existing {DIST_DIR.name}...\")\n22:         shutil.rmtree(DIST_DIR)\n23: \n24:     DIST_DIR.mkdir(parents=True, exist_ok=True)\n25: \n26:     # 1. Copy desktop_app\n27:     print(\"[+] Copying desktop_app/ ...\")\n28:     shutil.copytree(\n29:         PROJECT_ROOT / \"desktop_app\",\n30:         DIST_DIR / \"desktop_app\",\n31:         ignore=shutil.ignore_patterns(\"__pycache__\", \"*.pyc\", \".pytest_cache\")\n32:     )\n33: \n34:     # 2. Copy src\n35:     print(\"[+] Copying src/ ...\")\n36:     shutil.copytree(\n37:         PROJECT_ROOT / \"src\",\n38:         DIST_DIR / \"src\",\n39:         ignore=shutil.ignore_patterns(\"__pycache__\", \"*.pyc\", \".pytest_cache\")\n40:     )\n41: \n42:     # 3. Copy root essential files\n43:     essential_files = [\n44:         \"requirements.txt\",\n45:         \".env.example\",\n46:         \"fast_main.py\",\n47:     ]\n48:     for filename in essential_files:\n49:         src_file = PROJECT_ROOT / filename\n50:         if src_file.exists():\n51:             print(f\"[+] Copying {filename} ...\")\n52:             shutil.copy2(src_file, DIST_DIR / filename)\n53: \n54:     # 4. Create fresh data directory structure with clean database\n55:     data_dir = DIST_DIR / \"data\"\n56:     data_dir.mkdir(exist_ok=True)\n57:     (data_dir / \"processes\").mkdir(exist_ok=True)\n58:     (data_dir / \"inputs\").mkdir(exist_ok=True)\n59:     (data_dir / \".unstructured_cache\").mkdir(exist_ok=True)\n60:     \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
