{"step_index":6615,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-24T11:02:36Z","tool_calls":[{"name":"replace_file_content","args":{"AllowMultiple":false,"Description":"Update loadServersUI with pill switcher and is_external support","EndLine":3296,"Instruction":"Enhance loadServersUI to toggle provider pills and handle external vs managed status","ReplacementContent":"async function loadServersUI() {\n    if (!window.pywebview || !window.pywebview.api) return;\n    const t = I18N[currentLang] || I18N.ar;\n    \n    try {\n        const infoStr = await window.pywebview.api.get_servers_info();\n        const info = JSON.parse(infoStr);\n        const servers = info.servers || {};\n        const activeKey = info.active_server || 'gaistudio';\n        \n        // 1. Update 1-Click Provider Switcher Pills\n        const pillGai = document.getElementById('pill-provider-gaistudio');\n        const pillChat = document.getElementById('pill-provider-chatgpt');\n        if (pillGai) pillGai.classList.toggle('active', activeKey === 'gaistudio');\n        if (pillChat) pillChat.classList.toggle('active', activeKey === 'chatgpt');\n\n        // Backward compatibility for hidden elements\n        const activeSrv = servers[activeKey];\n        const bannerTitle = document.getElementById('active-banner-title');\n        const bannerSub = document.getElementById('active-banner-sub');\n        if (bannerTitle && activeSrv) {\n            bannerTitle.innerHTML = currentLang === 'en'\n                ? `Active Matching Provider: <strong>${activeSrv.name}</strong> (Port: ${activeSrv.port} • Model: ${activeSrv.default_model})`\n                : `المزود النشط حالياً لعمليات المطابقة: <strong>${activeSrv.name}</strong> (منفذ: ${activeSrv.port} • موديل: ${activeSrv.default_model})`;\n        }\n        if (bannerSub) {\n            bannerSub.textContent = currentLang === 'en'\n                ? `All shortage batches will be dispatched directly to ${activeSrv ? activeSrv.name : activeKey}.`\n                : `سيتم توجيه جميع دفعات مطابقة النواقص تلقائياً إلى هذا السيرفر (${activeSrv ? activeSrv.name : activeKey}).`;\n        }\n\n        // 2. Update each server card\n        ['gaistudio', 'chatgpt'].forEach(key => {\n            const srv = servers[key];\n            if (!srv) return;\n\n            const card = document.getElementById(`card-server-${key}`);\n            const badgeStatus = document.getElementById(`badge-status-${key}`);\n            const badgeActive = document.getElementById(`badge-active-${key}`);\n            const btnActive = document.getElementById(`btn-active-${key}`);\n            const btnToggle = document.getElementById(`btn-toggle-${key}`);\n            const valModel = document.getElementById(`val-model-${key}`);\n\n            if (valModel) valModel.textContent = srv.default_model;\n\n            const isRunning = !!srv.running;\n            const isExternal = !!srv.is_external;\n            const isManaged = !!srv.is_managed;\n            const isActive = (key === activeKey);\n\n            // Active Card Highlight & Badge\n            if (card) {\n                card.classList.toggle('is-active-provider', isActive);\n            }\n            if (badgeActive) {\n                badgeActive.style.display = isActive ? 'inline-flex' : 'none';\n                badgeActive.textContent = t.btn_already_active || '⭐ المزود النشط';\n            }\n\n            // Running Status Badge\n            if (badgeStatus) {\n                if (isManaged) {\n                    badgeStatus.className = 'badge-pill status-online';\n                    badgeStatus.textContent = currentLang === 'en' ? `🟢 Online (${srv.port})` : `🟢 متصل ومُدار (${srv.port})`;\n                } else if (isExternal) {\n                    badgeStatus.className = 'badge-pill status-warning';\n                    badgeStatus.textContent = currentLang === 'en' ? `⚠️ Occupied (${srv.port})` : `⚠️ محجوز خارجياً (${srv.port})`;\n                } else {\n                    badgeStatus.className = 'badge-pill status-offline';\n                    badgeStatus.textContent = currentLang === 'en' ? '🔴 Stopped' : '🔴 متوقف';\n                }\n            }\n\n            // Active Switch Button\n            if (btnActive) {\n                if (isActive) {\n                    btnActive.className = 'btn btn-small btn-outline';\n                    btnActive.style.borderColor = 'var(--primary)';\n                    btnActive.style.background = '#e0f2fe';\n                    btnActive.style.color = 'var(--primary)';\n                    btnActive.innerHTML = `<i class=\"ph-fill ph-star\"></i> <span>${t.btn_already_active || 'المزود النشط'}</span>`;\n                    btnActive.disabled = true;\n                } else {\n                    btnActive.className = 'btn btn-small btn-outline';\n                    btnActive.style.borderColor = '';\n                    btnActive.style.background = '';\n                    btnActive.style.color = '';\n                    btnActive.innerHTML = `<i class=\"ph-bold ph-check\"></i> <span>${t.btn_set_as_active || 'تفعيل كمزود نشط'}</span>`;\n                    btnActive.disabled = false;\n                }\n            }\n\n            // Toggle Run / Stop Button\n            if (btnToggle) {\n                if (isManaged) {\n                    btnToggle.className = 'btn btn-small btn-outline-secondary text-danger';\n                    btnToggle.innerHTML = `<i class=\"ph-bold ph-stop\"></i> <span>${t.btn_stop_instance || 'إيقاف السيرفر'}</span>`;\n                    btnToggle.title = currentLang === 'en' ? 'Stop server process' : 'إيقاف عملية السيرفر المُدارة';\n                    btnToggle.onclick = () => toggleServerInstance(key, false);\n                } else if (isExternal) {\n                    btnToggle.className = 'btn btn-small btn-outline-warning';\n                    btnToggle.innerHTML = `<i class=\"ph-bold ph-lightning\"></i> <span>${currentLang === 'en' ? 'Free Port' : 'تحرير المنفذ'}</span>`;\n                    btnToggle.title = currentLang === 'en' ? 'Port occupied by another process. Click to free.' : 'المنفذ محجوز بعملية سابقة. اضغط للتحرير والإغلاق الإجباري.';\n                    btnToggle.onclick = () => toggleServerInstance(key, false);\n                } else {\n                    btnToggle.className = 'btn btn-small btn-primary';\n                    btnToggle.innerHTML = `<i class=\"ph-bold ph-play\"></i> <span>${t.btn_start_instance || 'تشغيل السيرفر'}</span>`;\n                    btnToggle.title = currentLang === 'en' ? 'Start server instance' : 'بدء تشغيل السيرفر';\n                    btnToggle.onclick = () => toggleServerInstance(key, true);\n                }\n            }\n        });\n    } catch (e) {\n        console.error('Failed to load servers UI:', e);\n    }\n}","StartLine":3203,"TargetContent":"async function loadServersUI() {\n    if (!window.pywebview || !window.pywebview.api) return;\n    const t = I18N[currentLang] || I18N.ar;\n    \n    try {\n        const infoStr = await window.pywebview.api.get_servers_info();\n        const info = JSON.parse(infoStr);\n        const servers = info.servers || {};\n        const activeKey = info.active_server || 'gaistudio';\n        \n        // Update Active Provider Banner\n        const activeSrv = servers[activeKey];\n        const bannerTitle = document.getElementById('active-banner-title');\n        const bannerSub = document.getElementById('active-banner-sub');\n        if (bannerTitle && activeSrv) {\n            bannerTitle.innerHTML = currentLang === 'en'\n                ? `Active Matching Provider: <strong>${activeSrv.name}</strong> (Port: ${activeSrv.port} • Model: ${activeSrv.default_model})`\n                : `المزود النشط حالياً لعمليات المطابقة: <strong>${activeSrv.name}</strong> (منفذ: ${activeSrv.port} • موديل: ${activeSrv.default_model})`;\n        }\n        if (bannerSub) {\n            banne