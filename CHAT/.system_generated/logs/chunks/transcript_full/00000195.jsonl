     for u in user_lines:\n1130:         u_clean = re.sub(r'<\\s*thought\\b[^>]*>.*?<\\s*/\\s*thought\\s*>', '', u, flags=re.DOTALL | re.IGNORECASE)\n1131:         u_clean = re.sub(r'\\*\\*(?:Defining the Problem|Refining the Matching Criteria|Analyzing Match Results|Thinking Process)\\*\\*.*?(?=\\n\\n|$)', '', u_clean, flags=re.DOTALL)\n1132:         u_clean = re.sub(r'(?:Defining the Problem|Refining the Matching Criteria|Analyzing Match Results|I\\'ve just\\b).*?(?=\\n\\n|$)', '', u_clean, flags=re.DOTALL)\n1133:         u_clean = u_clean.strip()\n1134:         if u_clean:\n1135:             clean_user_lines.append(u_clean)\n1136: \n1137:     parts = []\n1138:     if system_lines:\n1139:         parts.append(\"[System Instructions]\\n\" + \"\\n\\n\".join(system_lines))\n1140: \n1141:     if clean_user_lines:\n1142:         parts.append(\"\\n\\n\".join(clean_user_lines))\n1143: \n1144:     return \"\\n\\n\".join(parts)\n1145: \n1146: # ------------------------------------------------------------------------------\n1147: # Endpoints\n1148: # ------------------------------------------------------------------------------\n1149: @app.post(\"/v1/chat/completions\", dependencies=[Depends(verify_api_key)])\n1150: @limiter.limit(RATE_LIMIT)\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
