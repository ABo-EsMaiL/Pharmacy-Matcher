{"step_index":6512,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-24T10:56:16Z","content":"Created At: 2026-09-24T13:56:16+03:00\nCompleted At: 2026-09-24T13:56:16+03:00\nFile Path: `file:///d:/AI_Engineer/Pharmacy-agy/desktop_app/templates/index.html`\nTotal Lines: 3328\nTotal Bytes: 138314\nShowing lines 3010 to 3280\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n3010:         updateServerStatus();\n3011:     } catch (error) {\n3012:         showToast('حدث خطأ أثناء تبديل حالة السيرفر', 'error');\n3013:     }\n3014: }\n3015: \n3016: const btnToggle = document.getElementById('btn-toggle-server');\n3017: if (btnToggle) btnToggle.addEventListener('click', toggleServer);\n3018: \n3019: // --- AI Servers Manager Logic ---\n3020: async function loadServersUI() {\n3021:     if (!window.pywebview || !window.pywebview.api) return;\n3022:     const t = I18N[currentLang] || I18N.ar;\n3023:     \n3024:     try {\n3025:         const infoStr = await window.pywebview.api.get_servers_info();\n3026:         const info = JSON.parse(infoStr);\n3027:         const servers = info.servers || {};\n3028:         const activeKey = info.active_server || 'gaistudio';\n3029:         \n3030:         // Update Active Provider Banner\n3031:         const activeSrv = servers[activeKey];\n3032:         const bannerTitle = document.getElementById('active-banner-title');\n3033:         const bannerSub = document.getElementById('active-banner-sub');\n3034:         if (bannerTitle && activeSrv) {\n3035:             bannerTitle.innerHTML = currentLang === 'en'\n3036:                 ? `Active Matching Provider: <strong>${activeSrv.name}</strong> (Port: ${activeSrv.port} • Model: ${activeSrv.default_model})`\n3037:                 : `المزود النشط حالياً لعمليات المطابقة: <strong>${activeSrv.name}</strong> (منفذ: ${activeSrv.port} • موديل: ${activeSrv.default_model})`;\n3038:         }\n3039:         if (bannerSub) {\n3040:             bannerSub.textContent = currentLang === 'en'\n3041:                 ? `All shortage batches will be dispatched directly to ${activeSrv ? activeSrv.name : activeKey}.`\n3042:                 : `سيتم توجيه جميع دفعات مطابقة النواقص تلقائياً إلى هذا السيرفر (${activeSrv ? activeSrv.name : activeKey}).`;\n3043:         }\n3044: \n3045:         // Update each server card\n3046:         ['gaistudio', 'chatgpt'].forEach(key => {\n3047:             const srv = servers[key];\n3048:             if (!srv) return;\n3049: \n3050:             const card = document.getElementById(`card-server-${key}`);\n3051:             const badgeStatus = document.getElementById(`badge-status-${key}`);\n3052:             const badgeActive = document.getElementById(`badge-active-${key}`);\n3053:             const btnActive = document.getElementById(`btn-active-${key}`);\n3054:             const btnToggle = document.getElementById(`btn-toggle-${key}`);\n3055:             const valModel = document.getElementById(`val-model-${key}`);\n3056: \n3057:             if (valModel) valModel.textContent = srv.default_model;\n3058: \n3059:             const isRunning = !!srv.running;\n3060:             const isActive = (key === activeKey);\n3061: \n3062:             // Active Card Highlight & Badge\n3063:             if (card) {\n3064:                 card.classList.toggle('is-active-provider', isActive);\n3065:             }\n3066:             if (badgeActive) {\n3067:                 badgeActive.style.display = isActive ? 'inline-flex' : 'none';\n3068:                 badgeActive.textContent = t.btn_already_active;\n3069:             }\n3070: \n3071:             // Running Status Badge\n3072:             if (badgeStatus) {\n3073:                 badgeStatus.className = isRunning ? 'badge-pill status-online' : 'badge-pill status-offline';\n3074:                 badgeStatus.textContent = isRunning \n3075:                     ? (currentLang === 'en' ? `🟢 Online (Port ${srv.port})` : `🟢 متصل ومستمع (${srv.port})`) \n3076:                     : (currentLang === 'en' ? '🔴 Stopped' : '🔴 متوقف');\n3077:             }\n3078: \n3079:             // Active Switch Button\n3080:             if (btnActive) {\n3081:                 if (isActive) {\n3082:                     btnActive.className = 'btn btn-outline';\n3083:                     btnActive.style.borderColor = 'var(--primary)';\n3084:                     btnActive.style.background = '#e0f2fe';\n3085:                     btnActive.style.color = 'var(--primary)';\n3086:                     btnActive.innerHTML = `<i class=\"ph-fill ph-star\"></i> <span>${t.btn_already_active}</span>`;\n3087:                     btnActive.disabled = true;\n3088:                 } else {\n3089:                     btnActive.className = 'btn btn-outline';\n3090:                     btnActive.style.borderColor = '';\n3091:                     btnActive.style.background = '';\n3092:                     btnActive.style.color = '';\n3093:                     btnActive.innerHTML = `<i class=\"ph-bold ph-check\"></i> <span>${t.btn_set_as_active}</span>`;\n3094:                     btnActive.disabled = false;\n3095:                 }\n3096:             }\n3097: \n3098:             // Toggle Run / Stop Button\n3099:             if (btnToggle) {\n3100:                 if (isRunning) {\n3101:                     btnToggle.className = 'btn btn-outline-secondary text-danger';\n3102:                     btnToggle.innerHTML = `<i class=\"ph-bold ph-stop\"></i> <span>${t.btn_stop_instance}</span>`;\n3103:                     btnToggle.onclick = () => toggleServerInstance(key, false);\n3104:                 } else {\n3105:                     btnToggle.className = 'btn btn-primary';\n3106:                     btnToggle.innerHTML = `<i class=\"ph-bold ph-play\"></i> <span>${t.btn_start_instance}</span>`;\n3107:                     btnToggle.onclick = () => toggleServerInstance(key, true);\n3108:                 }\n3109:             }\n3110:         });\n3111:     } catch (e) {\n3112:         console.error('Failed to load servers UI:', e);\n3113:     }\n3114: }\n3115: \n3116: async function toggleServerInstance(serverKey, startIt) {\n3117:     const t = I18N[currentLang] || I18N.ar;\n3118:     const btn = document.getElementById(`btn-toggle-${serverKey}`);\n3119:     if (btn) {\n3120:         btn.disabled = true;\n3121:         btn.innerHTML = `<i class=\"ph-fill ph-spinner-gap spinner\"></i> <span>${currentLang === 'en' ? 'Processing...' : 'جاري المعالجة...'}</span>`;\n3122:     }\n3123: \n3124:     try {\n3125:         let res;\n3126:         if (startIt) {\n3127:             showToast(currentLang === 'en' ? `Starting ${serverKey}...` : `جاري تشغيل سيرفر ${serverKey}...`, 'info');\n3128:             appendServerLog(`[SYSTEM] Starting server instance '${serverKey}'...`);\n3129:             res = await window.pywebview.api.start_server_instance(serverKey);\n3130:         } else {\n3131:             showToast(currentLang === 'en' ? `Stopping ${serverKey}...` : `جاري إيقاف سيرفر ${serverKey}...`, 'info');\n3132:             appendServerLog(`[SYSTEM] Stopping server instance '${serverKey}'...`);\n3133:             res = await window.pywebview.api.stop_server_instance(serverKey);\n3134:         }\n3135: \n3136:         if (res.success) {\n3137:             appendServerLog(`[SYSTEM] Server '${serverKey}' operation succeeded: ${res.message || 'OK'}`);\n3138:             showToast(res.message || (currentLang === 'en' ? 'Operation successful' : 'تمت العملية بنجاح'), 'success');\n3139:         } else {\n3140:             appendServerLog(`[WARNING] Server '${serverKey}' stop/start: ${res.message || res.error || 'Failed'}`);\n3141:             if (res.elevated) {\n3142:                 showCustomConfirm(\n3143:                     currentLang === 'en' ? 'Administrator Process' : 'تن