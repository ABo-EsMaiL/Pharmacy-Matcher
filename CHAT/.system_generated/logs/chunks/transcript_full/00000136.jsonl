\n3183:     if (!term) return;\n3184:     const now = new Date().toLocaleTimeString('en-US', { hour12: false });\n3185:     term.value += `[${now}] ${line}\\n`;\n3186:     term.scrollTop = term.scrollHeight;\n3187: }\n3188: \n3189: async function loadServerLogs() {\n3190:     const term = document.getElementById('ai-server-terminal');\n3191:     if (!term || !window.pywebview?.api?.get_server_logs) return;\n3192:     try {\n3193:         const raw = await window.pywebview.api.get_server_logs();\n3194:         const logs = JSON.parse(raw || '[]');\n3195:         if (logs.length > 0) {\n3196:             term.value = logs.join('\\n') + '\\n';\n3197:         } else if (!term.value.trim()) {\n3198:             term.value = '--- شاشة سجلات وخادم الذكاء الاصطناعي (AI Server Console) جاهزة ---\\nاضغط على \"اختبار الاتصال\" أو قم بتشغيل أي سيرفر لمشاهدة المخرجات هنا مباشرة.\\n';\n3199:         }\n3200:         term.scrollTop = term.scrollHeight;\n3201:     } catch (e) {\n3202:         console.error('Failed to load server logs', e);\n3203:     }\n3204: }\n3205: \n3206: async function clearServerLogs() {\n3207:     const term = document.getElementById('ai-server-terminal');\n3208:     if (term) term.value = '';\n3209:     try {\n3210:         if (window.pywebview?.api?.clear_server_logs) {\n3211:             await window.pywebview.api.clear_server_logs();\n3212:         }\n3213:         showToast(currentLang === 'en' ? 'Server logs cleared' : 'تم مسح سجل السيرفرات بنجاح', 'success');\n3214:     } catch (e) {\n3215:         console.error(e);\n3216:     }\n3217: }\n3218: \n3219: // Live Server Log Event Listener\n3220: window.addEventListener('new_server_log', (event) => {\n3221:     appendServerLog(event.detail);\n3222: });\n3223: \n3224: async function testServerInstance(serverKey) {\n3225:     const t = I18N[currentLang] || I18N.ar;\n3226:     const btn = document.getElementById(`btn-test-${serverKey}`);\n3227:     const originalHtml = btn ? btn.innerHTML : '';\n3228:     \n3229:     if (btn) {\n3230:         btn.disabled = true;\n3231:         btn.innerHTML = `<i class=\"ph-fill ph-spinner-gap spinner\"></i> <span>${t.server_testing || 'جاري الفحص...'}</span>`;\n3232:     }\n3233: \n3234:     appendServerLog(`Sending test ping to server instance '${serverKey}'...`);\n3235: \n3236:     try {\n3237:         const res = await window.pywebview.api.test_server_instance(serverKey);\n3238:         if (res.success) {\n3239:             const latencyStr = res.latency_ms ? `${res.latency_ms} ms` : `${res.latency || 0}s`;\n3240:             appendServerLog(`✅ SUCCESS: '${res.name}' responded in ${latencyStr} | Reply: \"${res.reply}\" | Model: ${res.model || ''}`);\n3241:             showToast(currentLang === 'en' ? `Ping success! Latency: ${latencyStr}` : `تم الاتصال بنجاح! زمن الاستجابة: ${latencyStr}`, 'success');\n3242:         } else if (res.is_stopped) {\n3243:             appendServerLog(`⚠️ WARNING: Server '${res.name || serverKey}' is currently STOPPED.`);\n3244:             appendServerLog(`💡 Suggestion: Click 'Start Server' (تشغيل السيرفر) first, then re-test.`);\n3245:             showToast(res.error || (currentLang === 'en' ? 'Server is stopped' : 'السيرفر متوقف حالياً. اضغط على تشغيل السيرفر أولاً'), 'warning');\n3246:         } else {\n3247:             appendServerLog(`❌ FAILED: Server '${serverKey}' ping failed: ${res.error}`);\n3248:             appendServerLog(`💡 Suggestion: Ensure the server is started and port ${res.port || '8000/8001'} is listening.`);\n3249:             showToast((currentLang === 'en' ? 'Ping failed: ' : 'فشل اختبار الاتصال: ') + (res.error || 'Unknown error'), 'error');\n3250:         }\n3251:     } catch (e) {\n3252:         appendServerLog(`❌ Unexpected test error: ${e.message}`);\n3253:         showToast(currentLang === 'en' ? 'Test error' : 'حدث خطأ أثناء الاختبار', 'error');\n3254:     } finally {\n3255:         if (btn) {\n3256:             btn.disabled = false;\n3257:             btn.innerHTML = ori