e_process(processId);\\n            if (res.success) {\\n                showToast(t.toast_deleted, 'success');\\n                loadHistory();\\n            } else {\\n                showToast((currentLang === 'en' ? 'Error: ' : 'خطأ: ') + res.error, 'error');\\n            }\\n        } catch (error) {\\n            showToast(currentLang === 'en' ? 'Deletion error' : 'خطأ في الحذف', 'error');\\n        }\\n    });\\n}\"","StartLine":"1499","TargetContent":"\"// Exit App\\nasync function exitApp() {\\n    try {\\n        let isRunning = false;\\n        if (window.pywebview && window.pywebview.api) {\\n            const historyStr = await window.pywebview.api.get_history();\\n            const history = JSON.parse(historyStr);\\n            isRunning = history.some(item => item.status === 'processing');\\n        }\\n        \\n        if (isRunning) {\\n            showCustomConfirm('تأكيد الإغلاق', 'توجد عمليات مطابقة قيد التشغيل في الخلفية. هل أنت متأكد من الإغلاق؟', async () => {\\n                await window.pywebview.api.exit_app();\\n            });\\n        } else {\\n            if (window.pywebview && window.pywebview.api) {\\n                await window.pywebview.api.exit_app();\\n            }\\n        }\\n    } catch (e) {\\n        console.error(e);\\n        // Fallback\\n        if (window.pywebview && window.pywebview.api) {\\n            window.pywebview.api.exit_app();\\n        }\\n    }\\n}\\n\\n// Delete Process\\nfunction deleteProcess(processId) {\\n    showCustomConfirm('تأكيد الحذف', 'هل أنت متأكد من حذف هذه العملية نهائياً من السجل؟', async () => {\\n        try {\\n            const res = await window.pywebview.api.delete_process(processId);\\n            if (res.success) {\\n                showToast('تم الحذف بنجاح', 'success');\\n                loadHistory();\\n            } else {\\n                showToast('خطأ: ' + res.error, 'error');\\n            }\\n        } catch (error) {\\n            showToast('خطأ في الحذف', 'error');\\n        }\\n    });\\n}\"","TargetFile":"\"d:/AI_Engineer/Pharmacy-agy/desktop_app/templates/index.html\"","toolAction":"\"Editing file\"","toolSummary":"\"Update exitApp and deleteProcess with I18N\""}}]}
