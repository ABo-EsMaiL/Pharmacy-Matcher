tical validation.\"\"\"\n92:         if not self.corpus:\n93:             return []\n94:             \n95:         q_norm = normalize_for_search(query)\n96:         if not q_norm:\n97:             return []\n98\n<truncated 309 bytes>\nkens(query)\n106:         req_form = extract_form_group(query)\n107:         \n108:         results = []\n109:         for idx in top_indices:\n110:             score = float(sims[idx])\n111:             cand_name = self.original_names[idx]\n112:             cand_brand = extract_brand_tokens(cand_name)\n113:             cand_form = extract_form_group(cand_name)\n114:             \n115:             # Rule 1: Zero tolerance for conflicting dosage forms (Tablets vs Syrup, Cream vs Suppository, etc.)\n116:             if req_form and cand_form and req_form != cand_form:\n117:                 continue\n118:                 \n119:             # Rule 2: Brand similarity check (Levenshtein / Token sort)\n120:             words_req = req_brand.split()\n121:             words_cand = cand_brand.split()\n122:             if len(words_req) > 1 or len(words_cand) > 1:\n123:                 brand_sim = fuzz.token_sort_ratio(req_brand, cand_brand)\n124:             else:\n125:                 brand_sim = fuzz.ratio(req_brand, cand_brand)\n126:                 \n127:             # Check prefix match for brand names\n128:             if req_brand and cand_brand:\n129:                 if req_brand.startswith(cand_brand) or cand_brand.startswith(req_brand):\n130:                     brand_sim = max(brand_sim, 80)\n131:                     \n132:             # Rule 3: Only accept candidates that share the brand name (>=58%) OR very high TF-IDF (>=0.50)\n133:             if brand_sim >= 58 or score >= 0.50:\n134:                 results.append({\n135:                     \"id\": self.ids[idx],\n136:                     \"name\": cand_name,\n137:                     \"score\": score,\n138:                     \"brand_sim\": brand_sim\n139:                 })\n140:                 if len(results) >= top_k:\n141:                     break\n142:                     \n143:         return results\n144: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n","truncated_fields":["content"]}
