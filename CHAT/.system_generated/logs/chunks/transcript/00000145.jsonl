{"step_index":9654,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-25T12:49:51Z","content":"Created At: 2026-09-25T15:49:51+03:00\nCompleted At: 2026-09-25T15:49:51+03:00\nFile Path: `file:///D:/AI_Engineer/MSEMAX-GAIStudio/app.py`\nTotal Lines: 1556\nTotal Bytes: 74538\nShowing lines 1 to 65\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"\"\"\n2: MSEMAX — Google AI Studio Web Hook Gateway (FastAPI Server)\n3: \n4: A 100% free, OpenAI-compatible API gateway that drives the Google AI Studio\n5: Web Interface (https://aistudio.google.com) using a persistent Chromium\n6: browser profile (./chrome_profile).\n7: \n8: No official API key is required. Uses real-time DOM stream capture to\n9: provide instant Server-Sent Events (SSE) responses compatible with any\n10: OpenAI client, LangChain, n8n, etc.\n11: \n12: Default Model: gemini-3.8-flash (Thinking: High)\n13: \n14: Author: Mohamed (MSEMAX) & Antigravity\n15: License: MIT\n16: \"\"\"\n17: \n18: import os\n19: import re\n20: import time\n21: import json\n22: import uuid\n23: import asyncio\n24: import logging\n25: from typing import AsyncGenerator, Optional, Any, List, Dict, Union\n26: from contextlib import asynccontextmanager\n27: \n28: from fastapi import FastAPI, Request, HTTPException, Depends, Header\n29: from fastapi.responses import StreamingResponse, JSONResponse\n30: from fastapi.middleware.cors import CORSMiddleware\n31: from pydantic import BaseModel\n32: from slowapi import Limiter, _rate_limit_exceeded_handler\n33: from slowapi.util import get_remote_address\n34: from slowapi.errors import RateLimitExceeded\n35: from dotenv import load_dotenv\n36: from playwright.async_api import async_playwright, BrowserContext, Page\n37: \n38: # Load environment\n39: load_dotenv()\n40: \n41: logging.basicConfig(\n42:     level=logging.INFO,\n43:     format=\"%(asctime)s - %(name)s - %(levelname)s - %(message)s\"\n44: )\n45: logger = logging.getLogger(\"msemax.webhook\")\n46: \n47: # ------------------------------------------------------------------------------\n48: # Configuration\n49: # ------------------------------------------------------------------------------\n50: API_KEY = os.getenv(\"MSE_MAX_KEY\", \"\").strip()\n51: CHROME_PROFILE_DIR = os.getenv(\"CHROME_PROFILE_DIR\", \"./chrome_profile\")\n52: BASE_DIR = os.path.dirname(os.path.abspath(__file__))\n53: if not os.path.isabs(CHROME_PROFILE_DIR):\n54:     CHROME_PROFILE_DIR = os.path.normpath(os.path.join(BASE_DIR, CHROME_PROFILE_DIR))\n55: HEADLESS = os.getenv(\"HEADLESS\", \"true\").lower() in (\"true\", \"1\", \"yes\")\n56: DEFAULT_MODEL = os.getenv(\"DEFAULT_MODEL\", \"gemini-3.8-flash\").strip()\n57: THINKING_MODE = os.getenv(\"THINKING_MODE\", \"high\").strip().lower()\n58: ENABLE_SEARCH_GROUNDING = os.getenv(\"ENABLE_SEARCH_GROUNDING\", \"false\").lower() in (\"true\", \"1\", \"yes\")\n59: CLEAR_CHAT_ON_REQUEST = os.getenv(\"CLEAR_CHAT_ON_REQUEST\", \"true\").lower() in (\"true\", \"1\", \"yes\")\n60: REQUEST_TIMEOUT = float(os.getenv(\"MSE_REQUEST_TIMEOUT\", \"180\"))\n61: RATE_LIMIT = os.getenv(\"MSE_RATE_LIMIT\", \"30/minute\").strip()\n62: MAX_CONCURRENT = int(os.getenv(\"MSE_MAX_CONCURRENT\", \"1\"))\n63: PORT = int(os.getenv(\"PORT\", \"8001\"))\n64: TARGET_URL = \"https://aistudio.google.com/prompts/new_chat\"\n65: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
