                const target = document.getElementById(screenId);\n3564:                 if (target) target.classList.add('active');\n3565:             }\n3566:             \n3567:             // Auto-detect and sync sidebar active nav item if element is null or not provided\n3568:             if (!element) {\n3569:                 element = document.querySelector(`.nav-menu .nav-item[onclick*=\"${screenId}\"]`);\n3570:             }\n3571:             if (element) {\n3572:                 document.querySelectorAll('.nav-item').forEach(btn => btn.classList.remove('active'));\n3573:                 element.classList.add('active');\n3574:             }\n3575: \n3576:             // Update top bar heading\n3577:             if (typeof updateTopBarHeading === 'function') {\n3578:                 updateTopBarHeading(screenId);\n3579:             }\n3580: \n3581:             if (screenId === 'screen-new') {\n3582:                 if (typeof isProcessRunning !== 'undefined' && isProcessRunning) {\n3583:                     const progressModal = document.getElementById('progress-modal');\n3584:                     if (progressModal) progressModal.style.display = 'flex';\n3585:                 } else {\n3586:                     resetNewProcessForm();\n3587:                 }\n3588:             } else if (screenId === 'screen-logs' || screenId === 'screen-settings') {\n3589:                 loadLogs();\n3590:             } else if (screenId === 'screen-servers') {\n3591:                 loadServersUI();\n3592:                 loadServerLogs();\n3593:             }\n3594:         };\n3595:         // Auto select first nav item and initialize language\n3596:         document.addEventListener(\"DOMContentLoaded\", () => {\n3597:             setLanguage(currentLang);\n3598:             const firstNav = document.querySelector('.nav-item');\n3599:             if (firstNav) firstNav.classList.add('active');\n3600:         });\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
