{"step_index":9036,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-24T23:04:00Z","content":"Created At: 2026-09-25T02:04:00+03:00\nCompleted At: 2026-09-25T02:04:00+03:00\nFile Path: `file:///D:/AI_Engineer/Pharmacy-agy/src/fast_match/coordinator.py`\nTotal Lines: 800\nTotal Bytes: 44051\nShowing lines 130 to 180\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n130: BRAND_FAMILIES = {'بيتادين', 'هيرو', 'انسولين', 'ليمتلس', 'سيتال'}\r\n131: \r\n132: def classify_pair(req: str, cand: str) -> tuple[str, str]:\r\n133:     \"\"\"\r\n134:     Classifies a (requested, candidate) pair according to the user's pharmaceutical algorithm:\r\n135:     - 'match': Same brand, same strength, identical/compatible form.\r\n136:     - 'review': Same brand, same strength, but DIFFERENT form (e.g. cream vs ointment, drops vs tablet).\r\n137:     - 'reject': Different strength (التركيز خط أحمر), or different combination, or brand family conflict.\r\n138:     - 'ambiguous': Brand similarity 60%-85% (OCR typos like برونفين vs بروفين) -> send to LLM.\r\n139:     \"\"\"\r\n140:     brand_r = extract_brand_tokens(req)\r\n141:     brand_c = extract_brand_tokens(cand)\r\n142:     if not brand_r or not brand_c:\r\n143:         return \"reject\", \"no_brand\"\r\n144:         \r\n145:     words_r = brand_r.split()\r\n146:     words_c = brand_c.split()\r\n147:     first_r = words_r[0] if words_r else \"\"\r\n148:     first_c = words_c[0] if words_c else \"\"\r\n149:     \r\n150:     # 1. Brand Family Protection\r\n151:     if first_r in BRAND_FAMILIES or first_c in BRAND_FAMILIES:\r\n152:         family_sim = max(fuzz.ratio(brand_r, brand_c), fuzz.token_set_ratio(brand_r, brand_c))\r\n153:         if family_sim < 85:\r\n154:             return \"reject\", \"brand_family_conflict\"\r\n155:             \r\n156:     # 2. Combination check (كو / بلس)\r\n157:     if has_co(req) != has_co(cand):\r\n158:         return \"reject\", \"combination_mismatch\"\r\n159:         \r\n160:     # 3. Strength check (التركيز خط أحمر - zero tolerance)\r\n161:     str_r = get_strength_pattern(req)\r\n162:     str_c = get_strength_pattern(cand)\r\n163:     if str_r and str_c:\r\n164:         try:\r\n165:             if float(str_r) != float(str_c):\r\n166:                 return \"reject\", f\"strength_conflict_{str_r}_vs_{str_c}\"\r\n167:         except:\r\n168:             if str_r != str_c:\r\n169:                 return \"reject\", f\"strength_conflict_{str_r}_vs_{str_c}\"\r\n170:                 \r\n171:     slash_r = re.search(r'(?:^|[^\\d/])(\\d+(?:\\.\\d+)?\\/\\d+(?:\\.\\d+)?)(?:[^\\d/]|$)', norm_num(req))\r\n172:     slash_c = re.search(r'(?:^|[^\\d/])(\\d+(?:\\.\\d+)?\\/\\d+(?:\\.\\d+)?)(?:[^\\d/]|$)', norm_num(cand))\r\n173:     if slash_r and slash_c and slash_r.group(1) != slash_c.group(1):\r\n174:         return \"reject\", \"slash_strength_conflict\"\r\n175:     if (slash_r and not slash_c) or (slash_c and not slash_r):\r\n176:         return \"reject\", \"slash_missing_conflict\"\r\n177: \r\n178:     # 4. Brand Similarity & Identity\r\n179:     b_sim = fuzz.ratio(brand_r, brand_c)\r\n180:     is_exact_brand = (brand_r == brand_c)\r\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
