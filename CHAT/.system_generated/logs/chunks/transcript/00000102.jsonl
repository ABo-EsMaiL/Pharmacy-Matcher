{"step_index":6712,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-24T14:34:40Z","content":"Created At: 2026-09-24T17:34:40+03:00\nCompleted At: 2026-09-24T17:34:40+03:00\nFile Path: `file:///d:/AI_Engineer/MSEMAX-GAIStudio/app.py`\nTotal Lines: 971\nTotal Bytes: 41919\nShowing lines 570 to 630\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n570:     content: Any = None\n571: \n572: class ChatRequest(BaseModel):\n573:     model: str = DEFAULT_MODEL\n574:     messages: List[ChatMessage]\n575:     stream: bool = True\n576:     temperature: Optional[float] = None\n577:     max_tokens: Optional[int] = None\n578: \n579: # ------------------------------------------------------------------------------\n580: # Helpers\n581: # ------------------------------------------------------------------------------\n582: def format_messages_to_prompt(messages: List[ChatMessage]) -> str:\n583:     \"\"\"Combines user/system/assistant messages into a clean prompt string.\"\"\"\n584:     if not CLEAR_CHAT_ON_REQUEST and messages:\n585:         # In continuous chat mode, extract the latest user message\n586:         last_user = \"\"\n587:         for m in reversed(messages):\n588:             if m.role == \"user\":\n589:                 content = m.content or \"\"\n590:                 if isinstance(content, list):\n591:                     content = \" \".join([p.get(\"text\", \"\") for p in content if isinstance(p, dict) and \"text\" in p])\n592:                 last_user = str(content).strip()\n593:                 break\n594: \n595:         system_lines = [\n596:             str(m.content).strip() for m in messages\n597:             if m.role == \"system\" and m.content\n598:         ]\n599:         if system_lines and len(messages) <= 2:\n600:             return f\"[System Instructions]\\n\" + \"\\n\".join(system_lines) + \"\\n\\n\" + last_user\n601:         if last_user:\n602:             return last_user\n603: \n604:     system_lines = []\n605:     dialogue_lines = []\n606: \n607:     for m in messages:\n608:         content = m.content or \"\"\n609:         if isinstance(content, list):\n610:             content = \" \".join([p.get(\"text\", \"\") for p in content if isinstance(p, dict) and \"text\" in p])\n611:         content = str(content).strip()\n612: \n613:         if m.role == \"system\":\n614:             system_lines.append(content)\n615:         elif m.role == \"user\":\n616:             dialogue_lines.append(f\"User: {content}\")\n617:         elif m.role == \"assistant\":\n618:             dialogue_lines.append(f\"Assistant: {content}\")\n619: \n620:     if len(dialogue_lines) == 1 and not system_lines:\n621:         return dialogue_lines[0].replace(\"User: \", \"\", 1)\n622: \n623:     parts = []\n624:     if system_lines:\n625:         parts.append(\"[System Instructions]\\n\" + \"\\n\".join(system_lines))\n626:     if dialogue_lines:\n627:         parts.append(\"\\n\".join(dialogue_lines))\n628: \n629:     return \"\\n\\n\".join(parts)\n630: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
