vision_cache/<file_slug>_<hash[:10]>.\n40:     \"\"\"\n41:     filepath = Path(filepath).resolve()\n42:     file_hash = _compute_file_hash(filepath)\n43:     file_slug = re.sub(r\"[^\\w\\-]\", \"_\", filepath.stem)[:25]\n44:     folder_name \n<truncated 3026 bytes>\n\"utf-8\") as f:\n128:                 loaded_manifest = json.load(f)\n129:             if loaded_manifest.get(\"file_hash\") == file_hash and loaded_manifest.get(\"total_pages\") == total_pages:\n130:                 manifest = loaded_manifest\n131:                 print(f\"  -> Found existing cache manifest (Completed pages: {len(manifest.get('completed_pages', []))}/{total_pages})\")\n132:         except Exception as e:\n133:             print(f\"  [!] Could not parse manifest, re-initializing: {e}\")\n134: \n135:     # Check if completely finished\n136:     completed_set = set(manifest.get(\"completed_pages\", []))\n137:     all_pages_cached = (len(completed_set) == total_pages and \n138:                         all((cache_dir / \"results\" / f\"page_{p}.json\").exists() for p in range(1, total_pages + 1)))\n139: \n140:     if all_pages_cached:\n141:         print(f\"[+] All {total_pages} pages previously extracted in cache. Loading instantly...\")\n142:         all_items = []\n143:         for p in range(1, total_pages + 1):\n144:             res_file = cache_dir / \"results\" / f\"page_{p}.json\"\n145:             with open(res_file, \"r\", encoding=\"utf-8\") as f:\n146:                 p_data = json.load(f)\n147:                 items = p_data.get(\"items\", [])\n148:                 for it in items:\n149:                     it[\"source_file\"] = filepath.name\n150:                     if \"source_page\" not in it:\n151:                         it[\"source_page\"] = p\n152:                 all_items.extend(items)\n153:         print(f\"[+] Loaded {len(all_items)} items from cache in 0.05s.\")\n154:         return all_items\n155: \n156:     # Process pending pages\n157:     print(f\"[*] Starting/Resuming Vision extraction across {total_pages} page(s)...\")\n158: \n159:     for page_num in range(1, total_pages + 1):\n160:         page_res_path = cache_dir / \"results\" / f\"page_{page_num}.json\"\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n","truncated_fields":["content"]}
