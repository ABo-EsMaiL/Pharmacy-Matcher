tion helpers\n32: def super_norm(s):\n33:     s = s.lower()\n34:     for e, w in zip('٠١٢٣٤٥٦٧٨٩', '0123456789'):\n35:         s = s.replace(e, w)\n36:     # Normalize arabic/persian letters\n37:     rep = {\n38:         'أ': 'ا', \n<truncated 1647 bytes>\nrm_req:\n73:                 sim = max(fuzz.ratio(brand, cand_brand), fuzz.token_set_ratio(norm_req, norm_cand))\n74:                 if sim >= 70:\n75:                     potential_discoveries.append({\n76:                         \"shortage\": shortage,\n77:                         \"warehouse\": wh,\n78:                         \"warehouse_item\": cand,\n79:                         \"sim\": sim,\n80:                         \"reason\": f\"Substring match '{brand}' in '{cand}'\"\n81:                     })\n82:                     continue\n83:                     \n84:             # High fuzzy ratio on brand\n85:             b_sim = fuzz.ratio(brand, cand_brand)\n86:             if b_sim >= 75 and len(brand) >= 4 and len(cand_brand) >= 4:\n87:                 potential_discoveries.append({\n88:                     \"shortage\": shortage,\n89:                     \"warehouse\": wh,\n90:                     \"warehouse_item\": cand,\n91:                     \"sim\": b_sim,\n92:                     \"reason\": f\"Brand fuzzy match ({b_sim}%): '{brand}' vs '{cand_brand}'\"\n93:                 })\n94: \n95: # Deduplicate by (shortage, warehouse, warehouse_item)\n96: unique_discoveries = {}\n97: for d in potential_discoveries:\n98:     k = (d[\"shortage\"], d[\"warehouse\"], d[\"warehouse_item\"])\n99:     if k not in unique_discoveries or d[\"sim\"] > unique_discoveries[k][\"sim\"]:\n100:         unique_discoveries[k] = d\n101: \n102: results = list(unique_discoveries.values())\n103: results.sort(key=lambda x: x[\"sim\"], reverse=True)\n104: \n105: print(f\"\\n=== POTENTIAL HIDDEN DISCOVERIES FOUND: {len(results)} ===\")\n106: for r in results[:50]:\n107:     print(f\"[{r['warehouse']}] Shortage: '{r['shortage']}'