oogle Account (if prompted).\")\n43:     print(\"  3. Accept any Google AI Studio terms if it's your first time.\")\n44:     print(\"  4. Once you see the prompt chat box / 'Run' button, the script\")\n45:     print(\"     will automatically detect it and save your session!\")\n46:     print(\"-\" * 65)\n47:     print(\"Launching Chromium...\")\n48: \n49:     async with async_playwright() as p:\n50:         try:\n51:             context = await p.chromium.launch_persistent_context(\n52:                 user_data_dir=CHROME_PROFILE_DIR,\n53:              