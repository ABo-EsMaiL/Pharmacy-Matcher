فسه لما نمسح الصف\\n    Application.EnableEvents = False\\n    \\n    ' التأكد إن التغيير حصل في العمود الأول (القرار) وإنه في خلية واحدة بس\\n    If Not Intersect(Target, Me.Columns(\\\"A\\\")) Is Nothing And Target.Count = 1 Then\\n        Dim decision As String\\n        decision = Target.Value\\n        \\n        Dim reqName As String\\n        Dim whName As String\\n        Dim whSheetName As String\\n        \\n        ' قراءة البيانات من نفس الصف\\n        reqName = Target.Offset(0, 1).Value ' اسم الصنف المطلوب\\n        whName = Target.Offset(0, 2).Value  ' اسم المرشح\\n        whSheetName = Target.Offset(0, 3).Value ' اسم المخزن\\n        \\n        ' تنظيف اسم المخزن عشان يطابق اسم الشيت (نفس الـ Logic بتاع البايثون)\\n        whSheetName = Left(whSheetName, 31)\\n        whSheetName = Replace(whSheetName, \\\"[\\\", \\\"_\\\")\\n        whSheetName = Replace(whSheetName, \\\"]\\\", \\\"_\\\")\\n        whSheetName = Replace(whSheetName, \\\":\\\", \\\"_\\\")\\n        whSheetName = Replace(whSheetName, \\\"*\\\", \\\"_\\\")\\n        whSheetName = Replace(whSheetName, \\\"?\\\", \\\"_\\\")\\n        whSheetName = Replace(whSheetName, \\\"/\\\", \\\"_\\\")\\n        whSheetName = Replace(whSheetName, \\\"\\\\\\\", \\\"_\\\")\\n        \\n        If decision = \\\"✅ مطابق\\\" Then\\n            Dim wsTarget As Worksheet\\n            On Error Resume Next\\n            Set wsTarget = ThisWorkbook.Sheets(whSheetName)\\n            On Error GoTo ErrorHandler\\n            \\n            If Not wsTarget Is Nothing Then\\n                Dim lastRow As Long\\n                lastRow = wsTarget.Cells(wsTarget.Rows.Count, \\\"A\\\").End(xlUp)\n<truncated 1330 bytes>","Description":"\"VBA Macro code to handle auto-moving rows based on dropdown selection in Excel\"","Overwrite":"true","TargetFile":"\"d:\\\\AI_Engineer\\\\Pharmacy-agy\\\\vba_macro.txt\"","toolAction":"\"Creating a text file containing the VBA Macro code\"","toolSummary":"\"Create VBA code file\""}}],"truncated_fields":["tool_calls"]}
