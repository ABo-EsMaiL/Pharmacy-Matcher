, socket.SOCK_STREAM) as s:\n42:             s.settimeout(timeout)\n43:             return s.connect_ex((host, port)) == 0\n44:     except Exception:\n45:         return False\n46: \n47: clas\n<truncated 10089 bytes>\nir = explicit_g_dir or default_g_dir\n273:         g_conf = dict(DEFAULT_SERVERS[\"gaistudio\"])\n274:         g_conf[\"dir\"] = g_dir\n275:         self.servers[\"gaistudio\"] = ServerInstance(\"gaistudio\", g_conf, logger_callback=self.logger)\n276: \n277:     def get_server(self, key: str) -> ServerInstance | None:\n278:         return self.servers.get(key)\n279: \n280:     def get_all_status(self, active_key: str = \"chatgpt\") -> dict:\n281:         return {\n282:             k: {**srv.get_status(), \"is_active\": (k == active_key)}\n283:             for k, srv in self.servers.items()\n284:         }\n285: \n286:     def start(self, key: str = \"chatgpt\") -> dict:\n287:         srv = self.get_server(key)\n288:         if srv:\n289:             return srv.start()\n290:         return {\"success\": False, \"message\": f\"Server {key} not found\"}\n291: \n292:     def stop(self, key: str = \"chatgpt\") -> dict:\n293:         srv = self.get_server(key)\n294:         if srv:\n295:             return srv.stop()\n296:         return {\"success\": False, \"message\": f\"Server {key} not found\"}\n297: \n298:     def is_running(self, key: str = \"chatgpt\") -> bool:\n299:         srv = self.get_server(key)\n300:         return srv.is_running() if srv else False\n301: \n302:     def test(self, key: str = \"chatgpt\") -> dict:\n303:         srv = self.get_server(key)\n304:         if srv:\n305:             return srv.test()\n306:         return {\"success\": False, \"error\": f\"Server {key} not found\"}\n307: \n308:     def run_get_session(self, key: str = \"chatgpt\") -> dict:\n309:         srv = self.get_server(key)\n310:         if srv:\n311:             return srv.run_get_session()\n312:         return {\"success\": False, \"output\": f\"Server {key} not found\"}\n313: \n314:     def cleanup(self):\n315:         for srv in self.servers.values():\n316:             if srv.process is not None:\n317:                 srv.stop()\n318: \n319: # Backward compatibility alias\n320: MSEMAXServerManager = MultiServerManager\n321: \n322: \nThe above content shows the entire, complete file contents of the requested file.\n","truncated_fields":["content"]}
