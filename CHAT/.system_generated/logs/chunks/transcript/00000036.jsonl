try['type']\\n        by_intended_type.setdefault(t, []).append((name, entry.get('target_warehouse'), entry.get('expected_wh_match')))\\n    else:\\n        by_intended_type.setdefault(\\\"Unknown\\\", []).append(name)\\n\\nfor t, items in by_intended_type.items():\\n    print(f\\\"\\\\n--- {t} ({len(items)} items) ---\\\")\\n    for it in items[:15]:\\n        print(f\\\"  Shortage: '{it[0]}' -> Target: {it[1]} -> Expected: '{it[2]}'\\\")\\n\"","Description":"\"Analyze items in PROC-003 not found sheet\"","Overwrite":"true","TargetFile":"\"d:\\\\AI_Engineer\\\\Pharmacy-agy\\\\scratch_analyze_not_found.py\"","toolAction":"\"Writing not found analysis script\"","toolSummary":"\"Write scratch_analyze_not_found.py\""}}]}
