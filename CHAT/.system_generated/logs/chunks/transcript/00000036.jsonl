 shortage_items: list[dict], warehouse_data: dict[str, list[dict]]) -> dict:\n39:         unique_shortages = {}\n40:         for item in shortage_items:\n41:             name = item.get(\"item_name_raw\", \"\")\n42:             if name and name not in unique_shortages:\n43:                 unique_shortages[name] = item\n44:                 \n45:         deduped_shortages = list(unique_shortages.values())\n46: \n47:         print(f\"\\n{'='*60}\")\n48:         print(f\"[FAST ENGINE] Starting Match: {len(shortage_items)} raw -> {len(deduped_shortages)} UNIQUE shortages x {len(warehouse_data)} warehouses\")\n49:         print(f\"{'='*60}\\n\")\n50: \n51:         all_warehouse_results = {}\n52:         found_in = {}\n53: \n54:         for wh_name, wh_items in warehouse_data.items():\n55:             print(f\"\\n{'-'*40}\")\n56:             print(f\"[Warehouse] {wh_name} ({len(wh_items)} items)\")\n57:             print(f\"{'-'*40}\")\n58: \n59:             wh_result = self._match_warehouse(deduped_shortages, wh_items, wh_name)\n60:             all_warehouse_results[wh_name] = wh_result\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
