40: load_dotenv()\n41: \n42: logging.basicConfig(\n43:     level=logging.INFO,\n44:     format=\"%(asctime)s - %(name)s - %(levelname)s - %(message)s\"\n45: )\n46: logger = logging.getLogger(\"msemax.webhook\")\n47: \n48: # ---\n<truncated 3767 bytes>\necontent\"]):\n120:                     if response.status >= 400:\n121:                         try:\n122:                             body = await response.text()\n123:                             logger.error(f\"[Google Backend Error {response.status}] URL: {url[:80]} | Response Body: {body[:600]}\")\n124:                         except Exception:\n125:                             logger.error(f\"[Google Backend Error {response.status}] URL: {url[:80]}\")\n126:                     elif \"generatecontent\" in url.lower() or \"runprompt\" in url.lower():\n127:                         logger.info(f\"[Google Backend Status {response.status}] URL: {url[:80]}\")\n128:             except Exception:\n129:                 pass\n130: \n131:         self.page.on(\"response\", handle_response)\n132:         self.page.on(\"pageerror\", lambda err: logger.warning(f\"[Browser Page Error]: {err}\"))\n133: \n134:         logger.info(f\"Navigating to {TARGET_URL} to ensure clean environment...\")\n135:         try:\n136:             await self.page.goto(TARGET_URL, timeout=60000, wait_until=\"domcontentloaded\")\n137:             await asyncio.sleep(2)\n138:         except Exception as e:\n139:             logger.warning(f\"Initial page navigation warning: {e}. Page will be ready on demand.\")\n140: \n141:         # Check if user needs to log in\n142:         if \"accounts.google.com\" in self.page.url or \"welcome\" in self.page.url:\n143:             logger.warning(\"=\" * 65)\n144:             logger.warning(\"[ACTION REQUIRED] Google AI Studio requires Google Account login!\")\n145:             logger.warning(\"Please sign into your Google account in the Chromium window.\")\n146:             logger.warning(\"Waiting for login co