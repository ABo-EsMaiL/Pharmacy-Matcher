\"matched_warehouse_index\": <رقم صنف المخزن المطابق (يبدأ من 0) أو -1 إذا لم يوجد>,\n68:     \"confidence\": \"<high أو medium أو low>\",\n69:     \"reason\": \"<سبب القرار باللغة العربية>\"\n70:   }},\n71:   ...\n72: ]\n73: \"\"\"\n74: \n75: \n76: def match_with_gemini(\n77:     shortage_name: str,\n78:     candidates: list[dict],\n79:     api_key: str,\n80:     model: str = \"gemini-2.5-flash\",\n81: ) -> dict:\n82:     \"\"\"\n83:     مطابقة صنف واحد مع قائمة مرشحين باستخدام Gemini.\n84: \n85:     Args:\n86:         shortage_name: اسم الصنف المطلوب (المفقود).\n87:         candidates: قائمة المرشحين، كل عنصر يحتوي على:\n88:             - item_name_raw: اسم الصنف الخام\n89:             - source: اسم الملف المصدر (المخزن)\n90:         api_key: مفتاح Gemini API.\n91:         model: اسم النموذج المستخدم.\n92: \n93:     Returns:\n94:         قاموس يحتوي على:\n95:             - matched: هل تم العثور على تطابق (bool)\n96:             - matched_item: اسم الصنف المطابق أو None\n97:             - confidence: درجة الثقة (high/medium/low)\n98:             - reason: سبب القرار\n99:     \"\"\"\n100:     if not candidates:\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n","truncated_fields":["content"]}
