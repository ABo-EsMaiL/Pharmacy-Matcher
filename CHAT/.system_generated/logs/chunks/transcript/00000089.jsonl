         self.log(\"[SYSTEM] Starting MSEMAX Server...\")\n47:             self.process = subprocess.Popen(\n48:                 [sys.executable, \"app.py\"],\n49:                 cwd=self.msemax_dir,\n50:                 creationflags=creationflags,\n51:                 stdout=subprocess.PIPE,\n52:                 stderr=subprocess.STDOUT,\n53:                 text=True,\n54:                 bufsize=1\n55:             )\n56:             \n57:             t = threading.Thread(target=self._read_output, args=(self.process.stdout, \"[SERVER]\"), daemon=True)\n58:             t.start()\n59:             \n60:             self.log(\"[SYSTEM] Server process started successfully.\")\n61:             return {\"success\": True, \"message\": \"started\"}\n62:         except Exception as e:\n63:             self.log(f\"[SYSTEM ERROR] Failed to start server: {str(e)}\")\n64:             return {\"success\": False, \"message\": str(e)}\n65: \n66:     def stop(self) -> dict:\n67:         if not self.is_running():\n68:             return {\"success\": True, \"message\": \"not running\"}\n69:             \n70:         try:\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
