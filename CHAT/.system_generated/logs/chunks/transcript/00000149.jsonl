AF_INET, socket.SOCK_STREAM) as s:\n42:             s.settimeout(timeout)\n43:             return s.connect_ex((host, port)) == 0\n44:     except Exception:\n45:         return False\n46: \n4\n<truncated 169 bytes>\n fastapi  # noqa\n51:         return sys.executable\n52:     except ImportError:\n53:         pass\n54:     \n55:     candidates = [\n56:         r\"D:\\miniconda3\\envs\\venv\\python.exe\",\n57:         str(Path(sys.prefix) / \"python.exe\"),\n58:         str(Path(sys.executable).parent / \"envs\" / \"venv\" / \"python.exe\"),\n59:     ]\n60:     for c in candidates:\n61:         if Path(c).exists():\n62:             return str(c)\n63:             \n64:     return sys.executable\n65: \n66: class ServerInstance:\n67:     def __init__(self, key: str, config: dict, logger_callback=None):\n68:         self.key = key\n69:         self.name = config.get(\"name\", key)\n70:         self.dir = config.get(\"dir\", config.get(\"default_dir\", \"\"))\n71:         self.port = int(config.get(\"port\", 8000))\n72:         self.default_model = config.get(\"default_model\", \"gpt-4o\")\n73:         self.url = config.get(\"url\", f\"http://127.0.0.1:{self.port}/v1/chat/completions\")\n74:         self.api_key = config.get(\"api_key\", \"[REDACTED_CREDENTIAL]\")\n75:         self.process = None\n76:         self.logger = logger_callback\n77: \n78:     def log(self, message: str):\n79:         prefix = f\"[{self.name}]\"\n80:         if self.logger:\n81:             self.logger(f\"{prefix} {message}\")\n82:         else:\n83:             print(f\"{prefix} {message}\")\n84: \n85:     def is_running(self) -> bool:\n86:         if self.process is not None and self.process.poll() is None:\n87:             return True\n88:         return is_port_listening(self.port)\n89: \n90:     def _read_output(self, pipe):\n91:         try:\n92:             for line in iter(pipe.readline, ''):\n93:                 if line:\n94:                     self.log(line.strip())\n95:         except Exception:\n96:             pass\n97:         finally:\n98:             pipe.close()\n99: \n100:     def start(self) -> dict:\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n","truncated_fields":["content"]}
