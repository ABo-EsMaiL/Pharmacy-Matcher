خ بعيد -> form:\\\", extract_form_group(\\\"جرانتيل امبول مجم تاريخ بعيد\\\"), \\\"| brand:\\\", extract_brand_tokens(\\\"جرانتيل امبول مجم تاريخ بعيد\\\"))\\n\\nprint(\\\"\\\\nVental check:\\\")\\nprint(\\\"فنتال بخاخ العربية -> form:\\\", extract_form_group(\\\"فنتال بخاخ العربية\\\"), \\\"| brand:\\\", extract_brand_tokens(\\\"فنتال بخاخ العربية\\\"))\\nprint(\\\"فتال عادى بخاخ -> form:\\\", extract_form_group(\\\"فتال عادى بخاخ\\\"), \\\"| brand:\\\", extract_brand_tokens(\\\"فتال عادى بخاخ\\\"))\\n\"","Description":"\"In