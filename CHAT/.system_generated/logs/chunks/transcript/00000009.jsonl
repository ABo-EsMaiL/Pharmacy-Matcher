ped event (if supported by pywebview version)\\n    try:\\n        window.events.dropped += on_dropped\\n    except AttributeError:\\n        pass\"","StartLine":"45","TargetContent":"\"    # Create the main window\\n    window = webview.create_window(\\n        title=\\\"Pharmacy Matcher — نظام مطابقة الأدوية\\\",\\n        url=str(html_path),\\n        js_api=api,\\n        width=1200,\\n        height=800,\\n        min_size=(900, 600),\\n        resizable=True,\\n        text_select=False,\\n    )\\n\\n    # Give the API a reference to the window (for evaluate_js calls)\\n    api.window = window\\n\\n    # On window close, cleanup resources\\n    def on_closing():\\n        try:\\n            api.on_closing()\\n        except Exception:\\n            pass\\n\\n    window.events.closing += on_closing\"","TargetFile":"\"d:\\\\AI_Engineer\\\\Pharmacy-agy\\\\desktop_app\\\\app.py\"","toolAction":"\"Hooking into pywebview's native file drop event\"","toolSummary":"\"Enable native D&D\""}}]}
