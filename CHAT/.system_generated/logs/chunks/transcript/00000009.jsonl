rderColor = '';\\n                zone.style.background = '';\\n            }\\n        });\\n        window.activeDragZone = null;\\n    }\\n}\\n\\nfunction setupDragAndDrop() {\\n    const zones = [\\n        { id: 'zone-shortage', type: 'shortage' },\\n        { id: 'zone-warehouse', type: 'warehouse' }\\n    ];\\n\\n    zones.forEach(({id, type}) => {\\n        const zone = document.getElementById(id);\\n        if (!zone) return;\\n\\n        zone.addEventListener('dragenter', () => { window.activeDragZone = type; });\\n        zone.addEventListener('dragover', (e) => {\\n            e.preventDefault();\\n            window.activeDragZone = type;\\n            zone.style.borderColor = 'var(--primary)';\\n            zone.style.background = '#f0f9ff';\\n        });\\n\\n        zone.addEventListener('dragleave', (e) => {\\n            e.preventDefault();\\n            zone.style.borderColor = '';\\n            zone.style.background = '';\\n            // We do not set activeDragZone to null here, \\n            // because dragleave fires right before the native drop event!\\n        });\\n\\n\n<truncated 1954 bytes>","TargetFile":"\"d:\\\\AI_Engineer\\\\Pharmacy-agy\\\\desktop_app\\\\templates\\\\index.html\"","toolAction":"\"Update drag and drop logic to fetch from python safely and validate file types\"","toolSummary":"\"Update index.html logic\""}}],"truncated_fields":["tool_calls"]}
