ipt to make a shortcut\n49: set SCRIPT_PATH=%~dp0run.bat\n50: set SHORTCUT_PATH=%USERPROFILE%\\Desktop\\Pharmacy Matcher.lnk\n51: set ICON_PATH=%~dp0desktop_app\\static\\icon.ico\n52: \n53: :: Write VBS to create shortcut\n54: echo Set WshShell = CreateObject(\"WScript.Shell\") > \"%TEMP%\\create_shortcut.vbs\"\n55: echo Set Shortcut = WshShell.CreateShortcut(\"%SHORTCUT_PATH%\") >> \"%TEMP%\\create_shortcut.vbs\"\n56: echo Shortcut.TargetPath = \"%SCRIPT_PATH%\" >> \"%TEMP%\\create_shortcut.vbs\"\n57: echo Shortcut.WorkingDirectory = \"%~dp0\" >> \"%TEMP%\\create_shortcut.vbs\"\n58: echo Shortcut.WindowStyle = 7 >> \"%TEMP%\\create_shortcut.vbs\"\n59: echo Shortcut.Description = \"Pharmacy Matcher - نظام مطابقة الأدوية\" >> \"%TEMP%\\create_shortcut.vbs\"\n60: if exist \"%ICON_PATH%\" (\n61:     echo Shortcut.IconLocation = \"%ICON_PATH%\" >> \"%TEMP%\\create_shortcut.vbs\"\n62: )\n63: echo Shortcut.Save >> \"%TEMP%\\create_shortcut.vbs\"\n64: \n65: cscript //nologo \"%TEMP%\\create_shortcut.vbs\"\n66: del \"%TEMP%\\create_shortcut.vbs\"\n67: echo       Shortcut created on Desktop.\n68: \n69: echo.\n70: echo ╔══════════════════════════════════════════════════════╗\n71: echo ║              Setup completed successfully!           ║\n72: echo ║         Double-click \"Pharmacy Matcher\" on Desktop   ║\n73: echo ╚══════════════════════════════════════════════════════╝\n74: echo.\n75: pause\n76: \nThe above content shows the entire, complete file contents of the requested file.\n"}
