\n    else:\r\n        # البحث عن .env في جذر المشروع\r\n        project_root = Path(__file__).resolve().parent.parent\r\n        load_dotenv(project_root / \".env\")\r\n\r\n    # قراءة المفاتيح المطلوبة\r\n    unstructured_key = os.getenv(\"UNSTRUCTURED_API_KEY\", \"\").strip()\r\n    gemini_key = os.getenv(\"GEMINI_API_KEY\", \"\").strip()\r\n\r\n    # التحقق من وجود المفاتيح\r\n    missing: list[str] = []\r\n    if not unstructured_key or unstructured_key == \"your_key_here\":\r\n        missing.append(\"UNSTRUCTURED_API_KEY\")\r\n    if not gemini_key or gemini_key == \"your_key_here\":\r\n        missing.append(\"GEMINI_API_KEY\")\r\n\r\n    if missing:\r\n        raise ValueError(\r\n            f\"⚠️ مفاتيح API التالية مفقودة أو غير مُعيَّنة في ملف .env:\\n\"\r\n            f\"  {', '.join(missing)}\\n\"\r\n            f\"يرجى نسخ .env.example إلى .env وتعبئة المفاتيح.\"\r\n        )\r\n\r\n    return Config(\r\n        unstructured_api_key=unstructured_key,\r\n        gemini_api_key=gemini_key,\r\n    )\r\n\r\n\n\n</SYSTEM_MESSAGE>"}
