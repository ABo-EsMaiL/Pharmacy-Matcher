e64 (Perfect for Edge WebView2)\\n                        await new Promise((resolve) => {\\n                            const reader = new FileReader();\\n                            reader.onload = async (event) => {\\n                                const base64 = event.target.result.split(',')[1];\\n                                const tempPath = await window.pywebview.api.save_dropped_file(file.name, base64);\\n                                if (tempPath) {\\n                                    savedPaths.push(tempPath);\\n                                }\\n                                resolve();\\n                            };\\n                            reader.readAsDataURL(file);\\n                        });\\n                    }\\n                }\\n                \\n                if (savedPaths.length > 0) {\\n                    proc\n<truncated 126 bytes>","StartLine":"1108","TargetContent":"\"        zone.addEventListener('dragleave', (e) => {\\n            e.preventDefault();\\n            zone.style.borderColor = '';\\n            zone.style.background = '';\\n            // We do not set activeDragZone to null here, \\n            // because dragleave fires right before the native drop event!\\n        });\\n\\n        // The native JS drop is blocked by Edge WebView2, \\n        // but we intercept the drop in Python and call handleNativeDrop!\\n        zone.addEventListener('drop', (e) => {\\n            e.preventDefault();\\n            // Just in case Edge *does* expose path on a future update or on Mac:\\n            if (e.dataTransfer && e.dataTransfer.files) {\\n                const files = Array.from(e.dataTransfer.files).map(f => f.path || f.name).filter(p => p);\\n                const hasPath = files.length > 0 && (files[0].includes('\\\\\\\\') || files[0].includes('/'));\\n                if (hasPath) {\\n                    handleNativeDrop(files);\\n                }\\n            }\\n        });\"","TargetFile":"\"d:\\