86\": \"ج\",  # چ -> ج (مثل زانوچيلد -> زانوجيلد)\n60:         \"\\u06BA\": \"ن\",  # ں -> ن\n61:         \"\\u0679\": \"ت\",  # ٹ -> ت\n62:         \"\\u0688\": \"د\",  # ڈ -> د\n63:         \"\\u0698\": \"ز\",  # ژ -> ز\n64:         \"\\u06C0\": \"ه\",  # ۀ -> ه\n65:         \"\\u06C1\": \"ه\",  # ہ -> ه\n66:     }\n67:     for k_char, v_char in ocr_replacements.items():\n68:         result = result.replace(k_char, v_char)\n69: \n70:     # 7. تحويل التاء المربوطة إلى هاء\n71:     result = result.replace(\"ة\", \"ه\")\n72: \n73:     # 8. توحيد المسافات\n74:     result = re.sub(r\"\\s+\", \" \", result)\n75: \n76:     # 9. حذف المسافات من البداية والنهاية\n77:     result = result.strip()\n78: \n79:     return result\n80: \n81: \n82: def find_candidates(\n83:     query: str,\n84:     items: list[str],\n85:     threshold: float = 0.60,\n86:     max_results: int = 5,\n87: ) -> list[tuple[str, float]]:\n88:     \"\"\"\n89:     البحث عن أقرب المرشحين لاسم دواء باستخدام المطابقة الضبابية.\n90: \n91:     يستخدم كلاً من token_sort_ratio و partial_ratio من مكتبة rapidfuzz\n92:     ويأخذ الأعلى بينهما لكل عنصر.\n93: \n94:     Args:\n95:         query: اسم الدواء المطلوب البحث عنه.\n96:         items: قائمة أسماء الأدوية المتاحة في المخزن.\n97:         threshold: الحد الأدنى لدرجة التشابه (0.0 إلى 1.0).\n98:         max_results: الحد الأقصى لعدد النتائج المُرجَعة.\n99: \n100:     Returns:\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n","truncated_fields":["content"]}
