hortcut.vbs\\\"\\necho Shortcut.WorkingDirectory = \\\"%~dp0\\\" >> \\\"%TEMP%\\\\cre\n<truncated 1021 bytes>","Description":"\"One-click setup installer that creates venv, installs deps, and creates a desktop shortcut\"","Overwrite":"false","TargetFile":"\"d:\\\\AI_Engineer\\\\Pharmacy-agy\\\\setup.bat\"","toolAction":"\"Creating setup installer script\"","toolSummary":"\"Create setup.bat\""}}],"truncated_fields":["tool_calls"]}
