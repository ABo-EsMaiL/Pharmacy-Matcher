{"step_index":6077,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-24T00:57:32Z","content":"Created At: 2026-09-24T03:57:32+03:00\nCompleted At: 2026-09-24T03:57:32+03:00\nFile Path: `file:///D:/AI_Engineer/MSEMAX-GAIStudio/app.py`\nTotal Lines: 961\nTotal Bytes: 41643\nShowing lines 1 to 60\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"\"\"\n2: MSEMAX — Google AI Studio Web Hook Gateway (FastAPI Server)\n3: \n4: A 100% free, OpenAI-compatible API gateway that drives the Google AI Studio\n5: Web Interface (https://aistudio.google.com) using a persistent Chromium\n6: browser profile (./chrome_profile).\n7: \n8: No official API key is required. Uses real-time DOM stream capture to\n9: provide instant Server-Sent Events (SSE) responses compatible with any\n10: OpenAI client, LangChain, n8n, etc.\n11: \n12: Default Model: gemini-3.8-flash (Thinking: High)\n13: \n14: Author: Mohamed (MSEMAX) & Antigravity\n15: License: MIT\n16: \"\"\"\n17: \n18: import os\n19: import time\n20: import json\n21: import uuid\n22: import asyncio\n23: import logging\n24: from typing import AsyncGenerator, Optional, Any, List, Dict\n25: from contextlib import asynccontextmanager\n26: \n27: from fastapi import FastAPI, Request, HTTPException, Depends, Header\n28: from fastapi.responses import StreamingResponse, JSONResponse\n29: from fastapi.middleware.cors import CORSMiddleware\n30: from pydantic import BaseModel\n31: from slowapi import Limiter, _rate_limit_exceeded_handler\n32: from slowapi.util import get_remote_address\n33: from slowapi.errors import RateLimitExceeded\n34: from dotenv import load_dotenv\n35: from playwright.async_api import async_playwright, BrowserContext, Page\n36: \n37: # Load environment\n38: load_dotenv()\n39: \n40: logging.basicConfig(\n41:     level=logging.INFO,\n42:     format=\"%(asctime)s - %(name)s - %(levelname)s - %(message)s\"\n43: )\n44: logger = logging.getLogger(\"msemax.webhook\")\n45: \n46: # ------------------------------------------------------------------------------\n47: # Configuration\n48: # ------------------------------------------------------------------------------\n49: API_KEY = os.getenv(\"MSE_MAX_KEY\", \"\").strip()\n50: CHROME_PROFILE_DIR = os.getenv(\"CHROME_PROFILE_DIR\", \"./chrome_profile\")\n51: HEADLESS = os.getenv(\"HEADLESS\", \"true\").lower() in (\"true\", \"1\", \"yes\")\n52: DEFAULT_MODEL = os.getenv(\"DEFAULT_MODEL\", \"gemini-3.8-flash\").strip()\n53: THINKING_MODE = os.getenv(\"THINKING_MODE\", \"high\").strip().lower()\n54: ENABLE_SEARCH_GROUNDING = os.getenv(\"ENABLE_SEARCH_GROUNDING\", \"true\").lower() in (\"true\", \"1\", \"yes\")\n55: CLEAR_CHAT_ON_REQUEST = os.getenv(\"CLEAR_CHAT_ON_REQUEST\", \"false\").lower() in (\"true\", \"1\", \"yes\")\n56: REQUEST_TIMEOUT = float(os.getenv(\"MSE_REQUEST_TIMEOUT\", \"180\"))\n57: RATE_LIMIT = os.getenv(\"MSE_RATE_LIMIT\", \"30/minute\").strip()\n58: MAX_CONCURRENT = int(os.getenv(\"MSE_MAX_CONCURRENT\", \"1\"))\n59: PORT = int(os.getenv(\"PORT\", \"8001\"))\n60: TARGET_URL = \"https://aistudio.google.com/prompts/new_chat\"\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
