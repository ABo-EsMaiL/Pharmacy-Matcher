_length = max(max_length, cell_len)\n66:         # حد أدنى 12، حد أقصى 60\n67:         adjusted_width = min(max(max_length + 4, 12), 60)\n68:         ws.column_dimensions[col_letter].width = adjusted_width\n69: \n70: \n71: def _add_data_rows(ws, rows: list[list], start_row: int = 2) -> None:\n72:     \"\"\"إضافة صفوف البيانات مع التنسيق.\"\"\"\n73:     for row_idx, row_data in enumerate(rows, start=start_row):\n74:         for col_idx, value in enumerate(row_data, start=1):\n75:             cell = ws.cell(row=row_idx, column=col_idx, value=value)\n76:             cell.font = _CELL_FONT\n77:             cell.alignment = _CELL_ALIGNMENT\n78:             cell.border = _THIN_BORDER\n79: \n80: \n81: def _truncate_sheet_name(name: str, max_len: int = 31) -> str:\n82:     \"\"\"\n83:     اقتطاع اسم الورقة ليتوافق مع حد Excel (31 حرفاً).\n84:     يزيل أيضاً الأحرف غير المسموح بها في أسماء الأوراق.\n85:     \"\"\"\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
