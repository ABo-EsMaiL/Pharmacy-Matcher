{"step_index":10102,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-25T14:11:34Z","content":"Created At: 2026-09-25T17:11:34+03:00\nCompleted At: 2026-09-25T17:12:06+03:00\nFile Path: `file:///d:/AI_Engineer/Pharmacy-agy-vision/src/extract/file_handler.py`\nTotal Lines: 142\nTotal Bytes: 4881\nShowing lines 1 to 60\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"\"\"\n2: File handler module - detects file type and routes to appropriate reader.\n3: \"\"\"\n4: \n5: import json\n6: from pathlib import Path\n7: \n8: from .excel_reader import read_excel, extract_item_names\n9: from .markdown_reader import read_markdown_file\n10: from .gemini_vision_extractor import extract_items_from_pdf_vision\n11: from .pdf_reader import parse_structured_result\n12: \n13: _EXCEL_EXTENSIONS = {\".xlsx\", \".xls\", \".xlsm\"}\n14: _MARKDOWN_EXTENSIONS = {\".md\", \".markdown\"}\n15: _PDF_EXTENSIONS = {\".pdf\"}\n16: _JSON_EXTENSIONS = {\".json\"}\n17: \n18: \n19: from concurrent.futures import ThreadPoolExecutor, as_completed\n20: \n21: \n22: def _process_single_file(\n23:     filepath: Path,\n24:     vision_api_url: str = \"http://127.0.0.1:8001/v1/chat/completions\",\n25:     vision_api_key: str = \"[REDACTED_CREDENTIAL]\",\n26:     vision_model: str = \"gemini-3.8-flash\",\n27:     api_key: str | None = None,\n28:     base_url: str = \"https://transform.unstructured.io\",\n29:     gemini_api_key: str | None = None,\n30:     profile: str = \"balanced\"\n31: ) -> tuple[str, list[dict]]:\n32:     filepath = Path(filepath)\n33:     ext = filepath.suffix.lower()\n34:     print(f\"\\n  -> [START] Processing file: {filepath.name} (Type: {ext})\")\n35:     try:\n36:         if ext in _EXCEL_EXTENSIONS:\n37:             items = _process_excel_file(filepath)\n38:         elif ext in _MARKDOWN_EXTENSIONS:\n39:             items = _process_markdown_file(filepath)\n40:         elif ext in _PDF_EXTENSIONS:\n41:             items = _process_pdf_file(\n42:                 filepath,\n43:                 vision_api_url=vision_api_url,\n44:                 vision_api_key=vision_api_key,\n45:                 vision_model=vision_model,\n46:                 legacy_api_key=api_key,\n47:                 legacy_base_url=base_url\n48:             )\n49:         elif ext in _JSON_EXTENSIONS:\n50:             items = _process_json_file(filepath)\n51:         else:\n52:             print(f\"[!] Unsupported extension: {ext} for {filepath.name}\")\n53:             return filepath.name, []\n54: \n55:         print(f\"  -> [DONE] {filepath.name}: {len(items)} items extracted.\")\n56:         return filepath.name, items\n57:     except Exception as e:\n58:         print(f\"[!] Exception processing {filepath.name}: {e}\")\n59:         return filepath.name, []\n60: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
