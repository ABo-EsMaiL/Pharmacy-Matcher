s = []\n32:     norm_a = normalize_text(a)\n33:     for r, s in shortages:\n34:         norm_s = normalize_text(s)\n35:         sc1 = fuzz.token_set_ratio(norm_a, norm_s)\n36:         sc2 = fuzz.token_sort_ratio(norm_a, norm_s)\n37:         sc = max(sc1, sc2)\n38:         if sc >= 50:\n39:             candidates.append((sc, r, s))\n40:     candidates.sort(key=lambda x: x[0], reverse=True)\n41:     if candidates:\n42:         best = candidates[0]\n43:         amr_matches.append((best[0], a, best[1], best[2]))\n44:         print(f\"[Score: {best[0]:.1f}] Amr: '{a}'\\n  --> Shortage (Row {best[1]}): '{best[2]}'\")\n45:     else:\n46:         print(f\"[No match >= 50%] Amr: '{a}'\")\n47: \n48: print(\"\\n\" + \"=\"*50)\n49: print(\"--- SALAM ITEMS MATCHING ---\")\n50: print(\"=\"*50)\n51: salam_matches = []\n52: for s_item in salam_items:\n53:     candidates = []\n54:     norm_item = normalize_text(s_item)\n55:     for r, s in shortages:\n56:         norm_s = normalize_text(s)\n57:         sc1 = fuzz.token_set_ratio(norm_item, norm_s)\n58:         sc2 = fuzz.token_sort_ratio(norm_item, norm_s)\n59:         sc = max(sc1, sc2)\n60:         if sc >= 50:\n61:             candidates.append((sc, r, s))\n62:     candidates.sort(key=lambda x: x[0], reverse=True)\n63:     if candidates:\n64:         best = candidates[0]\n65:         salam_matches.append((best[0], s_item, best[1], best[2]))\n66: \n67: print(f\"Salam items with match score >= 50%: {len(salam_matches)}\")\n68: salam_matches.sort(key=lambda x: x[0], reverse=True)\n69: for sc, item, r, s in salam_matches[:30]:\n70:     print(f\"[Score: {sc:.1f}] Salam: '{item}'\\n  --> Shortage (Row {r}): '{s}'\")\n71: \nThe above content shows the entire, complete file contents of the requested file.\n"}
