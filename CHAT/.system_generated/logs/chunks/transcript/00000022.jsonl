_ALIGNMENT\n38:         cell.border = _THIN_BORDER\n39: \n40: \n41: def _format_sheet(ws, num_cols: int) -> None:\n42:     \"\"\"تنسيق الورقة: تجميد الصف الأول، فلتر تلقائي، RTL، عرض الأعمدة.\"\"\"\n43:     # تجميد الصف الأول\n44:     ws.freeze_panes = \"A2\"\n45: \n46:     # فلتر تلقائي\n47:     if ws.max_row > 0 and num_cols > 0:\n48:         last_col_letter = get_column_letter(num_cols)\n49:         ws.auto_filter.ref = f\"A1:{last_col_letter}{ws.max_row}\"\n50: \n51:     # اتجاه الورقة من اليمين لليسار\n52:     ws.sheet_view.rightToLeft = True\n53: \n54:     # عرض الأعمدة التلقائي (تقدير بسيط)\n55:     for col_idx in range(1, num_cols + 1):\n56:         max_length = 0\n57:         col_letter = get_column_letter(col_idx)\n58:         for row in ws.iter_rows(\n59:             min_col=col_idx, max_col=col_idx, min_row=1, max_row=ws.max_row\n60:         ):\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
