             col_lengths[col_idx] += len(cell)\n334:         best_col = col_lengths.index(max(col_lengths)) if col_lengths else 0\n335: \n336:     # استخراج القيم من العمود المحدد\n337:     names: list[str] = []\n338:     for row in data_rows:\n339:         if best_col < len(row):\n340:             name = row[best_col].strip()\n341:             if name:\n342:                 names.append(name)\n343: \n344:     return names\n345: \n346: \n347: def _try_text_content(elements: list[dict]) -> list[dict]:\n348:     \"\"\"\n349:     محاولة استخراج الأصناف من المحتوى النصي.\n350: \n351:     يجمع النصوص من عناصر NarrativeText وTitle ويفصلها بالأسطر.\n352:     \"\"\"\n353:     items: list[dict] = []\n354:     arabic_pattern = re.compile(r\"[\\u0600-\\u06FF]\")\n355: \n356:     for elem in elements:\n357:         elem_type = elem.get(\"type\", \"\")\n358:         if elem_type not in (\"NarrativeText\", \"Title\", \"ListItem\", \"UncategorizedText\"):\n359:             continue\n360: \n361:         text = elem.get(\"text\", \"\").strip()\n362:         if not text:\n363:             continue\n364: \n365:         page = elem.get(\"metadata\", {}).get(\"page_number\")\n366: \n367:         # تقسيم النص إلى أسطر وفحص كل سطر\n368:         for line in text.split(\"\\n\"):\n369:             line = line.strip()\n370:             if not line or len(line) < 3:\n371:                 continue\n372: \n373:             # قبول الأسطر التي تحتوي على نص عربي أو أسماء أدوية (حروف لاتينية + أرقام)\n374:             has_arabic = bool(arabic_pattern.search(line))\n375:             has_drug_chars = bool(re.search(r\"[a-zA-Z]{3,}\", line))\n376: \n377:             if has_arabic or has_drug_chars:\n378:                 items.append({\"item_name_raw\": line, \"source_page\": page})\n379: \n380:     return items\n381: \nThe above content shows the entire, complete file contents of the requested file.\n","truncated_fields":["content"]}
