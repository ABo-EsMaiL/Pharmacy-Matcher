               else:\n182:                     headers.append(f\"_col_{i}\")\n183: \n184:             return row_idx, headers\n185: \n186:     return None, []\n187: \n188: \n189: def _detect_name_column(columns: list[str], rows: list[dict]) -> str:\n190:     \"\"\"\n191:     اكتشاف العمود الأكثر احتمالاً لاحتواء أسماء الأدوية.\n192: \n193:     الاستراتيجية:\n194:     1. البحث عن كلمات مفتاحية في أسماء الأعمدة.\n195:     2. إذا لم يُعثر عليها، اختيار العمود الذي يحتوي على أكبر نسبة نصوص عربية.\n196:     \"\"\"\n197:     # 1. البحث بالكلمات المفتاحية\n198:     for col in columns:\n199:         col_lower = col.strip().lower()\n200:         for keyword in _DRUG_NAME_KEYWORDS:\n201:             if keyword in col_lower:\n202:                 return col\n203: \n204:     # 2. البحث عن العمود الذي يحتوي على أكبر نسبة نصوص عربية طويلة\n205:     arabic_pattern = re.compile(r\"[\\u0600-\\u06FF]\")\n206:     best_col = columns[0]\n207:     best_score = 0\n208: \n209:     for col in columns:\n210:         score = 0\n211:         for row in rows[:20]:  # فحص أول 20 صف فقط\n212:             val = row.get(col)\n213:             if val is None:\n214:                 continue\n215:             val_str = str(val)\n216:             # حساب النتيجة: طول النص × نسبة الأحرف العربية\n217:             arabic_chars = len(arabic_pattern.findall(val_str))\n218:             if arabic_chars > 0:\n219:                 score += len(val_str) * (arabic_chars / max(len(val_str), 1))\n220: \n221:         if score > best_score:\n222:             best_score = score\n223:             best_col = col\n224: \n225:     return best_col\n226: \nThe above content shows the entire, complete file contents of the requested file.\n","truncated_fields":["content"]}
