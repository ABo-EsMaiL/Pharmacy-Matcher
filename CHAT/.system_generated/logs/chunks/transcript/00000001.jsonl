on,\n266:                             }\n267:                         )\n268:                 else:\n269:                     all_results.append(\n270:                         {\n271:                             \"matched\": False,\n272:                             \"matched_item\": None,\n273:                             \"confidence\": \"low\",\n274:                             \"reason\": \"لم يتم تضمين هذا الصنف في استجابة النموذج.\",\n275:                         }\n276:                     )\n277: \n278:         except json.JSONDecodeError as e:\n279:             logger.error(\"فشل تحليل استجابة Gemini كـ JSON (دفعة): %s\", e)\n280:             for _ in batch:\n281:                 all_results.append(\n282:                     {\n283:                         \"matched\": False,\n284:                         \"matched_item\": None,\n285:                         \"confidence\": \"low\",\n286:                         \"reason\": f\"خطأ في تحليل استجابة النموذج: {e}\",\n287:                     }\n288:                 )\n289:         except Exception as e:\n290:             logger.error(\"خطأ أثناء استدعاء Gemini API (دفعة): %s\", e)\n291:             for _ in batch:\n292:                 all_results.append(\n293:                     {\n294:                         \"matched\": False,\n295:                         \"matched_item\": None,\n296:                         \"confidence\": \"low\",\n297:                         \"reason\": f\"خطأ في الاتصال بالنموذج: {e}\",\n298:                     }\n299:                 )\n300: \n301:     return all_results\n302: \nThe above content shows the entire, complete file contents of the requested file.\n","truncated_fields":["content"]}
