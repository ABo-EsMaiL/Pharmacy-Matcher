ndow\n46:     window = webview.create_window(\n47:         title=\"Pharmacy Matcher — نظام مطابقة الأدوية\",\n48:         url=str(html_path.resolve()),\n49:         js_api=api,\n50:         width=1200,\n51:         height=800,\n52:         min_size=(900, 600),\n53:         resizable=True,\n54:         text_select=False,\n55:     )\n56: \n57:     # Give the API a reference to the window (for evaluate_js calls)\n58:     api.set_window(window)\n59: \n60:     # On window close, cleanup resources\n61:     def on_closing():\n62:         try:\n63:             api.on_closing()\n64:         except Exception:\n65:             pass\n66: \n67:     window.events.closing += on_closing\n68: \n69:     # Start the application (blocks until window is closed)\n70:     webview.start(\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
