l}\")\n27: \n28:     # 2. Look for buttons or spans mentioning model names or 'flash' or 'pro'\n29:     print(\"\\n=== LOOKING FOR MODEL TEXT/SELECTORS ===\")\n30:     candidates = await page.locator(\"[aria-label*='model' i], [aria-label*='Model' i], [class*='model' i], button:has-text('Flash'), button:has-text('Pro'), button:has-text('Gemini')\").all()\n31:     print(f\"Found {len(candidates)} candidate model elements:\")\n32:     for i, c in enumerate(candidates[:15]):\n33:         tag = await c.evaluate(\"el => el.tagName\")\n34:         aria = await c.get_attribute(\"aria-label\") or \"\"\n35:         txt = (await c.inner_text() or \"\").strip().replace(\"\\n\", \" \")\n36:         cls = await c.get_attribute(\"class\") or \"\"\n37:         print(f\"  cand[{i}]: tag={tag}, aria='{aria}', class='{cls}', text='{txt}'\")\n38: \n39:     await ctx.close()\n40:     await pw.stop()\n41: \n42: if __name__ == \"__main__\":\n43:     asyncio.run(inspect_ui())\n44: \nThe above content shows the entire, complete file contents of the requested file.\n"}
