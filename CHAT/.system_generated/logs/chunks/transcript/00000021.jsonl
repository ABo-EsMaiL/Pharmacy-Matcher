alue is None else {file_field: file_value}\r\n\r\n    request = api_client.param_serialize(\r\n        method=\"POST\",\r\n        resource_path=path,\r\n        header_params=header_params,\r\n        post_params=post_params,\r\n        files=files,\r\n        # Both schemes, matching the spec's `security` OR — the same list the\r\n        # generated operations pass, so this call authenticates the same way.\r\n        auth_settings=[\"ApiKeyAuth\", \"BearerAuth\"],\r\n    )\r\n\r\n    response = api_client.call_api(\r\n        *request, _request_timeout=client._timeout_seconds\r\n    )\r\n    response.read()\r\n    return api_client.response_deserialize(response, _RESPONSE_TYPES).data\r\n\r\n\n"}
