{"step_index":3621,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-22T19:31:19Z","content":"Created At: 2026-09-22T22:31:19+03:00\nCompleted At: 2026-09-22T22:31:20+03:00\nFile Path: `file:///d:/AI_Engineer/Pharmacy-agy/src/output/excel_writer.py`\nTotal Lines: 286\nTotal Bytes: 12625\nShowing lines 30 to 100\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n30: \n31: \n32: def _apply_header_style(ws, num_cols: int) -> None:\n33:     \"\"\"تطبيق تنسيق الرأس على الصف الأول.\"\"\"\n34:     for col_idx in range(1, num_cols + 1):\n35:         cell = ws.cell(row=1, column=col_idx)\n36:         cell.fill = _HEADER_FILL\n37:         cell.font = _HEADER_FONT\n38:         cell.alignment = _HEADER_ALIGNMENT\n39:         cell.border = _THIN_BORDER\n40: \n41: \n42: def _format_sheet(ws, num_cols: int) -> None:\n43:     \"\"\"تنسيق الورقة: تجميد الصف الأول، فلتر تلقائي، RTL، عرض الأعمدة.\"\"\"\n44:     # تجميد الصف الأول\n45:     ws.freeze_panes = \"A2\"\n46: \n47:     # فلتر تلقائي\n48:     if ws.max_row > 0 and num_cols > 0:\n49:         last_col_letter = get_column_letter(num_cols)\n50:         ws.auto_filter.ref = f\"A1:{last_col_letter}{ws.max_row}\"\n51: \n52:     # اتجاه الورقة من اليمين لليسار\n53:     ws.sheet_view.rightToLeft = True\n54: \n55:     # عرض الأعمدة التلقائي (تقدير بسيط)\n56:     for col_idx in range(1, num_cols + 1):\n57:         max_length = 0\n58:         col_letter = get_column_letter(col_idx)\n59:         for row in ws.iter_rows(\n60:             min_col=col_idx, max_col=col_idx, min_row=1, max_row=ws.max_row\n61:         ):\n62:             for cell in row:\n63:                 if cell.value:\n64:                     # حساب العرض التقريبي (الحروف العربية أعرض)\n65:                     cell_len = len(str(cell.value))\n66:                     max_length = max(max_length, cell_len)\n67:         # حد أدنى 12، حد أقصى 60\n68:         adjusted_width = min(max(max_length + 4, 12), 60)\n69:         ws.column_dimensions[col_letter].width = adjusted_width\n70: \n71: \n72: def _add_data_rows(ws, rows: list[list], start_row: int = 2) -> None:\n73:     \"\"\"إضافة صفوف البيانات مع التنسيق.\"\"\"\n74:     for row_idx, row_data in enumerate(rows, start=start_row):\n75:         for col_idx, value in enumerate(row_data, start=1):\n76:             cell = ws.cell(row=row_idx, column=col_idx, value=value)\n77:             cell.font = _CELL_FONT\n78:             cell.alignment = _CELL_ALIGNMENT\n79:             cell.border = _THIN_BORDER\n80: \n81: \n82: def _truncate_sheet_name(name: str, max_len: int = 31) -> str:\n83:     \"\"\"\n84:     اقتطاع اسم الورقة ليتوافق مع حد Excel (31 حرفاً).\n85:     يزيل أيضاً الأحرف غير المسموح بها في أسماء الأوراق.\n86:     \"\"\"\n87:     # إزالة الأحرف غير المسموح بها في أسماء أوراق Excel\n88:     invalid_chars = r\"[]:*?/\\\\\"\n89:     for ch in invalid_chars:\n90:         name = name.replace(ch, \"_\")\n91:     return name[:max_len]\n92: \n93: \n94: def _format_confidence(conf_raw: str) -> str:\n95:     \"\"\"تحويل قيم درجة التطابق الإنجليزية والتقنية إلى مصطلحات عربية واضحة.\"\"\"\n96:     if not conf_raw:\n97:         return \"\"\n98:     conf_str = str(conf_raw).strip()\n99:     conf_lower = conf_str.lower()\n100:     if conf_lower == \"exact\":\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
