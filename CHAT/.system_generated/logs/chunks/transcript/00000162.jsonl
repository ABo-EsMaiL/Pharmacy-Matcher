lEl = document.getElementById('setting-vision-url');\n3075:             if (visionUrlEl) visionUrlEl.value = settings.vision_api_url || 'http://127.0.0.1:8001/v1/chat/completions';\n3076:             const visionModelEl = document.getElementById('setting-vision-model');\n3077:             if (visionModelEl) visionModelEl.value = settings.vision_model || 'gemini-3.8-flash';\n3078:             document.getElementById('setting-local-url').value = settings.local_api_url || 'http://127.0.0.1:8001/v1/chat/completions';\n3079:             document.getElementById('setting-local-key').value = settings.local_api_key || '';\n3080:             document.getElementById('setting-model-name').value = settings.local_model || 'gemini-3.8-flash';\n3081:             document.getElementById('setting-msemax-dir').value = settings.msemax_dir || '';\n3082:         }\n3083:     } catch (error) {\n3084:         console.error('Failed to load settings', error);\n3085:     }\n3086: }\n3087: \n3088: async function saveSettings() {\n3089:     const profileEl = document.getElementById('setting-unstructured-profile');\n3090:     const visionUrlEl = document.getElementById('setting-vision-url');\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
